{
  "manifest_version": 3,
  "name": "AccountabiliBuddy",
  "version": "0.3.0",
  "description": "Connects your browser to the AccountabiliBuddy desktop app. Everything stays on this computer.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": { "128": "icon.png" },
  "permissions": ["tabs", "nativeMessaging", "favicon"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    }
  ]
}
