<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser native messaging host: stdio (extension) <-> named pipe (App). See ADR 5. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Started by the browser for every connection; keep startup lean. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Shares only the protocol files with Core instead of referencing it, so the host stays tiny. -->
  <ItemGroup>
    <Compile Include="..\AccountabiliBuddy.Core\Browser\NativeMessageFraming.cs" Link="Shared\NativeMessageFraming.cs" />
    <Compile Include="..\AccountabiliBuddy.Core\Browser\BrowserBridge.cs" Link="Shared\BrowserBridge.cs" />
  </ItemGroup>

</Project>
