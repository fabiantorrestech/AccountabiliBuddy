<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-hosted sealed relay (ADR 46): stores the sealed sync files as opaque bytes and pushes changes over SSE.
       Built on the ASP.NET Core shared framework only, no NuGet packages. Standalone: references nothing else in the repo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
