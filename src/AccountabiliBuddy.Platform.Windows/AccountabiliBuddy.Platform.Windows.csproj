<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows adapters for Core ports. 19041 TFM exposes WinRT (Windows.Media.Ocr, Windows.Graphics.Capture). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Required by CsWin32-generated interop code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source generator only: emits P/Invoke code for the APIs listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountabiliBuddy.Core\AccountabiliBuddy.Core.csproj" />
  </ItemGroup>

</Project>
