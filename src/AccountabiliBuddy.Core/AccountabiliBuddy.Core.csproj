<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable: no UI or OS-specific dependencies allowed here (ADR 4). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform; bundles native SQLite for Windows, Linux and macOS (ADR 6). -->
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
