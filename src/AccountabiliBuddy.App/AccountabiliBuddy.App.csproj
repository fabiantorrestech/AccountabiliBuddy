<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <!-- Bumped by scripts/package.ps1; Velopack needs a higher version for every update. -->
    <Version>0.1.115</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Reads the sync QR codes in a picture from the phone (ADR 22, user-approved 2026-10-21). -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- Installer, updates and uninstall hooks (ADR 10). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountabiliBuddy.Core\AccountabiliBuddy.Core.csproj" />
    <ProjectReference Include="..\AccountabiliBuddy.Platform.Windows\AccountabiliBuddy.Platform.Windows.csproj" />
    <!-- Built alongside so AccountabiliBuddy.NativeHost.exe lands next to the app, where the Setup tab registers it. -->
    <ProjectReference Include="..\AccountabiliBuddy.NativeHost\AccountabiliBuddy.NativeHost.csproj" />
  </ItemGroup>

  <!-- The sealed relay program (ADR 46) the "Run a relay on this PC" switch starts. Built before the app, but not referenced: it
       is a separate program with its own framework. A development build copies its build output to relay\ next to the app; the
       packaged app gets the self-contained build in the same folder from scripts/package.ps1. -->
  <ItemGroup>
    <ProjectReference Include="..\AccountabiliBuddy.Relay\AccountabiliBuddy.Relay.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyRelayToOutput" AfterTargets="Build">
    <MSBuild Projects="..\AccountabiliBuddy.Relay\AccountabiliBuddy.Relay.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="RelayTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <RelayBuildFolder>@(RelayTargetPath->'%(RootDir)%(Directory)')</RelayBuildFolder>
    </PropertyGroup>
    <ItemGroup>
      <RelayBuildFile Include="$(RelayBuildFolder)**" Exclude="$(RelayBuildFolder)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(RelayBuildFile)" DestinationFiles="@(RelayBuildFile->'$(OutDir)relay\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- The browser extension ships with the app: shared files plus one manifest per browser family. -->
  <ItemGroup>
    <None Include="..\..\extensions\shared\**" LinkBase="browser-extension\chromium" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\extensions\chromium\manifest.json" Link="browser-extension\chromium\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\extensions\shared\**" LinkBase="browser-extension\firefox" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\extensions\firefox\manifest.json" Link="browser-extension\firefox\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Guides the app opens from its pages (Devices → Sync with your own server). -->
  <ItemGroup>
    <None Include="..\..\doc\guides\self-hosted-sync.md" Link="guides\self-hosted-sync.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
