<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Instrument (the default): neutral grey ground, teal accent, hairline borders, IBM Plex Mono numerals. Same keys in all three theme files (ADR 49). Colours are Ab.<Name>Color, brushes Ab.<Name>. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Ab.BgColor">#F3F4F5</Color>
            <Color x:Key="Ab.SurfaceColor">#FFFFFF</Color>
            <Color x:Key="Ab.Surface2Color">#E6E9EB</Color>
            <Color x:Key="Ab.LineColor">#DDE1E4</Color>
            <Color x:Key="Ab.InkColor">#15181B</Color>
            <Color x:Key="Ab.MutedColor">#5B636B</Color>
            <Color x:Key="Ab.FaintColor">#8E969E</Color>
            <Color x:Key="Ab.AccentColor">#0F766E</Color>
            <Color x:Key="Ab.OnAccentColor">#FFFFFF</Color>
            <Color x:Key="Ab.AccentSoftColor">#DCEFEC</Color>
            <Color x:Key="Ab.InfoBgColor">#E4EBF0</Color>
            <Color x:Key="Ab.InfoInkColor">#2C3E50</Color>
            <Color x:Key="Ab.SleepColor">#5865A8</Color>
            <Color x:Key="Ab.MetColor">#0F766E</Color>
            <Color x:Key="Ab.WaitingColor">#B7791F</Color>
            <Color x:Key="Ab.DriftColor">#C2412D</Color>
            <Color x:Key="Ab.PlanColor">#C9CED3</Color>
            <Color x:Key="Ab.UpcomingColor">#B4BBC2</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight1">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight2">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight3">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark1">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark2">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark3">#0F766E</Color>
            <Color x:Key="SystemRegionColor">#F3F4F5</Color>
            <Color x:Key="SystemAltHighColor">#FFFFFF</Color>
            <Color x:Key="SystemBaseHighColor">#15181B</Color>
            <Color x:Key="SystemBaseMediumHighColor">#15181B</Color>
            <Color x:Key="SystemBaseMediumColor">#5B636B</Color>
            <Color x:Key="SystemBaseMediumLowColor">#8E969E</Color>
            <Color x:Key="SystemBaseLowColor">#E6E9EB</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #0F766E</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #15181B</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Ab.BgColor">#111315</Color>
            <Color x:Key="Ab.SurfaceColor">#181B1E</Color>
            <Color x:Key="Ab.Surface2Color">#202428</Color>
            <Color x:Key="Ab.LineColor">#2C3136</Color>
            <Color x:Key="Ab.InkColor">#E8EAEC</Color>
            <Color x:Key="Ab.MutedColor">#8E969E</Color>
            <Color x:Key="Ab.FaintColor">#5A626A</Color>
            <Color x:Key="Ab.AccentColor">#5EEAD4</Color>
            <Color x:Key="Ab.OnAccentColor">#06201D</Color>
            <Color x:Key="Ab.AccentSoftColor">#17312E</Color>
            <Color x:Key="Ab.InfoBgColor">#1A2530</Color>
            <Color x:Key="Ab.InfoInkColor">#B4C6D6</Color>
            <Color x:Key="Ab.SleepColor">#8E9BD6</Color>
            <Color x:Key="Ab.MetColor">#5EEAD4</Color>
            <Color x:Key="Ab.WaitingColor">#E8B04B</Color>
            <Color x:Key="Ab.DriftColor">#F0705A</Color>
            <Color x:Key="Ab.PlanColor">#3A4148</Color>
            <Color x:Key="Ab.UpcomingColor">#444C54</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight1">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight2">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight3">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark1">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark2">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark3">#5EEAD4</Color>
            <Color x:Key="SystemRegionColor">#111315</Color>
            <Color x:Key="SystemAltHighColor">#181B1E</Color>
            <Color x:Key="SystemBaseHighColor">#E8EAEC</Color>
            <Color x:Key="SystemBaseMediumHighColor">#E8EAEC</Color>
            <Color x:Key="SystemBaseMediumColor">#8E969E</Color>
            <Color x:Key="SystemBaseMediumLowColor">#5A626A</Color>
            <Color x:Key="SystemBaseLowColor">#202428</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #5EEAD4</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #E8EAEC</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="Ab.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Ab.NumeralFont">avares://AccountabiliBuddy.App/Assets/Fonts/IBMPlexMono#IBM Plex Mono, Consolas</FontFamily>
    <CornerRadius x:Key="Ab.CardRadius">14</CornerRadius>
    <CornerRadius x:Key="Ab.PanelRadius">10</CornerRadius>
    <!-- The time-left ring beside the timer digits: nudged so it sits on the digits' middle, which depends on the numeral font. -->
    <Thickness x:Key="Ab.TimeRingMargin">0,18,0,0</Thickness>
    <Thickness x:Key="Ab.CardBorderThickness">1</Thickness>
    <x:Double x:Key="Ab.DisplayLetterSpacing">0</x:Double>
    <FontWeight x:Key="Ab.NumeralWeight">Medium</FontWeight>
</ResourceDictionary>
