<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Instrument (the default): neutral grey ground, teal accent, hairline borders, IBM Plex Mono numerals. Same keys in all three theme files (ADR 49). Colours are Ab.<Name>Color, brushes Ab.<Name>. -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- FluentTheme's own brushes (SystemControlHighlightAccentBrush, TextBox focus border, CheckBox/RadioButton checked fill) sit in its
             "Default" (light) dictionary and resolve SystemAccentColor* against the Default variant, which never reads the "Light" one above:
             without this the light variants show Windows blue. Same colours as Light. -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight1">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight2">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight3">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark1">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark2">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark3">#0F766E</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Ab.BgColor">#F3F4F5</Color>
            <Color x:Key="Ab.SurfaceColor">#FFFFFF</Color>
            <Color x:Key="Ab.Surface2Color">#E6E9EB</Color>
            <Color x:Key="Ab.LineColor">#DDE1E4</Color>
            <Color x:Key="Ab.InkColor">#15181B</Color>
            <Color x:Key="Ab.MutedColor">#5B636B</Color>
            <Color x:Key="Ab.FaintColor">#8E969E</Color>
            <Color x:Key="Ab.AccentColor">#0F766E</Color>
            <Color x:Key="Ab.OnAccentColor">#FFFFFF</Color>
            <Color x:Key="Ab.AccentSoftColor">#DCEFEC</Color>
            <Color x:Key="Ab.InfoBgColor">#E4EBF0</Color>
            <Color x:Key="Ab.InfoInkColor">#2C3E50</Color>
            <Color x:Key="Ab.SleepColor">#5865A8</Color>
            <Color x:Key="Ab.MetColor">#0F766E</Color>
            <Color x:Key="Ab.WaitingColor">#B7791F</Color>
            <Color x:Key="Ab.DriftColor">#C2412D</Color>
            <Color x:Key="Ab.PlanColor">#C9CED3</Color>
            <Color x:Key="Ab.UpcomingColor">#B4BBC2</Color>
            <!-- Round 2 (brief §3.4, §3.5, §3.8): soft section blocks, a hovered row inside them, the amber late/behind pill, the drag Cancel zone. -->
            <Color x:Key="Ab.SectionBlockColor">#F5F6F7</Color>
            <Color x:Key="Ab.RowHoverColor">#FFFFFF</Color>
            <Color x:Key="Ab.AmberInkColor">#8A5300</Color>
            <Color x:Key="Ab.AmberFillColor">#FCF1D8</Color>
            <Color x:Key="Ab.AmberFillStrongColor">#F5E0B0</Color>
            <Color x:Key="Ab.AmberLineColor">#EBCB7E</Color>
            <Color x:Key="Ab.DragCancelColor">#C0392B</Color>
            <Color x:Key="Ab.DragCancelFillColor">#FBE9E7</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <SolidColorBrush x:Key="Ab.SectionBlock" Color="{DynamicResource Ab.SectionBlockColor}" />
            <SolidColorBrush x:Key="Ab.RowHover" Color="{DynamicResource Ab.RowHoverColor}" />
            <SolidColorBrush x:Key="Ab.AmberInk" Color="{DynamicResource Ab.AmberInkColor}" />
            <SolidColorBrush x:Key="Ab.AmberFill" Color="{DynamicResource Ab.AmberFillColor}" />
            <SolidColorBrush x:Key="Ab.AmberFillStrong" Color="{DynamicResource Ab.AmberFillStrongColor}" />
            <SolidColorBrush x:Key="Ab.AmberLine" Color="{DynamicResource Ab.AmberLineColor}" />
            <SolidColorBrush x:Key="Ab.DragCancel" Color="{DynamicResource Ab.DragCancelColor}" />
            <SolidColorBrush x:Key="Ab.DragCancelFill" Color="{DynamicResource Ab.DragCancelFillColor}" />
            <!-- Tasks redesign (plan item 3, #10): mixes of two tokens, precomputed from this theme's own colours (a mix of two DynamicResources
                 cannot be written in AbStyles), and the accent / drift / amber tints over transparent. Line2 = Line 88% + Ink 12%, Line3 = Line 68% + Ink 32%,
                 Ink2 = Ink 78% + Muted 22%, Muted2 = Muted 70% + Faint 30%, AccentLine = Accent 40% + AccentSoft 60%, AccentRing = Accent 65% +
                 AccentSoft 35%, DriftLine = Drift 55% + Surface 45%, Dialog = Surface. -->
            <Color x:Key="Ab.Line2Color">#C5C9CC</Color>
            <Color x:Key="Ab.Line3Color">#9DA1A4</Color>
            <Color x:Key="Ab.Ink2Color">#24282D</Color>
            <Color x:Key="Ab.Muted2Color">#6A727A</Color>
            <Color x:Key="Ab.AccentLineColor">#8ABFBA</Color>
            <Color x:Key="Ab.AccentRingColor">#57A09A</Color>
            <Color x:Key="Ab.DriftLineColor">#DD968C</Color>
            <Color x:Key="Ab.DialogColor">#FFFFFF</Color>
            <Color x:Key="Ab.AccentTint5Color">#0D0F766E</Color>
            <Color x:Key="Ab.AccentTint14Color">#240F766E</Color>
            <Color x:Key="Ab.AccentTint16Color">#290F766E</Color>
            <Color x:Key="Ab.AccentTint18Color">#2E0F766E</Color>
            <Color x:Key="Ab.AccentTint35Color">#590F766E</Color>
            <Color x:Key="Ab.DriftTint8Color">#14C2412D</Color>
            <Color x:Key="Ab.DriftTint12Color">#1FC2412D</Color>
            <Color x:Key="Ab.DriftTint14Color">#24C2412D</Color>
            <Color x:Key="Ab.AmberTint9Color">#178A5300</Color>
            <!-- Ab.Shadow's colour: black at 50% in dark, warm black rgba(30,25,15,0.16) in light. -->
            <Color x:Key="Ab.ShadowColor">#291E190F</Color>
            <SolidColorBrush x:Key="Ab.Line2" Color="{DynamicResource Ab.Line2Color}" />
            <SolidColorBrush x:Key="Ab.Line3" Color="{DynamicResource Ab.Line3Color}" />
            <SolidColorBrush x:Key="Ab.Ink2" Color="{DynamicResource Ab.Ink2Color}" />
            <SolidColorBrush x:Key="Ab.Muted2" Color="{DynamicResource Ab.Muted2Color}" />
            <SolidColorBrush x:Key="Ab.AccentLine" Color="{DynamicResource Ab.AccentLineColor}" />
            <SolidColorBrush x:Key="Ab.AccentRing" Color="{DynamicResource Ab.AccentRingColor}" />
            <SolidColorBrush x:Key="Ab.DriftLine" Color="{DynamicResource Ab.DriftLineColor}" />
            <SolidColorBrush x:Key="Ab.Dialog" Color="{DynamicResource Ab.DialogColor}" />
            <SolidColorBrush x:Key="Ab.AccentTint5" Color="{DynamicResource Ab.AccentTint5Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint14" Color="{DynamicResource Ab.AccentTint14Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint16" Color="{DynamicResource Ab.AccentTint16Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint18" Color="{DynamicResource Ab.AccentTint18Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint35" Color="{DynamicResource Ab.AccentTint35Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint8" Color="{DynamicResource Ab.DriftTint8Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint12" Color="{DynamicResource Ab.DriftTint12Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint14" Color="{DynamicResource Ab.DriftTint14Color}" />
            <SolidColorBrush x:Key="Ab.AmberTint9" Color="{DynamicResource Ab.AmberTint9Color}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight1">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight2">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight3">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark1">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark2">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark3">#0F766E</Color>
            <Color x:Key="SystemRegionColor">#F3F4F5</Color>
            <Color x:Key="SystemAltHighColor">#FFFFFF</Color>
            <Color x:Key="SystemBaseHighColor">#15181B</Color>
            <Color x:Key="SystemBaseMediumHighColor">#15181B</Color>
            <Color x:Key="SystemBaseMediumColor">#5B636B</Color>
            <Color x:Key="SystemBaseMediumLowColor">#8E969E</Color>
            <Color x:Key="SystemBaseLowColor">#E6E9EB</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #0F766E</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #15181B</BoxShadows>
            <!-- Tasks redesign: the 1 px ring on selected rows (Ab.AccentRing), the menus' shadow (0 12 36) and the dialogs' (0 18 50) in Ab.Shadow's colour. -->
            <BoxShadows x:Key="Ab.SelectedRing">inset 0 0 0 1 #57A09A</BoxShadows>
            <BoxShadows x:Key="Ab.Shadow">0 12 36 0 #291E190F</BoxShadows>
            <BoxShadows x:Key="Ab.DialogShadow">0 18 50 0 #291E190F</BoxShadows>
            <!-- Tasks redesign 8b.04: the dragged stack's top card (0 16 36 in Ab.Shadow's colour). -->
            <BoxShadows x:Key="Ab.StackShadow">0 16 36 0 #291E190F</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Ab.BgColor">#111315</Color>
            <Color x:Key="Ab.SurfaceColor">#181B1E</Color>
            <Color x:Key="Ab.Surface2Color">#202428</Color>
            <Color x:Key="Ab.LineColor">#2C3136</Color>
            <Color x:Key="Ab.InkColor">#E8EAEC</Color>
            <Color x:Key="Ab.MutedColor">#8E969E</Color>
            <Color x:Key="Ab.FaintColor">#5A626A</Color>
            <Color x:Key="Ab.AccentColor">#5EEAD4</Color>
            <Color x:Key="Ab.OnAccentColor">#06201D</Color>
            <Color x:Key="Ab.AccentSoftColor">#17312E</Color>
            <Color x:Key="Ab.InfoBgColor">#1A2530</Color>
            <Color x:Key="Ab.InfoInkColor">#B4C6D6</Color>
            <Color x:Key="Ab.SleepColor">#8E9BD6</Color>
            <Color x:Key="Ab.MetColor">#5EEAD4</Color>
            <Color x:Key="Ab.WaitingColor">#E8B04B</Color>
            <Color x:Key="Ab.DriftColor">#F0705A</Color>
            <Color x:Key="Ab.PlanColor">#3A4148</Color>
            <Color x:Key="Ab.UpcomingColor">#444C54</Color>
            <!-- Round 2 (brief §3.4, §3.5, §3.8): soft section blocks, a hovered row inside them, the amber late/behind pill, the drag Cancel zone. -->
            <Color x:Key="Ab.SectionBlockColor">#1C1F23</Color>
            <Color x:Key="Ab.RowHoverColor">#24282D</Color>
            <Color x:Key="Ab.AmberInkColor">#F2C46D</Color>
            <Color x:Key="Ab.AmberFillColor">#3A2C12</Color>
            <Color x:Key="Ab.AmberFillStrongColor">#4E3D1C</Color>
            <Color x:Key="Ab.AmberLineColor">#6B5124</Color>
            <Color x:Key="Ab.DragCancelColor">#F26B5B</Color>
            <Color x:Key="Ab.DragCancelFillColor">#3A1B18</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <SolidColorBrush x:Key="Ab.SectionBlock" Color="{DynamicResource Ab.SectionBlockColor}" />
            <SolidColorBrush x:Key="Ab.RowHover" Color="{DynamicResource Ab.RowHoverColor}" />
            <SolidColorBrush x:Key="Ab.AmberInk" Color="{DynamicResource Ab.AmberInkColor}" />
            <SolidColorBrush x:Key="Ab.AmberFill" Color="{DynamicResource Ab.AmberFillColor}" />
            <SolidColorBrush x:Key="Ab.AmberFillStrong" Color="{DynamicResource Ab.AmberFillStrongColor}" />
            <SolidColorBrush x:Key="Ab.AmberLine" Color="{DynamicResource Ab.AmberLineColor}" />
            <SolidColorBrush x:Key="Ab.DragCancel" Color="{DynamicResource Ab.DragCancelColor}" />
            <SolidColorBrush x:Key="Ab.DragCancelFill" Color="{DynamicResource Ab.DragCancelFillColor}" />
            <!-- Tasks redesign (plan item 3, #10): mixes of two tokens, precomputed from this theme's own colours (a mix of two DynamicResources
                 cannot be written in AbStyles), and the accent / drift / amber tints over transparent. Line2 = Line 88% + Ink 12%, Line3 = Line 68% + Ink 32%,
                 Ink2 = Ink 78% + Muted 22%, Muted2 = Muted 70% + Faint 30%, AccentLine = Accent 40% + AccentSoft 60%, AccentRing = Accent 65% +
                 AccentSoft 35%, DriftLine = Drift 55% + Surface 45%, Dialog = Surface 55% + Surface2 45%. -->
            <Color x:Key="Ab.Line2Color">#43474C</Color>
            <Color x:Key="Ab.Line3Color">#686C70</Color>
            <Color x:Key="Ab.Ink2Color">#D4D8DB</Color>
            <Color x:Key="Ab.Muted2Color">#7E868E</Color>
            <Color x:Key="Ab.AccentLineColor">#337B70</Color>
            <Color x:Key="Ab.AccentRingColor">#45A99A</Color>
            <Color x:Key="Ab.DriftLineColor">#8F4A3F</Color>
            <Color x:Key="Ab.DialogColor">#1C1F22</Color>
            <Color x:Key="Ab.AccentTint5Color">#0D5EEAD4</Color>
            <Color x:Key="Ab.AccentTint14Color">#245EEAD4</Color>
            <Color x:Key="Ab.AccentTint16Color">#295EEAD4</Color>
            <Color x:Key="Ab.AccentTint18Color">#2E5EEAD4</Color>
            <Color x:Key="Ab.AccentTint35Color">#595EEAD4</Color>
            <Color x:Key="Ab.DriftTint8Color">#14F0705A</Color>
            <Color x:Key="Ab.DriftTint12Color">#1FF0705A</Color>
            <Color x:Key="Ab.DriftTint14Color">#24F0705A</Color>
            <Color x:Key="Ab.AmberTint9Color">#17F2C46D</Color>
            <!-- Ab.Shadow's colour: black at 50% in dark, warm black rgba(30,25,15,0.16) in light. -->
            <Color x:Key="Ab.ShadowColor">#80000000</Color>
            <SolidColorBrush x:Key="Ab.Line2" Color="{DynamicResource Ab.Line2Color}" />
            <SolidColorBrush x:Key="Ab.Line3" Color="{DynamicResource Ab.Line3Color}" />
            <SolidColorBrush x:Key="Ab.Ink2" Color="{DynamicResource Ab.Ink2Color}" />
            <SolidColorBrush x:Key="Ab.Muted2" Color="{DynamicResource Ab.Muted2Color}" />
            <SolidColorBrush x:Key="Ab.AccentLine" Color="{DynamicResource Ab.AccentLineColor}" />
            <SolidColorBrush x:Key="Ab.AccentRing" Color="{DynamicResource Ab.AccentRingColor}" />
            <SolidColorBrush x:Key="Ab.DriftLine" Color="{DynamicResource Ab.DriftLineColor}" />
            <SolidColorBrush x:Key="Ab.Dialog" Color="{DynamicResource Ab.DialogColor}" />
            <SolidColorBrush x:Key="Ab.AccentTint5" Color="{DynamicResource Ab.AccentTint5Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint14" Color="{DynamicResource Ab.AccentTint14Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint16" Color="{DynamicResource Ab.AccentTint16Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint18" Color="{DynamicResource Ab.AccentTint18Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint35" Color="{DynamicResource Ab.AccentTint35Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint8" Color="{DynamicResource Ab.DriftTint8Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint12" Color="{DynamicResource Ab.DriftTint12Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint14" Color="{DynamicResource Ab.DriftTint14Color}" />
            <SolidColorBrush x:Key="Ab.AmberTint9" Color="{DynamicResource Ab.AmberTint9Color}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight1">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight2">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight3">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark1">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark2">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark3">#5EEAD4</Color>
            <Color x:Key="SystemRegionColor">#111315</Color>
            <Color x:Key="SystemAltHighColor">#181B1E</Color>
            <Color x:Key="SystemBaseHighColor">#E8EAEC</Color>
            <Color x:Key="SystemBaseMediumHighColor">#E8EAEC</Color>
            <Color x:Key="SystemBaseMediumColor">#8E969E</Color>
            <Color x:Key="SystemBaseMediumLowColor">#5A626A</Color>
            <Color x:Key="SystemBaseLowColor">#202428</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #5EEAD4</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #E8EAEC</BoxShadows>
            <!-- Tasks redesign: the 1 px ring on selected rows (Ab.AccentRing), the menus' shadow (0 12 36) and the dialogs' (0 18 50) in Ab.Shadow's colour. -->
            <BoxShadows x:Key="Ab.SelectedRing">inset 0 0 0 1 #45A99A</BoxShadows>
            <BoxShadows x:Key="Ab.Shadow">0 12 36 0 #80000000</BoxShadows>
            <BoxShadows x:Key="Ab.DialogShadow">0 18 50 0 #80000000</BoxShadows>
            <!-- Tasks redesign 8b.04: the dragged stack's top card (0 16 36 in Ab.Shadow's colour). -->
            <BoxShadows x:Key="Ab.StackShadow">0 16 36 0 #80000000</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="Ab.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Ab.NumeralFont">avares://AccountabiliBuddy.App/Assets/Fonts/IBMPlexMono#IBM Plex Mono, Consolas</FontFamily>
    <CornerRadius x:Key="Ab.CardRadius">14</CornerRadius>
    <CornerRadius x:Key="Ab.PanelRadius">10</CornerRadius>
    <!-- The Tasks page's cards and rails (spec 06 "r", PC values). -->
    <CornerRadius x:Key="Ab.TasksRadius">14</CornerRadius>
    <!-- Menus and popovers on the Tasks page (spec 06 "pr", PC values), with the shared popover shadow (spec 03 §C). -->
    <CornerRadius x:Key="Ab.PopoverRadius">10</CornerRadius>
    <BoxShadows x:Key="Ab.PopoverShadow">0 16 40 0 #38000000</BoxShadows>
    <!-- Task reminders (spec 03 §D): the tilted cards behind the toast stack, the full-screen card and the scrim behind it. -->
    <BoxShadows x:Key="Ab.ReminderBehindShadow">0 6 16 0 #1F000000</BoxShadows>
    <BoxShadows x:Key="Ab.AlarmShadow">0 24 60 0 #59000000</BoxShadows>
    <SolidColorBrush x:Key="Ab.Scrim" Color="#8C0A0E14" />
    <!-- Tasks redesign 3.26: the page dim behind the task editor and Move and label, rgba(10,9,8,0.55), the same in every theme and mode. -->
    <SolidColorBrush x:Key="Ab.PageScrim" Color="#8C0A0908" />
    <!-- Tasks redesign 6.03: the Archive sheet's dim, lighter than Ab.PageScrim: rgba(10,9,8,0.45), the same in every theme and mode. -->
    <SolidColorBrush x:Key="Ab.ArchiveScrim" Color="#730A0908" />
    <!-- The time-left ring beside the timer digits: nudged so it sits on the digits' middle, which depends on the numeral font. -->
    <Thickness x:Key="Ab.TimeRingMargin">0,18,0,0</Thickness>
    <Thickness x:Key="Ab.CardBorderThickness">1</Thickness>
    <x:Double x:Key="Ab.DisplayLetterSpacing">0</x:Double>
    <FontWeight x:Key="Ab.NumeralWeight">Medium</FontWeight>
</ResourceDictionary>
