<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paper: warm off-white ground, moss-green accent (owner 2026-11-14: light #4E6B3B, dark #B3C79A), hairline borders, Newsreader display. Same keys in all three theme files (ADR 49). Colours are Ab.<Name>Color, brushes Ab.<Name>. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Ab.BgColor">#F5F2EB</Color>
            <Color x:Key="Ab.SurfaceColor">#FBFAF6</Color>
            <Color x:Key="Ab.Surface2Color">#ECE7DC</Color>
            <Color x:Key="Ab.LineColor">#DDD7CA</Color>
            <Color x:Key="Ab.InkColor">#1F1D1A</Color>
            <Color x:Key="Ab.MutedColor">#6B655B</Color>
            <Color x:Key="Ab.FaintColor">#8C8578</Color>
            <Color x:Key="Ab.AccentColor">#4E6B3B</Color>
            <Color x:Key="Ab.OnAccentColor">#FFFFFF</Color>
            <Color x:Key="Ab.AccentSoftColor">#E7ECDF</Color>
            <Color x:Key="Ab.InfoBgColor">#E9ECE2</Color>
            <Color x:Key="Ab.InfoInkColor">#34452A</Color>
            <Color x:Key="Ab.SleepColor">#6E6A9E</Color>
            <Color x:Key="Ab.MetColor">#3F7A5A</Color>
            <Color x:Key="Ab.WaitingColor">#A8741D</Color>
            <Color x:Key="Ab.DriftColor">#B5523F</Color>
            <Color x:Key="Ab.PlanColor">#CFC8B9</Color>
            <Color x:Key="Ab.UpcomingColor">#BDB6A6</Color>
            <!-- Round 2 (brief §3.4, §3.5, §3.8): soft section blocks, a hovered row inside them, the amber late/behind pill, the drag Cancel zone. -->
            <Color x:Key="Ab.SectionBlockColor">#F3EFE6</Color>
            <Color x:Key="Ab.RowHoverColor">#FFFFFF</Color>
            <Color x:Key="Ab.AmberInkColor">#7F4F00</Color>
            <Color x:Key="Ab.AmberFillColor">#F8EBCB</Color>
            <Color x:Key="Ab.AmberLineColor">#E0C27A</Color>
            <Color x:Key="Ab.DragCancelColor">#A93226</Color>
            <Color x:Key="Ab.DragCancelFillColor">#F7E3DE</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <SolidColorBrush x:Key="Ab.SectionBlock" Color="{DynamicResource Ab.SectionBlockColor}" />
            <SolidColorBrush x:Key="Ab.RowHover" Color="{DynamicResource Ab.RowHoverColor}" />
            <SolidColorBrush x:Key="Ab.AmberInk" Color="{DynamicResource Ab.AmberInkColor}" />
            <SolidColorBrush x:Key="Ab.AmberFill" Color="{DynamicResource Ab.AmberFillColor}" />
            <SolidColorBrush x:Key="Ab.AmberLine" Color="{DynamicResource Ab.AmberLineColor}" />
            <SolidColorBrush x:Key="Ab.DragCancel" Color="{DynamicResource Ab.DragCancelColor}" />
            <SolidColorBrush x:Key="Ab.DragCancelFill" Color="{DynamicResource Ab.DragCancelFillColor}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#4E6B3B</Color>
            <Color x:Key="SystemAccentColorLight1">#4E6B3B</Color>
            <Color x:Key="SystemAccentColorLight2">#4E6B3B</Color>
            <Color x:Key="SystemAccentColorLight3">#4E6B3B</Color>
            <Color x:Key="SystemAccentColorDark1">#4E6B3B</Color>
            <Color x:Key="SystemAccentColorDark2">#4E6B3B</Color>
            <Color x:Key="SystemAccentColorDark3">#4E6B3B</Color>
            <Color x:Key="SystemRegionColor">#F5F2EB</Color>
            <Color x:Key="SystemAltHighColor">#FBFAF6</Color>
            <Color x:Key="SystemBaseHighColor">#1F1D1A</Color>
            <Color x:Key="SystemBaseMediumHighColor">#1F1D1A</Color>
            <Color x:Key="SystemBaseMediumColor">#6B655B</Color>
            <Color x:Key="SystemBaseMediumLowColor">#8C8578</Color>
            <Color x:Key="SystemBaseLowColor">#ECE7DC</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #4E6B3B</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #1F1D1A</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Ab.BgColor">#1A1917</Color>
            <Color x:Key="Ab.SurfaceColor">#22211E</Color>
            <Color x:Key="Ab.Surface2Color">#2C2A26</Color>
            <Color x:Key="Ab.LineColor">#34312C</Color>
            <Color x:Key="Ab.InkColor">#EDE8DE</Color>
            <Color x:Key="Ab.MutedColor">#A39C8F</Color>
            <Color x:Key="Ab.FaintColor">#6F695F</Color>
            <Color x:Key="Ab.AccentColor">#B3C79A</Color>
            <Color x:Key="Ab.OnAccentColor">#1C2614</Color>
            <Color x:Key="Ab.AccentSoftColor">#2B3124</Color>
            <Color x:Key="Ab.InfoBgColor">#292D24</Color>
            <Color x:Key="Ab.InfoInkColor">#C9D4B8</Color>
            <Color x:Key="Ab.SleepColor">#A9A5D6</Color>
            <Color x:Key="Ab.MetColor">#8DBFA0</Color>
            <Color x:Key="Ab.WaitingColor">#DDB25E</Color>
            <Color x:Key="Ab.DriftColor">#D99A8E</Color>
            <Color x:Key="Ab.PlanColor">#4A463F</Color>
            <Color x:Key="Ab.UpcomingColor">#5A554D</Color>
            <!-- Round 2 (brief §3.4, §3.5, §3.8): soft section blocks, a hovered row inside them, the amber late/behind pill, the drag Cancel zone. -->
            <Color x:Key="Ab.SectionBlockColor">#262421</Color>
            <Color x:Key="Ab.RowHoverColor">#2F2D29</Color>
            <Color x:Key="Ab.AmberInkColor">#E3B862</Color>
            <Color x:Key="Ab.AmberFillColor">#36291A</Color>
            <Color x:Key="Ab.AmberLineColor">#6A5530</Color>
            <Color x:Key="Ab.DragCancelColor">#E07F70</Color>
            <Color x:Key="Ab.DragCancelFillColor">#3B201C</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <SolidColorBrush x:Key="Ab.SectionBlock" Color="{DynamicResource Ab.SectionBlockColor}" />
            <SolidColorBrush x:Key="Ab.RowHover" Color="{DynamicResource Ab.RowHoverColor}" />
            <SolidColorBrush x:Key="Ab.AmberInk" Color="{DynamicResource Ab.AmberInkColor}" />
            <SolidColorBrush x:Key="Ab.AmberFill" Color="{DynamicResource Ab.AmberFillColor}" />
            <SolidColorBrush x:Key="Ab.AmberLine" Color="{DynamicResource Ab.AmberLineColor}" />
            <SolidColorBrush x:Key="Ab.DragCancel" Color="{DynamicResource Ab.DragCancelColor}" />
            <SolidColorBrush x:Key="Ab.DragCancelFill" Color="{DynamicResource Ab.DragCancelFillColor}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#B3C79A</Color>
            <Color x:Key="SystemAccentColorLight1">#B3C79A</Color>
            <Color x:Key="SystemAccentColorLight2">#B3C79A</Color>
            <Color x:Key="SystemAccentColorLight3">#B3C79A</Color>
            <Color x:Key="SystemAccentColorDark1">#B3C79A</Color>
            <Color x:Key="SystemAccentColorDark2">#B3C79A</Color>
            <Color x:Key="SystemAccentColorDark3">#B3C79A</Color>
            <Color x:Key="SystemRegionColor">#1A1917</Color>
            <Color x:Key="SystemAltHighColor">#22211E</Color>
            <Color x:Key="SystemBaseHighColor">#EDE8DE</Color>
            <Color x:Key="SystemBaseMediumHighColor">#EDE8DE</Color>
            <Color x:Key="SystemBaseMediumColor">#A39C8F</Color>
            <Color x:Key="SystemBaseMediumLowColor">#6F695F</Color>
            <Color x:Key="SystemBaseLowColor">#2C2A26</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #B3C79A</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #EDE8DE</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="Ab.DisplayFont">avares://AccountabiliBuddy.App/Assets/Fonts/Newsreader#Newsreader 16pt</FontFamily>
    <FontFamily x:Key="Ab.NumeralFont">avares://AccountabiliBuddy.App/Assets/Fonts/Newsreader#Newsreader 16pt</FontFamily>
    <CornerRadius x:Key="Ab.CardRadius">18</CornerRadius>
    <CornerRadius x:Key="Ab.PanelRadius">14</CornerRadius>
    <!-- The Tasks page's cards and rails (spec 06 "r", PC values). -->
    <CornerRadius x:Key="Ab.TasksRadius">18</CornerRadius>
    <!-- Menus and popovers on the Tasks page (spec 06 "pr", PC values), with the shared popover shadow (spec 03 §C). -->
    <CornerRadius x:Key="Ab.PopoverRadius">14</CornerRadius>
    <BoxShadows x:Key="Ab.PopoverShadow">0 16 40 0 #38000000</BoxShadows>
    <!-- Task reminders (spec 03 §D): the tilted cards behind the toast stack, the full-screen card and the scrim behind it. -->
    <BoxShadows x:Key="Ab.ReminderBehindShadow">0 6 16 0 #1F000000</BoxShadows>
    <BoxShadows x:Key="Ab.AlarmShadow">0 24 60 0 #59000000</BoxShadows>
    <SolidColorBrush x:Key="Ab.Scrim" Color="#8C12110E" />
    <!-- The time-left ring beside the timer digits: nudged so it sits on the digits' middle, which depends on the numeral font. -->
    <Thickness x:Key="Ab.TimeRingMargin">0,-24,0,0</Thickness>
    <Thickness x:Key="Ab.CardBorderThickness">1</Thickness>
    <x:Double x:Key="Ab.DisplayLetterSpacing">0</x:Double>
    <FontWeight x:Key="Ab.NumeralWeight">Normal</FontWeight>
</ResourceDictionary>
