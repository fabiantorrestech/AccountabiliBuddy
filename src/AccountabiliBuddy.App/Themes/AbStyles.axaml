<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <!-- Shared styles over the Ab.* tokens (ADR 49). Flat: no gradients, no drop shadows. -->

    <!-- Heatmap month lines (HM1): Normal = Ab.Faint (the look before), Lighter = Ab.Line, Darker = Ab.Muted; Off is the control's own switch. -->
    <Style Selector="controls|HeatmapControl">
        <Setter Property="DividerBrush" Value="{DynamicResource Ab.Faint}" />
    </Style>
    <Style Selector="controls|HeatmapControl:monthLinesLighter">
        <Setter Property="DividerBrush" Value="{DynamicResource Ab.Line}" />
    </Style>
    <Style Selector="controls|HeatmapControl:monthLinesDarker">
        <Setter Property="DividerBrush" Value="{DynamicResource Ab.Muted}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Ab.CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.CardRadius}" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <!-- Fluent's button template paints the background on the ContentPresenter in every state, so each state is set there. -->
    <Style Selector="Button.primary">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.quiet">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
    </Style>

    <!-- Pill-shaped buttons (the Today page's actions); .primary.pill is the one main button. -->
    <Style Selector="Button.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="24,16" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.primary.pill">
        <Setter Property="Padding" Value="30,16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource Ab.DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Ab.DisplayLetterSpacing}" />
    </Style>
    <Style Selector="TextBlock.numeral">
        <Setter Property="FontFamily" Value="{DynamicResource Ab.NumeralFont}" />
        <Setter Property="FontWeight" Value="{DynamicResource Ab.NumeralWeight}" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <!-- A ticked task's title: struck through and dimmed (bind Classes.done to the row's ticked state, so unticking undoes it at once). -->
    <Style Selector="TextBlock.done">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
    </Style>

    <!-- Settings pages (design 5q): a sunk panel of rows, each row a label + Muted line + a control on the right, hairlines between them. -->
    <Style Selector="Border.sPanel">
        <Setter Property="Background" Value="{DynamicResource Ab.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Ab.CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Rows carry their own bottom hairline; the panel's content sits at Margin="0,0,0,-1" so the last one is clipped away. -->
    <Style Selector="Border.sRow">
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,14" />
    </Style>
    <Style Selector="Border.sInfo">
        <Setter Property="Background" Value="{DynamicResource Ab.InfoBg}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
        <Setter Property="Padding" Value="18,14" />
    </Style>
    <Style Selector="Border.sInfo TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ab.InfoInk}" />
    </Style>
    <Style Selector="TextBlock.sTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sHint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sGroup">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="Margin" Value="4,10,0,0" />
    </Style>
    <!-- A round icon button and a soft pill button for a page's header actions. -->
    <Style Selector="Button.sRound">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sSoft">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- A segmented choice (Appearance, the sync light): a Surface2 track; the chosen segment sits on the page ground in ink. -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="controls:NoBringIntoView.Suppress" Value="True" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A check box drawn as a switch (Settings pages): Surface2 track, the accent when on (round 2 boards). -->
    <Style Selector="CheckBox.sw">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Border x:Name="SwTrack" Width="38" Height="22" CornerRadius="11" VerticalAlignment="Top" Margin="0,2,0,0"
                            Background="{DynamicResource Ab.Surface2}" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1">
                        <Ellipse x:Name="SwKnob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource Ab.Muted}" />
                    </Border>
                    <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.sw:checked /template/ Border#SwTrack">
        <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
    </Style>
    <Style Selector="CheckBox.sw:checked /template/ Ellipse#SwKnob">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Fill" Value="{DynamicResource Ab.OnAccent}" />
    </Style>
    <Style Selector="CheckBox.sw:pointerover /template/ Border#SwTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
    </Style>
    <Style Selector="CheckBox.sw:focus-visible /template/ Border#SwTrack">
        <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
    </Style>
    <Style Selector="CheckBox.sw:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Keyboard focus: a 2px ring drawn as a zero-blur box shadow outside the control, so nothing shifts when it appears.
         On the accent-filled primary button the ring is Ink, since accent on accent would not show. -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
    </Style>
    <Style Selector="Button.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRingOnAccent}" />
    </Style>
    <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
    </Style>
    <!-- The knob bounds are invisible while the switch is off, so the ring sits on the track (OuterBorder) in both states. -->
    <Style Selector="ToggleSwitch:focus-visible /template/ Border#OuterBorder">
        <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
    </Style>

    <!-- The Tasks dialogs (spec 03 §C, TaskDialogWindow): title, sub line, an outlined option row (highlighted: accent border and
         tint), a quiet text button, a red filled button and a small filled tag. -->
    <Style Selector="TextBlock.dlgTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dlgSub">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dlgHead">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <Style Selector="Button.dlgRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.PopoverRadius}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.dlgRow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.dlgRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.dlgRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.dlgRow.lit /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
    </Style>
    <Style Selector="Button.dlgRow.lit.deleteRow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Drift}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Drift}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Drift}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Drift}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <!-- A destructive button that is not the dialog's main one (board Goals-PC-Edit, "Delete goal…"): the secondary button's surface
         and line, the text in the drift red. -->
    <Style Selector="Button.dangerText">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.dangerText /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
    </Style>
    <Style Selector="Button.dangerText:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Drift}" />
    </Style>
    <Style Selector="Button.dangerText:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Drift}" />
    </Style>
    <!-- Buttons that paint their own ground in a view's styles keep no line (the secondary button's 1 px line is for plain buttons). -->
    <Style Selector="Button.current, Button.endedSwitch, Button.findArrow, Button.foot, Button.icon, Button.on, Button.remAccent, Button.row, Button.searchItem, Button.sendStep">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.dlgTag">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.dlgTag TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
    </Style>
    <Style Selector="Border.dlgTag.soft">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
    </Style>
    <Style Selector="Border.dlgTag.soft TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <!-- "Suggested" (board Goals-PC-Review): the accent tint with accent text. -->
    <Style Selector="Border.dlgTag.accentSoft">
        <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
    </Style>
    <Style Selector="Border.dlgTag.accentSoft TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Accent}" />
    </Style>

    <!-- ===== Round 2 shared chrome (brief §3.3-3.6, §3.8, §3.12; plan R1.3-R1.5). Every value is a theme token. ===== -->

    <!-- Page header (§3.3, Controls/PageHeader): "<Page> · Wed 11/11", labelled primary buttons, icon-only secondary controls with
         tooltips, then the one bordered Options (tune) button, last. No gear. -->
    <Style Selector="TextBlock.abPageTitle">
        <Setter Property="FontFamily" Value="{DynamicResource Ab.DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Ab.DisplayLetterSpacing}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.abPageDate">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <!-- An icon-only secondary header control (Views, Expand/collapse all, History): quiet, 34 square, a tooltip and a name. -->
    <Style Selector="Button.abHeaderIcon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.abHeaderIcon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.abHeaderIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.abHeaderIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
    </Style>
    <!-- The Options (tune) button: bordered, last in the header; it stays pressed-looking while its menu is open. -->
    <Style Selector="Button.abOptions">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.abOptions /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.abOptions:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.abOptions:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
    </Style>
    <Style Selector="Button.abOptions.open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
    </Style>

    <!-- Section headers (§3.4: Tasks bins, Goals areas): 16.5 px bold in ink, a 19 px icon, a grey count pill. -->
    <Style Selector="TextBlock.abSectionTitle">
        <Setter Property="FontSize" Value="16.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="mi|MaterialIcon.abSectionIcon">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.abCountPill">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.abCountPill > TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Hover-only secondary actions (§3.4 edit / grip / +, §3.5 row actions, §3.12): hidden until the pointer is over the host OR the
         keyboard is inside it, so Tab reaches them and they appear. Every hover rule here has its focus-within twin (AppChecks r1b). -->
    <Style Selector=":is(Control).abHoverHost :is(Control).abHoverOnly">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector=":is(Control).abHoverHost:pointerover :is(Control).abHoverOnly">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector=":is(Control).abHoverHost:focus-within :is(Control).abHoverOnly">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Lists (§3.5): soft rounded section blocks (no border), 18 px between blocks, no divider lines between rows (spacing only);
         a hovered row inside a block turns lighter (Ab.RowHover: white in Instrument light; TaskRowView applies it to its rows). -->
    <Style Selector="Border.abSoftBlock">
        <Setter Property="Background" Value="{DynamicResource Ab.SectionBlock}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="StackPanel.abBlocks">
        <Setter Property="Spacing" Value="18" />
    </Style>
    <!-- A sub-line under a name ("↳ 2h a day", "↳ ePT · 142c"): the text starts with "↳ ". -->
    <Style Selector="TextBlock.abSubLine">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- "Built in": a small chip, not text. -->
    <Style Selector="Border.abChip">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.abChip > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>

    <!-- Status (§3.8): amber pills mean late or behind ("Overdue 3 d", "1 behind"). Red is only for destructive actions and the drag
         Cancel zone. -->
    <Style Selector="Border.abPill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.abPill.amber">
        <Setter Property="Background" Value="{DynamicResource Ab.AmberFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.AmberLine}" />
    </Style>
    <Style Selector="Border.abPill.amber TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ab.AmberInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.abPill.amber mi|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource Ab.AmberInk}" />
    </Style>
    <!-- The drag Cancel zone ("keeps selected"): red outline on a faint red fill; lit (thicker) while a dragged task is over it. -->
    <Style Selector="Border.abDragCancel">
        <Setter Property="Background" Value="{DynamicResource Ab.DragCancelFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.DragCancel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
    </Style>
    <Style Selector="Border.abDragCancel.lit">
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.abDragCancel TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ab.DragCancel}" />
    </Style>
    <Style Selector="Border.abDragCancel mi|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource Ab.DragCancel}" />
    </Style>

    <!-- Menus (§3.6, Views/TaskMenus): a row outlined in the accent while its menu is open; thin dividers; section heads as small muted
         labels; values right-aligned and muted; ✓ and › muted; a destructive entry red. No shortcut letters anywhere. -->
    <Style Selector="Border.abMenuRing">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector=":is(Control).abMenuOpen > Border.abMenuRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Separator.abMenuDivider">
        <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,4" />
    </Style>
    <Style Selector="TextBlock.abMenuText">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="TextBlock.abMenuHead">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <!-- A menu entry's inline choices (board Goals-PC › Options): a Surface2 track, the choice in force on the surface, semibold. -->
    <Style Selector="Border.abMenuSegs">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Button.abMenuSeg">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.abMenuSeg /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.abMenuSeg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
    </Style>
    <Style Selector="Button.abMenuSeg.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.abMenuValue">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="MaxWidth" Value="140" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.abMenuCheck">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <Style Selector="TextBlock.abMenuMore">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <Style Selector="TextBlock.abMenuNote">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
    </Style>
    <Style Selector="TextBlock.abMenuDanger">
        <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
    </Style>
    <!-- A heading is a disabled entry: the theme's disabled dimming would make it unreadable on Paper, so it keeps full opacity. -->
    <Style Selector="MenuItem.abMenuHeading">
        <Setter Property="Opacity" Value="1" />
    </Style>
</Styles>
