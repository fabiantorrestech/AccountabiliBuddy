<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Night Desk - Calm: blue-black ground, sand accent, no card borders, Manrope display. Same keys in all three theme files (ADR 49). Colours are Ab.<Name>Color, brushes Ab.<Name>. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Ab.BgColor">#EEF1F5</Color>
            <Color x:Key="Ab.SurfaceColor">#FFFFFF</Color>
            <Color x:Key="Ab.Surface2Color">#E3E7EE</Color>
            <Color x:Key="Ab.LineColor">#E3E7EE</Color>
            <Color x:Key="Ab.InkColor">#1A2233</Color>
            <Color x:Key="Ab.MutedColor">#5E6B80</Color>
            <Color x:Key="Ab.FaintColor">#8A96A8</Color>
            <Color x:Key="Ab.AccentColor">#8C6D45</Color>
            <Color x:Key="Ab.OnAccentColor">#FFFFFF</Color>
            <Color x:Key="Ab.AccentSoftColor">#EFE9DF</Color>
            <Color x:Key="Ab.InfoBgColor">#E8EBF3</Color>
            <Color x:Key="Ab.InfoInkColor">#2E3757</Color>
            <Color x:Key="Ab.SleepColor">#5865A8</Color>
            <Color x:Key="Ab.MetColor">#3F7A5A</Color>
            <Color x:Key="Ab.WaitingColor">#5865A8</Color>
            <Color x:Key="Ab.DriftColor">#B5523F</Color>
            <Color x:Key="Ab.PlanColor">#CDD4DF</Color>
            <Color x:Key="Ab.UpcomingColor">#B9C2D0</Color>
            <!-- Round 2 (brief §3.4, §3.5, §3.8): soft section blocks, a hovered row inside them, the amber late/behind pill, the drag Cancel zone. -->
            <Color x:Key="Ab.SectionBlockColor">#F4F6F9</Color>
            <Color x:Key="Ab.RowHoverColor">#FFFFFF</Color>
            <Color x:Key="Ab.AmberInkColor">#8A5300</Color>
            <Color x:Key="Ab.AmberFillColor">#FBF0D9</Color>
            <Color x:Key="Ab.AmberFillStrongColor">#F3DFB2</Color>
            <Color x:Key="Ab.AmberLineColor">#E6C887</Color>
            <Color x:Key="Ab.DragCancelColor">#B3261E</Color>
            <Color x:Key="Ab.DragCancelFillColor">#FBE8E6</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <SolidColorBrush x:Key="Ab.SectionBlock" Color="{DynamicResource Ab.SectionBlockColor}" />
            <SolidColorBrush x:Key="Ab.RowHover" Color="{DynamicResource Ab.RowHoverColor}" />
            <SolidColorBrush x:Key="Ab.AmberInk" Color="{DynamicResource Ab.AmberInkColor}" />
            <SolidColorBrush x:Key="Ab.AmberFill" Color="{DynamicResource Ab.AmberFillColor}" />
            <SolidColorBrush x:Key="Ab.AmberFillStrong" Color="{DynamicResource Ab.AmberFillStrongColor}" />
            <SolidColorBrush x:Key="Ab.AmberLine" Color="{DynamicResource Ab.AmberLineColor}" />
            <SolidColorBrush x:Key="Ab.DragCancel" Color="{DynamicResource Ab.DragCancelColor}" />
            <SolidColorBrush x:Key="Ab.DragCancelFill" Color="{DynamicResource Ab.DragCancelFillColor}" />
            <!-- Tasks redesign (plan item 3, #10): mixes of two tokens, precomputed from this theme's own colours (a mix of two DynamicResources
                 cannot be written in AbStyles), and the accent / drift / amber tints over transparent. Line2 = Line 88% + Ink 12%, Line3 = Line 68% + Ink 32%,
                 Ink2 = Ink 78% + Muted 22%, Muted2 = Muted 70% + Faint 30%, AccentLine = Accent 40% + AccentSoft 60%, AccentRing = Accent 65% +
                 AccentSoft 35%, DriftLine = Drift 55% + Surface 45%, Dialog = Surface. -->
            <Color x:Key="Ab.Line2Color">#CBCFD8</Color>
            <Color x:Key="Ab.Line3Color">#A3A8B2</Color>
            <Color x:Key="Ab.Ink2Color">#293244</Color>
            <Color x:Key="Ab.Muted2Color">#6B788C</Color>
            <Color x:Key="Ab.AccentLineColor">#C7B7A1</Color>
            <Color x:Key="Ab.AccentRingColor">#AF987B</Color>
            <Color x:Key="Ab.DriftLineColor">#D6A095</Color>
            <Color x:Key="Ab.DialogColor">#FFFFFF</Color>
            <Color x:Key="Ab.AccentTint5Color">#0D8C6D45</Color>
            <Color x:Key="Ab.AccentTint14Color">#248C6D45</Color>
            <Color x:Key="Ab.AccentTint16Color">#298C6D45</Color>
            <Color x:Key="Ab.AccentTint18Color">#2E8C6D45</Color>
            <Color x:Key="Ab.AccentTint35Color">#598C6D45</Color>
            <Color x:Key="Ab.DriftTint8Color">#14B5523F</Color>
            <Color x:Key="Ab.DriftTint12Color">#1FB5523F</Color>
            <Color x:Key="Ab.DriftTint14Color">#24B5523F</Color>
            <Color x:Key="Ab.AmberTint9Color">#178A5300</Color>
            <!-- Ab.Shadow's colour: black at 50% in dark, warm black rgba(30,25,15,0.16) in light. -->
            <Color x:Key="Ab.ShadowColor">#291E190F</Color>
            <SolidColorBrush x:Key="Ab.Line2" Color="{DynamicResource Ab.Line2Color}" />
            <SolidColorBrush x:Key="Ab.Line3" Color="{DynamicResource Ab.Line3Color}" />
            <SolidColorBrush x:Key="Ab.Ink2" Color="{DynamicResource Ab.Ink2Color}" />
            <SolidColorBrush x:Key="Ab.Muted2" Color="{DynamicResource Ab.Muted2Color}" />
            <SolidColorBrush x:Key="Ab.AccentLine" Color="{DynamicResource Ab.AccentLineColor}" />
            <SolidColorBrush x:Key="Ab.AccentRing" Color="{DynamicResource Ab.AccentRingColor}" />
            <SolidColorBrush x:Key="Ab.DriftLine" Color="{DynamicResource Ab.DriftLineColor}" />
            <SolidColorBrush x:Key="Ab.Dialog" Color="{DynamicResource Ab.DialogColor}" />
            <SolidColorBrush x:Key="Ab.AccentTint5" Color="{DynamicResource Ab.AccentTint5Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint14" Color="{DynamicResource Ab.AccentTint14Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint16" Color="{DynamicResource Ab.AccentTint16Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint18" Color="{DynamicResource Ab.AccentTint18Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint35" Color="{DynamicResource Ab.AccentTint35Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint8" Color="{DynamicResource Ab.DriftTint8Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint12" Color="{DynamicResource Ab.DriftTint12Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint14" Color="{DynamicResource Ab.DriftTint14Color}" />
            <SolidColorBrush x:Key="Ab.AmberTint9" Color="{DynamicResource Ab.AmberTint9Color}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#8C6D45</Color>
            <Color x:Key="SystemAccentColorLight1">#8C6D45</Color>
            <Color x:Key="SystemAccentColorLight2">#8C6D45</Color>
            <Color x:Key="SystemAccentColorLight3">#8C6D45</Color>
            <Color x:Key="SystemAccentColorDark1">#8C6D45</Color>
            <Color x:Key="SystemAccentColorDark2">#8C6D45</Color>
            <Color x:Key="SystemAccentColorDark3">#8C6D45</Color>
            <Color x:Key="SystemRegionColor">#EEF1F5</Color>
            <Color x:Key="SystemAltHighColor">#FFFFFF</Color>
            <Color x:Key="SystemBaseHighColor">#1A2233</Color>
            <Color x:Key="SystemBaseMediumHighColor">#1A2233</Color>
            <Color x:Key="SystemBaseMediumColor">#5E6B80</Color>
            <Color x:Key="SystemBaseMediumLowColor">#8A96A8</Color>
            <Color x:Key="SystemBaseLowColor">#E3E7EE</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #8C6D45</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #1A2233</BoxShadows>
            <!-- Tasks redesign: the 1 px ring on selected rows (Ab.AccentRing), the menus' shadow (0 12 36) and the dialogs' (0 18 50) in Ab.Shadow's colour. -->
            <BoxShadows x:Key="Ab.SelectedRing">inset 0 0 0 1 #AF987B</BoxShadows>
            <BoxShadows x:Key="Ab.Shadow">0 12 36 0 #291E190F</BoxShadows>
            <BoxShadows x:Key="Ab.DialogShadow">0 18 50 0 #291E190F</BoxShadows>
            <!-- Tasks redesign 8b.04: the dragged stack's top card (0 16 36 in Ab.Shadow's colour). -->
            <BoxShadows x:Key="Ab.StackShadow">0 16 36 0 #291E190F</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Ab.BgColor">#10141C</Color>
            <Color x:Key="Ab.SurfaceColor">#171C27</Color>
            <Color x:Key="Ab.Surface2Color">#1F2532</Color>
            <Color x:Key="Ab.LineColor">#283040</Color>
            <Color x:Key="Ab.InkColor">#DCE1EA</Color>
            <Color x:Key="Ab.MutedColor">#8C95A8</Color>
            <Color x:Key="Ab.FaintColor">#5A6378</Color>
            <Color x:Key="Ab.AccentColor">#D2B98F</Color>
            <Color x:Key="Ab.OnAccentColor">#241B0E</Color>
            <Color x:Key="Ab.AccentSoftColor">#2A2822</Color>
            <Color x:Key="Ab.InfoBgColor">#1B2134</Color>
            <Color x:Key="Ab.InfoInkColor">#B7C0DE</Color>
            <Color x:Key="Ab.SleepColor">#A7B2D6</Color>
            <Color x:Key="Ab.MetColor">#8FBFA6</Color>
            <Color x:Key="Ab.WaitingColor">#A7B2D6</Color>
            <Color x:Key="Ab.DriftColor">#D99A8E</Color>
            <Color x:Key="Ab.PlanColor">#343C52</Color>
            <Color x:Key="Ab.UpcomingColor">#46506A</Color>
            <!-- Round 2 (brief §3.4, §3.5, §3.8): soft section blocks, a hovered row inside them, the amber late/behind pill, the drag Cancel zone. -->
            <Color x:Key="Ab.SectionBlockColor">#1B2130</Color>
            <Color x:Key="Ab.RowHoverColor">#232A39</Color>
            <Color x:Key="Ab.AmberInkColor">#E9C27A</Color>
            <Color x:Key="Ab.AmberFillColor">#33280F</Color>
            <Color x:Key="Ab.AmberFillStrongColor">#463718</Color>
            <Color x:Key="Ab.AmberLineColor">#5E4A22</Color>
            <Color x:Key="Ab.DragCancelColor">#E5776A</Color>
            <Color x:Key="Ab.DragCancelFillColor">#3A1D1C</Color>
            <SolidColorBrush x:Key="Ab.Bg" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="Ab.Surface" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="Ab.Surface2" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="Ab.Line" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="Ab.Ink" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="Ab.Muted" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="Ab.Faint" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="Ab.Accent" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="Ab.OnAccent" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="Ab.AccentSoft" Color="{DynamicResource Ab.AccentSoftColor}" />
            <SolidColorBrush x:Key="Ab.InfoBg" Color="{DynamicResource Ab.InfoBgColor}" />
            <SolidColorBrush x:Key="Ab.InfoInk" Color="{DynamicResource Ab.InfoInkColor}" />
            <SolidColorBrush x:Key="Ab.Sleep" Color="{DynamicResource Ab.SleepColor}" />
            <SolidColorBrush x:Key="Ab.Met" Color="{DynamicResource Ab.MetColor}" />
            <SolidColorBrush x:Key="Ab.Waiting" Color="{DynamicResource Ab.WaitingColor}" />
            <SolidColorBrush x:Key="Ab.Drift" Color="{DynamicResource Ab.DriftColor}" />
            <SolidColorBrush x:Key="Ab.Plan" Color="{DynamicResource Ab.PlanColor}" />
            <SolidColorBrush x:Key="Ab.Upcoming" Color="{DynamicResource Ab.UpcomingColor}" />
            <SolidColorBrush x:Key="Ab.SectionBlock" Color="{DynamicResource Ab.SectionBlockColor}" />
            <SolidColorBrush x:Key="Ab.RowHover" Color="{DynamicResource Ab.RowHoverColor}" />
            <SolidColorBrush x:Key="Ab.AmberInk" Color="{DynamicResource Ab.AmberInkColor}" />
            <SolidColorBrush x:Key="Ab.AmberFill" Color="{DynamicResource Ab.AmberFillColor}" />
            <SolidColorBrush x:Key="Ab.AmberFillStrong" Color="{DynamicResource Ab.AmberFillStrongColor}" />
            <SolidColorBrush x:Key="Ab.AmberLine" Color="{DynamicResource Ab.AmberLineColor}" />
            <SolidColorBrush x:Key="Ab.DragCancel" Color="{DynamicResource Ab.DragCancelColor}" />
            <SolidColorBrush x:Key="Ab.DragCancelFill" Color="{DynamicResource Ab.DragCancelFillColor}" />
            <!-- Tasks redesign (plan item 3, #10): mixes of two tokens, precomputed from this theme's own colours (a mix of two DynamicResources
                 cannot be written in AbStyles), and the accent / drift / amber tints over transparent. Line2 = Line 88% + Ink 12%, Line3 = Line 68% + Ink 32%,
                 Ink2 = Ink 78% + Muted 22%, Muted2 = Muted 70% + Faint 30%, AccentLine = Accent 40% + AccentSoft 60%, AccentRing = Accent 65% +
                 AccentSoft 35%, DriftLine = Drift 55% + Surface 45%, Dialog = Surface 55% + Surface2 45%. -->
            <Color x:Key="Ab.Line2Color">#3E4554</Color>
            <Color x:Key="Ab.Line3Color">#626976</Color>
            <Color x:Key="Ab.Ink2Color">#CAD0DB</Color>
            <Color x:Key="Ab.Muted2Color">#7D869A</Color>
            <Color x:Key="Ab.AccentLineColor">#6D624E</Color>
            <Color x:Key="Ab.AccentRingColor">#978669</Color>
            <Color x:Key="Ab.DriftLineColor">#826160</Color>
            <Color x:Key="Ab.DialogColor">#1B202C</Color>
            <Color x:Key="Ab.AccentTint5Color">#0DD2B98F</Color>
            <Color x:Key="Ab.AccentTint14Color">#24D2B98F</Color>
            <Color x:Key="Ab.AccentTint16Color">#29D2B98F</Color>
            <Color x:Key="Ab.AccentTint18Color">#2ED2B98F</Color>
            <Color x:Key="Ab.AccentTint35Color">#59D2B98F</Color>
            <Color x:Key="Ab.DriftTint8Color">#14D99A8E</Color>
            <Color x:Key="Ab.DriftTint12Color">#1FD99A8E</Color>
            <Color x:Key="Ab.DriftTint14Color">#24D99A8E</Color>
            <Color x:Key="Ab.AmberTint9Color">#17E9C27A</Color>
            <!-- Ab.Shadow's colour: black at 50% in dark, warm black rgba(30,25,15,0.16) in light. -->
            <Color x:Key="Ab.ShadowColor">#80000000</Color>
            <SolidColorBrush x:Key="Ab.Line2" Color="{DynamicResource Ab.Line2Color}" />
            <SolidColorBrush x:Key="Ab.Line3" Color="{DynamicResource Ab.Line3Color}" />
            <SolidColorBrush x:Key="Ab.Ink2" Color="{DynamicResource Ab.Ink2Color}" />
            <SolidColorBrush x:Key="Ab.Muted2" Color="{DynamicResource Ab.Muted2Color}" />
            <SolidColorBrush x:Key="Ab.AccentLine" Color="{DynamicResource Ab.AccentLineColor}" />
            <SolidColorBrush x:Key="Ab.AccentRing" Color="{DynamicResource Ab.AccentRingColor}" />
            <SolidColorBrush x:Key="Ab.DriftLine" Color="{DynamicResource Ab.DriftLineColor}" />
            <SolidColorBrush x:Key="Ab.Dialog" Color="{DynamicResource Ab.DialogColor}" />
            <SolidColorBrush x:Key="Ab.AccentTint5" Color="{DynamicResource Ab.AccentTint5Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint14" Color="{DynamicResource Ab.AccentTint14Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint16" Color="{DynamicResource Ab.AccentTint16Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint18" Color="{DynamicResource Ab.AccentTint18Color}" />
            <SolidColorBrush x:Key="Ab.AccentTint35" Color="{DynamicResource Ab.AccentTint35Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint8" Color="{DynamicResource Ab.DriftTint8Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint12" Color="{DynamicResource Ab.DriftTint12Color}" />
            <SolidColorBrush x:Key="Ab.DriftTint14" Color="{DynamicResource Ab.DriftTint14Color}" />
            <SolidColorBrush x:Key="Ab.AmberTint9" Color="{DynamicResource Ab.AmberTint9Color}" />
            <!-- FluentTheme colour keys, so Fluent controls follow the theme (see FluentOverrides.axaml). -->
            <Color x:Key="SystemAccentColor">#D2B98F</Color>
            <Color x:Key="SystemAccentColorLight1">#D2B98F</Color>
            <Color x:Key="SystemAccentColorLight2">#D2B98F</Color>
            <Color x:Key="SystemAccentColorLight3">#D2B98F</Color>
            <Color x:Key="SystemAccentColorDark1">#D2B98F</Color>
            <Color x:Key="SystemAccentColorDark2">#D2B98F</Color>
            <Color x:Key="SystemAccentColorDark3">#D2B98F</Color>
            <Color x:Key="SystemRegionColor">#10141C</Color>
            <Color x:Key="SystemAltHighColor">#171C27</Color>
            <Color x:Key="SystemBaseHighColor">#DCE1EA</Color>
            <Color x:Key="SystemBaseMediumHighColor">#DCE1EA</Color>
            <Color x:Key="SystemBaseMediumColor">#8C95A8</Color>
            <Color x:Key="SystemBaseMediumLowColor">#5A6378</Color>
            <Color x:Key="SystemBaseLowColor">#1F2532</Color>
            <BoxShadows x:Key="Ab.FocusRing">inset 0 0 0 2 #D2B98F</BoxShadows>
            <BoxShadows x:Key="Ab.FocusRingOnAccent">inset 0 0 0 2 #DCE1EA</BoxShadows>
            <!-- Tasks redesign: the 1 px ring on selected rows (Ab.AccentRing), the menus' shadow (0 12 36) and the dialogs' (0 18 50) in Ab.Shadow's colour. -->
            <BoxShadows x:Key="Ab.SelectedRing">inset 0 0 0 1 #978669</BoxShadows>
            <BoxShadows x:Key="Ab.Shadow">0 12 36 0 #80000000</BoxShadows>
            <BoxShadows x:Key="Ab.DialogShadow">0 18 50 0 #80000000</BoxShadows>
            <!-- Tasks redesign 8b.04: the dragged stack's top card (0 16 36 in Ab.Shadow's colour). -->
            <BoxShadows x:Key="Ab.StackShadow">0 16 36 0 #80000000</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="Ab.DisplayFont">avares://AccountabiliBuddy.App/Assets/Fonts/Manrope#Manrope</FontFamily>
    <FontFamily x:Key="Ab.NumeralFont">avares://AccountabiliBuddy.App/Assets/Fonts/Manrope#Manrope</FontFamily>
    <CornerRadius x:Key="Ab.CardRadius">28</CornerRadius>
    <CornerRadius x:Key="Ab.PanelRadius">24</CornerRadius>
    <!-- The Tasks page's cards and rails (spec 06 "r", PC values). -->
    <CornerRadius x:Key="Ab.TasksRadius">22</CornerRadius>
    <!-- Menus and popovers on the Tasks page (spec 06 "pr", PC values), with the shared popover shadow (spec 03 §C). -->
    <CornerRadius x:Key="Ab.PopoverRadius">16</CornerRadius>
    <BoxShadows x:Key="Ab.PopoverShadow">0 16 40 0 #38000000</BoxShadows>
    <!-- Task reminders (spec 03 §D): the tilted cards behind the toast stack, the full-screen card and the scrim behind it. -->
    <BoxShadows x:Key="Ab.ReminderBehindShadow">0 6 16 0 #1F000000</BoxShadows>
    <BoxShadows x:Key="Ab.AlarmShadow">0 24 60 0 #59000000</BoxShadows>
    <SolidColorBrush x:Key="Ab.Scrim" Color="#8C0A0E14" />
    <!-- Tasks redesign 3.26: the page dim behind the task editor and Move and label, rgba(10,9,8,0.55), the same in every theme and mode. -->
    <SolidColorBrush x:Key="Ab.PageScrim" Color="#8C0A0908" />
    <!-- Tasks redesign 6.03: the Archive sheet's dim, lighter than Ab.PageScrim: rgba(10,9,8,0.45), the same in every theme and mode. -->
    <SolidColorBrush x:Key="Ab.ArchiveScrim" Color="#730A0908" />
    <!-- The time-left ring beside the timer digits: nudged so it sits on the digits' middle, which depends on the numeral font. -->
    <Thickness x:Key="Ab.TimeRingMargin">0,32,0,0</Thickness>
    <Thickness x:Key="Ab.CardBorderThickness">0</Thickness>
    <x:Double x:Key="Ab.DisplayLetterSpacing">-0.5</x:Double>
    <FontWeight x:Key="Ab.NumeralWeight">SemiBold</FontWeight>
</ResourceDictionary>
