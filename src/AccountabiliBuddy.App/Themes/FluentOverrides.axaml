<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Maps FluentTheme's brushes for ground, text, buttons and text boxes onto the Ab.* tokens (ADR 49), so pages that
         are not redesigned yet follow the active theme. Fluent's accent and base COLOUR keys (SystemAccentColor*,
         SystemRegionColor, SystemAltHighColor, SystemBase*Color) are set inside each theme file, because a Color key
         cannot alias another resource. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SystemRegionBrush" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource Ab.InkColor}" />
            <!-- Secondary buttons (round 2 boards, brief §3: Stats, Edit, Snooze, Step away, Cancel, Back): the surface with a 1 px line;
                 hover and press go one step greyer. Filled (.primary, .danger) and quiet buttons set their own in AbStyles. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource Ab.SurfaceColor}" />
            <!-- ToggleSwitch: Surface2 track, the accent when on (round 2 boards), the knob muted off and page-ground on. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource Ab.OnAccentColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SystemRegionBrush" Color="{DynamicResource Ab.BgColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource Ab.InkColor}" />
            <!-- Secondary buttons (round 2 boards, brief §3: Stats, Edit, Snooze, Step away, Cancel, Back): the surface with a 1 px line;
                 hover and press go one step greyer. Filled (.primary, .danger) and quiet buttons set their own in AbStyles. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource Ab.InkColor}" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource Ab.SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource Ab.SurfaceColor}" />
            <!-- ToggleSwitch: Surface2 track, the accent when on (round 2 boards), the knob muted off and page-ground on. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{DynamicResource Ab.Surface2Color}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource Ab.LineColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{DynamicResource Ab.FaintColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{DynamicResource Ab.AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{DynamicResource Ab.MutedColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource Ab.OnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource Ab.OnAccentColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
