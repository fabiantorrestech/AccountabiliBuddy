<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.AboutView"
             x:DataType="vm:UpdatesViewModel">
    <!-- The app, its version and updates, with the camp quote in the middle. -->
    <ScrollViewer>
        <StackPanel Margin="24,0,24,24" Spacing="20" MaxWidth="640" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                <!-- 5 taps open the migration assistant (set up what's new since your last version). -->
                <Image x:Name="Logo" Source="/Assets/app-icon.png" Width="96" Height="96" HorizontalAlignment="Center" Tapped="OnLogoTapped" />
                <TextBlock Text="AccountabiliBuddy" Classes="display" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding VersionText}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Padding="24,20" Margin="0,8">
                <TextBlock Text="&quot;Now to make sure you don't slip up while in camp, we assign every camper an accountability buddy...&quot;"
                           FontSize="20" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" LineHeight="30" Foreground="{DynamicResource Ab.Ink}" />
            </Border>

            <!-- What the app is for, in the user's words. -->
            <StackPanel Spacing="12" Margin="8,0,8,8" MaxWidth="640">
                    <TextBlock Text="AccountabiliBuddy is a companion you install on the devices you use every day (your phone, tablet, personal computer and work computer) to help you use your time on purpose. It notices when you drift or get derailed, and gives you a few other productivity tools to make sitting down and getting sh*t done as straightforward as possible." TextWrapping="Wrap" Foreground="{DynamicResource Ab.Muted}" LineHeight="22" />
                    <TextBlock Text="It works best alongside a blocker for each platform when you really want to shut distractions out (e.g. Curbox on Android, Cold Turkey on Windows)." TextWrapping="Wrap" Foreground="{DynamicResource Ab.Muted}" LineHeight="22" />
                    <TextBlock Text="It's not perfect; no tool can be." TextWrapping="Wrap" Foreground="{DynamicResource Ab.Muted}" LineHeight="22" />
                    <TextBlock Text="It's hard to focus in a world of digital noise, with everything vying for your attention. We're fighting back, to help you reach your goals and reclaim your time and attention. (:" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Muted}" LineHeight="22" />
            </StackPanel>

            <Border Classes="sPanel" search:SearchArea.Name="Updates">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Updates" Classes="sTitle" />
                                <TextBlock Classes="sHint"
                                           Text="New versions come from the public AccountabiliBuddy releases page on GitHub. By default the app tells you when one is ready and you choose when to install; it never installs during a session." />
                                <TextBlock Text="{Binding Status}" Classes="sHint" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Check now" Command="{Binding CheckCommand}" />
                                <Button Content="{Binding InstallText}" Command="{Binding InstallCommand}" Classes="primary" IsVisible="{Binding HasUpdate}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Classes="sTitle" Text="Install updates automatically" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding AutoInstall}" IsEnabled="{Binding CanUpdate}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Install updates automatically" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <!-- Off (the Local only type): the app makes no update check of its own; Check now still asks. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Check for updates on its own" />
                                <TextBlock Classes="sHint" Text="Off: only when you click Check now. Automatic installs happen when no session is running; the app restarts by itself." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding CheckForUpdates}" IsEnabled="{Binding CanUpdate}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Check for updates on its own" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ADR 39: the one way out of AccountabiliBuddy's Cold Turkey locks. -->
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Emergency release (Cold Turkey)" Classes="sTitle" />
                                <TextBlock Classes="sHint"
                                           Text="If AccountabiliBuddy holds your Cold Turkey blocks and you truly need them off, release them for today with your spare key. Lost the key? Get a new one: it takes a reason and a 10-minute wait, and releases nothing." />
                            </StackPanel>
                            <!-- ADR 41: a new key without using the old one. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Emergency release…" Command="{Binding EmergencyReleaseCommand}" />
                                <Button Content="Get a new spare key…" Command="{Binding NewSpareKeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ADR 49: the city list behind Settings › Appearance › Find a city. -->
            <TextBlock Text="City list © GeoNames (geonames.org), CC BY 4.0." Classes="faint" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
