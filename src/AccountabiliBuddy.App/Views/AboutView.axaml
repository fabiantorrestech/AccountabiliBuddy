<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.AboutView"
             x:DataType="vm:UpdatesViewModel">
    <!-- The app, its version and updates, with the camp quote in the middle. -->
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="20" MaxWidth="640" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,24,0,0">
                <!-- 5 taps open the migration assistant (set up what's new since your last version). -->
                <Image x:Name="Logo" Source="/Assets/app-icon.png" Width="96" Height="96" HorizontalAlignment="Center" Tapped="OnLogoTapped" />
                <TextBlock Text="AccountabiliBuddy" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding VersionText}" Opacity="0.75" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Padding="24,20" Margin="0,8">
                <TextBlock Text="&quot;Now to make sure you don't slip up while in camp, we assign every camper an accountability buddy...&quot;"
                           FontSize="20" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" LineHeight="30" />
            </Border>

            <!-- What the app is for, in the user's words. -->
            <StackPanel Spacing="12" Margin="8,0,8,8" MaxWidth="640">
                    <TextBlock Text="AccountabiliBuddy is a companion you install on the devices you use every day (your phone, tablet, personal computer and work computer) to help you use your time on purpose. It notices when you drift or get derailed, and gives you a few other productivity tools to make sitting down and getting sh*t done as straightforward as possible." TextWrapping="Wrap" Opacity="0.85" LineHeight="22" />
                    <TextBlock Text="It works best alongside a blocker for each platform when you really want to shut distractions out (e.g. Curbox on Android, Cold Turkey on Windows)." TextWrapping="Wrap" Opacity="0.85" LineHeight="22" />
                    <TextBlock Text="It's not perfect; no tool can be." TextWrapping="Wrap" Opacity="0.85" LineHeight="22" />
                    <TextBlock Text="It's hard to focus in a world of digital noise, with everything vying for your attention. We're fighting back, to help you reach your goals and reclaim your time and attention. (:" TextWrapping="Wrap" Opacity="0.85" LineHeight="22" />
            </StackPanel>

            <Border Background="#0F808080" BorderBrush="#26808080" BorderThickness="1" CornerRadius="10" Padding="18,16"
                    search:SearchArea.Name="Updates">
                <StackPanel Spacing="6">
                    <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="New versions come from the public AccountabiliBuddy releases page on GitHub. By default the app tells you when one is ready and you choose when to install; it never installs during a session."
                               Opacity="0.75" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check now" Command="{Binding CheckCommand}" />
                        <Button Content="{Binding InstallText}" Command="{Binding InstallCommand}" Classes="accent" IsVisible="{Binding HasUpdate}" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding AutoInstall}" IsEnabled="{Binding CanUpdate}"
                              Content="Install updates automatically (when no session is running; the app restarts by itself)" />
                    <!-- Off (the Local only type): the app makes no update check of its own; Check now still asks. -->
                    <CheckBox IsChecked="{Binding CheckForUpdates}" IsEnabled="{Binding CanUpdate}"
                              Content="Check for updates on its own (off: only when you click Check now)" />
                </StackPanel>
            </Border>

            <!-- ADR 39: the one way out of AccountabiliBuddy's Cold Turkey locks. -->
            <Border Background="#0F808080" BorderBrush="#26808080" BorderThickness="1" CornerRadius="10" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Emergency release (Cold Turkey)" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="If AccountabiliBuddy holds your Cold Turkey blocks and you truly need them off, release them for today with your spare key. Lost the key? Get a new one: it takes a reason and a 10-minute wait, and releases nothing." Opacity="0.75" TextWrapping="Wrap" />
                    <!-- ADR 41: a new key without using the old one. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Emergency release…" Command="{Binding EmergencyReleaseCommand}" />
                        <Button Content="Get a new spare key…" Command="{Binding NewSpareKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ADR 49: the city list behind Settings › Appearance › Find a city. -->
            <TextBlock Text="City list © GeoNames (geonames.org), CC BY 4.0." Opacity="0.65" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
