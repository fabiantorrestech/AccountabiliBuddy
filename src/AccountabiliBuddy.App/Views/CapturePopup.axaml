<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AccountabiliBuddy.App.Views.CapturePopup"
        Title="Park an idea"
        Width="460" SizeToContent="Height"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!-- Ctrl+Alt+N: one line, Enter saves it as a come-back, Esc drops it; clicking away saves what's typed. -->
    <Border Padding="14,12" Background="#FF15191E" BorderBrush="#552A9D8F" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock Text="Park it for later: what is it?" FontWeight="SemiBold" />
            <TextBox x:Name="Line" PlaceholderText="e.g. try the new sync idea on the laptop" />
            <TextBlock Text="Enter saves it under Come back to on Today · Esc drops it" FontSize="11" Opacity="0.7" />
        </StackPanel>
    </Border>
</Window>
