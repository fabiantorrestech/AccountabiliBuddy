<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.GuidanceModeSwitch"
             x:DataType="vm:GuidanceModeViewModel">
    <!-- Settings › App & data › App mode (ADR 68, 69): the mode on all devices, its wait, and where the two modes' own settings differ. -->
    <StackPanel Spacing="6" search:SearchArea.Name="App mode">
        <TextBlock Classes="sGroup" Text="App mode" />
        <Border Classes="sPanel">
            <StackPanel Margin="0,0,0,-1">
                <Border Classes="sRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="sTitle" Text="{x:Static vm:GuidanceModeViewModel.ToggleTitle}" />
                            <TextBlock Classes="sHint" Text="{Binding Explanation}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsCompanionOn}" OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static vm:GuidanceModeViewModel.ToggleTitle}" />
                    </Grid>
                </Border>

                <Border Classes="sRow" IsVisible="{Binding HasPending}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="sHint" Text="{Binding PendingText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Cancel the switch" Command="{Binding CancelCommand}" />
                            <Button Content="Switch now instead…" Command="{Binding SwitchNowCommand}" IsVisible="{Binding CanSwitchNow}"
                                    ToolTip.Tip="Costs what ending this session early costs, then the usual wait, with the session still running." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="sRow" IsVisible="{Binding CanKeep}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Classes="sHint" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="This is the starting mode: until you keep it, this device follows the mode your other devices chose." />
                        <Button Grid.Column="1" Content="{Binding KeepText}" Command="{Binding KeepCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Classes="sRow" IsVisible="{Binding HasHiddenNote}">
                    <TextBlock Classes="sHint" Text="{Binding HiddenNote}" TextWrapping="Wrap" />
                </Border>

                <!-- Where the two modes' own settings differ (ADR 69), editable here. -->
                <Border Classes="sRow" DataContext="{Binding Compare}" IsVisible="{Binding HasRows, FallbackValue=False}" x:DataType="vm:ModeCompareViewModel">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="sTitle" Text="Differences between the modes" />
                        <TextBlock Classes="sHint" TextWrapping="Wrap"
                                   Text="Each mode keeps these settings for itself. Make one side win for all of them, or pick a side per row and apply: both modes then keep that value." />
                        <Grid ColumnDefinitions="2*,1.4*,1.4*" ColumnSpacing="8">
                            <TextBlock Text="Setting" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Static vm:ModeCompareViewModel.GuardingName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Static vm:ModeCompareViewModel.CompanionName}" FontWeight="SemiBold" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModeCompareRowViewModel">
                                    <Border BorderBrush="{DynamicResource Ab.Line}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <Grid ColumnDefinitions="2*,1.4*,1.4*" ColumnSpacing="8">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Section}" Classes="sHint" />
                                            </StackPanel>
                                            <RadioButton Grid.Column="1" GroupName="{Binding Label}" IsChecked="{Binding UseGuarding}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GuardingText}" TextWrapping="Wrap" />
                                            </RadioButton>
                                            <RadioButton Grid.Column="2" GroupName="{Binding Label}" IsChecked="{Binding UseCompanion}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompanionText}" TextWrapping="Wrap" />
                                            </RadioButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Content="{x:Static vm:ModeCompareViewModel.SyncToCompanionText}" Command="{Binding SyncToCompanionCommand}" Margin="0,0,8,6" />
                            <Button Content="{x:Static vm:ModeCompareViewModel.SyncToGuardingText}" Command="{Binding SyncToGuardingCommand}" Margin="0,0,8,6" />
                            <Button Content="Apply picks" Command="{Binding ApplyCommand}" IsEnabled="{Binding HasPicks}" Margin="0,0,8,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
