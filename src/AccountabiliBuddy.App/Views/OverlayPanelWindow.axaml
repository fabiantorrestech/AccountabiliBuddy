<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AccountabiliBuddy.App.Views.OverlayPanelWindow"
        x:DataType="vm:OverlayPanelViewModel"
        Title="AccountabiliBuddy panel"
        WindowDecorations="None" CanResize="False" SizeToContent="Height" Width="{Binding Width}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" RequestedThemeVariant="Dark"
        TransparencyLevelHint="Transparent" Background="Transparent">
    <Window.Styles>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.act">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.act.primary">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.act TextBlock, Button.foot TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.foot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.foot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <!-- A task row with its steps under it while it is the current one. -->
        <DataTemplate x:Key="taskFull" x:DataType="vm:TaskRowViewModel">
            <StackPanel>
                <Button Classes="row" Command="{Binding PickCommand}">
                    <Grid ColumnDefinitions="*,Auto,28">
                        <TextBlock Text="{Binding Title}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:PanelFontWeights.Current}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Ab.Ink}" />
                        <TextBlock Grid.Column="1" Text="{Binding EstimateMinutes, StringFormat='{}{0} min'}" Classes="key" Margin="0,0,8,0"
                                   IsVisible="{Binding EstimateMinutes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Number}" Classes="key" HorizontalAlignment="Right" />
                    </Grid>
                </Button>
                <ItemsControl ItemsSource="{Binding Subtasks}" IsVisible="{Binding IsCurrent}" Margin="22,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubtaskRowViewModel">
                            <CheckBox IsChecked="{Binding IsDone}" Content="{Binding Title}" FontSize="12" MinHeight="26" Foreground="{DynamicResource Ab.Ink}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="taskCompact" x:DataType="vm:TaskRowViewModel">
            <Button Classes="row" Command="{Binding PickCommand}">
                <Grid ColumnDefinitions="*,28">
                    <TextBlock Text="{Binding Title}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:PanelFontWeights.Current}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ab.Ink}" />
                    <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="key" HorizontalAlignment="Right" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Border x:Name="Frame" Background="{DynamicResource Ab.Surface}" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <!-- Now -->
                <StackPanel Margin="16,14,16,12" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <controls:ProgressRing Width="40" Height="40" Value="{Binding Model.RingValue}" TrackBrush="{DynamicResource Ab.Surface2}" ArcBrush="{Binding Model.RingBrush}" Thickness="4.5"
                                               VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Model.MinutesText}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Model.MinutesBrush}" />
                                <TextBlock Text="{Binding HeaderSub}" FontSize="12" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <TextBlock Text="{Binding Model.TaskText}" FontSize="13" Foreground="{DynamicResource Ab.Ink}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsCompact}" VerticalAlignment="Center">
                            <Button Classes="foot" Command="{Binding Model.DoneCommand}" IsVisible="{Binding Model.ShowsDone}" AutomationProperties.Name="Done">
                                <mi:MaterialIcon Kind="Check" Width="16" Height="16" />
                            </Button>
                            <Button Classes="foot" Command="{Binding Model.PauseCommand}" IsVisible="{Binding Model.ShowsPause}" AutomationProperties.Name="Pause">
                                <mi:MaterialIcon Kind="{Binding Model.PauseIcon}" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <controls:OverlayTimeline Done="{Binding Model.TimelineDone}" Left="{Binding Model.TimelineLeft}" Break="{Binding Model.TimelineBreak}" Next="{Binding Model.TimelineNext}"
                                              DoneBrush="{DynamicResource Ab.Accent}" LeftBrush="{DynamicResource Ab.Upcoming}" BreakBrush="{DynamicResource Ab.Sleep}"
                                              NextBrush="{DynamicResource Ab.Plan}" TickBrush="{DynamicResource Ab.Ink}" HorizontalAlignment="Stretch" IsVisible="{Binding InSession}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsCompact}">
                        <Button Classes="act primary" Command="{Binding Model.DoneCommand}" IsVisible="{Binding Model.ShowsDone}" Background="{DynamicResource Ab.Accent}" Foreground="{DynamicResource Ab.OnAccent}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Check" Width="14" Height="14" />
                                <TextBlock Text="Done" FontWeight="SemiBold" />
                                <TextBlock Text="D" Opacity="0.6" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act" Command="{Binding Model.PauseCommand}" IsVisible="{Binding Model.ShowsPause}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{Binding Model.PauseIcon}" Width="14" Height="14" />
                                <TextBlock Text="{Binding PauseText}" />
                                <TextBlock Text="P" Classes="key" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act" Command="{Binding Model.ExtendFocusCommand}" IsVisible="{Binding ShowsExtend}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                <TextBlock Text="10 min" />
                                <TextBlock Text="T" Classes="key" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act primary" Command="{Binding StartCommand}" IsVisible="{Binding !InSession}" Background="{DynamicResource Ab.Accent}" Foreground="{DynamicResource Ab.OnAccent}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Start" FontWeight="SemiBold" />
                                <TextBlock Text="F" Opacity="0.6" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act" Command="{Binding StartLunchCommand}" IsVisible="{Binding ShowsLunch}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Lunch" />
                                <TextBlock Text="L" Classes="key" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Ab.Line}" />
                <!-- The goal line, and "I'm ready" while the planning minutes run -->
                <TextBlock Text="{Binding GoalText}" IsVisible="{Binding GoalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="head" Margin="16,8,16,0" TextWrapping="Wrap" />
                <Button Classes="act" Command="{Binding ReadyCommand}" IsVisible="{Binding ShowsReady}" Margin="16,8,16,0" HorizontalAlignment="Left" ToolTip.Tip="End the planning minutes now">
                    <TextBlock Text="I'm ready" />
                </Button>
                <!-- This session -->
                <StackPanel Margin="6,8,6,6">
                    <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,4">
                        <TextBlock Text="{Binding TasksHeader}" Classes="head" />
                        <TextBlock Grid.Column="1" Text="{Binding SwitchHint}" Classes="key" />
                    </Grid>
                    <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}" />
                    <Button Classes="row" Command="{Binding ParkCommand}">
                        <Grid ColumnDefinitions="Auto,*,28" ColumnSpacing="8">
                            <mi:MaterialIcon Kind="NotePlusOutline" Width="14" Height="14" Foreground="{DynamicResource Ab.Faint}" />
                            <TextBlock Grid.Column="1" Text="Park a thought…" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="N" Classes="key" HorizontalAlignment="Right" />
                        </Grid>
                    </Button>
                </StackPanel>
                <!-- This PC's timers and alarms: pause, a minute more, stop (or dismiss once it is up) -->
                <ItemsControl ItemsSource="{Binding Model.Timers.Lines}" IsVisible="{Binding Model.Timers.HasLines, FallbackValue=False}" Margin="16,6,16,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OverlayTimerLine">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" MinHeight="30">
                                <mi:MaterialIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Ink}" />
                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="key" Margin="0,0,4,0" />
                                <Button Grid.Column="3" Classes="foot" Command="{Binding PauseResumeCommand}" IsVisible="{Binding IsTimer}" ToolTip.Tip="{Binding PauseTip}" AutomationProperties.Name="Pause or resume"><mi:MaterialIcon Kind="{Binding PauseIcon}" Width="14" Height="14" /></Button>
                                <Button Grid.Column="4" Classes="foot" Command="{Binding AddMinuteCommand}" IsVisible="{Binding IsTimer}" Content="+1" ToolTip.Tip="A minute more" />
                                <Button Grid.Column="5" Classes="foot" Command="{Binding StopCommand}" ToolTip.Tip="{Binding StopTip}" AutomationProperties.Name="Stop"><mi:MaterialIcon Kind="Close" Width="14" Height="14" /></Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Sleep mode: tonight's wake time, which - and + change for this one night -->
                <StackPanel Margin="16,2,16,8" Spacing="4" IsVisible="{Binding Model.Wake.IsShown, FallbackValue=False}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Model.Wake.WakeText}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Ink}" />
                        <Button Grid.Column="1" Classes="act" Content="−" Command="{Binding Model.Wake.EarlierCommand}" ToolTip.Tip="15 minutes earlier, tonight only" Padding="10,0" />
                        <Button Grid.Column="2" Classes="act" Content="+" Command="{Binding Model.Wake.LaterCommand}" ToolTip.Tip="15 minutes later, tonight only" Padding="10,0" />
                    </Grid>
                    <Button Classes="foot" Content="{Binding Model.Wake.PlanWakeText}" Command="{Binding Model.Wake.BackToPlanCommand}" IsVisible="{Binding Model.Wake.IsChanged}" HorizontalAlignment="Left" />
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Ab.Line}" IsVisible="{Binding Model.Noise, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- Sound -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="16,10,16,10" IsVisible="{Binding Model.Noise, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <mi:MaterialIcon Kind="Waveform" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Model.TrackText}" FontSize="13" Foreground="{DynamicResource Ab.Ink}" TextTrimming="CharacterEllipsis" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding Model.Noise.Volume}" MinHeight="0" Margin="0,-2,0,-6">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource Ab.InkColor}" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource Ab.InkColor}" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource Ab.InkColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource Ab.InkColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource Ab.InkColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource Ab.InkColor}" />
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="foot" Command="{Binding Model.Noise.ToggleLockCommand}" ToolTip.Tip="{Binding Model.Noise.LockTip}" AutomationProperties.Name="Headphone lock"><mi:MaterialIcon Kind="{Binding Model.Noise.LockIcon}" Width="14" Height="14" /></Button>
                        <Button Classes="foot" Command="{Binding Model.Noise.PreviousCommand}" AutomationProperties.Name="Previous sound"><mi:MaterialIcon Kind="SkipPrevious" Width="16" Height="16" /></Button>
                        <Button Classes="foot" Command="{Binding Model.Noise.PlayPauseCommand}" AutomationProperties.Name="Play or pause the noise"><mi:MaterialIcon Kind="PlayPause" Width="16" Height="16" /></Button>
                        <Button Classes="foot" Command="{Binding Model.Noise.NextCommand}" AutomationProperties.Name="Next sound"><mi:MaterialIcon Kind="SkipNext" Width="16" Height="16" /></Button>
                        <TextBlock Text="M" Classes="key" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Ab.Line}" />
                <TextBlock IsVisible="{Binding IsCompact}" Text="D done   P pause   T +10   B side task   H hide" Classes="key" Margin="16,6,16,0" />
                <!-- Footer -->
                <Grid ColumnDefinitions="*,Auto" Margin="8,4,8,6">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="foot" Command="{Binding SideTaskCommand}" IsVisible="{Binding ShowsSideTaskButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="CoffeeOutline" Width="14" Height="14" /><TextBlock Text="Side task" /><TextBlock Text="B" Classes="key" /></StackPanel>
                        </Button>
                        <Button Classes="foot" Command="{Binding HideCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="EyeOffOutline" Width="14" Height="14" /><TextBlock Text="Hide" /><TextBlock Text="H" Classes="key" /></StackPanel>
                        </Button>
                        <Button Classes="foot" Command="{Binding ShowQrCommand}" IsVisible="{Binding HasQr}" ToolTip.Tip="Show today's QR codes for your phone to scan">
                            <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Qrcode" Width="14" Height="14" /><TextBlock Text="QR" /></StackPanel>
                        </Button>
                        <Button Classes="foot" Command="{Binding OpenAppCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="OpenInNew" Width="14" Height="14" /><TextBlock Text="Open app" /><TextBlock Text="O" Classes="key" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="foot" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Overlay settings" AutomationProperties.Name="Overlay settings">
                        <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>
            <!-- Large: Come back to, Timers, Next up, Devices -->
            <StackPanel Grid.Column="1" Width="300" IsVisible="{Binding IsLarge}" Margin="0">
                <Border Width="1" Background="{DynamicResource Ab.Line}" HorizontalAlignment="Left" />
                <StackPanel Margin="16,14,16,12" Spacing="14">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Come back to" Classes="head" /><TextBlock Grid.Column="1" Text="{Binding Comebacks.Count}" Classes="key" /></Grid>
                        <ItemsControl ItemsSource="{Binding Comebacks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="13" Margin="0,3" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ab.Ink}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding Model.Timers.HasLines, FallbackValue=False}">
                        <TextBlock Text="Timers" Classes="head" />
                        <ItemsControl ItemsSource="{Binding Model.Timers.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverlayTimerLine">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{DynamicResource Ab.Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ab.Ink}" />
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="key" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Next up" Classes="head" />
                        <ItemsControl ItemsSource="{Binding NextUpLines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="13" Margin="0,3" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ab.Ink}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding Devices.Count}">
                        <TextBlock Text="Devices" Classes="head" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverlayBatteryRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{DynamicResource Ab.Muted}" />
                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{Binding Brush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
