<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsLocked}" Background="#33F59E0B"
                Padding="12,8" Margin="0,0,0,12" CornerRadius="6">
            <TextBlock Text="Profiles are locked while a focus session is running." />
        </Border>
        <views:PendingChangesBanner DockPanel.Dock="Top" DataContext="{Binding PendingChanges}" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
            <Button Content="Revert" Command="{Binding RevertCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="200,16,*">
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                    <Button Content="Add profile" Command="{Binding AddProfileCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Add example profile" Command="{Binding AddExampleProfileCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Delete profile" Command="{Binding DeleteProfileCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <!-- Grouped by device once a phone or tablet is linked: this PC first, then each linked device. -->
                        <Button IsVisible="{Binding HasLinkedDevices}" Command="{Binding ToggleThisDeviceCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="4,6">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="{Binding ThisDeviceArrow}" />
                                    <Run Text="{Binding ThisDeviceTitle}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ThisDeviceDetail}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsVisible="{Binding ShowsProfileList}"
                                 Margin="{Binding HasLinkedDevices, Converter={x:Static vm:IndentConverter.Instance}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileEditorViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl ItemsSource="{Binding LinkedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceProfilesRowViewModel">
                                    <StackPanel>
                                        <Button Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="Transparent" Padding="4,6">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{Binding Arrow}" />
                                                    <Run Text="{Binding Name}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding ProfileNames}" IsVisible="{Binding IsExpanded}" Margin="20,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding}" Opacity="0.75" Margin="0,2" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <ScrollViewer Grid.Column="2">
                <ContentControl Content="{Binding SelectedProfile}" IsEnabled="{Binding !IsLocked}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ProfileEditorViewModel">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Name" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Name}" Width="260" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Ask about unknown apps after (seconds)" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding GraceSeconds}" Width="120" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding AskAboutUnlistedSites}">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Ask about websites with no rule, even when the browser app is allowed (otherwise allowing a browser allows every site you haven't blocked)" />
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="On-screen timer during this profile's sessions" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{x:Static vm:TimerChoice.Names}" SelectedIndex="{Binding TimerChoiceIndex}"
                                              MinWidth="130" ToolTip.Tip="Use default follows Settings → On-screen timer" />
                                    <ComboBox ItemsSource="{Binding TimerColors}" SelectedItem="{Binding TimerColor}"
                                              IsVisible="{Binding HasOwnTimer}" MinWidth="170" ToolTip.Tip="Timer colour">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimerColorOption">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                            BorderBrush="#55808080" BorderThickness="1" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding HasColdTurkeyBlocks}">
                                    <TextBlock Text="Cold Turkey blocks this profile expects to be on" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ColdTurkeyBlocks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExpectedBlockOption">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsExpected}" Margin="0,0,16,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                               Text="This computer only. During this profile's focus you're told when one of them is off; nothing is changed in Cold Turkey." />
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                           Text="Rules: when several match, Channel beats Url beats WindowTitle beats ProcessName, a longer pattern beats a shorter one, and Block wins a tie. OcrText rules are only checked when nothing else matched. ProcessName is without .exe (e.g. chrome). Domain matching (Url only) includes subdomains." />

                                <!-- Ticked rules go to another profile or a new one (copied, or moved out of this one). -->
                                <Border IsVisible="{Binding HasSelectedRules}" Background="#1F808080" CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Text="· to" VerticalAlignment="Center" Opacity="0.75" />
                                        <ComboBox MinWidth="180" ItemsSource="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).PortTargets}"
                                                  SelectedItem="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).SelectedPortTarget}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PortTargetOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Copy" Command="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).CopySelectedRulesCommand}"
                                                ToolTip.Tip="Copy the ticked rules there; this profile keeps them" />
                                        <Button Content="Move" Command="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).MoveSelectedRulesCommand}"
                                                ToolTip.Tip="Move the ticked rules there; they leave this profile" />
                                    </StackPanel>
                                </Border>
                                <!-- "New profile…": start from this profile's settings or brand new. -->
                                <Border IsVisible="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).IsAskingNewProfileStart}" BorderBrush="#80FFFFFF" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).NewProfilePrompt}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="accent" Content="From this profile's settings"
                                                    Command="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).StartNewProfileFromSettingsCommand}" />
                                            <Button Content="Brand new" Command="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).StartNewProfileBrandNewCommand}" />
                                            <Button Content="Cancel" Command="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).CancelNewProfileCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="2*" MinWidth="140" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding AllRulesSelected}" MinWidth="0" Padding="0"
                                              ToolTip.Tip="Select all (to copy or move them to another profile)" AutomationProperties.Name="Select all rules" />
                                    <TextBlock Grid.Column="1" Text="Match on" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="How" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="Pattern" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="Verdict" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="Note" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RuleEditorViewModel">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="2*" MinWidth="140" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" MinWidth="90" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                                          ToolTip.Tip="Tick to copy or move it to another profile" AutomationProperties.Name="{Binding Pattern}" />
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                          ItemsSource="{x:Static vm:RuleEditorViewModel.Targets}"
                                                          SelectedItem="{Binding Target}" />
                                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                          ItemsSource="{x:Static vm:RuleEditorViewModel.Kinds}"
                                                          SelectedItem="{Binding Kind}" />
                                                <TextBox Grid.Column="3" Text="{Binding Pattern}" Margin="0,0,4,0"
                                                         PlaceholderText="e.g. youtube.com/shorts" />
                                                <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                          ItemsSource="{x:Static vm:RuleEditorViewModel.Verdicts}"
                                                          SelectedItem="{Binding Verdict}" />
                                                <TextBox Grid.Column="5" Text="{Binding Note}" Margin="0,0,4,0"
                                                         PlaceholderText="optional" />
                                                <Button Grid.Column="6" Content="✕" Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Remove rule" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Add rule" Command="{Binding AddRuleCommand}" />

                                <TextBlock Text="Unlock options" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                           Text="Ways to lift this profile's blocks (Session tab → Unlock). You wait the time shown and give a reason; then the session ends until it relocks (midnight by default, see Settings). Can't be changed during focus." />
                                <ItemsControl ItemsSource="{Binding UnlockOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UnlockOptionEditorViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <TextBox Text="{Binding Name}" Width="220" PlaceholderText="e.g. Off day" />
                                                <TextBlock Text="wait" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding WaitMinutes}" Width="72" />
                                                <TextBlock Text="minutes" VerticalAlignment="Center" />
                                                <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove unlock option" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add unlock option" Command="{Binding AddUnlockOptionCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
