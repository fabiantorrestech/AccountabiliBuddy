<views:TaskDialogWindow xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
                        xmlns:views="using:AccountabiliBuddy.App.Views"
                        x:Class="AccountabiliBuddy.App.Views.GoalAreaDialog"
                        x:DataType="vm:GoalAreaEditorViewModel"
                        Title="{Binding Title}"
                        Icon="/Assets/app-icon.png"
                        Width="480">
    <!-- Edit area (round 2 R5.4): name, icon, colour, its place among the areas; Delete asks first and says where its goals go. -->
    <views:TaskDialogWindow.Styles>
        <Style Selector="ListBox.picker">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.picker > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.picker > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </views:TaskDialogWindow.Styles>

    <StackPanel Margin="22,20" Spacing="14">
        <TextBlock Classes="dlgTitle" Text="{Binding Title}" />
        <StackPanel Spacing="6">
            <TextBlock Classes="dlgHead" Text="Name" />
            <TextBox Classes="dialogStart" Text="{Binding Name}" MaxLength="80" PlaceholderText="Learning" AutomationProperties.Name="Area name" />
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Classes="dlgHead" Text="Icon" />
            <ListBox Classes="picker" ItemsSource="{Binding Icons}" SelectedItem="{Binding SelectedIcon}" AutomationProperties.Name="Area icon">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GoalChoice">
                        <Border Width="36" Height="36" ToolTip.Tip="{Binding Text}">
                            <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Classes="dlgHead" Text="Colour" />
            <ListBox Classes="picker" ItemsSource="{Binding Colours}" SelectedItem="{Binding SelectedColour}" AutomationProperties.Name="Area colour">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GoalChoice">
                        <Border Width="30" Height="30" Padding="5" ToolTip.Tip="{Binding Text}">
                            <Ellipse Fill="{Binding Brush}" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="dlgHead" Text="Order" />
                <TextBlock Classes="muted" FontSize="12" Text="Its place in the Goals list" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" SelectedIndex="{Binding PositionIndex}" MinWidth="110" AutomationProperties.Name="Area order" />
        </Grid>

        <!-- Delete: asks first, then says where the goals go. -->
        <Border IsVisible="{Binding IsConfirmingDelete}" Background="{DynamicResource Ab.Surface2}" CornerRadius="12" Padding="14,12">
            <StackPanel Spacing="8">
                <TextBlock Text="Delete this area?" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12.5" Text="{Binding DeleteText}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding NeedsDestination}">
                    <TextBlock Text="Move its goals to" VerticalAlignment="Center" FontSize="12.5" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Move its goals to">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GoalChoice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding Brush}" />
                                    <TextBlock Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12.5" Foreground="{DynamicResource Ab.Waiting}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Classes="danger" Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Grid.Column="3" Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
        </Grid>
    </StackPanel>
</views:TaskDialogWindow>
