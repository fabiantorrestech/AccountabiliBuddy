<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.LunchEndPromptView"
             x:DataType="vm:LunchEndPromptViewModel">
    <!-- The "End lunch?" question (LU1b, ADR 88): the ✕ on Today's lunch card, the title bar's lunch chip and the overlay's lunch row all
         show this one view. It is small (300 wide at most), so it fits the Today side column, a title-bar pop-up and the overlay panel. -->
    <StackPanel Spacing="8" MaxWidth="300">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="SilverwareForkKnife" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding UsedText}" FontSize="13" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CountText}" FontSize="12.5" Foreground="{DynamicResource Ab.Muted}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DiscardText}" FontSize="12.5" Foreground="{DynamicResource Ab.Muted}" TextWrapping="Wrap"
                   IsVisible="{Binding CanDiscard}" />
        <WrapPanel ItemSpacing="6" LineSpacing="6">
            <Button Classes="primary" Content="Count it" Command="{Binding CountItCommand}" AutomationProperties.Name="Count it" />
            <Button Content="Discard it" Command="{Binding DiscardItCommand}" IsVisible="{Binding CanDiscard}" AutomationProperties.Name="Discard it" />
            <Button Classes="quiet" Content="Keep going" Command="{Binding KeepGoingCommand}" AutomationProperties.Name="Keep going" />
        </WrapPanel>
    </StackPanel>
</UserControl>
