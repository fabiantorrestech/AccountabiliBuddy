<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             x:Class="AccountabiliBuddy.App.Views.CategoryEditorView"
             x:DataType="vm:CategoryEditorViewModel">
    <!-- The Categories editor of the Tasks page: the same rows as Today's tag button. Add (Enter), rename (Enter or click away),
         recolour and delete. -->
    <StackPanel Spacing="4">
        <TextBlock Text="Categories" FontWeight="SemiBold" />
        <TextBlock Classes="faint" Text="Deleting one leaves its tasks, Later items and come-backs with no category." FontSize="12" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="No categories yet. Add one below." FontSize="13" IsVisible="{Binding IsEmpty}" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskCategoryRowViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" Margin="0,2">
                        <controls:CategoryColorButton />
                        <TextBox Grid.Column="1" Text="{Binding Name}" LostFocus="OnCategoryNameLostFocus"
                                 AutomationProperties.Name="Category name">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveNameCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2" Classes="quiet" Command="{Binding AskDeleteCommand}" Padding="8,4" ToolTip.Tip="Delete this category"
                                AutomationProperties.Name="Delete this category">
                            <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                        <!-- The delete question: always asked, with how many items lose the category. -->
                        <Border Grid.Row="1" Grid.ColumnSpan="3" IsVisible="{Binding IsConfirmingDelete}" Margin="0,2,0,4" Padding="10,8" CornerRadius="10"
                                BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="quiet" Content="Delete" Command="{Binding DeleteCommand}" AutomationProperties.Name="Confirm delete" />
                                    <Button Classes="quiet" Content="Keep it" Command="{Binding CancelDeleteCommand}" AutomationProperties.Name="Keep this category" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Text="{Binding NewCategoryName}" PlaceholderText="New category, e.g. Work (Enter)" AutomationProperties.Name="New category">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCategoryCommand}" />
            </TextBox.KeyBindings>
        </TextBox>
    </StackPanel>
</UserControl>
