<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AccountabiliBuddy.App.Views.SessionOverlayWindow"
        x:DataType="vm:OnScreenOverlayViewModel"
        Title="AccountabiliBuddy timer"
        WindowDecorations="None" CanResize="False" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" RequestedThemeVariant="Dark"
        TransparencyLevelHint="Transparent" Background="Transparent">
    <Window.Styles>
        <!-- The bar's tick boxes (while Ctrl+Alt is held): an empty box, like the checklist's. -->
        <Style Selector="Button.tick">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1,6,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#CCFFFFFF" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.tick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
        </Style>
    </Window.Styles>
    <!-- Click-through except while Ctrl+Alt is held; then it can be dragged (see code-behind). -->
    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </LayoutTransformControl.LayoutTransform>
        <Panel Opacity="{Binding Fade}">
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
            </Panel.Transitions>
            <Border Margin="2" CornerRadius="10" Padding="10,7" Background="#FF15191E"
                    BorderBrush="{Binding OutlineBrush}" BorderThickness="1.5" Opacity="{Binding PanelOpacity}">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <StackPanel x:Name="MainStack" Grid.Row="1" Spacing="8" HorizontalAlignment="{Binding MainAlignment}">
                        <!-- Plan first: the session's first minutes. -->
                        <TextBlock Text="{Binding PlanningText}" IsVisible="{Binding ShowsPlanning}" Foreground="#E6FFFFFF" FontSize="11"
                                   Width="{x:Static vm:SessionOverlayViewModel.BarLength}" TextTrimming="CharacterEllipsis" />
                        <!-- Stepped away: the countdown is paused until any input. -->
                        <Border IsVisible="{Binding ShowsAway}" Background="#33FFFFFF" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AwayText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <!-- Guided sessions: how far along and the task now on one line ("2/5 · 3. Fix tests", with a pin), its subtask
                             under it (2 lines then "…"); all of both while Ctrl+Alt is held. -->
                        <StackPanel Spacing="1" IsVisible="{Binding TaskLineShown}"
                                    Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                            <!-- While Ctrl+Alt is held, a box by each line ticks it right here. -->
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                <Button Classes="tick" Command="{Binding Checklist.TickCurrentTaskCommand}" IsVisible="{Binding ShowsDetails}"
                                        VerticalAlignment="Top" views:OverlayHint.Text="Tick this task (and its subtasks)" AutomationProperties.Name="Tick the task" />
                                <!-- The task's category colour. -->
                                <Ellipse Grid.Column="1" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding TaskCategoryBrush}" IsVisible="{Binding ShowsTaskCategory}" />
                                <mi:MaterialIcon Grid.Column="2" Kind="Pin" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                                 Foreground="#E6FFFFFF" />
                                <TextBlock Grid.Column="3" Text="{Binding TaskLine}" Foreground="#E6FFFFFF" FontSize="11"
                                           TextWrapping="Wrap" MaxLines="{Binding TaskMaxLines}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="10,0,0,0" IsVisible="{Binding ShowsSubtaskLine}">
                                <Button Classes="tick" Command="{Binding Checklist.TickCurrentSubtaskCommand}" IsVisible="{Binding ShowsDetails}"
                                        VerticalAlignment="Top" views:OverlayHint.Text="Tick this subtask" AutomationProperties.Name="Tick the subtask" />
                                <TextBlock Grid.Column="1" Text="{Binding SubtaskLine}" Foreground="#C8FFFFFF" FontSize="11"
                                           TextWrapping="Wrap" MaxLines="{Binding SubtaskMaxLines}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                        <!-- Sleep mode, in the evening: sleep left if you go to bed now. -->
                        <TextBlock Text="{Binding Day.SleepText}" IsVisible="{Binding ShowsSleep}" Foreground="{Binding Day.SleepBrush}"
                                   Width="{x:Static vm:SessionOverlayViewModel.BarLength}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- All-day timeline: a small copy of the day bar, with the next block under it. -->
                        <StackPanel Spacing="2" IsVisible="{Binding ShowsTimeline}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                            <controls:DayBarControl Layout="{Binding Day.Layout}" Compact="True" Quiet="{Binding IsQuiet}" QuietMarks="{Binding QuietMarks}"
                                                    NowFraction="{Binding Day.NowFraction}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Day.StatusText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Foreground="#CCFFFFFF" FontSize="10" Classes.unstarted="{Binding Day.IsUnstarted}">
                                    <!-- Work time with no session: amber until one starts. -->
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.unstarted">
                                            <Setter Property="Foreground" Value="#F4A261" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" IsVisible="{Binding ShowsTimelineTime}" Margin="6,0,0,0"
                                           Foreground="White" FontSize="10" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>

                        <Panel IsVisible="{Binding ShowsTimer}">
                            <StackPanel Spacing="6" DataContext="{Binding Timer}" x:DataType="vm:SessionOverlayViewModel">
                                <Panel HorizontalAlignment="{Binding #MainStack.HorizontalAlignment}">
                                    <StackPanel Spacing="4" IsVisible="{Binding !IsRing}" MaxWidth="{x:Static vm:SessionOverlayViewModel.BarLength}">
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowsHeader}">
                                            <TextBlock Text="{Binding HeaderLabel}" TextTrimming="CharacterEllipsis"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding HeaderTime}" Margin="6,0,0,0"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Text="{Binding BigTimeText}" IsVisible="{Binding ShowsBigTime}"
                                                   Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                        <Panel IsVisible="{Binding ShowsBar}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}" Height="6">
                                            <Border Background="#40FFFFFF" CornerRadius="3" />
                                            <!-- Glides over the second between updates instead of stepping. -->
                                            <Border Background="{Binding AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Width" Duration="0:0:1" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                            <controls:TimerMarks Divisions="{Binding Divisions}" />
                                        </Panel>
                                        <TextBlock Text="{Binding EndText}" IsVisible="{Binding ShowsEndText}"
                                                   Foreground="#CCFFFFFF" FontSize="10" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Panel IsVisible="{Binding IsRing}" Width="68" Height="68">
                                        <Ellipse Stroke="#40FFFFFF" StrokeThickness="6" Margin="3" />
                                        <Arc Stroke="{Binding AccentBrush}" StrokeThickness="6" Margin="3"
                                             StartAngle="-90" SweepAngle="{Binding RingSweep}" StrokeLineCap="Round">
                                            <Arc.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="SweepAngle" Duration="0:0:1" />
                                                </Transitions>
                                            </Arc.Transitions>
                                        </Arc>
                                        <controls:TimerMarks Divisions="{Binding Divisions}" IsRing="True" RingStroke="6" RingInset="3" />
                                        <TextBlock Text="{Binding RingText}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>

                                    <!-- Count-up: every half hour the time in shows in the middle for a few seconds (with the glow).
                                         Small enough to fit over the bar without changing the window's size. -->
                                    <Border IsVisible="{Binding ShowsElapsedBadge}" Background="#E60B1220" CornerRadius="6" Padding="6,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ElapsedBadge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Panel>
                            </StackPanel>
                        </Panel>

                        <TextBlock Text="{Binding DoneText}" IsVisible="{Binding ShowsDone}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />

                        <!-- Timers and alarms (this PC only): a line each, name and time left over a thin bar (alarms: when, 12-hour). -->
                        <ItemsControl ItemsSource="{Binding Timers.Lines}" IsVisible="{Binding ShowsTimers}"
                                      Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverlayTimerLine">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                            <mi:MaterialIcon Kind="{Binding Icon}" Width="11" Height="11" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="#E6FFFFFF" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#E6FFFFFF" FontSize="10"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <Panel Height="3" IsVisible="{Binding IsTimer}">
                                            <Border Background="#40FFFFFF" CornerRadius="1.5" />
                                            <Border Background="{Binding BarBrush}" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Width" Duration="0:0:1" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </Panel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Only while Ctrl+Alt is held. It opens away from the bar's zone of the screen (above the bar in the bottom third), so
                         the bar stays where the window's spot is measured from, and it hugs the same edge as the bar (the right edge in the
                         right third, otherwise the left). Its rows fill its width: at least the bar's length, at most 360, so long names wrap. -->
                    <StackPanel Grid.Row="{Binding DetailsRow}" Margin="{Binding DetailsMargin}" Spacing="8" IsVisible="{Binding ShowsDetails}"
                                HorizontalAlignment="{Binding MainAlignment}" MinWidth="200" MaxWidth="360">
                        <TextBlock Text="{Binding Day.SummaryText}" IsVisible="{Binding ShowsTimeline}"
                                   Foreground="#CCFFFFFF" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GoalText}" IsVisible="{Binding GoalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#CCFFFFFF" FontSize="11" TextWrapping="Wrap" />
                        <Panel IsVisible="{Binding ShowsTimer}">
                            <Panel DataContext="{Binding Timer}" x:DataType="vm:SessionOverlayViewModel">
                                <StackPanel Spacing="1" IsVisible="{Binding ShowsDetails}">
                                    <TextBlock Text="{Binding DetailTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailTimes}" Foreground="#CCFFFFFF" FontSize="11" />
                                    <TextBlock Text="{Binding DetailProgress}" Foreground="#CCFFFFFF" FontSize="11"
                                               IsVisible="{Binding DetailProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                        <!-- Timers: pause or resume, a minute more, and stop (or dismiss once it's up). -->
                        <ItemsControl ItemsSource="{Binding Timers.Lines}" IsVisible="{Binding ShowsTimers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverlayTimerLine">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" IsVisible="{Binding IsTimer}">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding PauseResumeCommand}" views:OverlayHint.Text="{Binding PauseTip}"
                                                Padding="6,2" Foreground="White" Background="#33FFFFFF" CornerRadius="5">
                                            <mi:MaterialIcon Kind="{Binding PauseIcon}" Width="12" Height="12" />
                                        </Button>
                                        <Button Grid.Column="2" Content="+1" Command="{Binding AddMinuteCommand}" views:OverlayHint.Text="A minute more"
                                                Padding="6,1" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                                        <Button Grid.Column="3" Command="{Binding StopCommand}" views:OverlayHint.Text="{Binding StopTip}"
                                                Padding="6,2" Foreground="White" Background="#33FFFFFF" CornerRadius="5">
                                            <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Guided sessions: tick tasks here while Ctrl+Alt is held; done ones collapsed; end at once when all are done. -->
                        <Panel IsVisible="{Binding ShowsTasks}">
                            <views:ChecklistView DataContext="{Binding Checklist}" />
                        </Panel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <TextBlock Text="{Binding AppDropText}" IsVisible="{Binding ShowsAppDrop}" Foreground="#CCFFFFFF" FontSize="10"
                                       TextWrapping="Wrap" />
                        </Panel>
                        <!-- After a drag: only for now, until Keep. -->
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsTemporary}">
                            <TextBlock Text="Moved for now" Foreground="#CCFFFFFF" FontSize="10" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding KeepText}" Click="OnKeepClick" Padding="8,2" FontSize="11" Foreground="White"
                                        Background="#4D0F766E" CornerRadius="5" />
                                <Button Content="↺" Click="OnUndoMoveClick" views:OverlayHint.Text="Put it back" Padding="8,2" FontSize="11"
                                        Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                            </StackPanel>
                        </StackPanel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <Button Content="{Binding UseDefaultText}" Command="{Binding UseDefaultForAppCommand}" IsVisible="{Binding ShowsUseDefaultForApp}"
                                    views:OverlayHint.Text="Forget this app's own spot" Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF"
                                    CornerRadius="5" HorizontalAlignment="Left" />
                        </Panel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <Button Content="Back to default spot" Command="{Binding BackToDefaultSpotCommand}" IsVisible="{Binding ShowsBackToSpot}"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" HorizontalAlignment="Left" />
                        </Panel>
                        <!-- Sleep mode: tonight's wake time, which − and + change for this one night (the plan stays). -->
                        <Panel IsVisible="{Binding ShowsDetails}">
                          <Panel IsVisible="{Binding Wake.IsShown, FallbackValue=False}">
                            <StackPanel DataContext="{Binding Wake}" x:DataType="vm:TonightWakeViewModel" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <TextBlock Text="{Binding WakeText}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="−" Command="{Binding EarlierCommand}" views:OverlayHint.Text="15 minutes earlier, tonight only"
                                            Padding="8,1" FontSize="12" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                                    <Button Grid.Column="2" Content="+" Command="{Binding LaterCommand}" views:OverlayHint.Text="15 minutes later, tonight only"
                                            Padding="8,1" FontSize="12" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                                </Grid>
                                <Button Content="{Binding PlanWakeText}" Command="{Binding BackToPlanCommand}" IsVisible="{Binding IsChanged}"
                                        Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" HorizontalAlignment="Left" />
                            </StackPanel>
                          </Panel>
                        </Panel>
                        <!-- The noise player: play/pause whether or not it's playing, the headphone lock, and its own volume;
                             "Connect headphones" under it for a moment after Play while locked without them. -->
                        <Panel IsVisible="{Binding ShowsDetails}">
                          <Panel IsVisible="{Binding Noise, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel DataContext="{Binding Noise}" x:DataType="vm:NoisePlayerViewModel" Spacing="2">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                <Button Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" views:OverlayHint.Text="{Binding PlayTip}"
                                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Padding="8,4" Foreground="White"
                                        Background="#33FFFFFF" CornerRadius="5" />
                                <Button Grid.Column="1" Command="{Binding ToggleLockCommand}" views:OverlayHint.Text="{Binding LockTip}"
                                        Padding="6,4" Foreground="White" Background="#33FFFFFF" CornerRadius="5">
                                    <mi:MaterialIcon Kind="{Binding LockIcon}" Width="14" Height="14" />
                                </Button>
                                <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="0,-10" views:OverlayHint.Text="Noise volume" />
                                <TextBlock Grid.Column="3" Text="{Binding VolumeText}" Foreground="#CCFFFFFF" FontSize="10" MinWidth="28"
                                           VerticalAlignment="Center" TextAlignment="Right" />
                              </Grid>
                              <TextBlock Text="{Binding TrackText}" IsVisible="{Binding HasNotice}" Foreground="#FBBF24" FontSize="11" />
                            </StackPanel>
                          </Panel>
                        </Panel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <Button Content="I'm ready" Command="{Binding ReadyCommand}" IsVisible="{Binding ShowsReady}"
                                    views:OverlayHint.Text="End the planning minutes now"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#4D0F766E" CornerRadius="5" HorizontalAlignment="Left" />
                        </Panel>
                        <!-- Step away: pauses the countdown until any key or mouse movement. -->
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <Button Content="{Binding StepAwayText}" Command="{Binding StepAwayCommand}" IsVisible="{Binding ShowsStepAway}"
                                    views:OverlayHint.Text="Pauses the countdown; any key or mouse movement brings you back"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#4D0F766E" CornerRadius="5" HorizontalAlignment="Left" />
                        </Panel>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsDetails}">
                            <TextBlock Text="Drag to move" Foreground="#99FFFFFF" FontSize="10" VerticalAlignment="Center" />
                            <!-- Only reachable while Ctrl+Alt is held (otherwise clicks pass through the window). -->
                            <!-- Today's sync QR codes for the phone (ADR 22), while the QR code method is on. -->
                            <Button Grid.Column="1" Content="QR" Command="{Binding ShowSyncQrCommand}" IsVisible="{Binding ShowsQrButton}"
                                    views:OverlayHint.Text="Show today's QR codes for your phone to scan"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                            <!-- Also Ctrl+Alt + double-click on an empty spot of the window. -->
                            <Button Grid.Column="2" Content="Open AccountabiliBuddy" Command="{Binding OpenAppCommand}"
                                    views:OverlayHint.Text="Or Ctrl+Alt + double-click the timer or timeline"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                            <Button Grid.Column="3" Content="{Binding HideButtonText}" Command="{Binding HideBrieflyCommand}"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Glows white when time is up. -->
            <Border Margin="2" CornerRadius="10" Background="White" IsHitTestVisible="False" Opacity="{Binding GlowOpacity}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.9" Easing="SineEaseInOut" />
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- Soft brighten when a mark is passed. -->
            <Border Margin="2" CornerRadius="10" Background="White" IsHitTestVisible="False" Opacity="{Binding Timer.PulseOpacity}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                    </Transitions>
                </Border.Transitions>
            </Border>
        </Panel>
    </LayoutTransformControl>
</Window>
