<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        x:Class="AccountabiliBuddy.App.Views.SessionOverlayWindow"
        x:DataType="vm:OnScreenOverlayViewModel"
        Title="AccountabiliBuddy timer"
        WindowDecorations="None" CanResize="False" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" RequestedThemeVariant="Dark"
        TransparencyLevelHint="Transparent" Background="Transparent">
    <!-- Click-through except while Ctrl+Alt is held; then it can be dragged (see code-behind). -->
    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </LayoutTransformControl.LayoutTransform>
        <Panel Opacity="{Binding Fade}">
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
            </Panel.Transitions>
            <Border Margin="2" CornerRadius="10" Padding="10,7" Background="#FF15191E"
                    BorderBrush="{Binding OutlineBrush}" BorderThickness="1.5" Opacity="{Binding PanelOpacity}">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="{Binding MainAlignment}">
                        <!-- Guided sessions: the task now and how far along ("▸ Write intro · 2/5"). -->
                        <TextBlock Text="{Binding TaskLine}" IsVisible="{Binding ShowsTasks}" Foreground="#E6FFFFFF" FontSize="11"
                                   Width="{x:Static vm:SessionOverlayViewModel.BarLength}" TextTrimming="CharacterEllipsis" />
                        <!-- Sleep mode, in the evening: sleep left if you go to bed now. -->
                        <TextBlock Text="{Binding Day.SleepText}" IsVisible="{Binding ShowsSleep}" Foreground="{Binding Day.SleepBrush}"
                                   Width="{x:Static vm:SessionOverlayViewModel.BarLength}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- All-day timeline: a small copy of the day bar, with the next block under it. -->
                        <StackPanel Spacing="2" IsVisible="{Binding ShowsTimeline}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                            <controls:DayBarControl Layout="{Binding Day.Layout}" Compact="True" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Day.StatusText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Foreground="#CCFFFFFF" FontSize="10" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" IsVisible="{Binding ShowsTimelineTime}" Margin="6,0,0,0"
                                           Foreground="White" FontSize="10" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>

                        <Panel IsVisible="{Binding ShowsTimer}">
                            <StackPanel Spacing="6" DataContext="{Binding Timer}" x:DataType="vm:SessionOverlayViewModel">
                                <Panel HorizontalAlignment="Center">
                                    <StackPanel Spacing="4" IsVisible="{Binding !IsRing}" MaxWidth="{x:Static vm:SessionOverlayViewModel.BarLength}">
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowsHeader}">
                                            <TextBlock Text="{Binding HeaderLabel}" TextTrimming="CharacterEllipsis"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding HeaderTime}" Margin="6,0,0,0"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Text="{Binding BigTimeText}" IsVisible="{Binding ShowsBigTime}"
                                                   Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                        <Panel IsVisible="{Binding ShowsBar}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}" Height="6">
                                            <Border Background="#40FFFFFF" CornerRadius="3" />
                                            <!-- Glides over the second between updates instead of stepping. -->
                                            <Border Background="{Binding AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Width" Duration="0:0:1" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                            <controls:TimerMarks Divisions="{Binding Divisions}" />
                                        </Panel>
                                        <TextBlock Text="{Binding EndText}" IsVisible="{Binding ShowsEndText}"
                                                   Foreground="#CCFFFFFF" FontSize="10" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Panel IsVisible="{Binding IsRing}" Width="68" Height="68">
                                        <Ellipse Stroke="#40FFFFFF" StrokeThickness="6" Margin="3" />
                                        <Arc Stroke="{Binding AccentBrush}" StrokeThickness="6" Margin="3"
                                             StartAngle="-90" SweepAngle="{Binding RingSweep}" StrokeLineCap="Round">
                                            <Arc.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="SweepAngle" Duration="0:0:1" />
                                                </Transitions>
                                            </Arc.Transitions>
                                        </Arc>
                                        <controls:TimerMarks Divisions="{Binding Divisions}" IsRing="True" RingStroke="6" RingInset="3" />
                                        <TextBlock Text="{Binding RingText}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>

                                    <!-- Count-up: every half hour the time in shows in the middle for a few seconds (with the glow).
                                         Small enough to fit over the bar without changing the window's size. -->
                                    <Border IsVisible="{Binding ShowsElapsedBadge}" Background="#E60B1220" CornerRadius="6" Padding="6,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ElapsedBadge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Panel>
                            </StackPanel>
                        </Panel>

                        <TextBlock Text="{Binding DoneText}" IsVisible="{Binding ShowsDone}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                    </StackPanel>
                    <!-- Only while Ctrl+Alt is held. It opens toward the middle of the screen (above the bar in the lower half), so
                         the bar itself never moves and stays where the window's spot is measured from. -->
                    <StackPanel Grid.Row="{Binding DetailsRow}" Margin="{Binding DetailsMargin}" Spacing="8" IsVisible="{Binding ShowsDetails}">
                        <TextBlock Text="{Binding Day.SummaryText}" IsVisible="{Binding ShowsTimeline}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}"
                                   Foreground="#CCFFFFFF" FontSize="11" TextWrapping="Wrap" />
                        <Panel IsVisible="{Binding ShowsTimer}">
                            <Panel DataContext="{Binding Timer}" x:DataType="vm:SessionOverlayViewModel">
                                <StackPanel Spacing="1" IsVisible="{Binding ShowsDetails}" MaxWidth="{x:Static vm:SessionOverlayViewModel.BarLength}">
                                    <TextBlock Text="{Binding DetailTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailTimes}" Foreground="#CCFFFFFF" FontSize="11" />
                                    <TextBlock Text="{Binding DetailProgress}" Foreground="#CCFFFFFF" FontSize="11"
                                               IsVisible="{Binding DetailProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                        <!-- Guided sessions: tick tasks here while Ctrl+Alt is held; done ones collapsed; end at once when all are done. -->
                        <Panel IsVisible="{Binding ShowsTasks}">
                            <views:ChecklistView DataContext="{Binding Checklist}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}" />
                        </Panel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <TextBlock Text="{Binding AppDropText}" IsVisible="{Binding ShowsAppDrop}" Foreground="#CCFFFFFF" FontSize="10"
                                       TextWrapping="Wrap" Width="{x:Static vm:SessionOverlayViewModel.BarLength}" />
                        </Panel>
                        <!-- After a drag: only for now, until Keep. -->
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsTemporary}" Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                            <TextBlock Text="Moved for now" Foreground="#CCFFFFFF" FontSize="10" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding KeepText}" Click="OnKeepClick" Padding="8,2" FontSize="11" Foreground="White"
                                        Background="#4D0F766E" CornerRadius="5" />
                                <Button Content="↺" Click="OnUndoMoveClick" ToolTip.Tip="Put it back" Padding="8,2" FontSize="11"
                                        Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                            </StackPanel>
                        </StackPanel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <Button Content="{Binding UseDefaultText}" Command="{Binding UseDefaultForAppCommand}" IsVisible="{Binding ShowsUseDefaultForApp}"
                                    ToolTip.Tip="Forget this app's own spot" Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF"
                                    CornerRadius="5" HorizontalAlignment="Left" />
                        </Panel>
                        <Panel IsVisible="{Binding ShowsDetails}">
                            <Button Content="Back to default spot" Command="{Binding BackToDefaultSpotCommand}" IsVisible="{Binding ShowsBackToSpot}"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" HorizontalAlignment="Left" />
                        </Panel>
                        <!-- Sleep mode: tonight's wake time, which − and + change for this one night (the plan stays). -->
                        <Panel IsVisible="{Binding ShowsDetails}">
                          <Panel IsVisible="{Binding Wake.IsShown, FallbackValue=False}">
                            <StackPanel DataContext="{Binding Wake}" x:DataType="vm:TonightWakeViewModel" Spacing="4"
                                        Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <TextBlock Text="{Binding WakeText}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="−" Command="{Binding EarlierCommand}" ToolTip.Tip="15 minutes earlier, tonight only"
                                            Padding="8,1" FontSize="12" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                                    <Button Grid.Column="2" Content="+" Command="{Binding LaterCommand}" ToolTip.Tip="15 minutes later, tonight only"
                                            Padding="8,1" FontSize="12" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                                </Grid>
                                <Button Content="{Binding PlanWakeText}" Command="{Binding BackToPlanCommand}" IsVisible="{Binding IsChanged}"
                                        Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" HorizontalAlignment="Left" />
                            </StackPanel>
                          </Panel>
                        </Panel>
                        <!-- The noise player: play/pause whether or not it's playing, and its own volume. -->
                        <Panel IsVisible="{Binding ShowsDetails}">
                          <Panel IsVisible="{Binding Noise, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid DataContext="{Binding Noise}" x:DataType="vm:NoisePlayerViewModel" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                                  Width="{x:Static vm:SessionOverlayViewModel.BarLength}">
                                <Button Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{Binding PlayTip}"
                                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Padding="8,4" Foreground="White"
                                        Background="#33FFFFFF" CornerRadius="5" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="0,-10" ToolTip.Tip="Noise volume" />
                                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Foreground="#CCFFFFFF" FontSize="10" MinWidth="28"
                                           VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                          </Panel>
                        </Panel>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsDetails}">
                            <TextBlock Text="Drag to move" Foreground="#99FFFFFF" FontSize="10" VerticalAlignment="Center" />
                            <!-- Only reachable while Ctrl+Alt is held (otherwise clicks pass through the window). -->
                            <!-- Today's sync QR codes for the phone (ADR 22), while the QR code method is on. -->
                            <Button Grid.Column="1" Content="QR" Command="{Binding ShowSyncQrCommand}" IsVisible="{Binding ShowsQrButton}"
                                    ToolTip.Tip="Show today's QR codes for your phone to scan"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                            <!-- Also Ctrl+Alt + double-click on an empty spot of the window. -->
                            <Button Grid.Column="2" Content="Open AccountabiliBuddy" Command="{Binding OpenAppCommand}"
                                    ToolTip.Tip="Or Ctrl+Alt + double-click the timer or timeline"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                            <Button Grid.Column="3" Content="{Binding HideButtonText}" Command="{Binding HideBrieflyCommand}"
                                    Padding="8,2" FontSize="11" Foreground="White" Background="#33FFFFFF" CornerRadius="5" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Glows white when time is up. -->
            <Border Margin="2" CornerRadius="10" Background="White" IsHitTestVisible="False" Opacity="{Binding GlowOpacity}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.9" Easing="SineEaseInOut" />
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- Soft brighten when a mark is passed. -->
            <Border Margin="2" CornerRadius="10" Background="White" IsHitTestVisible="False" Opacity="{Binding Timer.PulseOpacity}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                    </Transitions>
                </Border.Transitions>
            </Border>
        </Panel>
    </LayoutTransformControl>
</Window>
