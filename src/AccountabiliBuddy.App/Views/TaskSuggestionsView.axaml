<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="AccountabiliBuddy.App.Views.TaskSuggestionsView"
             x:DataType="vm:ListPickerViewModel"
             IsVisible="{Binding HasSuggestions}">
    <!-- Tasks matching what is typed in the box above (controls:TaskSuggestions). In the page's own layout, not a popup, so the keyboard stays
         in the box and a window that closes when it loses focus (the quick session) stays open. The buttons act on press, before focus can move. -->
    <UserControl.Styles>
        <Style Selector="Button.suggestion">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
        </Style>
        <Style Selector="Button.suggestion.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
    </UserControl.Styles>
    <Border BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="2">
        <ItemsControl ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ListPickRowViewModel">
                    <!-- Tasks redesign 10.26: the Tasks rows' look: the title over a ↳ sub-line (the label's dot and name, then the list and
                         its detail). -->
                    <Button Classes="suggestion" Classes.selected="{Binding IsSelected}" Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="2,0,0,0">
                                <mi:MaterialIcon Kind="SubdirectoryArrowRight" Width="12" Height="12" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" IsVisible="{Binding HasCategory}" />
                                <TextBlock Text="{Binding CategoryName}" FontSize="12" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCategory}" />
                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" IsVisible="{Binding HasCategory}" />
                                <TextBlock Text="{Binding SuggestionDetail}" FontSize="12" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
