<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TasksView"
             x:DataType="vm:TasksViewModel">
    <!-- The Tasks page (spec 03 §B; round 2 R3; Tasks redesign item 4a, boards 01 / 09 / 23). One card: the page header in one line
         ("Tasks · Tuesday · Nov 24", the search with its filter button, Group by Bins | Labels | None, Views, Expand / collapse all,
         History until item 6, Options), the add row (the add box and the Today drop pill: a drop target into Today › Queued, Open
         Today), the one notice slot (Hold to reset, the session ended strip, the naming row, notices, the view fallback note, the weekly
         tidy-up…), the label row, then the Shelf's columns (ShelfView: each scrolling on its own; the page never scrolls), and the
         Archive row at the bottom. During a session (Hide the Shelf on) the columns hide behind "Show the Shelf" (Ctrl+\) with a quiet
         count; adding, searching and the pill still work. Menus and pop-ups float over the page: nothing above the bottom row moves when
         they open. Right of the card: the detail card of the task the user opened. Cards take the theme's Tasks radius. -->
    <UserControl.Resources>
        <!-- Check boxes, expanders and switches read in ink, not accent. -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource Ab.InkColor}" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.tasksCard">
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.TasksRadius}" />
        </Style>
        <!-- A pill: category filter and estimate choice. Selected = Ink on Surface2 (the pill is Ink, its text Bg). -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.chip.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Bg}" />
        </Style>
        <!-- A smaller pill, for the filter flyout. -->
        <Style Selector="Button.chip.small">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Bg}" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>

        <!-- The Archive row at the bottom of the page (4c.61): one full-width button, radius 10, padding 0 12, Muted. -->
        <Style Selector="Button.archiveRow">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.archiveRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.archiveRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>

        <!-- Normal / Compact: two halves of one pill; the one in use is Surface2. -->
        <Style Selector="Button.segment">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.segment /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.segment.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <!-- A narrow page: Hold to reset keeps its icon only. -->
        <ContainerQuery Name="TasksPage" Query="max-width:620">
            <Style Selector="TextBlock.segmentText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>

        <!-- The Today drop pill (4a.40-4a.44; was the round 2 Today strip): 44 high, a 1 px dashed Line3 outline, no fill; lit (accent)
             while a row is dragged, stronger over it. 320 wide right of the add box; under it, full width, when the row is narrower than
             750 (the card narrower than 794). Set by style, not in place, so the container query can move it. -->
        <Style Selector="Border.todayStrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.todayPill">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Width" Value="320" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <ContainerQuery Name="TasksPage" Query="max-width:793">
            <Style Selector="Border.todayPill">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
        </ContainerQuery>
        <Style Selector="Border.todayStrip.lit">
            <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
        </Style>
        <Style Selector="Rectangle.stripLine">
            <Setter Property="Stroke" Value="{DynamicResource Ab.Line3}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="4,3" />
            <Setter Property="RadiusX" Value="22" />
            <Setter Property="RadiusY" Value="22" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Rectangle.stripLine.lit">
            <Setter Property="Stroke" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <Style Selector="Rectangle.stripLine.hot">
            <Setter Property="Stroke" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="" />
        </Style>
        <Style Selector="Button.stripOpen">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.stripOpen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <Style Selector="Button.stripOpen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Accent}" />
        </Style>

        <!-- The header (4a.08-4a.19). Search filters: 28 round, Tune 15, faded until used. -->
        <Style Selector="Button.searchFilters">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.searchFilters /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.searchFilters:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <!-- Group by: a 32 high pill track with a 1 px Line border, padding 2; each choice 26 high, icon 14 + 12.5 px text; the one in
             force on a Line fill in Ink, semibold; the others Muted; fill and colour change over 0.2 s. -->
        <Style Selector="Border.groupToggle">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="RadioButton.groupChoice">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.groupChoice:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="RadioButton.groupChoice:checked">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Views, Expand / collapse all, History: 36 square, radius 10, no border, an 18 px icon in Muted; Options: the same size, its
             1 px Line border and Ink icon from Button.abOptions. -->
        <Style Selector="Button.abHeaderIcon.tasksIcon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.abHeaderIcon.tasksIcon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.abHeaderIcon.tasksIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.abHeaderIcon.tasksIcon.viewOn">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.abHeaderIcon.tasksIcon.viewOn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="controls|PageHeader#TasksHeader Button.abOptions">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- The label row (Tasks redesign 4b.01-4b.19, boards 01-03): chips 30 high, radius 999, 13 px. The button is only a frame (no
             fill of its own, the app's focus ring); its Border.chipFace draws the chip. At rest a label's text is Muted and its dot at 50%;
             the row lights as one (hover, keyboard focus, the +N menu open, Fade off: class "lit"); a picked label stays lit in its own
             colour at 17% with a full-colour border. Colours and fills fade over 0.28 s (opacity: the idleFade classes, Themes/AbStyles). -->
        <Style Selector=":is(Button).rowChip">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).rowChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.chipFace">
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.28" Easing="SineEaseInOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.28" Easing="SineEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.allChip.picked Border.chipFace">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.moreChip Border.chipFace">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="ToggleButton.labelChip:checked Border.chipFace" x:DataType="vm:LabelFilterChipViewModel">
            <Setter Property="Background" Value="{Binding Tint}" />
            <Setter Property="BorderBrush" Value="{Binding Dot}" />
        </Style>
        <Style Selector="TextBlock.chipText">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.28" Easing="SineEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.chipDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="SineEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.labelRow:pointerover TextBlock.chipText, Grid.labelRow:focus-within TextBlock.chipText, Grid.labelRow.lit TextBlock.chipText, ToggleButton.labelChip:checked TextBlock.chipText">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Grid.labelRow:pointerover Ellipse.chipDot, Grid.labelRow:focus-within Ellipse.chipDot, Grid.labelRow.lit Ellipse.chipDot, ToggleButton.labelChip:checked Ellipse.chipDot">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBox.searchEntry">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.searchEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.searchEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.searchEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Border.searchPill">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.searchPill:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        </Style>

        <!-- The hidden Shelf during a session: a dashed area with a quiet note, "Show the Shelf · Ctrl+\". -->
        <Style Selector="Rectangle.hiddenLine">
            <Setter Property="Stroke" Value="{DynamicResource Ab.Line}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="4,3" />
            <Setter Property="RadiusX" Value="12" />
            <Setter Property="RadiusY" Value="12" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.keyChip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The add row: a Surface2 pill whose entry has no box of its own. -->
        <Style Selector="TextBox.rowEntry">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.rowEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.rowEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.rowEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Border.addPill:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        </Style>

        <!-- The detail card's title: a TextBox that looks like the display text until it is clicked. -->
        <Style Selector="TextBox.titleEntry">
            <Setter Property="FontFamily" Value="{DynamicResource Ab.DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="LineHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
        </Style>
        <Style Selector="TextBox.titleEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.titleEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.titleEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <!-- The notes box: Surface2, no border of its own. -->
        <Style Selector="TextBox.noteEntry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="96" />
        </Style>
        <Style Selector="TextBox.noteEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.noteEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.noteEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <!-- The open task's chips (label, tags, + Tag, time limit, highlight): 28 high Surface2 pills, 12 text. -->
        <Style Selector="Button.openChip">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.openChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.openChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <Style Selector="Border.letterChip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.stepHandle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Grid.stepRow:pointerover Border.stepHandle">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Grid.stepRow.focused">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="TextBlock.focusedStep">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.syncProblem">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <Style Selector="TextBlock.stepDone">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>

        <Style Selector="Border.detailCard">
            <Setter Property="Width" Value="340" />
        </Style>
        <!-- The session ended strip (P4): accent tint 12 %, a 1 px accent line at 35 %; "Switch now" a Surface pill. -->
        <Style Selector="Border.endedStrip">
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PopoverRadius}" />
            <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.endedSwitch">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
        </Style>
        <Style Selector="Button.endedSave /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.endedSave:pointerover TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <!-- Only with Animations on (.motionOn on the main window); Off shows the change at once. -->
        <Style Selector=":is(Window).motionOn Button.resetHold">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.detailBody">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Page" ColumnDefinitions="*,Auto">
        <Border x:Name="TasksCard" Grid.Column="0" Classes="card tasksCard" Padding="0" ClipToBounds="True"
                Container.Name="TasksPage" Container.Sizing="Width">
            <!-- Tasks redesign (4a.01): the card's rows 22 px in from its sides, 18 px from its top, 12 px apart: the header, the add row,
                 the notice slot (no height while empty), the label row, the Shelf; the Archive row at the bottom. -->
            <DockPanel>
                <!-- The page header in one line at every width (4a.02-4a.21): "Tasks" · "Tuesday · Nov 24" · the search with its filter
                     button · Group by Bins | Labels | None · Views · Expand / collapse all · History (until item 6) · Options. The date
                     shortens first, then the search narrows (Controls/PageHeaderRow). Its icon buttons rest faint (idleFade). -->
                <controls:PageHeader x:Name="TasksHeader" DockPanel.Dock="Top" Margin="22,18,22,0" Title="Tasks" Date="{Binding TodayDateText}"
                                     FadesOptions="True" OptionsRequested="OnTasksOptionsRequested">
                    <controls:PageHeader.Search>
                        <!-- Search (titles, steps, notes, tags, or a number like 142b; Esc clears) and, at its right edge, Search filters. -->
                        <Border Classes="searchPill" Height="36" Padding="12,0,3,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="searchEntry" Text="{Binding Shelf.SearchText}" PlaceholderText="Search · @label #tag" KeyDown="OnSearchKeyDown"
                                         AutomationProperties.Name="Search tasks">
                                    <TextBox.InnerRightContent><controls:ClearTextButton /></TextBox.InnerRightContent>
                                </TextBox>
                                <!-- Opens the Search filters panel (item 7); until then it does nothing. -->
                                <Button x:Name="SearchFiltersButton" Grid.Column="2" Classes="searchFilters idleFade" ToolTip.Tip="Search filters"
                                        AutomationProperties.Name="Search filters">
                                    <mi:MaterialIcon Kind="Tune" Width="15" Height="15" />
                                </Button>
                            </Grid>
                        </Border>
                    </controls:PageHeader.Search>
                    <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- Group by (4a.11-4a.16): the open view's working copy; a view stored as "tag" shows Bins and keeps its value. -->
                    <Border Classes="groupToggle" IsVisible="{Binding Shelf.HasViews}" ToolTip.Tip="Group by" AutomationProperties.Name="Group by">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GroupBinsChoice" Classes="groupChoice" GroupName="TasksGroupBy" IsChecked="{Binding Shelf.IsGroupedByBins, Mode=OneWay}"
                                         Command="{Binding Shelf.PickGroupCommand}" CommandParameter="bins" AutomationProperties.Name="Bins">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="ViewColumnOutline" Width="14" Height="14" />
                                    <TextBlock Text="Bins" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="groupChoice" GroupName="TasksGroupBy" IsChecked="{Binding Shelf.IsGroupedByLabels, Mode=OneWay}"
                                         Command="{Binding Shelf.PickGroupCommand}" CommandParameter="label" AutomationProperties.Name="Labels">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="CircleSlice8" Width="14" Height="14" />
                                    <TextBlock Text="Labels" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="groupChoice" GroupName="TasksGroupBy" IsChecked="{Binding Shelf.IsGroupedByNone, Mode=OneWay}"
                                         Command="{Binding Shelf.PickGroupCommand}" CommandParameter="none" AutomationProperties.Name="None">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="FormatListBulleted" Width="14" Height="14" />
                                    <TextBlock Text="None" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- A view other than the default in use: the button widens into a tinted pill with the view's name (lit, not faded);
                         back on the default, the plain bookmark. -->
                    <Button x:Name="ViewsButton" Classes="abHeaderIcon tasksIcon idleFade" Classes.viewOn="{Binding Shelf.HasCustomView}"
                            Classes.on="{Binding Shelf.HasCustomView}" Click="OnViewsClick"
                            IsVisible="{Binding Shelf.HasViews}" ToolTip.Tip="{Binding Shelf.ViewsButtonText}" AutomationProperties.Name="{Binding Shelf.ViewsButtonText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="BookmarkOutline" Width="18" Height="18" IsVisible="{Binding !Shelf.HasCustomView}" />
                            <mi:MaterialIcon Kind="Bookmark" Width="16" Height="16" IsVisible="{Binding Shelf.HasCustomView}" />
                            <TextBlock Text="{Binding Shelf.CustomViewName}" IsVisible="{Binding Shelf.HasCustomView}" MaxWidth="140"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Classes="abHeaderIcon tasksIcon idleFade" Command="{Binding Shelf.Panel.ToggleExpandCommand}" ToolTip.Tip="{Binding Shelf.Panel.ExpandTip}"
                            AutomationProperties.Name="{Binding Shelf.Panel.ExpandTip}">
                        <mi:MaterialIcon Kind="{Binding Shelf.Panel.ExpandIcon}" Width="18" Height="18" />
                    </Button>
                    <!-- History leaves with item 6 (the Archive sheet); until then it stays, faded like the others. -->
                    <Button x:Name="HistoryButton" Classes="abHeaderIcon tasksIcon idleFade" Click="OnHistoryClick" IsVisible="{Binding Shelf.HasHistory}"
                            ToolTip.Tip="History: finished and deleted tasks, 30 days" AutomationProperties.Name="History">
                        <mi:MaterialIcon Kind="History" Width="18" Height="18" />
                    </Button>
                    </StackPanel>
                    </StackPanel>
                    </controls:PageHeader.Actions>
                </controls:PageHeader>

                <!-- The add row (4a.35-4a.44): the add box fills the row; the Today drop pill sits to its right (320) and wraps under the box
                     when the row is narrower than 750 (the TasksPage container query). The add box's hint line and "@" / "#" list float
                     over what is below (ZIndex). -->
                <Grid x:Name="AddRow" DockPanel.Dock="Top" Margin="22,12,22,0" ZIndex="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <views:AddBoxView DataContext="{Binding AddBox}" VerticalAlignment="Top" />
                    <!-- The Today pill: what Today holds ("Nothing queued · drop a task here"), a drop target into Today › Queued (Undo in
                         the toast; never This session), Open Today. A click anywhere on it opens Today as well. -->
                    <Border x:Name="TodayStripBar" Classes="todayStrip todayPill" Classes.lit="{Binding TodayStrip.IsLit}"
                            PointerReleased="OnTodayStripReleased" ToolTip.Tip="{Binding TodayStrip.HintText}"
                            AutomationProperties.Name="Today: drop a task here to queue it for today, or open Today">
                        <Panel>
                            <Rectangle Classes="stripLine" Classes.lit="{Binding TodayStrip.IsLit}" Classes.hot="{Binding TodayStrip.IsHot}" />
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="14,0,6,0">
                                <mi:MaterialIcon Kind="CalendarToday" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Today" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding TodayStrip.StatusText}" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontFeatures="+tnum" />
                                <Button Grid.Column="3" Classes="stripOpen" Command="{Binding TodayStrip.OpenTodayCommand}" ToolTip.Tip="Show the Today tab"
                                        AutomationProperties.Name="Open Today">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="Open Today" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>

                <!-- The notice slot (4a.45-4a.52): every notice of the page, between the add row and the label row, in today's order; none
                     shows anywhere else. Empty, it takes no height; two at once stack (each 12 px below the one above). -->
                <StackPanel x:Name="NoticeSlot" DockPanel.Dock="Top" Margin="22,0,22,0">
                    <!-- Hold to reset (1.5 s): the session view back the way it started; shown while it changed. A click that isn't a hold
                         shows the hint; a narrow page keeps the icon only. -->
                    <Button x:Name="ResetButton" Margin="0,12,0,0" HorizontalAlignment="Left" Classes="quiet resetHold" Padding="0" MinHeight="0" MinWidth="0"
                            IsVisible="{Binding IsSessionViewChanged}" ToolTip.Tip="{x:Static vm:TasksViewModel.ResetHint}"
                            ToolTip.IsOpen="{Binding ShowsResetHint}" AutomationProperties.Name="Hold to reset the session view">
                        <Panel>
                            <Border x:Name="ResetFill" HorizontalAlignment="Left" Width="0" CornerRadius="999" Background="{DynamicResource Ab.Accent}"
                                    Opacity="0.22" IsHitTestVisible="False" />
                            <Border BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" CornerRadius="999" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                                    <TextBlock Classes="segmentText" Text="Hold to reset" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Panel>
                    </Button>

                    <!-- MIG1: after the task migration, the open tasks of the earlier version wait in To sort; never shown during a session. -->
                    <Border Margin="0,12,0,0" Padding="14,8,8,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ab.Line}"
                            DataContext="{Binding EarlierTasks}" x:DataType="vm:EarlierTasksCardViewModel" IsVisible="{Binding IsVisible, FallbackValue=False}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Sort them now" Command="{Binding SortThemNowCommand}" />
                            <Button Grid.Column="2" Classes="quiet" Width="30" Height="30" Padding="0" MinHeight="0" MinWidth="0" Command="{Binding DismissCommand}"
                                    AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss for good">
                                <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- "Session ended at 12:52 AM" (P4): Tasks switches to planning the next time it opens, or now; × closes it (a 15-second ring). -->
                    <Border Classes="endedStrip" Margin="0,12,0,0" Padding="14,10,8,10" IsVisible="{Binding ShowsEndedNotice}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <mi:MaterialIcon Classes="endedTarget" Kind="Target" Width="19" Height="19" Foreground="{DynamicResource Ab.Accent}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EndedTitle}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="Tasks switches to planning the next time you open it." FontSize="12" TextWrapping="Wrap" />
                                <Button Classes="link endedSave" Padding="0" MinHeight="0" HorizontalAlignment="Left" Command="{Binding SaveSessionViewCommand}"
                                        ToolTip.Tip="Create a view from what the Shelf shows now" AutomationProperties.Name="Save it as a view">
                                    <TextBlock Classes="faint" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                               Text="Want to keep this setup? Save it as a view now, before it resets." />
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="endedSwitch" Content="Switch now" Command="{Binding SwitchNowCommand}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="quiet" Width="30" Height="30" Padding="0" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                    Command="{Binding DismissEndedCommand}" AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss (it closes by itself)">
                                <Panel>
                                    <controls:ProgressRing Width="26" Height="26" Value="{Binding EndedCountdown}" Thickness="2" TrackBrush="Transparent"
                                                           ArcBrush="{DynamicResource Ab.Faint}" IsHitTestVisible="False" />
                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- A picker's "New category…": its name; Enter makes it and applies it. -->
                    <Border Margin="0,12,0,0" Padding="16,4,8,4" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                            IsVisible="{Binding IsNamingCategory}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="NewCategoryBox" Classes="rowEntry" FontSize="14" Text="{Binding NewCategoryName}" PlaceholderText="{Binding NamePrompt}"
                                     AutomationProperties.Name="New category name">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SaveNewCategoryCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelNewCategoryCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <CheckBox Grid.Column="1" Content="Only on this device" IsChecked="{Binding NewOnlyHere}" IsVisible="{Binding CanChooseScope}" FontSize="12"
                                      Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Shared on all your devices unless this is ticked"
                                      AutomationProperties.Name="Only on this device" />
                            <Button Grid.Column="2" Classes="quiet" Command="{Binding CancelNewCategoryCommand}" Padding="8,2" AutomationProperties.Name="Cancel new category"><mi:MaterialIcon Kind="Close" Width="14" Height="14" /></Button>
                        </Grid>
                    </Border>

                    <!-- Why something was not done. -->
                    <Border Margin="0,12,0,0" Padding="16,10,8,10" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                            IsVisible="{Binding HasNotice}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="muted" Text="{Binding Notice}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="quiet" Command="{Binding DismissNoticeCommand}" Padding="8,2" AutomationProperties.Name="Dismiss"><mi:MaterialIcon Kind="Close" Width="14" Height="14" /></Button>
                        </Grid>
                    </Border>

                    <!-- ADR 89: the view filters only by labels another device keeps to itself, so the page shows Default. -->
                    <Border Margin="0,12,0,0" Padding="16,10,16,10" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                            IsVisible="{Binding HasViewFallbackNote}">
                        <TextBlock Classes="muted" Text="{Binding ViewFallbackNote}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Border>

                    <!-- "Add to Today" at three tasks: nothing is added until this is answered. -->
                    <Border Margin="0,12,0,0" Padding="18,14" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                            IsVisible="{Binding HasPending}">
                        <ContentControl Content="{Binding Pending}">
                            <ContentControl.DataTemplates>
                                <DataTemplate x:DataType="vm:PendingMoveViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding TitleText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Reason}" PlaceholderText="Why? (10+ characters, stays on this PC)" AutomationProperties.Name="Why add it anyway" />
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Ab.Drift}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Add anyway" Command="{Binding AddAnywayCommand}" />
                                            <Button Classes="quiet" Content="Leave it where it is" Command="{Binding CancelCommand}" />
                                        </StackPanel>
                                        <StackPanel Spacing="2" IsVisible="{Binding CanSwap}">
                                            <TextBlock Classes="muted" Text="Or put it in place of one of today's tasks (that one goes to Come back to):" FontSize="13" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding SwapChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PendingMoveViewModel+SwapChoice">
                                                        <Button Classes="quiet" Command="{Binding SwapCommand}" HorizontalAlignment="Left" Padding="10,6">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Border>

                    <!-- Weekly tidy-up: on its day, never in a session; × = not this week. -->
                    <Border Margin="0,12,0,0" Padding="16,8,8,8" CornerRadius="{DynamicResource Ab.PanelRadius}" Background="{DynamicResource Ab.Surface2}"
                            IsVisible="{Binding Shelf.HasTidyCard}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <mi:MaterialIcon Kind="Broom" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Shelf.TidyTitle}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Shelf.TidySub}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="3" Content="Tidy up" Command="{Binding Shelf.StartTidyCommand}" Padding="12,5" VerticalAlignment="Center"
                                    ToolTip.Tip="Go through the untouched tasks one by one" AutomationProperties.Name="Tidy up" />
                            <Button Grid.Column="4" Classes="quiet" Padding="6" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Command="{Binding Shelf.DismissTidyCommand}"
                                    ToolTip.Tip="Not this week" AutomationProperties.Name="Not this week">
                                <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- The label row (Tasks redesign 4b; SPEC "Page layout" row 3; boards 01-03, 23): "All" · the labels in category order (the
                     +N menu's order) · +N. Only the whole chips that fit show (LabelChipRowPanel measures them); +N counts the rest plus No
                     label and opens the +N menu (LabelsMenuView, in the window's overlay layer). Several labels can be picked (the view's
                     working copy); "All" clears them. Idle, the row rests at 30% and lights as one; dimmed with the Shelf during a session. -->
                <Grid x:Name="LabelRow" DockPanel.Dock="Top" Margin="22,12,22,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                      Classes="labelRow idleFadeHost" Classes.lit="{Binding Shelf.IsLabelRowLit}" IsVisible="{Binding Shelf.HasViews}">
                    <Grid.Opacity>
                        <Binding Path="IsShelfShown" Converter="{x:Static views:TasksView.ShownOpacity}" />
                    </Grid.Opacity>
                    <Button Classes="rowChip allChip idleFade fadeChip" Classes.picked="{Binding Shelf.IsAllPicked}" Command="{Binding Shelf.PickAllLabelsCommand}"
                            IsHitTestVisible="{Binding IsShelfShown}" ToolTip.Tip="Every label" AutomationProperties.Name="All labels">
                        <Border Classes="chipFace" Padding="14,0">
                            <TextBlock Text="All" Foreground="{DynamicResource Ab.Ink}" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Shelf.RowChips}" IsHitTestVisible="{Binding IsShelfShown}" AutomationProperties.Name="Labels">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:LabelChipRowPanel Spacing="6" FitCount="{Binding Shelf.ChipsInRow, Mode=OneWayToSource}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LabelFilterChipViewModel">
                                <ToggleButton Classes="rowChip labelChip idleFade fadeLabel" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding PickCommand}"
                                              KeyboardNavigation.IsTabStop="{Binding InRow}" AutomationProperties.Name="{Binding Name}">
                                    <Border Classes="chipFace" Padding="12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Classes="chipDot" Fill="{Binding Dot}" />
                                            <TextBlock Classes="chipText" Text="{Binding Name}" />
                                        </StackPanel>
                                    </Border>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MoreLabelsButton" Grid.Column="2" Classes="rowChip moreChip idleFade fadeChip" Classes.on="{Binding Shelf.HasPickBehindMore}"
                            Click="OnMoreLabelsClick" IsHitTestVisible="{Binding IsShelfShown}" ToolTip.Tip="Every label: pick, reorder, add"
                            AutomationProperties.Name="More labels and reorder">
                        <Border Classes="chipFace" Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Shelf.MoreText}" FontWeight="SemiBold" Foreground="{DynamicResource Ab.Ink}" VerticalAlignment="Center" />
                                <mi:MaterialIcon Kind="ChevronDown" Width="13" Height="13" Foreground="{DynamicResource Ab.Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- The +N menu: 8 under the row, right-aligned with it; no page dim; a click outside or Esc closes it. -->
                    <Popup x:Name="LabelsMenuPopup" Grid.Column="2" PlacementTarget="{Binding #LabelRow}" Placement="BottomEdgeAlignedRight" VerticalOffset="8"
                           ShouldUseOverlayLayer="True" IsLightDismissEnabled="True" IsOpen="{Binding Shelf.IsLabelsMenuOpen, Mode=TwoWay}"
                           Opened="OnLabelsMenuOpened" Closed="OnLabelsMenuClosed">
                        <views:LabelsMenuView x:Name="LabelsMenu" DataContext="{Binding Shelf}" />
                    </Popup>
                </Grid>

                <!-- The bottom row (Tasks redesign 4c.59-4c.62): 44 px at the card's foot, 10 px wider than the content on each side. It is a
                     slot: it shows exactly one of the Archive row, the select bar (item 8a) or the drag bar (item 8b), all in this same place,
                     so swapping them moves nothing above. Today only the Archive row is built: it opens the Archive (the Notebook) in place
                     of the columns until the Archive sheet (item 6) replaces it; faint until used, lit while the Archive is open. -->
                <Panel x:Name="BottomRowSlot" DockPanel.Dock="Bottom" Height="44" Margin="12,12,12,2">
                    <Button x:Name="ArchiveRowButton" Classes="archiveRow idleFade" Classes.on="{Binding ShowsArchive}" Command="{Binding ToggleArchiveCommand}"
                            AutomationProperties.Name="Archive" ToolTip.Tip="{Binding Archive.TaskCountsText}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                            <mi:MaterialIcon Kind="ArchiveOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Archive" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Archive.TaskCountsText}" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <mi:MaterialIcon Grid.Column="3" Kind="ChevronUp" Width="18" Height="18" VerticalAlignment="Center" IsVisible="{Binding !ShowsArchive}" />
                            <mi:MaterialIcon Grid.Column="3" Kind="ChevronDown" Width="18" Height="18" VerticalAlignment="Center" IsVisible="{Binding ShowsArchive}" />
                        </Grid>
                    </Button>
                </Panel>

                <!-- The Shelf's columns; the hidden Shelf's note during a session; or the Archive. -->
                <Panel Margin="22,12,22,0">
                    <Panel>
                        <Panel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ShowsShelfColumns" />
                                <Binding Path="!ShowsArchive" />
                            </MultiBinding>
                        </Panel.IsVisible>
                        <views:ShelfView DataContext="{Binding Shelf}" />
                    </Panel>

                    <Panel>
                        <Panel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!ShowsShelfColumns" />
                                <Binding Path="!ShowsArchive" />
                            </MultiBinding>
                        </Panel.IsVisible>
                        <Rectangle Classes="hiddenLine" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
                            <mi:MaterialIcon Kind="Leaf" Width="24" Height="24" Foreground="{DynamicResource Ab.Muted}" HorizontalAlignment="Center" />
                            <TextBlock Text="The Shelf is hidden while you focus" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Classes="muted" Text="{Binding ShelfHiddenText}" FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="ShowShelfButton" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="12,6" Command="{Binding ToggleShelfCommand}"
                                    AutomationProperties.Name="Show the Shelf" ToolTip.Tip="Show the Shelf (Ctrl+\)">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Show the Shelf" FontSize="13.5" VerticalAlignment="Center" />
                                    <Border Classes="keyChip">
                                        <TextBlock Classes="muted" Text="Ctrl+\" FontSize="11" FontFamily="{DynamicResource Ab.NumeralFont}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="faint" Text="Hides again when you leave Tasks · Settings › Tasks › During a session" FontSize="12"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Panel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsArchive}">
                        <views:NotebookView DataContext="{Binding Archive}" Margin="0,0,0,12" />
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Border>

        <!-- The detail card for the selected task, Later item or come-back. -->
        <Border x:Name="DetailCard" Grid.Column="1" Classes="card detailCard" IsVisible="{Binding IsDetailOpen}" Margin="14,0,0,0" Padding="28,26">
            <Panel>
                <TextBlock Classes="muted" Text="Pick a task to see its steps, estimate and notes." TextWrapping="Wrap" FontSize="14"
                           IsVisible="{Binding !HasDetail}" />
                <ContentControl Content="{Binding Detail}" IsVisible="{Binding HasDetail}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="vm:TaskDetailViewModel">
                            <DockPanel LastChildFill="True">
                                <!-- The footer: the running bar or "Start with this", the quiet moves, and what was refused. -->
                                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                                    <TextBlock Classes="muted" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
                                    <Border IsVisible="{Binding ShowsRunningBar}" Background="{DynamicResource Ab.Surface2}" CornerRadius="26" Padding="16,14">
                                        <TextBlock Classes="muted" Text="{Binding RunningText}" FontSize="16" HorizontalAlignment="Center" />
                                    </Border>
                                    <Button Classes="primary pill" Content="Start with this" Command="{Binding StartWithThisCommand}" IsEnabled="{Binding CanStart}"
                                            IsVisible="{Binding ShowsStart}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="24,14" AutomationProperties.Name="Start with this" />
                                    <WrapPanel ItemSpacing="4" LineSpacing="4" HorizontalAlignment="Center">
                                        <Button Classes="quiet" Padding="14,8" Content="Add to Today" Command="{Binding AddToTodayCommand}"
                                                IsVisible="{Binding ShowsMoveToSession}" FontSize="15" AutomationProperties.Name="Add to Today"
                                                ToolTip.Tip="Put it on today's list (a done one comes back open, as a copy)" />
                                        <Button Classes="quiet" Padding="14,8" Content="Move to Later" Command="{Binding MoveToLaterCommand}" IsVisible="{Binding ShowsMoveToLater}"
                                                FontSize="15" />
                                        <Button Classes="quiet" Padding="14,8" Content="Put in plan" IsVisible="{Binding ShowsPlan}" FontSize="15"
                                                AutomationProperties.Name="Put in plan">
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedRight">
                                                    <ScrollViewer MaxHeight="360" Width="300">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Classes="section" Text="Put it in the plan for…" />
                                                            <TextBlock Classes="muted" Text="Nothing in the plan for the coming week." FontSize="13"
                                                                       IsVisible="{Binding !HasPlanDays}" />
                                                            <ItemsControl ItemsSource="{Binding PlanDays}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:PlanDayChoiceViewModel">
                                                                        <StackPanel Spacing="2" Margin="0,0,0,8">
                                                                            <TextBlock Classes="muted" Text="{Binding Label}" FontSize="13" />
                                                                            <ItemsControl ItemsSource="{Binding Parts}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:PlanPartChoiceViewModel">
                                                                                        <Button Classes="quiet" Command="{Binding PickCommand}" HorizontalAlignment="Stretch"
                                                                                                HorizontalContentAlignment="Left" Padding="10,6">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="{Binding Text}" FontSize="14" />
                                                                                                <mi:MaterialIcon Kind="Check" Width="14" Height="14" IsVisible="{Binding IsSelected}" />
                                                                                            </StackPanel>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Classes="quiet" Content="Not in the plan" Command="{Binding ClearPlanCommand}" IsVisible="{Binding HasPlan}"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" />
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Classes="quiet" Padding="14,8" Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding ShowsDelete}" FontSize="15"
                                                ToolTip.Tip="Delete it (it goes from your other devices too; Undo and Archive > Recently deleted bring it back)" />
                                    </WrapPanel>
                                    <!-- The sync line, the task's menu and its ID chip ("142", copies "142 · title"). -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding SyncText}"
                                                    IsVisible="{Binding !HasConflict}">
                                            <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Ab.Muted}" IsVisible="{Binding !IsSyncProblem}" />
                                            <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Ab.Drift}" IsVisible="{Binding IsSyncProblem}" />
                                            <TextBlock Classes="muted" Classes.syncProblem="{Binding IsSyncProblem}" Text="{Binding SyncText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Changed on both devices: the line opens the dialog. -->
                                        <Button Classes="quiet" Padding="4,2" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsVisible="{Binding HasConflict}" Command="{Binding OpenConflictCommand}"
                                                ToolTip.Tip="Pick the version to keep" AutomationProperties.Name="Changed on both devices: pick a version">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Drift}" />
                                                <TextBlock Classes="muted syncProblem" Text="{Binding SyncText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" TextDecorations="Underline" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="quiet" Padding="6,4" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                                AutomationProperties.Name="More actions" ToolTip.Tip="More (or right-click the row)" Click="OnMoreClick">
                                            <mi:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="openChip" IsVisible="{Binding HasNumber}" Click="OnCopyIdClick"
                                                ToolTip.Tip="Copy task ID" AutomationProperties.Name="Copy task ID">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding NumberText}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="11.5" VerticalAlignment="Center" />
                                                <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Classes="detailBody" Spacing="14">
                                        <TextBlock Classes="muted" Text="{Binding KindText}" FontSize="13" />
                                        <TextBox Classes="titleEntry" Name="DetailTitleBox" Text="{Binding Title}" IsReadOnly="{Binding !CanEditTitle}" AutomationProperties.Name="Title"
                                                 LostFocus="OnDetailTitleLostFocus">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding CommitTitleCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <!-- The chips row: label, tags, + Tag, time limit, highlight (the full menus are 3.5). -->
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Button Classes="openChip" IsVisible="{Binding CanLabel}" Click="OnLabelChipClick" ToolTip.Tip="Label"
                                                    AutomationProperties.Name="Label">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Panel Width="9" Height="9" VerticalAlignment="Center">
                                                        <Ellipse Fill="{Binding LabelBrush}" />
                                                        <Ellipse Stroke="{DynamicResource Ab.Faint}" StrokeThickness="1.5" />
                                                    </Panel>
                                                    <TextBlock Text="{Binding LabelName}" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding TagChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Classes="openChip" Content="{Binding}" Click="OnTagChipClick" ToolTip.Tip="Tags" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="openChip" IsVisible="{Binding CanTag}" Click="OnTagChipClick" ToolTip.Tip="Add a tag"
                                                    AutomationProperties.Name="Add a tag">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <mi:MaterialIcon Kind="Pound" Width="13" Height="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="+ Tag" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="openChip" IsVisible="{Binding ShowsEditableFields}" Click="OnTimeLimitChipClick" ToolTip.Tip="Time limit"
                                                    AutomationProperties.Name="Time limit">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <mi:MaterialIcon Kind="TimerOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TimeLimitText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="openChip" IsVisible="{Binding CanHighlight}" Command="{Binding ToggleHighlightCommand}"
                                                    ToolTip.Tip="{Binding HighlightTip}" AutomationProperties.Name="{Binding HighlightTip}">
                                                <mi:MaterialIcon Kind="{Binding HighlightIcon}" Width="15" Height="15" Foreground="{DynamicResource Ab.Accent}" />
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsComeBack}">
                                            <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Command="{Binding TickComeBackCommand}" MinWidth="0" Padding="0"
                                                      Content="Done" IsEnabled="{Binding CanEdit}" />
                                            <TextBlock Classes="muted" Text="{Binding ParkedText}" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding HasParkedText}" />
                                        </StackPanel>

                                        <!-- Steps. -->
                                        <StackPanel Spacing="2" IsVisible="{Binding ShowsFields}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StepsHead}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Classes="muted" Text="{Binding StepsSub}" FontSize="12" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TaskStepViewModel">
                                                        <StackPanel Spacing="2" Margin="0,1">
                                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource Ab.Accent}" IsVisible="{Binding ShowsLineAbove}" IsHitTestVisible="False" />
                                                            <Grid Classes="stepRow stepItem" Classes.focused="{Binding IsFocused}" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" KeyDown="OnStepKeyDown"
                                                                  Background="Transparent">
                                                                <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanEdit}"
                                                                          MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"
                                                                          ToolTip.Tip="Tick step" />
                                                                <Border Grid.Column="1" Classes="letterChip" IsVisible="{Binding HasLetter}" ToolTip.Tip="{Binding LetterTip}">
                                                                    <TextBlock Classes="muted" Text="{Binding Letter}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="11.5" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                           Classes.stepDone="{Binding IsDone}" Classes.focusedStep="{Binding IsFocused}"
                                                                           IsVisible="{Binding IsNotEditing}" />
                                                                <TextBox Grid.Column="2" Classes="rowEntry" Text="{Binding EditText}" IsVisible="{Binding IsEditing}" FontSize="14"
                                                                         PropertyChanged="OnInlineBoxPropertyChanged" AutomationProperties.Name="Step name">
                                                                    <TextBox.KeyBindings>
                                                                        <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
                                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                                    </TextBox.KeyBindings>
                                                                </TextBox>
                                                                <TextBlock Grid.Column="3" Classes="muted" Text="in focus" FontSize="11.5" VerticalAlignment="Center" IsVisible="{Binding IsFocused}" />
                                                                <Button Grid.Column="4" Classes="quiet" Padding="4" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                                                        IsVisible="{Binding CanFocus}" Command="{Binding FocusCommand}" ToolTip.Tip="Bring into focus"
                                                                        AutomationProperties.Name="Bring into focus">
                                                                    <mi:MaterialIcon Kind="Target" Width="15" Height="15" Foreground="{DynamicResource Ab.Faint}" />
                                                                </Button>
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" IsVisible="{Binding HasTime}">
                                                                    <mi:MaterialIcon Kind="TimerOutline" Width="13" Height="13" Foreground="{DynamicResource Ab.Muted}" />
                                                                    <TextBlock Classes="muted" Text="{Binding TimeText}" FontSize="12" />
                                                                </StackPanel>
                                                                <Button Grid.Column="6" Classes="quiet" Padding="6,2" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="More actions for this step" ToolTip.Tip="Rename, add a step after, delete" Click="OnMoreClick">
                                                                    <mi:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" />
                                                                </Button>
                                                                <Border Grid.Column="7" Classes="stepHandle" IsVisible="{Binding CanDrag}" ToolTip.Tip="Drag to reorder (Alt+↑/↓)"
                                                                        AutomationProperties.Name="Drag to reorder" PointerPressed="OnStepHandlePressed" PointerMoved="OnStepHandleMoved"
                                                                        PointerReleased="OnStepHandleReleased" PointerCaptureLost="OnStepHandleCaptureLost">
                                                                    <mi:MaterialIcon Kind="DragHorizontalVariant" Width="16" Height="16" VerticalAlignment="Center"
                                                                                     HorizontalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                                </Border>
                                                            </Grid>
                                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource Ab.Accent}" IsVisible="{Binding ShowsLineBelow}" IsHitTestVisible="False" />
                                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsAddingAfter}" Margin="30,0,0,0">
                                                                <mi:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBox Grid.Column="1" Classes="rowEntry" FontSize="15" Text="{Binding NewAfterText}" PlaceholderText="A step after this one"
                                                                         PropertyChanged="OnInlineBoxPropertyChanged" AutomationProperties.Name="New step after this one">
                                                                    <TextBox.KeyBindings>
                                                                        <KeyBinding Gesture="Enter" Command="{Binding SaveAddAfterCommand}" />
                                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelAddAfterCommand}" />
                                                                    </TextBox.KeyBindings>
                                                                </TextBox>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanAddStep}" Margin="4,2,0,0">
                                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1" Name="DetailStepBox" Classes="rowEntry" FontSize="15" Text="{Binding NewStepText}" PlaceholderText="Add a step"
                                                         AutomationProperties.Name="Add a step">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding AddStepCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                            </Grid>
                                        </StackPanel>

                                        <!-- A custom time limit (the time limit chip's "Custom…"). -->
                                        <StackPanel Spacing="8" IsVisible="{Binding ShowsEditableFields}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomEstimateOpen}">
                                                <TextBox Width="90" Text="{Binding CustomEstimateText}" PlaceholderText="minutes" AutomationProperties.Name="Estimate in minutes">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding ApplyCustomEstimateCommand}" />
                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelCustomEstimateCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Classes="quiet" Content="Set" Command="{Binding ApplyCustomEstimateCommand}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Later: when it is due. -->
                                        <StackPanel Spacing="8" IsVisible="{Binding IsLater}">
                                            <TextBlock Classes="muted" Text="Due" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CalendarDatePicker SelectedDate="{Binding DueDate}" AutomationProperties.Name="Due date" />
                                                <Button Classes="quiet" Content="Clear" Command="{Binding ClearDueCommand}" IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPlan}">
                                            <TextBlock Classes="muted" Text="{Binding PlanText}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Notes: private text, kept on blur or a moment after typing; sealed here and on your other devices. -->
                                        <StackPanel Spacing="8" IsVisible="{Binding ShowsFields}">
                                            <TextBlock Classes="muted" Text="Notes" FontSize="13" />
                                            <Border Background="{DynamicResource Ab.Surface2}" CornerRadius="16" Padding="12,8">
                                                <TextBox Classes="noteEntry" Text="{Binding Note}" IsReadOnly="{Binding !CanEdit}" PlaceholderText="Add a private note"
                                                         AutomationProperties.Name="Notes" LostFocus="OnDetailNoteLostFocus" />
                                            </Border>
                                        </StackPanel>

                                        <!-- The reminders line (a click opens Reminders & due date where the task list holds the task) and Effort (coming soon). -->
                                        <WrapPanel ItemSpacing="14" LineSpacing="6">
                                            <Button Classes="quiet" Padding="4,2" MinHeight="0" Margin="-4,0,0,0" IsEnabled="{Binding CanEditReminders}"
                                                    Click="OnRemindersClick" ToolTip.Tip="Reminders and the due date" AutomationProperties.Name="Reminders and due date">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <mi:MaterialIcon Kind="BellOutline" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" Classes.faint="{Binding !HasReminders}" Text="{Binding ReminderText}" FontSize="12.5"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.5" ToolTip.Tip="Effort is coming soon">
                                                <mi:MaterialIcon Kind="WeightLifter" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                                <TextBlock Classes="muted" Text="Effort · soon" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
                <!-- The card shows only for a task the user opened: this (or Esc) closes it. -->
                <Button Classes="quiet closeDetail" Padding="6" MinHeight="0" MinWidth="0" Margin="0,-12,-12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseDetailCommand}" AutomationProperties.Name="Close details" ToolTip.Tip="Close (Esc)">
                    <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" />
                </Button>
            </Panel>
        </Border>

        <!-- The toast (spec 03 §F; 4c.63): 22 px from the card's left, its bottom 60 px above the card's bottom (above the 44 px bottom row). Only the toast takes clicks: the panel around it
             has no background. -->
        <Panel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="20" Margin="22,0,0,60">
            <views:TaskToastView DataContext="{Binding Toasts}" />
        </Panel>
    </Grid>
</UserControl>
