<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TasksView"
             x:DataType="vm:TasksViewModel">
    <!-- The Tasks page (spec 03 §B, P5/P6): the Today column card (the "Tasks" title, Normal / Compact and Expand / Collapse at its
         top right, the add box, then This session, Queued and Finished today, and Jot it down at the bottom), a resize handle, the
         Shelf column card (hidden by default: its rail "Shelf · 10 tasks" on the right edge, Ctrl+\), and the detail card of the
         task the user opened. Either column can hide into a rail. Cards take the theme's Tasks radius. -->
    <UserControl.Resources>
        <!-- Check boxes, expanders and switches read in ink, not accent. -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource Ab.InkColor}" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.tasksCard">
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.TasksRadius}" />
        </Style>
        <!-- A pill: category filter and estimate choice. Selected = Ink on Surface2 (the pill is Ink, its text Bg). -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.chip.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Bg}" />
        </Style>
        <!-- A smaller pill, for the filter flyout. -->
        <Style Selector="Button.chip.small">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Bg}" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>

        <!-- The Archive row under the Shelf: a flat button with a chevron. -->
        <Style Selector="Button.archiveRow">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.archiveRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
        </Style>
        <Style Selector="Button.archiveRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>

        <!-- Normal / Compact: two halves of one pill; the one in use is Surface2. -->
        <Style Selector="Button.segment">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.segment /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.segment.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <!-- A narrow Today column: the segments keep their icons only. -->
        <ContainerQuery Name="TaskColumn" Query="max-width:520">
            <Style Selector="TextBlock.segmentText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>

        <!-- The add row: a Surface2 pill whose entry has no box of its own. -->
        <Style Selector="TextBox.rowEntry">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.rowEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.rowEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.rowEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Border.addPill:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        </Style>

        <!-- The detail card's title: a TextBox that looks like the display text until it is clicked. -->
        <Style Selector="TextBox.titleEntry">
            <Setter Property="FontFamily" Value="{DynamicResource Ab.DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="LineHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
        </Style>
        <Style Selector="TextBox.titleEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.titleEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.titleEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <!-- The notes box: Surface2, no border of its own. -->
        <Style Selector="TextBox.noteEntry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="96" />
        </Style>
        <Style Selector="TextBox.noteEntry /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.noteEntry:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.noteEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <!-- The open task's chips (label, tags, + Tag, time limit, highlight): 28 high Surface2 pills, 12 text. -->
        <Style Selector="Button.openChip">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.openChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.openChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <Style Selector="Border.letterChip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.stepHandle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Grid.stepRow:pointerover Border.stepHandle">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Grid.stepRow.focused">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="TextBlock.focusedStep">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.syncProblem">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <Style Selector="TextBlock.stepDone">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>

        <!-- The resize handle's grip: Line, Muted while dragged. -->
        <Style Selector="Border#SplitGrip">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <Style Selector="Border#SplitGrip.active">
            <Setter Property="Background" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Border.detailCard">
            <Setter Property="Width" Value="340" />
        </Style>
        <Style Selector="StackPanel.detailBody">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Page" ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
        <!-- Today hidden: its rail on the left. -->
        <views:ShelfRailView Grid.Column="0" Margin="0,0,12,0" IsVisible="{Binding ShowsTodayRail}" Title="Today" Sub="{Binding TodayRailText}"
                             Icon="ArrowExpandRight" Tip="Show Today" Command="{Binding ShowTodayCommand}" />

        <!-- The Today column. -->
        <Border x:Name="TodayColumn" Grid.Column="1" Classes="card tasksCard" IsVisible="{Binding ShowsToday}" Padding="0" ClipToBounds="True"
                Container.Name="TaskColumn" Container.Sizing="Width">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="26,20,16,0">
                    <TextBlock Classes="display" Text="Tasks" FontSize="30" VerticalAlignment="Center" />
                    <Border Grid.Column="1" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" CornerRadius="999" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="segment" Classes.on="{Binding !IsCompact}" Command="{Binding UseNormalRowsCommand}" ToolTip.Tip="Normal rows"
                                    AutomationProperties.Name="Normal rows">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="ViewHeadline" Width="15" Height="15" />
                                    <TextBlock Classes="segmentText" Text="Normal" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="segment" Classes.on="{Binding IsCompact}" Command="{Binding UseCompactRowsCommand}" ToolTip.Tip="Compact rows"
                                    AutomationProperties.Name="Compact rows">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="FormatLineSpacing" Width="15" Height="15" />
                                    <TextBlock Classes="segmentText" Text="Compact" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Classes="quiet" Padding="7,5" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                            Command="{Binding TodayPanel.ToggleExpandCommand}" ToolTip.Tip="{Binding TodayPanel.ExpandTip}"
                            AutomationProperties.Name="{Binding TodayPanel.ExpandTip}">
                        <mi:MaterialIcon Kind="{Binding TodayPanel.ExpandIcon}" Width="18" Height="18" />
                    </Button>
                </Grid>

                <!-- The add box: "+ Add a task" at rest, the full row with Send to while in use; its hint line floats over what is below. -->
                <views:AddBoxView DockPanel.Dock="Top" DataContext="{Binding AddBox}" Margin="22,14,16,10" ZIndex="1" />

                <!-- Jot it down at the bottom of the column (fainter during a session; Ctrl+J). -->
                <views:JotBoxView DockPanel.Dock="Bottom" DataContext="{Binding Jot}" Margin="22,8,16,12" ZIndex="1" />

                <!-- The Undo bar after a delete (10 seconds); the item stays in Archive > Recently deleted. -->
                <views:UndoBarView DockPanel.Dock="Bottom" DataContext="{Binding Undo}" Margin="22,6,16,14" />

                <!-- A picker's "New category…": its name; Enter makes it and applies it. -->
                <Border DockPanel.Dock="Top" Margin="22,0,16,8" Padding="16,4,8,4" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                        IsVisible="{Binding IsNamingCategory}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="NewCategoryBox" Classes="rowEntry" FontSize="14" Text="{Binding NewCategoryName}" PlaceholderText="{Binding NamePrompt}"
                                 AutomationProperties.Name="New category name">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveNewCategoryCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelNewCategoryCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="quiet" Command="{Binding CancelNewCategoryCommand}" Padding="8,2" AutomationProperties.Name="Cancel new category"><mi:MaterialIcon Kind="Close" Width="14" Height="14" /></Button>
                    </Grid>
                </Border>

                <!-- Why something was not done. -->
                <Border DockPanel.Dock="Top" Margin="22,0,16,8" Padding="16,10,8,10" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                        IsVisible="{Binding HasNotice}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" Text="{Binding Notice}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="quiet" Command="{Binding DismissNoticeCommand}" Padding="8,2" AutomationProperties.Name="Dismiss"><mi:MaterialIcon Kind="Close" Width="14" Height="14" /></Button>
                    </Grid>
                </Border>

                <!-- "Add to Today" at three tasks: nothing is added until this is answered. -->
                <Border DockPanel.Dock="Top" Margin="22,0,16,8" Padding="18,14" CornerRadius="18" Background="{DynamicResource Ab.Surface2}"
                        IsVisible="{Binding HasPending}">
                    <ContentControl Content="{Binding Pending}">
                        <ContentControl.DataTemplates>
                            <DataTemplate x:DataType="vm:PendingMoveViewModel">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding TitleText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Reason}" PlaceholderText="Why? (10+ characters, stays on this PC)" AutomationProperties.Name="Why add it anyway" />
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Ab.Drift}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Add anyway" Command="{Binding AddAnywayCommand}" />
                                        <Button Classes="quiet" Content="Leave it where it is" Command="{Binding CancelCommand}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding CanSwap}">
                                        <TextBlock Classes="muted" Text="Or put it in place of one of today's tasks (that one goes to Come back to):" FontSize="13" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding SwapChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PendingMoveViewModel+SwapChoice">
                                                    <Button Classes="quiet" Command="{Binding SwapCommand}" HorizontalAlignment="Left" Padding="10,6">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="12,2,12,20" ItemsSource="{Binding TodayPanel.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskSectionViewModel">
                                <views:TaskSectionView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Drag to resize the two columns; double-click puts the split back. -->
        <Border x:Name="SplitHandle" Grid.Column="2" Width="14" Background="Transparent" Cursor="SizeWestEast" IsVisible="{Binding ShowsSplitHandle}"
                ToolTip.Tip="Drag to resize · double-click to reset" AutomationProperties.Name="Resize the columns"
                PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" PointerCaptureLost="OnSplitCaptureLost"
                DoubleTapped="OnSplitDoubleTapped">
            <Border x:Name="SplitGrip" Width="4" Height="44" CornerRadius="2" VerticalAlignment="Center" />
        </Border>

        <!-- The Shelf column. -->
        <Border x:Name="ShelfColumn" Grid.Column="3" Classes="card tasksCard" IsVisible="{Binding IsShelfShown}" Padding="0" ClipToBounds="True"
                Container.Name="TaskColumn" Container.Sizing="Width">
            <views:ShelfView DataContext="{Binding Shelf}">
                <views:ShelfView.Footer>
                    <!-- The Archive: one row under the bins that opens the Notebook (come-backs, session notes, unfinished and done tasks), with its filters and search. -->
                    <StackPanel x:DataType="vm:TasksViewModel" DataContext="{Binding $parent[views:TasksView].((vm:TasksViewModel)DataContext)}" Margin="8,6,8,16">
                        <Button Classes="archiveRow" Command="{Binding ToggleArchiveCommand}" AutomationProperties.Name="Archive">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Classes="muted" Text="Archive" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Archive.SummaryText}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" IsVisible="{Binding !ShowsArchive}" />
                                <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" IsVisible="{Binding ShowsArchive}" />
                            </Grid>
                        </Button>
                        <views:NotebookView DataContext="{Binding Archive}" IsVisible="{Binding $parent[views:TasksView].((vm:TasksViewModel)DataContext).ShowsArchive}" />
                    </StackPanel>
                </views:ShelfView.Footer>
            </views:ShelfView>
        </Border>

        <!-- Shelf hidden (the default): its rail on the right edge. -->
        <views:ShelfRailView Grid.Column="4" Margin="12,0,0,0" IsVisible="{Binding ShowsShelfRail}" Title="Shelf" Sub="{Binding Shelf.CountText}"
                             Icon="ArrowExpandLeft" Tip="Show the Shelf (Ctrl+\)" Command="{Binding ToggleShelfCommand}" />

        <!-- The detail card for the selected task, Later item or come-back. -->
        <Border x:Name="DetailCard" Grid.Column="5" Classes="card detailCard" IsVisible="{Binding IsDetailOpen}" Margin="14,0,0,0" Padding="28,26">
            <Panel>
                <TextBlock Classes="muted" Text="Pick a task to see its steps, estimate and notes." TextWrapping="Wrap" FontSize="14"
                           IsVisible="{Binding !HasDetail}" />
                <ContentControl Content="{Binding Detail}" IsVisible="{Binding HasDetail}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="vm:TaskDetailViewModel">
                            <DockPanel LastChildFill="True">
                                <!-- The footer: the running bar or "Start with this", the quiet moves, and what was refused. -->
                                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                                    <TextBlock Classes="muted" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
                                    <Border IsVisible="{Binding ShowsRunningBar}" Background="{DynamicResource Ab.Surface2}" CornerRadius="26" Padding="16,14">
                                        <TextBlock Classes="muted" Text="{Binding RunningText}" FontSize="16" HorizontalAlignment="Center" />
                                    </Border>
                                    <Button Classes="primary pill" Content="Start with this" Command="{Binding StartWithThisCommand}" IsEnabled="{Binding CanStart}"
                                            IsVisible="{Binding ShowsStart}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="24,14" AutomationProperties.Name="Start with this" />
                                    <WrapPanel ItemSpacing="4" LineSpacing="4" HorizontalAlignment="Center">
                                        <Button Classes="quiet" Padding="14,8" Content="Add to Today" Command="{Binding AddToTodayCommand}"
                                                IsVisible="{Binding ShowsMoveToSession}" FontSize="15" AutomationProperties.Name="Add to Today"
                                                ToolTip.Tip="Put it on today's list (a done one comes back open, as a copy)" />
                                        <Button Classes="quiet" Padding="14,8" Content="Move to Later" Command="{Binding MoveToLaterCommand}" IsVisible="{Binding ShowsMoveToLater}"
                                                FontSize="15" />
                                        <Button Classes="quiet" Padding="14,8" Content="Put in plan" IsVisible="{Binding ShowsPlan}" FontSize="15"
                                                AutomationProperties.Name="Put in plan">
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedRight">
                                                    <ScrollViewer MaxHeight="360" Width="300">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Classes="section" Text="Put it in the plan for…" />
                                                            <TextBlock Classes="muted" Text="Nothing in the plan for the coming week." FontSize="13"
                                                                       IsVisible="{Binding !HasPlanDays}" />
                                                            <ItemsControl ItemsSource="{Binding PlanDays}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:PlanDayChoiceViewModel">
                                                                        <StackPanel Spacing="2" Margin="0,0,0,8">
                                                                            <TextBlock Classes="muted" Text="{Binding Label}" FontSize="13" />
                                                                            <ItemsControl ItemsSource="{Binding Parts}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:PlanPartChoiceViewModel">
                                                                                        <Button Classes="quiet" Command="{Binding PickCommand}" HorizontalAlignment="Stretch"
                                                                                                HorizontalContentAlignment="Left" Padding="10,6">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="{Binding Text}" FontSize="14" />
                                                                                                <mi:MaterialIcon Kind="Check" Width="14" Height="14" IsVisible="{Binding IsSelected}" />
                                                                                            </StackPanel>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Classes="quiet" Content="Not in the plan" Command="{Binding ClearPlanCommand}" IsVisible="{Binding HasPlan}"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" />
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Classes="quiet" Padding="14,8" Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding ShowsDelete}" FontSize="15"
                                                ToolTip.Tip="Delete it (it goes from your other devices too; Undo and Archive > Recently deleted bring it back)" />
                                    </WrapPanel>
                                    <!-- The sync line, the task's menu and its ID chip ("142", copies "142 · title"). -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding SyncText}"
                                                    IsVisible="{Binding !HasConflict}">
                                            <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Ab.Muted}" IsVisible="{Binding !IsSyncProblem}" />
                                            <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Ab.Drift}" IsVisible="{Binding IsSyncProblem}" />
                                            <TextBlock Classes="muted" Classes.syncProblem="{Binding IsSyncProblem}" Text="{Binding SyncText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Changed on both devices: the line opens the dialog. -->
                                        <Button Classes="quiet" Padding="4,2" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsVisible="{Binding HasConflict}" Command="{Binding OpenConflictCommand}"
                                                ToolTip.Tip="Pick the version to keep" AutomationProperties.Name="Changed on both devices: pick a version">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Drift}" />
                                                <TextBlock Classes="muted syncProblem" Text="{Binding SyncText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" TextDecorations="Underline" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="quiet" Padding="6,4" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                                AutomationProperties.Name="More actions" ToolTip.Tip="More (or right-click the row)" Click="OnMoreClick">
                                            <mi:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="openChip" IsVisible="{Binding HasNumber}" Click="OnCopyIdClick"
                                                ToolTip.Tip="Copy task ID" AutomationProperties.Name="Copy task ID">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding NumberText}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="11.5" VerticalAlignment="Center" />
                                                <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Classes="detailBody" Spacing="14">
                                        <TextBlock Classes="muted" Text="{Binding KindText}" FontSize="13" />
                                        <TextBox Classes="titleEntry" Name="DetailTitleBox" Text="{Binding Title}" IsReadOnly="{Binding !CanEditTitle}" AutomationProperties.Name="Title"
                                                 LostFocus="OnDetailTitleLostFocus">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding CommitTitleCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <!-- The chips row: label, tags, + Tag, time limit, highlight (the full menus are 3.5). -->
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Button Classes="openChip" IsVisible="{Binding CanLabel}" Click="OnLabelChipClick" ToolTip.Tip="Label"
                                                    AutomationProperties.Name="Label">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Panel Width="9" Height="9" VerticalAlignment="Center">
                                                        <Ellipse Fill="{Binding LabelBrush}" />
                                                        <Ellipse Stroke="{DynamicResource Ab.Faint}" StrokeThickness="1.5" />
                                                    </Panel>
                                                    <TextBlock Text="{Binding LabelName}" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding TagChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Classes="openChip" Content="{Binding}" Click="OnTagChipClick" ToolTip.Tip="Tags" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="openChip" IsVisible="{Binding CanTag}" Click="OnTagChipClick" ToolTip.Tip="Add a tag"
                                                    AutomationProperties.Name="Add a tag">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <mi:MaterialIcon Kind="Pound" Width="13" Height="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="+ Tag" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="openChip" IsVisible="{Binding ShowsEditableFields}" Click="OnTimeLimitChipClick" ToolTip.Tip="Time limit"
                                                    AutomationProperties.Name="Time limit">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <mi:MaterialIcon Kind="TimerOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TimeLimitText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="openChip" IsVisible="{Binding CanHighlight}" Command="{Binding ToggleHighlightCommand}"
                                                    ToolTip.Tip="{Binding HighlightTip}" AutomationProperties.Name="{Binding HighlightTip}">
                                                <mi:MaterialIcon Kind="{Binding HighlightIcon}" Width="15" Height="15" Foreground="{DynamicResource Ab.Accent}" />
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsComeBack}">
                                            <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Command="{Binding TickComeBackCommand}" MinWidth="0" Padding="0"
                                                      Content="Done" IsEnabled="{Binding CanEdit}" />
                                            <TextBlock Classes="muted" Text="{Binding ParkedText}" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding HasParkedText}" />
                                        </StackPanel>

                                        <!-- Steps. -->
                                        <StackPanel Spacing="2" IsVisible="{Binding ShowsFields}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StepsHead}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Classes="muted" Text="{Binding StepsSub}" FontSize="12" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TaskStepViewModel">
                                                        <StackPanel Spacing="2" Margin="0,1">
                                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource Ab.Accent}" IsVisible="{Binding ShowsLineAbove}" IsHitTestVisible="False" />
                                                            <Grid Classes="stepRow stepItem" Classes.focused="{Binding IsFocused}" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" KeyDown="OnStepKeyDown"
                                                                  Background="Transparent">
                                                                <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanEdit}"
                                                                          MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"
                                                                          ToolTip.Tip="Tick step" />
                                                                <Border Grid.Column="1" Classes="letterChip" IsVisible="{Binding HasLetter}" ToolTip.Tip="{Binding LetterTip}">
                                                                    <TextBlock Classes="muted" Text="{Binding Letter}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="11.5" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                           Classes.stepDone="{Binding IsDone}" Classes.focusedStep="{Binding IsFocused}"
                                                                           IsVisible="{Binding IsNotEditing}" />
                                                                <TextBox Grid.Column="2" Classes="rowEntry" Text="{Binding EditText}" IsVisible="{Binding IsEditing}" FontSize="14"
                                                                         PropertyChanged="OnInlineBoxPropertyChanged" AutomationProperties.Name="Step name">
                                                                    <TextBox.KeyBindings>
                                                                        <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
                                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                                    </TextBox.KeyBindings>
                                                                </TextBox>
                                                                <TextBlock Grid.Column="3" Classes="muted" Text="in focus" FontSize="11.5" VerticalAlignment="Center" IsVisible="{Binding IsFocused}" />
                                                                <Button Grid.Column="4" Classes="quiet" Padding="4" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                                                        IsVisible="{Binding CanFocus}" Command="{Binding FocusCommand}" ToolTip.Tip="Bring into focus"
                                                                        AutomationProperties.Name="Bring into focus">
                                                                    <mi:MaterialIcon Kind="Target" Width="15" Height="15" Foreground="{DynamicResource Ab.Faint}" />
                                                                </Button>
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" IsVisible="{Binding HasTime}">
                                                                    <mi:MaterialIcon Kind="TimerOutline" Width="13" Height="13" Foreground="{DynamicResource Ab.Muted}" />
                                                                    <TextBlock Classes="muted" Text="{Binding TimeText}" FontSize="12" />
                                                                </StackPanel>
                                                                <Button Grid.Column="6" Classes="quiet" Padding="6,2" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="More actions for this step" ToolTip.Tip="Rename, add a step after, delete" Click="OnMoreClick">
                                                                    <mi:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" />
                                                                </Button>
                                                                <Border Grid.Column="7" Classes="stepHandle" IsVisible="{Binding CanDrag}" ToolTip.Tip="Drag to reorder (Alt+↑/↓)"
                                                                        AutomationProperties.Name="Drag to reorder" PointerPressed="OnStepHandlePressed" PointerMoved="OnStepHandleMoved"
                                                                        PointerReleased="OnStepHandleReleased" PointerCaptureLost="OnStepHandleCaptureLost">
                                                                    <mi:MaterialIcon Kind="DragHorizontalVariant" Width="16" Height="16" VerticalAlignment="Center"
                                                                                     HorizontalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                                </Border>
                                                            </Grid>
                                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource Ab.Accent}" IsVisible="{Binding ShowsLineBelow}" IsHitTestVisible="False" />
                                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsAddingAfter}" Margin="30,0,0,0">
                                                                <mi:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBox Grid.Column="1" Classes="rowEntry" FontSize="15" Text="{Binding NewAfterText}" PlaceholderText="A step after this one"
                                                                         PropertyChanged="OnInlineBoxPropertyChanged" AutomationProperties.Name="New step after this one">
                                                                    <TextBox.KeyBindings>
                                                                        <KeyBinding Gesture="Enter" Command="{Binding SaveAddAfterCommand}" />
                                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelAddAfterCommand}" />
                                                                    </TextBox.KeyBindings>
                                                                </TextBox>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding CanAddStep}" Margin="4,2,0,0">
                                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1" Name="DetailStepBox" Classes="rowEntry" FontSize="15" Text="{Binding NewStepText}" PlaceholderText="Add a step"
                                                         AutomationProperties.Name="Add a step">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding AddStepCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                            </Grid>
                                        </StackPanel>

                                        <!-- A custom time limit (the time limit chip's "Custom…"). -->
                                        <StackPanel Spacing="8" IsVisible="{Binding ShowsEditableFields}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomEstimateOpen}">
                                                <TextBox Width="90" Text="{Binding CustomEstimateText}" PlaceholderText="minutes" AutomationProperties.Name="Estimate in minutes">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding ApplyCustomEstimateCommand}" />
                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelCustomEstimateCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Classes="quiet" Content="Set" Command="{Binding ApplyCustomEstimateCommand}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Later: when it is due. -->
                                        <StackPanel Spacing="8" IsVisible="{Binding IsLater}">
                                            <TextBlock Classes="muted" Text="Due" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CalendarDatePicker SelectedDate="{Binding DueDate}" AutomationProperties.Name="Due date" />
                                                <Button Classes="quiet" Content="Clear" Command="{Binding ClearDueCommand}" IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPlan}">
                                            <TextBlock Classes="muted" Text="{Binding PlanText}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Notes: private text, kept on blur or a moment after typing; sealed here and on your other devices. -->
                                        <StackPanel Spacing="8" IsVisible="{Binding ShowsFields}">
                                            <TextBlock Classes="muted" Text="Notes" FontSize="13" />
                                            <Border Background="{DynamicResource Ab.Surface2}" CornerRadius="16" Padding="12,8">
                                                <TextBox Classes="noteEntry" Text="{Binding Note}" IsReadOnly="{Binding !CanEdit}" PlaceholderText="Add a private note"
                                                         AutomationProperties.Name="Notes" LostFocus="OnDetailNoteLostFocus" />
                                            </Border>
                                        </StackPanel>

                                        <!-- The reminders line (a click opens Reminders & due date where the task list holds the task) and Effort (coming soon). -->
                                        <WrapPanel ItemSpacing="14" LineSpacing="6">
                                            <Button Classes="quiet" Padding="4,2" MinHeight="0" Margin="-4,0,0,0" IsEnabled="{Binding CanEditReminders}"
                                                    Click="OnRemindersClick" ToolTip.Tip="Reminders and the due date" AutomationProperties.Name="Reminders and due date">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <mi:MaterialIcon Kind="BellOutline" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" Classes.faint="{Binding !HasReminders}" Text="{Binding ReminderText}" FontSize="12.5"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.5" ToolTip.Tip="Effort is coming soon">
                                                <mi:MaterialIcon Kind="WeightLifter" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                                <TextBlock Classes="muted" Text="Effort · soon" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
                <!-- The card shows only for a task the user opened: this (or Esc) closes it. -->
                <Button Classes="quiet closeDetail" Padding="6" MinHeight="0" MinWidth="0" Margin="0,-12,-12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseDetailCommand}" AutomationProperties.Name="Close details" ToolTip.Tip="Close (Esc)">
                    <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" />
                </Button>
            </Panel>
        </Border>
    </Grid>
</UserControl>
