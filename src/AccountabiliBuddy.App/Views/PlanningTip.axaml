<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.PlanningTip">
    <!-- The planning tip: one line and an optional "Why?" -->
    <StackPanel Spacing="2">
        <TextBlock Text="{x:Static vm:PlanningGuidance.Tip}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
        <Expander Header="Why?" Padding="0" FontSize="11">
            <TextBlock Text="{x:Static vm:PlanningGuidance.Why}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
        </Expander>
    </StackPanel>
</UserControl>
