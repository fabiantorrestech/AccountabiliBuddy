<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
    <!-- Setup: what AccountabiliBuddy is allowed to do on this computer, each a row with Grant and Revoke. Revoking and deleting are locked
         while a focus session runs (the shell above says so); granting still works. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,24" Spacing="12">
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <Button Content="Full setup (imports, browsers)…" Command="{Binding RunAssistantCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />
            </WrapPanel>

            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <!-- Start with Windows -->
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" Classes="sTitle" />
                                <TextBlock Text="{Binding StartupStatus}" Classes="sHint" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Grant" Command="{Binding GrantStartupCommand}" />
                                <Button Content="Revoke" Command="{Binding RevokeStartupCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Quick session shortcut -->
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Quick session in the Start menu" Classes="sTitle" />
                                <TextBlock Text="{Binding QuickLaunchStatus}" Classes="sHint" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Grant" Command="{Binding GrantQuickLaunchCommand}" />
                                <Button Content="Revoke" Command="{Binding RevokeQuickLaunchCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Browser extensions (the list has its own heading and one-line explanation) -->
            <views:BrowserSetupList Margin="0,8,0,0" />

            <!-- Data permissions -->
            <TextBlock Text="Your data" Classes="sGroup" />
            <TextBlock Classes="sHint" Margin="4,-6,0,0" Text="Everything stays on this computer." />
            <Border Classes="sPanel" DataContext="{Binding Privacy}">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Screen reading (OCR)" Classes="sTitle" />
                                <TextBlock Text="{Binding ScreenReadingStatus}" Classes="sHint" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Grant" Command="{Binding GrantScreenReadingCommand}" />
                                <Button Content="Revoke" Command="{Binding RevokeScreenReadingCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Activity history" Classes="sTitle" />
                                <TextBlock Text="{Binding ActivityLogStatus}" Classes="sHint" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Grant" Command="{Binding GrantActivityLogCommand}" />
                                <Button Content="Revoke" Command="{Binding RevokeActivityLogCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Text="{Binding DeleteStatus}" Classes="sHint" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{Binding DeleteButtonText}" Command="{Binding DeleteDataCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
