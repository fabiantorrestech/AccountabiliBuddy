<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#E9A23B" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <Border IsVisible="{Binding IsLocked}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                <TextBlock Text="Revoking and deleting are locked while a focus session is running. Granting still works."
                           TextWrapping="Wrap" />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Everything AccountabiliBuddy is allowed to do on this computer. Revoke anything outside a focus session."
                           Classes="muted" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Run setup assistant…" Command="{Binding RunAssistantCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />
                </StackPanel>
            </Grid>

            <!-- Start with Windows -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Start with Windows" Classes="title" />
                    <TextBlock Grid.Row="1" Text="{Binding StartupStatus}" Classes="muted" />
                    <StackPanel Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Grant" Command="{Binding GrantStartupCommand}" Classes="accent" />
                        <Button Content="Revoke" Command="{Binding RevokeStartupCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick session shortcut -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Quick session in the Start menu" Classes="title" />
                    <TextBlock Grid.Row="1" Text="{Binding QuickLaunchStatus}" Classes="muted" />
                    <StackPanel Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Grant" Command="{Binding GrantQuickLaunchCommand}" Classes="accent" />
                        <Button Content="Revoke" Command="{Binding RevokeQuickLaunchCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Browsers -->
            <TextBlock Text="Browsers" Classes="title" Margin="0,8,0,0" />
            <TextBlock Classes="muted"
                       Text="Lets AccountabiliBuddy see the address of the active tab (and the YouTube channel) and send a tab to its block page. It talks only to this app; nothing leaves the computer." />
            <views:BrowserSetupList />

            <!-- Linked devices (ADR 14) -->
            <TextBlock Text="Linked devices" Classes="title" Margin="0,8,0,0" />
            <TextBlock Classes="muted"
                       Text="Lets your phone or tablet (the AccountabiliBuddy companion) show this PC's session and start or end one, with the same wait and reason as here. Only on your home network and encrypted; nothing goes through the internet. Windows Firewall asks once: allow it on private networks." />
            <Border Classes="card" DataContext="{Binding LinkedDevices}" x:DataType="vm:LinkedDevicesViewModel">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Let phones and tablets link to this PC" Classes="title" />
                        <TextBlock Grid.Row="1" Text="{Binding Status}" Classes="muted" />
                        <StackPanel Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Turn on" Command="{Binding TurnOnCommand}" Classes="accent" />
                            <Button Content="Turn off" Command="{Binding TurnOffCommand}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Pair a phone or tablet…" Command="{Binding PairCommand}" IsVisible="{Binding IsEnabled}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsPairing}">
                        <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
                            <Image Source="{Binding QrImage}" Width="220" Height="220" RenderOptions.BitmapInterpolationMode="None" />
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center" MaxWidth="340">
                            <TextBlock Text="Scan it with your phone's camera" FontWeight="SemiBold" />
                            <TextBlock Classes="muted"
                                       Text="The link opens the AccountabiliBuddy companion, which shows this code to compare before pairing:" />
                            <TextBlock Text="{Binding PairingCode}" FontSize="24" FontWeight="SemiBold" FontFamily="Consolas, Courier New, monospace" />
                            <TextBlock Text="{Binding PairingDetail}" Classes="muted" />
                            <Button Content="Cancel" Command="{Binding CancelPairingCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkedDeviceRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Unpair" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:LinkedDevicesViewModel)DataContext).UnpairCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Data permissions -->
            <TextBlock Text="Your data" Classes="title" Margin="0,8,0,0" />
            <TextBlock Classes="muted" Text="Everything stays on this computer." />
            <StackPanel Spacing="8" DataContext="{Binding Privacy}">
                <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Screen reading (OCR)" Classes="title" />
                        <TextBlock Grid.Row="1" Text="{Binding ScreenReadingStatus}" Classes="muted" />
                        <StackPanel Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Grant" Command="{Binding GrantScreenReadingCommand}" Classes="accent" />
                            <Button Content="Revoke" Command="{Binding RevokeScreenReadingCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Activity history" Classes="title" />
                            <TextBlock Grid.Row="1" Text="{Binding ActivityLogStatus}" Classes="muted" />
                            <StackPanel Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Grant" Command="{Binding GrantActivityLogCommand}" Classes="accent" />
                                <Button Content="Revoke" Command="{Binding RevokeActivityLogCommand}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding DeleteButtonText}" Command="{Binding DeleteDataCommand}" />
                            <TextBlock Text="{Binding DeleteStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
