<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.FocusView"
             x:DataType="vm:FocusViewModel">
    <!-- Focus mode: the countdown, End session, the focus so far, the current task in front and the checklist, and
         Step away / Interrupted. Nothing else while a session runs. -->
    <UserControl.Styles>
        <!-- The planning stage (before the focus countdown) reads in its own colour: the timer, the bar and the line. -->
        <Style Selector="TextBlock.planning">
            <Setter Property="Foreground" Value="#7C9EF2" />
        </Style>
        <Style Selector="ProgressBar.planning">
            <Setter Property="Foreground" Value="#7C9EF2" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
        </Style>
        <Style Selector="Button.away">
            <Setter Property="Background" Value="#4D0F766E" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">
        <Border Padding="20" CornerRadius="10" Background="#220F766E" BorderBrush="#550F766E" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding TimeLeftText}" FontSize="44" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Classes.planning="{Binding InPlanningStage}" AutomationProperties.Name="Time left" />
                        <TextBlock Text="{Binding PhaseText}" FontSize="15" Opacity="0.8" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding EndSessionText}" Command="{Binding EndSessionCommand}" VerticalAlignment="Center" />
                </Grid>
                <!-- Plan first: the session's first minutes, for the plan; "I'm ready" ends them. -->
                <Border IsVisible="{Binding IsPlanning}" Background="#33FFFFFF" CornerRadius="6" Padding="10,6">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding PlanningText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Classes.planning="{Binding InPlanningStage}" />
                            <Button Grid.Column="1" Content="I'm ready" Command="{Binding ReadyCommand}" Classes="accent" IsVisible="{Binding CanReady}" />
                        </Grid>
                        <views:PlanningTip />
                        <!-- The stage's own bar: empties as planning time passes, in the planning colour. -->
                        <ProgressBar Classes="planning" Minimum="0" Maximum="100" Value="{Binding PlanningLeftPercent}" IsVisible="{Binding InPlanningStage}" />
                    </StackPanel>
                </Border>
                <!-- Stepped away or on a side task: the countdown is paused until "I'm back" or "Back on track". -->
                <Border IsVisible="{Binding IsPlainAway}" Background="#33FFFFFF" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AwayText}" FontWeight="SemiBold" />
                </Border>
                <!-- A side task's time grows in amber next to the paused focus time. -->
                <Border IsVisible="{Binding IsSideTask}" Background="#33FBBF24" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AwayText}" FontWeight="SemiBold" Foreground="#FBBF24" />
                </Border>
                <TextBlock Text="{Binding FocusedTodayText}" Opacity="0.75" TextWrapping="Wrap"
                           IsVisible="{Binding FocusedTodayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding PhoneText}" Opacity="0.75" TextWrapping="Wrap" Foreground="#22C55E"
                           IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasStepAway}">
                    <Button Classes="away" Content="{Binding StepAwayText}" Command="{Binding StepAwayCommand}"
                            ToolTip.Tip="A bathroom break: the countdown pauses until you say you are back on track" />
                    <Button Classes="away" Content="Interrupted" Command="{Binding InterruptedCommand}" IsVisible="{Binding !IsAway}"
                            ToolTip.Tip="Someone at your desk or a call: the same pause, kept apart in History" />
                    <Button Classes="away" Content="Side task" Command="{Binding SideTaskCommand}" IsVisible="{Binding !IsAway}"
                            ToolTip.Tip="A small errand of 5, 10 or 15 minutes: the focus clock pauses, blocking and nudges keep running" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The task in front, then the checklist (tick, add, edit). -->
        <Border Padding="20" CornerRadius="10" Background="#1A808080" BorderBrush="#33808080" BorderThickness="1"
                IsVisible="{Binding Checklist, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2" IsVisible="{Binding HasTasks}">
                    <TextBlock Text="{Binding NowText}" Opacity="0.7" FontSize="12" />
                    <TextBlock Text="{Binding CurrentTaskText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentSubtaskText, StringFormat='↳ {0}'}" FontSize="14" Opacity="0.8" TextWrapping="Wrap"
                               IsVisible="{Binding HasSubtask}" />
                </StackPanel>
                <views:ChecklistView DataContext="{Binding Checklist}" />
            </StackPanel>
        </Border>

        <!-- Capture (redesign phase 5): a thought goes here instead of into a new tab. -->
        <Border Padding="16,12" CornerRadius="10" Background="#1A808080" BorderBrush="#33808080" BorderThickness="1"
                DataContext="{Binding Capture}" x:DataType="vm:CaptureBoxViewModel"
                IsVisible="{Binding $parent[UserControl].((vm:FocusViewModel)DataContext).Capture, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding Text}" PlaceholderText="A thought? Type it, Enter keeps it for later">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ToggleButton Grid.Column="1" Content="⚑" IsChecked="{Binding IsComeback}"
                                  ToolTip.Tip="Must not drift: park it under Come back to (or start the line with !)" />
                </Grid>
                <TextBlock Text="{Binding Message}" FontSize="11" Opacity="0.7"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="Enter keeps a note for this session's review · ⚑ or a leading ! parks it under Come back to" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
