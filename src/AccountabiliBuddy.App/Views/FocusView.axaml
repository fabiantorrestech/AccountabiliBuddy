<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.FocusView"
             x:DataType="vm:FocusViewModel">
    <!-- The inside of Today's main card while a session runs, in the card's one frame: the content on top, the action row pinned
         to the bottom. Planning (the session's first minutes, or a first session's learning): the "Plan first" line, the question,
         the numbered tasks, then "I'm ready", "or tick the first task to begin" and the session's length. Running: the chip and
         line, the big timer, the task in front with its steps, then Done / Pause / +10 min / ⋯ and what comes next. -->
    <UserControl.Styles>
        <!-- A tail (what comes next, the length) sits at the right of its action row; the narrow page's rule below puts it under. -->
        <Style Selector=":is(Control).tail">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="Button.plusTen">
            <Setter Property="Padding" Value="14,16" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip.plan">
            <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
        </Style>
        <Style Selector="TextBlock.done">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <!-- The question and the timer step down on a narrow page (the Today page's own width, set on its root). -->
        <Style Selector="TextBlock.question">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="LineHeight" Value="44" />
        </Style>
        <Style Selector="TextBlock.timer">
            <Setter Property="FontSize" Value="120" />
            <Setter Property="LineHeight" Value="128" />
        </Style>
        <Style Selector="TextBlock.taskTitle">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="LineHeight" Value="42" />
        </Style>
        <!-- The time-left ring at the timer's right (about its cap height). Accent on Surface2; a break uses the sleep colour and the
             last 2 minutes of focus go ink. It scales with the timer (both sit in one Viewbox). -->
        <Style Selector="controls|ProgressRing.timeRing">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Thickness" Value="8" />
            <Setter Property="TrackBrush" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <Style Selector="controls|ProgressRing.timeRing.break">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Sleep}" />
        </Style>
        <Style Selector="controls|ProgressRing.timeRing.wrapUp">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="StackPanel.column">
            <Setter Property="Spacing" Value="16" />
        </Style>
        <Style Selector="Panel.actionRow">
            <Setter Property="Margin" Value="0,28,0,0" />
        </Style>
        <ContainerQuery Name="TodayPage" Query="max-width:940">
            <Style Selector="TextBlock.question">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="LineHeight" Value="34" />
            </Style>
            <Style Selector="TextBlock.taskTitle">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="LineHeight" Value="34" />
            </Style>
            <!-- Tighter above and below, so the action row stays in view at 900x560. -->
            <Style Selector="StackPanel.column">
                <Setter Property="Spacing" Value="8" />
            </Style>
            <Style Selector="Panel.actionRow">
                <Setter Property="Margin" Value="0,14,0,0" />
            </Style>
            <Style Selector="TextBlock.timer">
                <Setter Property="FontSize" Value="96" />
                <Setter Property="LineHeight" Value="104" />
            </Style>
            <Style Selector="controls|ProgressRing.timeRing">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="76" />
                <Setter Property="Thickness" Value="7" />
            </Style>
            <!-- The action rows are a wrapping group of buttons and a tail (what comes next, the length): on a narrow page the tail goes under. -->
            <Style Selector="Button.pill">
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style Selector="Button.primary.pill">
                <Setter Property="Padding" Value="22,14" />
            </Style>
            <Style Selector="Button.plusTen">
                <Setter Property="Padding" Value="10,14" />
            </Style>
            <Style Selector=":is(Control).tail">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- "Note for this session...": one line, Enter keeps it for the session's review, Esc closes. -->
        <Flyout x:Key="NoteFlyout" Placement="TopEdgeAlignedLeft" Opened="OnNoteOpened">
            <StackPanel Spacing="6" Width="340">
                <TextBox Text="{Binding Capture.Text}" PlaceholderText="A note for this session (Enter keeps it)" AutomationProperties.Name="Note for this session"
                         KeyDown="OnNoteKeyDown" />
                <TextBlock Classes="muted" Text="{Binding Capture.Message}" FontSize="12"
                           IsVisible="{Binding Capture.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
            </StackPanel>
        </Flyout>
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto">

        <Panel>
            <!-- Planning: the session's first minutes are for the plan; "I'm ready" ends them. -->
            <StackPanel Classes="column" IsVisible="{Binding IsPlanning}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="chip plan">
                        <TextBlock Text="Plan first" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding PlanningText}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
                <StackPanel Spacing="4" HorizontalAlignment="Left" MaxWidth="640">
                    <!-- Wraps by itself in two or three calm lines; never cut. -->
                    <TextBlock Classes="display question" MaxWidth="470" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="What are the three things this session is for?" />
                    <Button Classes="quiet" HorizontalAlignment="Left" Padding="0,4" Margin="0,8,0,0" AutomationProperties.Name="Why plan first?">
                        <TextBlock Classes="muted" Text="Why plan first?" FontSize="13" TextDecorations="Underline" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" Width="320">
                                    <TextBlock Text="{x:Static vm:PlanningGuidance.Tip}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{x:Static vm:PlanningGuidance.Why}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Panel IsVisible="{Binding Checklist, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="640" HorizontalAlignment="Left">
                    <views:TodayTaskRowsView DataContext="{Binding Checklist}" />
                </Panel>
            </StackPanel>

            <!-- Running: the line, the timer, the task in front and its steps. -->
            <StackPanel Classes="column" IsVisible="{Binding !IsPlanning}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="chip">
                        <TextBlock Text="{Binding ChipText}" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SessionLineText}" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- Scales down instead of clipping when the window is narrow; the ring at the timer's right scales with it. -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,-4">
                    <StackPanel Orientation="Horizontal" Spacing="28">
                        <TextBlock Classes="numeral timer" Text="{Binding TimeLeftText}" LetterSpacing="-4"
                                   AutomationProperties.Name="Time left" />
                        <controls:ProgressRing Classes="timeRing" Classes.break="{Binding TimeRingIsBreak}" Classes.wrapUp="{Binding TimeRingIsWrapUp}"
                                               Value="{Binding TimeLeftFraction}" VerticalAlignment="Center" IsVisible="{Binding ShowsTimeRing}"
                                               AutomationProperties.Name="Share of this phase left" />
                    </StackPanel>
                </Viewbox>
                <TextBlock Classes="display taskTitle" TextWrapping="Wrap" Text="{Binding TitleText}" />
                <ItemsControl ItemsSource="{Binding Checklist.CurrentTask.Subtasks}" MaxWidth="520" HorizontalAlignment="Left"
                              IsVisible="{Binding Checklist.CurrentTask.HasSubtasks, FallbackValue=False}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubtaskRowViewModel">
                            <CheckBox IsChecked="{Binding IsDone}" Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" Classes.done="{Binding IsDone}" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" Text="{Binding PhoneText}" FontSize="13" TextWrapping="Wrap"
                           IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Every task (add, rename, steps, move, categories) stays one click away while it runs. -->
                <Expander HorizontalAlignment="Stretch" MaxWidth="640" IsExpanded="False"
                          IsVisible="{Binding Checklist, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Expander.Header>
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding Checklist.Heading}" />
                    </Expander.Header>
                    <Panel Margin="0,8,0,0">
                        <views:TodayTaskRowsView DataContext="{Binding Checklist}" />
                    </Panel>
                </Expander>
            </StackPanel>
        </Panel>

        <!-- The action row, pinned to the card's bottom. -->
        <Panel Grid.Row="1" Classes="actionRow">

            <!-- Planning: I'm ready, the tick hint, the ⋯ menu and the length of the session after it. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding IsPlanning}">
                <WrapPanel ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
                    <Button Classes="primary pill" Content="I'm ready" Command="{Binding ReadyCommand}" IsVisible="{Binding CanReady}" />
                    <Button Classes="pill" Content="{Binding StepAwayText}" Command="{Binding StepAwayCommand}"
                            IsVisible="{Binding IsAway}" ToolTip.Tip="The countdown pauses until you say you are back on track" />
                    <TextBlock Classes="muted" Text="or tick the first task to begin" FontSize="14" VerticalAlignment="Center"
                               IsVisible="{Binding ShowsTickHint}" />
                </WrapPanel>
                <StackPanel Classes="tail" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="MorePlanningButton" Classes="quiet pill" Padding="12,14" ToolTip.Tip="Step away, Interrupted, Side task, End session" AutomationProperties.Name="More session actions">
                        <mi:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{Binding StepAwayText}" Command="{Binding StepAwayCommand}" IsVisible="{Binding HasStepAway}"
                                          ToolTip.Tip="A bathroom break: the countdown pauses until you say you are back on track" />
                                <MenuItem Header="Interrupted" Command="{Binding InterruptedCommand}" IsVisible="{Binding !IsAway}"
                                          ToolTip.Tip="Someone at your desk or a call: the same pause, kept apart in History" />
                                <MenuItem Header="Side task" Command="{Binding SideTaskCommand}" IsVisible="{Binding !IsAway}"
                                          ToolTip.Tip="A small errand of 5, 10 or 15 minutes: the focus clock pauses, blocking and nudges keep running" />
                                <MenuItem Header="Note for this session…" Click="OnNoteClick" IsVisible="{Binding Capture, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                                          ToolTip.Tip="A line for this session's review in History" />
                                <MenuItem Header="Tell me when all tasks are done" ToggleType="CheckBox" IsChecked="{Binding Checklist.NotifyAllDone, Mode=TwoWay}"
                                          IsVisible="{Binding Checklist.ShowsNotifyChoice, FallbackValue=False}" />
                                <MenuItem Header="{Binding TimerToggle.ButtonText}" Command="{Binding TimerToggle.ToggleCommand}"
                                          IsVisible="{Binding TimerToggle.IsVisible, FallbackValue=False}" />
                                <MenuItem Header="{Binding EndSessionText}" Command="{Binding EndSessionCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- The planning stage shows the focus length that follows it; a first session's learning shows its time left. -->
                    <TextBlock Classes="numeral muted" FontSize="32" VerticalAlignment="Center" Text="{Binding FocusLengthText}"
                               IsVisible="{Binding InPlanningStage}" AutomationProperties.Name="Session length" />
                    <TextBlock Classes="numeral muted" FontSize="32" VerticalAlignment="Center" Text="{Binding TimeLeftText}"
                               IsVisible="{Binding IsLearning}" AutomationProperties.Name="Time left" />
                </StackPanel>
            </Grid>

            <!-- Running: Done ticks the task in front (the next comes up), Pause is Step away, +10 min, ⋯ holds the rest. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding !IsPlanning}">
                <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                    <Button Classes="primary pill" Content="Done" Command="{Binding Checklist.TickCurrentTaskCommand}"
                            AutomationProperties.Name="Done: tick the task in front">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsPlanning" />
                                <Binding Path="Checklist.CurrentTask" Converter="{x:Static ObjectConverters.IsNotNull}" FallbackValue="False" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Classes="primary pill" Content="End session · all tasks done" Command="{Binding Checklist.EndAtOnceCommand}"
                            IsVisible="{Binding Checklist.CanEndAtOnce, FallbackValue=False}"
                            ToolTip.Tip="Every task is ticked: the session ends now, with the reason &quot;All tasks done&quot;" />
                    <Button Classes="pill" Content="{Binding StepAwayText}" Command="{Binding StepAwayCommand}"
                            IsVisible="{Binding HasStepAway}"
                            ToolTip.Tip="A bathroom break: the countdown pauses until you say you are back on track" />
                    <Button Classes="quiet plusTen" Content="+10 min" Command="{Binding ExtendFocusCommand}" IsVisible="{Binding ShowsExtend}"
                            FontSize="15" AutomationProperties.Name="Add 10 minutes"
                            ToolTip.Tip="Ends this focus 10 minutes later, at once. Never in planning, a break, a side task or away." />
                    <Button x:Name="MoreRunningButton" Classes="quiet pill" Padding="12,14" ToolTip.Tip="Interrupted, Side task, End session" AutomationProperties.Name="More session actions">
                        <mi:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Interrupted" Command="{Binding InterruptedCommand}" IsVisible="{Binding !IsAway}"
                                          ToolTip.Tip="Someone at your desk or a call: the same pause, kept apart in History" />
                                <MenuItem Header="Side task" Command="{Binding SideTaskCommand}" IsVisible="{Binding !IsAway}"
                                          ToolTip.Tip="A small errand of 5, 10 or 15 minutes: the focus clock pauses, blocking and nudges keep running" />
                                <MenuItem Header="Note for this session…" Click="OnNoteClick" IsVisible="{Binding Capture, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                                          ToolTip.Tip="A line for this session's review in History" />
                                <MenuItem Header="Tell me when all tasks are done" ToggleType="CheckBox" IsChecked="{Binding Checklist.NotifyAllDone, Mode=TwoWay}"
                                          IsVisible="{Binding Checklist.ShowsNotifyChoice, FallbackValue=False}" />
                                <MenuItem Header="{Binding TimerToggle.ButtonText}" Command="{Binding TimerToggle.ToggleCommand}"
                                          IsVisible="{Binding TimerToggle.IsVisible, FallbackValue=False}" />
                                <MenuItem Header="{Binding EndSessionText}" Command="{Binding EndSessionCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding ExtendMessage}"
                               IsVisible="{Binding ExtendMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </WrapPanel>
                <TextBlock Classes="muted tail" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"
                           Text="{Binding Checklist.NextTaskTitle, StringFormat='Next: {0}'}"
                           IsVisible="{Binding Checklist.NextTaskTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
            </Grid>
        </Panel>
    </Grid>
</UserControl>
