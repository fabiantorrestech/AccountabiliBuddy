<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.FocusView"
             x:DataType="vm:FocusViewModel">
    <!-- The inside of Today's main card while a session runs. Planning (the session's first minutes): the question, the
         tasks, "I'm ready" and the time left to plan. Running: the line (chip, profile, end time), the big timer, the task
         in front with its steps, Done / Pause / the ⋯ menu, and what comes next. Nothing else while a session runs. -->
    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip.plan">
            <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
        </Style>
        <Style Selector="TextBlock.done">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <!-- The planning stage's own bar: thin, in the muted ink (accent is for the progress ring and the one main button). -->
        <Style Selector="ProgressBar.planning">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="4" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">

        <!-- Planning: the session's first minutes are for the plan; "I'm ready" ends them. -->
        <StackPanel Spacing="22" IsVisible="{Binding IsPlanning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="chip plan">
                    <TextBlock Text="Plan first" FontSize="13" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding PlanningText}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Classes="display" FontSize="40" TextWrapping="Wrap" Text="What are the three things this session is for?" />
            <ProgressBar Classes="planning" Minimum="0" Maximum="100" Value="{Binding PlanningLeftPercent}" IsVisible="{Binding InPlanningStage}" />
            <views:PlanningTip />
            <Panel IsVisible="{Binding Checklist, Converter={x:Static ObjectConverters.IsNotNull}}">
                <views:ChecklistView DataContext="{Binding Checklist}" MaxWidth="620" HorizontalAlignment="Left" />
            </Panel>
        </StackPanel>

        <!-- Running: the line, the timer, the task in front and its steps. -->
        <StackPanel Spacing="16" IsVisible="{Binding !IsPlanning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="chip">
                    <TextBlock Text="{Binding ChipText}" FontSize="13" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SessionLineText}" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <!-- Scales down instead of clipping when the window is narrow. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock Classes="numeral" Text="{Binding TimeLeftText}" FontSize="120" LetterSpacing="-4"
                           AutomationProperties.Name="Time left" />
            </Viewbox>
            <!-- Stepped away or on a side task: the countdown is paused until "I'm back" or "Back on track". -->
            <Border Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding IsAway}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="PauseCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                    <TextBlock Text="{Binding AwayText}" FontWeight="SemiBold" Foreground="{DynamicResource Ab.Sleep}" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="4" IsVisible="{Binding HasTasks}">
                <TextBlock Classes="display" FontSize="32" TextWrapping="Wrap" Text="{Binding Checklist.CurrentTaskText}" />
                <TextBlock Classes="muted" Text="{Binding CurrentSubtaskText, StringFormat='↳ {0}'}" FontSize="14" TextWrapping="Wrap">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasSubtask" />
                            <Binding Path="!Checklist.CurrentTask.HasSubtasks" FallbackValue="True" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Checklist.CurrentTask.Subtasks}" MaxWidth="520" HorizontalAlignment="Left"
                          IsVisible="{Binding Checklist.CurrentTask.HasSubtasks, FallbackValue=False}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubtaskRowViewModel">
                        <CheckBox IsChecked="{Binding IsDone}" Margin="0,2">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Classes.done="{Binding IsDone}" />
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The actions: Done ticks the task in front (the next comes up), Pause is Step away, ⋯ holds the rest. -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
            <Button Classes="primary pill" Content="I'm ready" Command="{Binding ReadyCommand}" IsVisible="{Binding CanReady}" />
            <Button Grid.Column="1" Classes="primary pill" Content="Done" Command="{Binding Checklist.TickCurrentTaskCommand}"
                    AutomationProperties.Name="Done: tick the task in front">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsPlanning" />
                        <Binding Path="Checklist.CurrentTask" Converter="{x:Static ObjectConverters.IsNotNull}" FallbackValue="False" />
                    </MultiBinding>
                </Button.IsVisible>
            </Button>
            <Button Grid.Column="1" Classes="primary pill" Content="End session · all tasks done" Command="{Binding Checklist.EndAtOnceCommand}"
                    IsVisible="{Binding Checklist.CanEndAtOnce, FallbackValue=False}"
                    ToolTip.Tip="Every task is ticked: the session ends now, with the reason &quot;All tasks done&quot;" />
            <Button Grid.Column="2" Classes="pill" Content="{Binding StepAwayText}" Command="{Binding StepAwayCommand}"
                    IsVisible="{Binding HasStepAway}"
                    ToolTip.Tip="A bathroom break: the countdown pauses until you say you are back on track" />
            <Button Grid.Column="3" Classes="quiet pill" Padding="12,16" ToolTip.Tip="Interrupted, Side task, End session" AutomationProperties.Name="More session actions">
                <mi:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="Interrupted" Command="{Binding InterruptedCommand}" IsVisible="{Binding !IsAway}"
                                  ToolTip.Tip="Someone at your desk or a call: the same pause, kept apart in History" />
                        <MenuItem Header="Side task" Command="{Binding SideTaskCommand}" IsVisible="{Binding !IsAway}"
                                  ToolTip.Tip="A small errand of 5, 10 or 15 minutes: the focus clock pauses, blocking and nudges keep running" />
                        <MenuItem Header="{Binding EndSessionText}" Command="{Binding EndSessionCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock Grid.Column="4" Classes="muted" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       Margin="12,0,0,0" Text="{Binding Checklist.NextTaskTitle, StringFormat='Next: {0}'}"
                       IsVisible="{Binding Checklist.NextTaskTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
            <!-- Planning: the time left to plan, where the running timer would be big. -->
            <TextBlock Grid.Column="5" Classes="numeral muted" FontSize="56" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="{Binding TimeLeftText}" IsVisible="{Binding IsPlanning}" />
        </Grid>

        <!-- The day so far, and the phone's line. -->
        <TextBlock Classes="muted" Text="{Binding FocusedTodayText}" FontSize="13" TextWrapping="Wrap"
                   IsVisible="{Binding FocusedTodayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding PhoneText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Met}"
                   IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Capture: a thought goes here instead of into a new tab. -->
        <Panel DataContext="{Binding Capture}" x:DataType="vm:CaptureBoxViewModel"
               IsVisible="{Binding $parent[UserControl].((vm:FocusViewModel)DataContext).Capture, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding Text}" PlaceholderText="A thought? Type it, Enter keeps it for later">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ToggleButton Grid.Column="1" Classes="choice" Content="⚑" IsChecked="{Binding IsComeback}"
                                  ToolTip.Tip="Must not drift: park it under Come back to (or start the line with !)" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding Message}" FontSize="12"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap"
                           Text="Enter keeps a note for this session's review · ⚑ or a leading ! parks it under Come back to" />
            </StackPanel>
        </Panel>

        <!-- All the tasks (add, rename, move, categories) stay one click away while it runs. -->
        <Expander Header="{Binding Checklist.Heading}" HorizontalAlignment="Stretch" IsVisible="{Binding !IsPlanning}"
                  IsExpanded="False">
            <Panel IsVisible="{Binding Checklist, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,8,0,0">
                <views:ChecklistView DataContext="{Binding Checklist}" />
            </Panel>
        </Expander>
    </StackPanel>
</UserControl>
