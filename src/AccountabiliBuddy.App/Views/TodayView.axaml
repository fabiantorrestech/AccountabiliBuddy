<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             x:Class="AccountabiliBuddy.App.Views.TodayView"
             x:DataType="vm:SessionViewModel">
    <!-- The Today page (round 2, brief §4.2, CN §1 and §3 PC): "Today · Wed 11/11" with the page's Options; then the session card in a
         340-wide slot on the left (SessionCardView: the ring, its line, Done · step / Step away / ⋯, the note line; or the start card)
         and This session's list on the right (the current task tinted with Now and its steps open; Queued, Reminders due today and
         Finished today folded under it). The same skeleton in and out of a session (rule 7). The Today sidebar (TodaySidebarView) slides
         OVER the list from the right and hides to a rail during a session (rule 2: its rail's room is reserved, nothing moves). Under the
         session card: the day's notices, "Seen while planning", the session review and the "More today" fold. The shutdown routine takes
         the list's slot while it runs. "Jot it down · Ctrl+J" sits at the bottom left. -->
    <UserControl.Resources>
        <!-- Check boxes and the fold read in ink, not accent: accent is for the progress ring and the one main button. -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource Ab.InkColor}" />
        <!-- The alarm switch, on: ink fill, Bg knob. -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource Ab.BgColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource Ab.BgColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource Ab.BgColor}" />
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- A come-back's ✎ and "Add to tasks": small and flat, like the checklist's row buttons. -->
        <Style Selector="Button.comebackAction">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A panel inside a card or the fold: Surface2, no tint. -->
        <Style Selector="Border.inner">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.count">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A switched-on toggle (Distracting / Fine / Ignore, weekdays): ink on Surface2, never accent. -->
        <Style Selector="ToggleButton.choice:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.choice:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <!-- The week switch (1, 2, 3…): outlined, the current week filled and bold. -->
        <Style Selector="Button.week /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.week:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
        </Style>
        <Style Selector="Button.week.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.week.current">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Status icons: coloured by meaning, or muted while the colour setting is Quiet (the Ab.IsQuietColour resource). -->
        <Style Selector="mi|MaterialIcon.met">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Met}" />
        </Style>
        <Style Selector="mi|MaterialIcon.waiting">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Waiting}" />
        </Style>
        <Style Selector="mi|MaterialIcon.quiet">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="controls|ProgressRing.goalRing">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <Style Selector="controls|ProgressRing.goalRing.running">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="controls|ProgressRing.stepsRing">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <Style Selector="controls|ProgressRing.stepsRing.met">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Met}" />
        </Style>
        <!-- This session's card on the right; the folded sections sit under it, outside the card. -->
        <Style Selector="Border.sessionList">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Ab.CardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.CardRadius}" />
            <Setter Property="Padding" Value="6,8,6,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Container.Name="TodayRoot" Container.Sizing="Width">
        <!-- The page header (round 2, brief §3.3): "Today · Wed 11/11", Expand / collapse all (icon only), then the bordered Options
             (tune), last; its last row opens Settings › Today. -->
        <controls:PageHeader x:Name="TodayHeader" Margin="27,21,44,9" Title="Today" DataContext="{Binding TaskPage}" x:DataType="vm:TasksViewModel"
                             Date="{Binding TodayDateText, FallbackValue={x:Null}}" OptionsRequested="OnTodayOptionsRequested">
            <controls:PageHeader.Actions>
                <Button Classes="abHeaderIcon" Command="{Binding TodayTabPanel.ToggleExpandCommand, FallbackValue={x:Null}}"
                        ToolTip.Tip="{Binding TodayTabPanel.ExpandTip, FallbackValue={x:Null}}"
                        AutomationProperties.Name="{Binding TodayTabPanel.ExpandTip, FallbackValue={x:Null}}">
                    <mi:MaterialIcon Kind="{Binding TodayTabPanel.ExpandIcon, FallbackValue=UnfoldMoreHorizontal}" Width="18" Height="18" />
                </Button>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Panel Grid.Row="1">
            <!-- The page scrolls as one; 30 DIP on the right are the sidebar rail's (reserved, so the rail never covers a row). -->
            <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" Margin="0,0,30,0">
                <Grid x:Name="Columns" ColumnDefinitions="340,*" ColumnSpacing="20" Margin="26,0,14,16">

                    <!-- ===== Left: the session card (same slot in and out of a session), then the day's notices and the fold. ===== -->
                    <StackPanel x:Name="CardColumn" Spacing="14" VerticalAlignment="Top">
                        <views:SessionCardView x:Name="SessionCard" IsVisible="{Binding MainColumn.ShowsSessionCard, FallbackValue=True}" />
                        <StackPanel Spacing="10">
                            <!-- The error text (a failed Pomodoro start, a read-only settings file). -->
                            <Border Classes="inner" Background="{DynamicResource Ab.InfoBg}" Padding="18,12"
                                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Ab.InfoInk}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Waits running in the background (ADR 66): an armed end, an unlock or a new spare key, each with Cancel. -->
                            <Border Classes="inner" DataContext="{Binding RunningWaits}" x:DataType="vm:RunningWaitsViewModel"
                                    IsVisible="{Binding HasWaits, FallbackValue=False}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <mi:MaterialIcon Kind="TimerSand" Width="20" Height="20" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{DynamicResource Ab.InfoInk}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RunningWaitRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- The overlay was turned off with the Ctrl+Alt panel's Disable: Turn on here, or the switch in Settings. -->
                            <Border Classes="inner" DataContext="{Binding OverlayStatus}" x:DataType="vm:OverlayStatusViewModel"
                                    IsVisible="{Binding IsOffFromPanel, FallbackValue=False}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <mi:MaterialIcon Kind="Power" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Overlay turned off from the panel" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="No timer over the taskbar and no Ctrl+Alt panel until you turn it on here." />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Turn on" Command="{Binding TurnOnCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Ctrl+Alt+H keeps the overlay hidden: a quiet line, not a card. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,0" DataContext="{Binding OverlayStatus}" x:DataType="vm:OverlayStatusViewModel"
                                  IsVisible="{Binding IsHidden, FallbackValue=False}">
                                <mi:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding HiddenText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="2" Classes="quiet" Content="Show" Command="{Binding ShowCommand}" FontSize="12" Padding="8,2" MinHeight="0" />
                            </Grid>
                        </StackPanel>

                        <!-- TD1: one-time quiet card, steps left Today for Goals. One tap makes the goal (never made on its own); × hides it for good. -->
                        <Border Classes="inner" Padding="14,10" DataContext="{Binding StepsMoved}" x:DataType="vm:StepsMovedCardViewModel"
                                IsVisible="{Binding IsVisible, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <mi:MaterialIcon Kind="Walk" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource Ab.Muted}" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Steps now live in Goals" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Classes="quiet" HorizontalAlignment="Left" Command="{Binding AddGoalCommand}" Padding="8,4" AutomationProperties.Name="Add a steps goal">
                                        <TextBlock Text="Add a steps goal" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="quiet" VerticalAlignment="Top" Command="{Binding DismissCommand}" Padding="6,4" MinHeight="0"
                                        ToolTip.Tip="Don't show this again" AutomationProperties.Name="Hide this note">
                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Seen while planning: the sites and apps with no rule noticed so far; planning stage only, once there is one. They are
                             asked about together when planning ends. -->
                        <Border Classes="card" DataContext="{Binding SeenWhilePlanning}" x:DataType="vm:SeenWhilePlanningViewModel"
                                IsVisible="{Binding IsVisible, FallbackValue=False}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section" Text="Seen while planning" />
                                <TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Subjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="count" Padding="13,7">
                                                <TextBlock Text="{Binding}" FontSize="13" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- After a session: what it used with no rule, as rules (Distracting / Fine / Ignore). -->
                        <Panel IsVisible="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <views:SessionReviewView DataContext="{Binding Review}" />
                        </Panel>

                        <!-- ===== More today: what is not the day's main job, folded. ===== -->
                        <Border x:Name="MoreTodayCard" Classes="card" Padding="10,6" IsVisible="{Binding MoreToday.ShowsCard, FallbackValue=True}">
                            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="More today" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Classes="count" IsVisible="{Binding MoreToday.HasAlert, FallbackValue=False}">
                                            <TextBlock Text="{Binding MoreToday.AlertText, FallbackValue={x:Null}}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="10" Margin="0,8,0,4">
                                    <!-- The day bar, the same one the main window shows on History. -->
                                    <Expander DataContext="{Binding Day}" x:DataType="vm:DayBarViewModel" Header="Today's timeline"
                                              HorizontalAlignment="Stretch" IsVisible="{Binding IsVisible, FallbackValue=False}">
                                        <StackPanel Spacing="6" Margin="0,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsSleep}">
                                                <Ellipse Width="8" Height="8" Fill="{Binding SleepBrush}" VerticalAlignment="Center" />
                                                <TextBlock Classes="muted" Text="{Binding SleepText}" />
                                            </StackPanel>
                                            <controls:DayBarControl Layout="{Binding Layout}" EventRequested="OnDayBarEvent" OpenProfileCommand="{Binding OpenProfileCommand}"
                                                                    OpenDayPlanCommand="{Binding OpenDayPlanCommand}" AddSessionCommand="{Binding AddSessionCommand}" />
                                            <TextBlock Classes="muted" Text="{Binding SummaryText}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- MIG1: after the task migration, the open tasks of the earlier version wait in To sort; never shown during a session. -->
                                    <Border Classes="inner" DataContext="{Binding EarlierTasks}" x:DataType="vm:EarlierTasksCardViewModel"
                                            IsVisible="{Binding IsVisible, FallbackValue=False}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Sort them now" Command="{Binding SortThemNowCommand}" />
                                            <Button Grid.Column="2" Classes="quiet" Width="30" Height="30" Padding="0" MinHeight="0" MinWidth="0" Command="{Binding DismissCommand}"
                                                    AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss for good">
                                                <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Migration assistant: after an upgrade that brought something to set up. -->
                                    <Border Classes="inner" DataContext="{Binding WhatsNew}" x:DataType="vm:WhatsNewCardViewModel"
                                            IsVisible="{Binding IsVisible, FallbackValue=False}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Set up" Command="{Binding SetUpCommand}" />
                                            <Button Grid.Column="2" Classes="quiet" Content="Not now" Command="{Binding NotNowCommand}" />
                                        </Grid>
                                    </Border>

                                    <!-- Repeating weeks (ADR 47): which week of the cycle this one is. A switch that frees today's work waits like any looser plan change. -->
                                    <Border Classes="inner" DataContext="{Binding Week}" x:DataType="vm:WeekCardViewModel"
                                            IsVisible="{Binding IsVisible, FallbackValue=False}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                <mi:MaterialIcon Kind="CalendarWeek" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <!-- Under the title and wrapping: the main column is only about 200 px inside the card in the real window. -->
                                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Choices}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:WeekChoiceViewModel">
                                                            <!-- The current week is the filled one (ink on Surface, bold), not accent. -->
                                                            <Button Content="{Binding Number}" Classes="week" Classes.current="{Binding IsCurrent}" MinWidth="40"
                                                                    Command="{Binding $parent[ItemsControl].((vm:WeekCardViewModel)DataContext).SetWeekCommand}"
                                                                    CommandParameter="{Binding Number}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource Ab.Waiting}" TextWrapping="Wrap"
                                                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- A day off taken in the Pre-Work window: Undo if it was a mistake. -->
                                    <Border Classes="inner" Padding="16,10" DataContext="{Binding DayOff}" x:DataType="vm:DayOffCardViewModel"
                                            IsVisible="{Binding IsVisible, FallbackValue=False}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <DockPanel>
                                                <mi:MaterialIcon DockPanel.Dock="Left" Kind="Beach" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                <Panel Width="8" DockPanel.Dock="Left" />
                                                <TextBlock Text="Day off on this computer: no Pre-Work, work-hours guard or start nudges today." VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" />
                                        </Grid>
                                    </Border>

                                    <!-- Cold Turkey: which of its blocks are on (read from its settings; nothing is changed there). -->
                                    <Border Classes="inner" DataContext="{Binding ColdTurkey}" x:DataType="vm:ColdTurkeyStatusViewModel"
                                            IsVisible="{Binding IsVisible, FallbackValue=False}">
                                        <StackPanel Spacing="6">
                                            <DockPanel>
                                                <mi:MaterialIcon DockPanel.Dock="Left" Kind="Snowflake" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                <Panel Width="8" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColdTurkeyBlockRow">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Classes="muted" Text="{Binding StateText}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap"
                                                       Text="Read from Cold Turkey's settings; this app never changes them. Which blocks a profile expects is set in Profiles." />
                                        </StackPanel>
                                    </Border>

                                    <!-- Unlock: lift the blocks after a wait (options are set per profile). Folded away unless it's in progress. -->
                                    <Expander DataContext="{Binding Unlock}" x:DataType="vm:UnlockViewModel" IsVisible="{Binding IsVisible}"
                                              IsExpanded="{Binding !IsFormVisible, Mode=OneWay}" HorizontalAlignment="Stretch"
                                              Header="Unlock (lift the blocks after a wait)">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                            <StackPanel Spacing="8" IsVisible="{Binding IsFormVisible}">
                                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinWidth="220" />
                                                    <ComboBox ItemsSource="{Binding RelockChoices}" SelectedItem="{Binding SelectedRelock}" MinWidth="180" />
                                                    <TextBox Text="{Binding RelockTimeText}" IsVisible="{Binding IsRelockTimeVisible}"
                                                             PlaceholderText="e.g. 6pm" Width="100" />
                                                </WrapPanel>
                                                <TextBox Text="{Binding Reason}" PlaceholderText="{Binding ReasonHint}" />
                                                <Button Content="Start unlock countdown" Command="{Binding RequestCommand}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Button Content="Cancel unlock" Command="{Binding CancelCommand}" IsVisible="{Binding IsWaiting}" HorizontalAlignment="Left" />
                                            <Button Content="Lock again" Command="{Binding LockAgainCommand}" IsVisible="{Binding IsUnlocked}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Ab.Drift}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>

                    <!-- ===== Right: This session's list (or the shutdown routine while it runs). ===== -->
                    <Panel Grid.Column="1" VerticalAlignment="Top">
                        <Border Classes="card" Padding="28,24">
                            <Border.IsVisible>
                                <Binding Path="ShowsShutdown" />
                            </Border.IsVisible>
                            <Panel IsVisible="{Binding ShowsShutdown}">
                                <StackPanel Spacing="16" DataContext="{Binding Shutdown}" x:DataType="vm:ShutdownCardViewModel">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <mi:MaterialIcon Kind="WeatherSunset" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                        <TextBlock Grid.Column="1" Classes="display" Text="{Binding Title}" FontSize="32" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="faint" FontSize="12" Text="{Binding StepText}" />
                                        <TextBlock Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 1. Empty your capture: each parked thought gets a home. -->
                                    <Border Classes="inner" IsVisible="{Binding IsCapture}">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <mi:MaterialIcon Kind="FlagOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                <TextBlock Classes="section" Text="Come back to" VerticalAlignment="Center" />
                                                <TextBlock Classes="muted" Text="{Binding ComebackCount}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Comebacks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShutdownComebackRow">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding DueDate}" IsVisible="{Binding AsksForDate}"
                                                                                PlaceholderText="Due (optional)" AutomationProperties.Name="Due date" />
                                                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ShutdownComebackRow.ChoiceNames}" SelectedIndex="{Binding ChoiceIndex}"
                                                                      MinWidth="150" AutomationProperties.Name="What to do with it" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Unfinished tasks: tick what's done, the rest carries over. -->
                                    <Border Classes="inner" IsVisible="{Binding IsUnfinished}">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <mi:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                <TextBlock Classes="section" Text="Left open" VerticalAlignment="Center" />
                                                <TextBlock Classes="muted" Text="{Binding UnfinishedCount}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding UnfinishedGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShutdownTaskGroup">
                                                        <StackPanel Spacing="2" Margin="0,4,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" IsVisible="{Binding HasCategory}" />
                                                                <TextBlock Classes="muted" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ShutdownTaskRow">
                                                                        <CheckBox IsChecked="{Binding IsDone}" Content="{Binding Title}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Look ahead: Later items due soon and the calendar's next two weeks (read-only). -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsLookAhead}">
                                        <Border Classes="inner" IsVisible="{Binding HasLaterDueSoon}">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mi:MaterialIcon Kind="ClockOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                    <TextBlock Classes="section" Text="Later, due soon" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding LaterDueSoon}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ShutdownLaterRow">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding DueText}" FontSize="12" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="inner" IsVisible="{Binding HasCalendarAhead}">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mi:MaterialIcon Kind="CalendarMonthOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                    <TextBlock Classes="section" Text="On your calendar" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding CalendarAhead}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ShutdownAheadDay">
                                                            <Grid ColumnDefinitions="56,*" Margin="0,10,0,0">
                                                                <!-- The day's label, as in Google Calendar's agenda widget. -->
                                                                <StackPanel Spacing="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                    <TextBlock Classes="muted" Text="{Binding Weekday}" FontSize="12" />
                                                                    <TextBlock Text="{Binding DayNumber}" FontSize="22" FontWeight="SemiBold" />
                                                                    <TextBlock Classes="muted" Text="Tomorrow" FontSize="10" IsVisible="{Binding IsTomorrow}" TextWrapping="NoWrap" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="6">
                                                                    <ItemsControl ItemsSource="{Binding Events}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Spacing="6" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ShutdownAheadEvent">
                                                                                <Border Background="{Binding Background}" CornerRadius="12" Padding="12,8">
                                                                                    <StackPanel Spacing="1">
                                                                                        <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}" FontSize="14" FontWeight="SemiBold"
                                                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding TimeText}" Foreground="{Binding Foreground}" FontSize="12" IsVisible="{Binding IsTimed}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock Classes="muted" Text="{Binding MoreText}" FontSize="12" IsVisible="{Binding HasMore}" Margin="4,0,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="muted" Text="Nothing is due soon and nothing is on your calendar for the next two weeks." TextWrapping="Wrap"
                                                   IsVisible="{Binding NothingAhead}" />
                                    </StackPanel>

                                    <!-- 4. Plan tomorrow: up to three tasks in tomorrow's day parts, and the quick path (tomorrow's first task). -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsPlanTomorrow}">
                                        <Border Classes="inner" IsVisible="{Binding HasPlanRows}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section" Text="Tomorrow's top tasks" />
                                                <ItemsControl ItemsSource="{Binding PlanRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ShutdownPlanRowViewModel">
                                                            <StackPanel Spacing="0" Margin="0,0,0,6">
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                                    <TextBox Text="{Binding Text}" PlaceholderText="A task for tomorrow" AutomationProperties.Name="A task for tomorrow"
                                                                             controls:TaskSuggestions.Picker="{Binding Picker}" controls:TaskSuggestions.KeepsText="True" />
                                                                    <Button Grid.Column="1" Classes="quiet" Padding="8,4" VerticalAlignment="Center"
                                                                            ToolTip.Tip="Choose one of your tasks" AutomationProperties.Name="From your lists">
                                                                        <mi:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16" />
                                                                        <Button.Flyout>
                                                                            <Flyout Placement="BottomEdgeAlignedRight" Opening="OnTomorrowPickerOpening">
                                                                                <views:ListPickerView DataContext="{Binding Picker}" />
                                                                            </Flyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Parts}" SelectedIndex="{Binding PartIndex}" MinWidth="190"
                                                                              AutomationProperties.Name="Day part">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ShutdownPartChoice">
                                                                                <TextBlock Text="{Binding Label}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                                <views:TaskSuggestionsView DataContext="{Binding Picker}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap"
                                                           Text="A task waits on your Later list until its part starts, then joins that session's list." />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="muted" IsVisible="{Binding HasNoPlanParts}" TextWrapping="Wrap"
                                                   Text="Tomorrow's plan has no parts to put a task in. You can still set tomorrow's first task below." />
                                        <StackPanel Spacing="0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox Text="{Binding TomorrowTask}" PlaceholderText="Tomorrow's first task (it waits at the top of Today's checklist)"
                                                         AutomationProperties.Name="Tomorrow's first task"
                                                         controls:TaskSuggestions.Picker="{Binding TomorrowPicker}" controls:TaskSuggestions.KeepsText="True" />
                                                <Button Grid.Column="1" x:Name="TomorrowListButton" Classes="quiet" Padding="8,4" VerticalAlignment="Center"
                                                        ToolTip.Tip="Choose one of your tasks: it moves to the top of tomorrow's list" AutomationProperties.Name="From your lists">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <mi:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16" />
                                                        <TextBlock Text="From your lists" FontSize="13" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedRight" Opening="OnTomorrowPickerOpening">
                                                            <views:ListPickerView DataContext="{Binding TomorrowPicker}" />
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <views:TaskSuggestionsView DataContext="{Binding TomorrowPicker}" />
                                        </StackPanel>
                                        <Button Classes="quiet" HorizontalAlignment="Left" Command="{Binding OpenPlanCommand}" Padding="8,4" AutomationProperties.Name="Open the Plan page">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mi:MaterialIcon Kind="ViewAgendaOutline" Width="16" Height="16" />
                                                <TextBlock Text="Edit tomorrow's plan" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 5. Today in review: focus against the goal, drift, what got done, how did today go. -->
                                    <Border Classes="inner" IsVisible="{Binding IsReview}">
                                        <StackPanel Spacing="10" DataContext="{Binding Review}" x:DataType="vm:ShutdownReviewViewModel">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mi:MaterialIcon Kind="TargetVariant" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                    <TextBlock Classes="section" Text="Focus" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FocusText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DriftText}" IsVisible="{Binding HasDrift}" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Spacing="2" IsVisible="{Binding HasDone}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mi:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                    <TextBlock Classes="section" Text="Done" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding DoneLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mi:MaterialIcon Kind="EmoticonNeutralOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                    <TextBlock Classes="section" Text="How did today go? (optional)" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Classes="quiet" HorizontalAlignment="Left" Content="No feeling" Command="{Binding ClearFeelingCommand}"
                                                        FontSize="12" Padding="8,2" MinHeight="0" AutomationProperties.Name="Take the feeling back" />
                                                <ItemsControl ItemsSource="{Binding FeelingOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ShutdownFeelingOption">
                                                            <RadioButton IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,12,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBox Text="{Binding Note}" MaxLength="{x:Static vm:ShutdownReviewViewModel.MaxNoteLength}" PlaceholderText="One line about the day (stays sealed on this PC)"
                                                         AutomationProperties.Name="A line about the day" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. Work over for today: what was checked. -->
                                    <Border Classes="inner" IsVisible="{Binding IsClosing}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="section" Text="You checked" />
                                            <ItemsControl ItemsSource="{Binding CheckedLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                            <mi:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="muted" Text="Nothing was checked: you skipped every step." TextWrapping="Wrap" IsVisible="{Binding CheckedNothing}" />
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="primary pill" Content="Next" Command="{Binding NextCommand}" IsVisible="{Binding CanSkip}" />
                                        <Button Classes="primary pill" Content="Finish" Command="{Binding FinishCommand}" IsVisible="{Binding IsClosing}" />
                                        <Button Classes="pill" Content="Skip this step" Command="{Binding SkipStepCommand}" IsVisible="{Binding CanSkip}" />
                                        <Button Classes="pill" Content="Not now" Command="{Binding NotNowCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Panel>
                        </Border>
                        <!-- TodayPageScope: only here does the running row get its tint, Now badge and open steps. -->
                        <!-- todayRows: the rows' Today look (TaskRowView, TaskSectionView): the indented sub-line, actions on hover, the board's headers. -->
                        <StackPanel x:Name="TaskList" Classes="todayRows" views:TodayPageScope.IsToday="True"
                                    Container.Name="TaskColumn" Container.Sizing="Width">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!ShowsShutdown" />
                                    <Binding Path="MainColumn.ShowsThisSession" FallbackValue="True" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <ItemsControl DataContext="{Binding TaskPage}" x:DataType="vm:TasksViewModel" ItemsSource="{Binding TodayTabPanel.Sections, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskSectionViewModel">
                                        <Border Classes.sessionList="{Binding IsSessionSection}">
                                            <views:TaskSectionView />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Panel>
                </Grid>
            </ScrollViewer>

            <!-- The Today sidebar: over the list (it covers nothing else: its empty room takes no clicks). -->
            <views:TodaySidebarView x:Name="Sidebar" DataContext="{Binding Sidebar}" IsVisible="{Binding $parent[views:TodayView].((vm:SessionViewModel)DataContext).Sidebar, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
        </Panel>

        <!-- Jot it down rests at the bottom left (fainter during a session; Ctrl+J); the page's toast floats above it. -->
        <Panel Grid.Row="2" DataContext="{Binding TaskPage}" x:DataType="vm:TasksViewModel" IsVisible="{Binding $parent[views:TodayView].((vm:SessionViewModel)DataContext).TaskPage, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <views:JotBoxView DataContext="{Binding Jot}" Margin="22,4,14,12" HorizontalAlignment="Left" MinWidth="240" MaxWidth="420" ZIndex="1" />
            <Canvas Height="0" VerticalAlignment="Top" ZIndex="20">
                <views:TaskToastView DataContext="{Binding Toasts}" Canvas.Left="18" Canvas.Bottom="6" MaxWidth="364" />
            </Canvas>
        </Panel>
    </Grid>
</UserControl>
