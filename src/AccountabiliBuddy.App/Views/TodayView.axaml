<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TodayView"
             x:DataType="vm:SessionViewModel">
    <!-- The Today page (redesign phase 1): one job, starting. Tasks first, then the big Quick Start, Start, and the
         rest folded away. The day bar above the page is the timeline. While a session runs, the running card and its
         tasks show instead. -->
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16" Width="560" HorizontalAlignment="Center">

            <!-- Running: Focus mode (countdown, End session, the task in front, Step away). -->
            <Panel IsVisible="{Binding IsSessionActive}">
                <views:FocusView DataContext="{Binding Focus}" />
            </Panel>
            <Panel IsVisible="{Binding IsSessionActive}">
                <Button DataContext="{Binding TimerToggle}" x:DataType="vm:TimerToggleViewModel"
                        Content="{Binding ButtonText}" Command="{Binding ToggleCommand}"
                        IsVisible="{Binding IsVisible, FallbackValue=False}" HorizontalAlignment="Left" />
            </Panel>

            <!-- The shutdown card (redesign phase 5): once after the day's last work part. -->
            <Border Padding="16,12" CornerRadius="10" Background="#1A6366F1" BorderBrush="#556366F1" BorderThickness="1"
                    DataContext="{Binding Shutdown}" x:DataType="vm:ShutdownCardViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).Shutdown, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Wrap up the day" FontWeight="SemiBold" FontSize="16" />
                    <StackPanel Spacing="2" IsVisible="{Binding HasComebacks}">
                        <TextBlock Text="Come-backs: tick the ones that are done" Opacity="0.8" />
                        <ItemsControl ItemsSource="{Binding Comebacks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShutdownComebackRow">
                                    <CheckBox IsChecked="{Binding IsDone}" Content="{Binding Text}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding HasUnfinished}">
                        <TextBlock Text="Left open today: ticked ones carry into tomorrow's checklist" Opacity="0.8" />
                        <ItemsControl ItemsSource="{Binding Unfinished}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShutdownTaskRow">
                                    <CheckBox IsChecked="{Binding Carry}" Content="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBox Text="{Binding TomorrowTask}" PlaceholderText="Tomorrow's first task (it waits at the top of Today's checklist)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Done for today" Command="{Binding DoneCommand}" Classes="accent" />
                        <Button Content="Skip" Command="{Binding SkipCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Today's deep work against the daily goal (redesign phase 4). -->
            <Border Padding="16,12" CornerRadius="10" Background="#1A2A9D8F" BorderBrush="#552A9D8F" BorderThickness="1"
                    DataContext="{Binding Goal}" x:DataType="vm:GoalCardViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).Goal, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="Deep work today" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" Opacity="0.85" />
                        <Button Grid.Column="2" Content="✎" Command="{Binding EditCommand}" ToolTip.Tip="Change the daily goal" Padding="8,2" />
                    </Grid>
                    <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100" Height="8" Foreground="#2A9D8F" />
                    <TextBlock Text="{Binding PhoneText}" Foreground="#22C55E" TextWrapping="Wrap"
                               IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#F4A261" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                        <TextBlock Text="Daily goal" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding GoalMinutes}" Minimum="30" Maximum="480" Increment="15" FormatString="0" Width="120" />
                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Come back to: parked ideas until ticked (idle and in Focus mode). Ctrl+Alt+N adds one from anywhere. -->
            <Border Padding="16" CornerRadius="10" Background="#1AD97757" BorderBrush="#55D97757" BorderThickness="1"
                    DataContext="{Binding Comebacks}" x:DataType="vm:ComebacksViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).Comebacks, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Come back to" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComebackRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                                    <CheckBox Command="{Binding TickCommand}" ToolTip.Tip="Done: tick it off" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding NewText}" PlaceholderText="Park an idea (Enter) · or Ctrl+Alt+N anywhere">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>
            </Border>

            <!-- After a session: what it used with no rule, as rules (Distracting / Fine / Ignore). -->
            <Panel IsVisible="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}">
                <views:SessionReviewView DataContext="{Binding Review}" />
            </Panel>

            <!-- New here: no profiles yet. -->
            <Border IsVisible="{Binding ShowsWelcome}" Padding="20" CornerRadius="10"
                    Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Welcome! Let's set up your first focus profile" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="A profile says what counts as distracting while you focus (sites and apps to block). Start with the example, which blocks common time-wasters like YouTube, Reddit and social media; you can change it any time." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Add the example profile" Command="{Binding AddExampleProfileCommand}" Classes="accent" />
                        <Button Content="Make my own in Profiles" Command="{Binding OpenProfilesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Idle: the start card. Tasks, Quick Start with Default, Start, and More options folded away. -->
            <StackPanel Spacing="16" IsVisible="{Binding ShowsStart}">
                <Border Padding="20" CornerRadius="10" Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <!-- The day's status is in the day bar's header above; the card is for starting. -->
                        <views:QuickStartPanel DataContext="{Binding QuickStart}" />
                        <TextBlock Text="{Binding HotkeyTip}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Header="Other ways to start: Pomodoro, no set end" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Pomodoro" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PomodoroSummary}" Opacity="0.75" TextWrapping="Wrap" />
                            <TextBlock Text="Focus cycles (blank = until you stop it)" Opacity="0.75" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding PomodoroCycles}" Width="120" />
                                <Button Content="Start Pomodoro" Command="{Binding StartPomodoroCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="No set end" FontWeight="SemiBold" />
                            <TextBlock Text="Runs until you end it; ending it takes no wait or reason." Opacity="0.75" TextWrapping="Wrap" />
                            <Button Content="Start until I end it" Command="{Binding StartOpenEndedCommand}" />
                        </StackPanel>
                        <TextBlock Text="Uses the profile picked under More options. Pomodoro lengths are set in Settings." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- Unlock: lift the blocks after a wait (options are set per profile). Folded away unless it's in progress. -->
            <Expander DataContext="{Binding Unlock}" x:DataType="vm:UnlockViewModel" IsVisible="{Binding IsVisible}"
                      IsExpanded="{Binding !IsFormVisible, Mode=OneWay}" HorizontalAlignment="Stretch"
                      Header="Unlock (lift the blocks after a wait)">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <StackPanel Spacing="8" IsVisible="{Binding IsFormVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinWidth="220" />
                            <ComboBox ItemsSource="{Binding RelockChoices}" SelectedItem="{Binding SelectedRelock}" MinWidth="180" />
                            <TextBox Text="{Binding RelockTimeText}" IsVisible="{Binding IsRelockTimeVisible}"
                                     PlaceholderText="e.g. 6pm" Width="100" />
                        </StackPanel>
                        <TextBox Text="{Binding Reason}" PlaceholderText="{Binding ReasonHint}" />
                        <Button Content="Start unlock countdown" Command="{Binding RequestCommand}" />
                    </StackPanel>
                    <Button Content="Cancel unlock" Command="{Binding CancelCommand}" IsVisible="{Binding IsWaiting}" />
                    <Button Content="Lock again" Command="{Binding LockAgainCommand}" Classes="accent"
                            IsVisible="{Binding IsUnlocked}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!-- Cold Turkey: which of its blocks are on (read from its settings; nothing is changed there). -->
            <Border DataContext="{Binding ColdTurkey}" x:DataType="vm:ColdTurkeyStatusViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}" Padding="16" CornerRadius="10"
                    Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColdTurkeyBlockRow">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding StateText}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Text="Read from Cold Turkey's settings; this app never changes them. Which blocks a profile expects is set in Profiles." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
