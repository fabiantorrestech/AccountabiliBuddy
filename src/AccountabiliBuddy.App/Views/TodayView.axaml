<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TodayView"
             x:DataType="vm:SessionViewModel">
    <!-- The Today page (redesign phase 1): one job, starting. Tasks first, then the big Quick Start, Start, and the
         rest folded away. The day bar above the page is the timeline. While a session runs, the running card and its
         tasks show instead. -->
    <UserControl.Styles>
        <!-- A come-back's ✎ and "Add to tasks": small and flat, like the checklist's row buttons. -->
        <Style Selector="Button.comebackAction">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16" Width="560" HorizontalAlignment="Center">

            <!-- Running: Focus mode (countdown, End session, the task in front, Step away). -->
            <Panel IsVisible="{Binding IsSessionActive}">
                <views:FocusView DataContext="{Binding Focus}" />
            </Panel>
            <Panel IsVisible="{Binding IsSessionActive}">
                <Button DataContext="{Binding TimerToggle}" x:DataType="vm:TimerToggleViewModel"
                        Content="{Binding ButtonText}" Command="{Binding ToggleCommand}"
                        IsVisible="{Binding IsVisible, FallbackValue=False}" HorizontalAlignment="Left" />
            </Panel>

            <!-- Migration assistant: after an upgrade that brought something to set up. -->
            <Border Padding="14,10" CornerRadius="10" Background="#146366F1" BorderBrush="#446366F1" BorderThickness="1"
                    DataContext="{Binding WhatsNew}" x:DataType="vm:WhatsNewCardViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Set up" Command="{Binding SetUpCommand}" Classes="accent" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="Not now" Command="{Binding NotNowCommand}" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- ADR 37: one-off days from three questions (kind of day, sleep, blocks). -->
            <Button Content="Plan day(s)…" Command="{Binding PlanDayCommand}" IsVisible="{Binding !IsSessionActive}" HorizontalAlignment="Right"
                    ToolTip.Tip="An adjusted workday or an off-day: its sleep and which blocks to lift" />

            <!-- The shutdown card (redesign phase 5): once after the day's last work part. -->
            <Border Padding="16,12" CornerRadius="10" Background="#1A6366F1" BorderBrush="#556366F1" BorderThickness="1"
                    DataContext="{Binding Shutdown}" x:DataType="vm:ShutdownCardViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).Shutdown, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="WeatherSunset" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Wrap up the day" FontWeight="SemiBold" FontSize="16" /></StackPanel>
                    <TextBlock Text="Tick what's done. The rest carries over." Opacity="0.8" />
                    <Border Padding="12,8" CornerRadius="8" Background="#1A2A9D8F" IsVisible="{Binding HasComebacks}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="FlagOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="Come back to" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ComebackCount}" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Comebacks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShutdownComebackRow">
                                        <CheckBox IsChecked="{Binding IsDone}" Content="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Padding="12,8" CornerRadius="8" Background="#1AF4A261" IsVisible="{Binding HasUnfinished}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="Left open" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UnfinishedCount}" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding UnfinishedGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShutdownTaskGroup">
                                        <StackPanel Spacing="2" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" IsVisible="{Binding HasCategory}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShutdownTaskRow">
                                                        <CheckBox IsChecked="{Binding IsDone}" Content="{Binding Title}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBox Text="{Binding TomorrowTask}" PlaceholderText="Tomorrow's first task (it waits at the top of Today's checklist)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Done for today" Command="{Binding DoneCommand}" Classes="accent" />
                        <Button Content="Skip" Command="{Binding SkipCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- A day off taken in the Pre-Work window: Undo if it was a mistake. -->
            <Border Padding="16,10" CornerRadius="10" Background="#1AF4A261" BorderBrush="#55F4A261" BorderThickness="1"
                    DataContext="{Binding DayOff}" x:DataType="vm:DayOffCardViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <DockPanel><mi:MaterialIcon DockPanel.Dock="Left" Kind="Beach" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><Panel Width="8" DockPanel.Dock="Left" /><TextBlock Text="Day off on this computer: no Pre-Work, work-hours guard or start nudges today." VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
                    <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" />
                </Grid>
            </Border>

            <!-- Flexible lunch (schema v8): start it on any workday; then the time left, +5 / −5 min and "I'm back". -->
            <Border Padding="16,12" CornerRadius="10" Background="#1ACA8A04" BorderBrush="#55CA8A04" BorderThickness="1"
                    DataContext="{Binding Lunch}" x:DataType="vm:LunchCardViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <DockPanel><mi:MaterialIcon DockPanel.Dock="Left" Kind="SilverwareForkKnife" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><Panel Width="8" DockPanel.Dock="Left" /><TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" /></DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Start lunch" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" Classes="accent" />
                        <Button Content="−5 min" Command="{Binding ShorterCommand}" IsVisible="{Binding IsOnLunch}" IsEnabled="{Binding CanShorten}"
                                ToolTip.Tip="End lunch 5 minutes sooner (never less than a minute from now); your other devices follow" />
                        <Button Content="+5 min" Command="{Binding LongerCommand}" IsVisible="{Binding IsOnLunch}"
                                ToolTip.Tip="5 more minutes of lunch; your other devices follow" />
                        <Button Content="I'm back" Command="{Binding BackCommand}" IsVisible="{Binding IsOnLunch}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Today's deep work against the daily goal (redesign phase 4). -->
            <Border Padding="16,12" CornerRadius="10" Background="#1A2A9D8F" BorderBrush="#552A9D8F" BorderThickness="1"
                    DataContext="{Binding Goal}" x:DataType="vm:GoalCardViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).Goal, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="BullseyeArrow" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Deep work today" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" Opacity="0.85" />
                        <Button Grid.Column="2" Content="✎" Command="{Binding EditCommand}" ToolTip.Tip="Change the daily goal" Padding="8,2" />
                    </Grid>
                    <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100" Height="8" Foreground="#2A9D8F" />
                    <!-- A Budget day's pace (ADR 47): the budget left and the day left for it; amber when the day can't hold it any more. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPaceOnTrack}">
                        <mi:MaterialIcon Kind="TimerSand" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock Text="{Binding PaceText}" VerticalAlignment="Center" Opacity="0.9" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPaceBehind}">
                        <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="#F4A261" />
                        <TextBlock Text="{Binding PaceText}" VerticalAlignment="Center" Foreground="#F4A261" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding PhoneText}" Foreground="#22C55E" TextWrapping="Wrap"
                               IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#F4A261" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                        <TextBlock Text="Daily goal" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding GoalMinutes}" Minimum="30" Maximum="480" Increment="15" FormatString="0" Width="120" />
                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Repeating weeks (ADR 47): which week of the cycle this one is. A switch that frees today's work waits like any looser plan change. -->
            <Border Padding="16,10" CornerRadius="10" Background="#146366F1" BorderBrush="#446366F1" BorderThickness="1"
                    DataContext="{Binding Week}" x:DataType="vm:WeekCardViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <mi:MaterialIcon Kind="CalendarWeek" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeekChoiceViewModel">
                                    <Button Content="{Binding Number}" Classes.accent="{Binding IsCurrent}" MinWidth="40"
                                            Command="{Binding $parent[ItemsControl].((vm:WeekCardViewModel)DataContext).SetWeekCommand}"
                                            CommandParameter="{Binding Number}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#F4A261" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Beeminder (ADR 43, read only): the user's goals, soonest due first; red when due today. -->
            <Border Padding="16,12" CornerRadius="10" Background="#1AF4A261" BorderBrush="#55F4A261" BorderThickness="1"
                    DataContext="{Binding Beeminder}" x:DataType="vm:BeeminderViewModel"
                    IsVisible="{Binding HasToken, FallbackValue=False}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Bee" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Beeminder" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="No goals to show yet." Opacity="0.7" IsVisible="{Binding !HasGoals}" />
                    <ItemsControl ItemsSource="{Binding Goals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BeeminderGoalRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Needed}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding HasNeeded}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SafeText}" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="SemiBold" IsVisible="{Binding IsDueToday}" />
                                        <TextBlock Text="{Binding SafeText}" HorizontalAlignment="Right" IsVisible="{Binding !IsDueToday}" />
                                        <TextBlock Text="{Binding DueText}" HorizontalAlignment="Right" FontSize="11" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Come back to: parked ideas until ticked (idle and in Focus mode). Ctrl+Alt+N adds one from anywhere. -->
            <Border Padding="16" CornerRadius="10" Background="#1AD97757" BorderBrush="#55D97757" BorderThickness="1"
                    DataContext="{Binding Comebacks}" x:DataType="vm:ComebacksViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:SessionViewModel)DataContext).Comebacks, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="FlagOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Come back to" FontWeight="SemiBold" /></StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <!-- ✎ edits it in place (Enter or click away saves, Esc cancels); the list icon makes it a task at the end of the checklist. -->
                            <DataTemplate x:DataType="vm:ComebackRowViewModel">
                                <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                    <CheckBox Command="{Binding TickCommand}" ToolTip.Tip="Done: tick it off" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" />
                                    <TextBox Grid.Column="1" Text="{Binding EditText}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Come-back text"
                                             PropertyChanged="OnComebackBoxPropertyChanged" LostFocus="OnComebackBoxLostFocus">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Classes="comebackAction" Content="✎" Command="{Binding BeginEditCommand}" ToolTip.Tip="Edit" />
                                    <Button Grid.Column="4" Classes="comebackAction" Command="{Binding AddToTasksCommand}" IsVisible="{Binding CanAddToTasks}"
                                            ToolTip.Tip="Add to tasks: it goes at the end of the checklist and leaves this list" AutomationProperties.Name="Add to tasks">
                                        <mi:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                                <!-- A 4th task: a reason first (3 tasks per session). -->
                                <StackPanel Spacing="4" IsVisible="{Binding IsAskingOverLimit}">
                                    <TextBlock Text="Keep it to 3. Add it anyway? Why (10+ characters, stays on this PC)" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding OverLimitReason}" />
                                    <TextBlock Text="{Binding OverLimitError}" Foreground="#E5484D" TextWrapping="Wrap"
                                               IsVisible="{Binding OverLimitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="small" Content="Add anyway" Command="{Binding ConfirmOverLimitCommand}" />
                                        <Button Classes="small" Content="Cancel" Command="{Binding CancelOverLimitCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding NewText}" PlaceholderText="Park an idea (Enter) · or Ctrl+Alt+N anywhere">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>
            </Border>

            <!-- Timers and alarms (this PC only), idle and in Focus mode. -->
            <Panel IsVisible="{Binding Timers, Converter={x:Static ObjectConverters.IsNotNull}}">
                <views:TimersCardView DataContext="{Binding Timers}" />
            </Panel>

            <!-- After a session: what it used with no rule, as rules (Distracting / Fine / Ignore). -->
            <Panel IsVisible="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}">
                <views:SessionReviewView DataContext="{Binding Review}" />
            </Panel>

            <!-- New here: no profiles yet. -->
            <Border IsVisible="{Binding ShowsWelcome}" Padding="20" CornerRadius="10"
                    Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="HandWave" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Welcome! Let's set up your first focus profile" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="A profile says what counts as distracting while you focus (sites and apps to block). Start with the example, which blocks common time-wasters like YouTube, Reddit and social media; you can change it any time." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Add the example profile" Command="{Binding AddExampleProfileCommand}" Classes="accent" />
                        <Button Content="Make my own in Profiles" Command="{Binding OpenProfilesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Idle: the start card. Tasks, Quick Start with Default, Start, and More options folded away. -->
            <StackPanel Spacing="16" IsVisible="{Binding ShowsStart}">
                <Border Padding="20" CornerRadius="10" Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <!-- The day's status is in the day bar's header above; the card is for starting. -->
                        <views:QuickStartPanel DataContext="{Binding QuickStart}" />
                        <TextBlock Text="{Binding HotkeyTip}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Header="Other ways to start: Pomodoro, no set end" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="TimerOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Pomodoro" FontWeight="SemiBold" /></StackPanel>
                            <TextBlock Text="{Binding PomodoroSummary}" Opacity="0.75" TextWrapping="Wrap" />
                            <TextBlock Text="Focus cycles (blank = until you stop it)" Opacity="0.75" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding PomodoroCycles}" Width="120" />
                                <Button Content="Start Pomodoro" Command="{Binding StartPomodoroCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="AllInclusive" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="No set end" FontWeight="SemiBold" /></StackPanel>
                            <TextBlock Text="Runs until you end it; ending it takes no wait or reason." Opacity="0.75" TextWrapping="Wrap" />
                            <Button Content="Start until I end it" Command="{Binding StartOpenEndedCommand}" />
                        </StackPanel>
                        <TextBlock Text="Uses the profile picked under More options. Pomodoro lengths are set in Settings." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- Unlock: lift the blocks after a wait (options are set per profile). Folded away unless it's in progress. -->
            <Expander DataContext="{Binding Unlock}" x:DataType="vm:UnlockViewModel" IsVisible="{Binding IsVisible}"
                      IsExpanded="{Binding !IsFormVisible, Mode=OneWay}" HorizontalAlignment="Stretch"
                      Header="Unlock (lift the blocks after a wait)">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <StackPanel Spacing="8" IsVisible="{Binding IsFormVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinWidth="220" />
                            <ComboBox ItemsSource="{Binding RelockChoices}" SelectedItem="{Binding SelectedRelock}" MinWidth="180" />
                            <TextBox Text="{Binding RelockTimeText}" IsVisible="{Binding IsRelockTimeVisible}"
                                     PlaceholderText="e.g. 6pm" Width="100" />
                        </StackPanel>
                        <TextBox Text="{Binding Reason}" PlaceholderText="{Binding ReasonHint}" />
                        <Button Content="Start unlock countdown" Command="{Binding RequestCommand}" />
                    </StackPanel>
                    <Button Content="Cancel unlock" Command="{Binding CancelCommand}" IsVisible="{Binding IsWaiting}" />
                    <Button Content="Lock again" Command="{Binding LockAgainCommand}" Classes="accent"
                            IsVisible="{Binding IsUnlocked}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!-- Cold Turkey: which of its blocks are on (read from its settings; nothing is changed there). -->
            <Border DataContext="{Binding ColdTurkey}" x:DataType="vm:ColdTurkeyStatusViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}" Padding="16" CornerRadius="10"
                    Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                <StackPanel Spacing="6">
                    <DockPanel><mi:MaterialIcon DockPanel.Dock="Left" Kind="Snowflake" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" /><Panel Width="8" DockPanel.Dock="Left" /><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" /></DockPanel>
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColdTurkeyBlockRow">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding StateText}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Text="Read from Cold Turkey's settings; this app never changes them. Which blocks a profile expects is set in Profiles." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
