<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.PendingChangesBanner"
             x:DataType="vm:PendingChangesViewModel">
    <!-- The looser-changes queue (hard rules: stricter changes apply at once, looser ones wait): what is waiting, when it applies, and Cancel.
         No "apply now". Info colours, never the accent. -->
    <Border Classes="sInfo" IsVisible="{Binding HasPending}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <mi:MaterialIcon Kind="TimerSand" Width="20" Height="20" VerticalAlignment="Top" Foreground="{DynamicResource Ab.InfoInk}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding AppliesText}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Text="Stricter changes already apply. The editors below show your saved changes; until then the old values are enforced." />
            </StackPanel>
            <Button Grid.Column="2" Content="Cancel looser changes" Command="{Binding CancelCommand}" VerticalAlignment="Top" />
        </Grid>
    </Border>
</UserControl>
