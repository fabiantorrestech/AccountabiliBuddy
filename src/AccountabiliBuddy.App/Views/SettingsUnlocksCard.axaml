<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.SettingsUnlocksCard"
             x:DataType="vm:SettingsViewModel">
    <!-- The Unlocks setting, a row under the profiles on the Guards page (it belongs to the profiles' unlock options). -->
    <Border Classes="sRow" search:SearchArea.Name="Unlocks">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsEnabled="{Binding !IsLocked}">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="sTitle" Text="Unlocks" />
                <TextBlock Classes="sHint"
                           Text="Relock at midnight: when on, an unlock lifts the blocks only until the next midnight unless you pick another time when unlocking. Unlock options are set per profile." />
            </StackPanel>
            <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding RelockAtMidnight}" VerticalAlignment="Center" AutomationProperties.Name="Relock at midnight" />
        </Grid>
    </Border>
</UserControl>
