<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        x:Class="AccountabiliBuddy.App.Views.PrivateWindowsNagWindow"
        x:DataType="vm:PrivateWindowsNagViewModel"
        Title="Allow AccountabiliBuddy in private windows"
        Icon="/Assets/app-icon.png"
        Width="600" SizeToContent="Height" CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,20" Spacing="12">
        <TextBlock Text="Allow AccountabiliBuddy in private windows" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap"
                   Text="The extension can't see private (incognito) windows in these browsers, so anything could be open there. Until it's allowed, these browsers count as distracting during focus sessions, and this reminder keeps coming back." />
        <ItemsControl ItemsSource="{Binding Browsers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PrivateWindowsNagRowViewModel">
                    <Border Background="#1A808080" BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <SelectableTextBlock Text="{Binding Steps}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open extensions page" Command="{Binding OpenExtensionsPageCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E9A23B"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Remind me in 5 minutes" Command="{Binding RemindLaterCommand}" />
            <Button Content="I've turned it on" Command="{Binding CheckAgainCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
