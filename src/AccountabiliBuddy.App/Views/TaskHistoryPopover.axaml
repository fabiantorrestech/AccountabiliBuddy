<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.TaskHistoryPopover"
             x:DataType="vm:TaskHistoryViewModel">
    <!-- History (spec 05 §10): the last 30 days, Finished (Do again) and Deleted and archived (Bring back). Shown in a TaskPopoverFlyout
         from the View menu; it stays open, so several can be brought back in a row. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.head">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:TaskHistoryRowViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,4,4,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Classes="muted" Text="{Binding Sub}" FontSize="11.5" />
                </StackPanel>
                <Button Grid.Column="1" Classes="quiet" Padding="8,4" MinHeight="0" VerticalAlignment="Center" Command="{Binding Command}"
                        AutomationProperties.Name="{Binding ActionText}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{Binding ActionIcon}" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActionText}" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel Margin="6">
        <StackPanel Margin="8,4,8,2">
            <TextBlock Text="History" FontWeight="SemiBold" FontSize="13.5" />
            <TextBlock Classes="muted" Text="Finished and deleted tasks · last 30 days" FontSize="12" />
        </StackPanel>
        <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="Nothing in the last 30 days." Margin="8,10" FontSize="13" />
        <TextBlock Classes="head" Text="Finished" IsVisible="{Binding HasFinished}" />
        <ItemsControl ItemsSource="{Binding Finished}" IsVisible="{Binding HasFinished}" />
        <TextBlock Classes="head" Text="Deleted and archived" IsVisible="{Binding HasRemoved}" />
        <ItemsControl ItemsSource="{Binding Removed}" IsVisible="{Binding HasRemoved}" />
    </StackPanel>
</UserControl>
