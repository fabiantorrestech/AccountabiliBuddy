<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <UserControl.Resources>
        <!-- One app or site: icon, name, time, a ⋯ menu (rename, hide, delete), and its bar. -->
        <DataTemplate x:Key="UsageRow" x:DataType="vm:UsageRowViewModel">
            <Grid ColumnDefinitions="26,*" Margin="0,0,0,8">
                <!-- The app's or site's icon, or a coloured letter until there is one. -->
                <Panel Width="18" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="18" Height="18" />
                    <Border IsVisible="{Binding !HasIcon}" Background="{Binding BadgeBrush}" CornerRadius="9">
                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !IsEditing}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RealNameHint}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="⋯" ToolTip.Tip="Show, rename, hide or delete"
                                Background="Transparent" Padding="6,0" Margin="4,0" FontSize="14" Opacity="0.7">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Show in File Explorer" Command="{Binding ShowInExplorerCommand}" IsVisible="{Binding CanShowFile}" />
                                    <MenuItem Header="Open in browser" Command="{Binding OpenSiteCommand}" IsVisible="{Binding CanOpenSite}" />
                                    <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" />
                                    <MenuItem Header="Hide from this list (time still counts)" Command="{Binding HideCommand}"
                                              IsVisible="{Binding CanHide}" />
                                    <MenuItem Header="Delete from this period (time is subtracted)…" Command="{Binding AskDeleteCommand}"
                                              IsVisible="{Binding CanDelete}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Opacity="0.8" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding FileNotFoundText}" IsVisible="{Binding ShowsFileNotFound}" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditing}">
                        <TextBox Text="{Binding EditText}" Width="170" />
                        <Button Content="Save" Command="{Binding SaveRenameCommand}" Classes="accent" />
                        <Button Content="Reset" Command="{Binding ResetNameCommand}" ToolTip.Tip="Back to the real name" />
                        <Button Content="✕" Command="{Binding CancelRenameCommand}" ToolTip.Tip="Cancel" />
                    </StackPanel>
                    <Border IsVisible="{Binding IsConfirmingDelete}" Background="#22E5484D" CornerRadius="6" Padding="8,6">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Background="#B91C1C" Foreground="White" />
                                <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="5" MinHeight="5"
                                 Classes.distraction="{Binding IsDistraction}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- The names hidden from a list, each with Show again (open from the "N hidden" button). -->
        <DataTemplate x:Key="HiddenList" x:DataType="vm:HiddenListViewModel">
            <ItemsControl ItemsSource="{Binding Names}" IsVisible="{Binding IsOpen}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding}" Opacity="0.75" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Show again" FontSize="12" Padding="8,2"
                                    Command="{Binding $parent[ItemsControl].((vm:HiddenListViewModel)DataContext).ShowAgainCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ProgressBar.distraction">
            <Setter Property="Foreground" Value="#E0A030" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
            <Border IsVisible="{Binding IsLoggingOff}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                <TextBlock Text="Activity history is turned off, so nothing new is being recorded. Turn it on in Setup." TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding ErrorText}" Foreground="#E76F51" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="Today" IsChecked="{Binding ShowToday}" GroupName="period" />
                    <RadioButton Content="Last 7 days" IsChecked="{Binding ShowWeek}" GroupName="period" />
                    <RadioButton Content="Day" IsChecked="{Binding ShowDay}" GroupName="period" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowDay}">
                        <Button Content="◀" Command="{Binding PreviousDayCommand}" ToolTip.Tip="Day before" Padding="8,4" />
                        <CalendarDatePicker SelectedDate="{Binding SelectedDay}" DisplayDateStart="{Binding FirstDay}"
                                            DisplayDateEnd="{Binding LastDay}" SelectedDateFormat="Long" MinWidth="200" />
                        <Button Content="▶" Command="{Binding NextDayCommand}" ToolTip.Tip="Day after" Padding="8,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding PeriodLabel}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"
                               IsVisible="{Binding !ShowDay}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Totals during focus -->
            <UniformGrid Rows="1" Columns="4">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Focus time" Classes="muted" />
                        <TextBlock Text="{Binding FocusTimeText}" Classes="big" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="On track" Classes="muted" />
                        <TextBlock Text="{Binding OnTrackText}" Classes="big" Foreground="#2A9D8F" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Distracted" Classes="muted" />
                        <TextBlock Text="{Binding DistractedText}" Classes="big" Foreground="#E0A030" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Not classified" Classes="muted" />
                        <TextBlock Text="{Binding UnknownText}" Classes="big" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Classes="muted" FontSize="12"
                       Text="Totals cover focus phases only and are counted per monitor. Activities appear once they end; idle time (5+ min without keyboard or mouse) is not counted." />

            <!-- Top lists -->
            <Grid ColumnDefinitions="*,16,*">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Top distractions during focus" Classes="title" />
                        <TextBlock Text="None. Nice." Classes="muted" IsVisible="{Binding HasNoDistractions}" />
                        <ItemsControl ItemsSource="{Binding TopDistractions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UsageRowViewModel">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageRow}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding DistractionsToggleText}" Command="{Binding ToggleAllDistractionsCommand}"
                                    IsVisible="{Binding HasMoreDistractions}" />
                            <Button DataContext="{Binding HiddenDistractions}" x:DataType="vm:HiddenListViewModel"
                                    Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasAny}"
                                    ToolTip.Tip="Hidden from this list" />
                        </StackPanel>
                        <ContentControl Content="{Binding HiddenDistractions}" ContentTemplate="{StaticResource HiddenList}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Most used apps and sites" Classes="title" />
                        <TextBlock Text="Nothing recorded yet." Classes="muted" IsVisible="{Binding HasNoUsage}" />
                        <ItemsControl ItemsSource="{Binding TopOverall}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UsageRowViewModel">
                                    <StackPanel>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageRow}" />
                                        <!-- A browser's sites, indented under it: the top few, then "+N more sites". -->
                                        <Border BorderBrush="#33808080" BorderThickness="1,0,0,0" Margin="8,-4,0,8" Padding="12,0,0,0"
                                                IsVisible="{Binding HasSites}">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding ShownSites}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:UsageRowViewModel">
                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsageRow}" FontSize="13" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding SitesToggleText}" Command="{Binding ToggleSitesCommand}" IsVisible="{Binding HasMoreSites}"
                                                        Background="Transparent" Padding="0,0,0,4" FontSize="12" Opacity="0.75" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding OverallToggleText}" Command="{Binding ToggleAllOverallCommand}"
                                    IsVisible="{Binding HasMoreOverall}" />
                            <Button DataContext="{Binding HiddenOverall}" x:DataType="vm:HiddenListViewModel"
                                    Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasAny}"
                                    ToolTip.Tip="Hidden from this list" />
                            <Button Content="{Binding DeletedToggleText}" Command="{Binding ToggleDeletedCommand}" IsVisible="{Binding HasDeleted}"
                                    ToolTip.Tip="Time deleted in this period" />
                        </StackPanel>
                        <ContentControl Content="{Binding HiddenOverall}" ContentTemplate="{StaticResource HiddenList}" />
                        <ItemsControl ItemsSource="{Binding DeletedRows}" IsVisible="{Binding ShowDeleted}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeletedRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding Text}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Restore" FontSize="12" Padding="8,2"
                                                Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).RestoreCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sessions -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sessions" Classes="title" />
                    <TextBlock Text="No sessions in this period." Classes="muted" IsVisible="{Binding HasNoSessions}" />
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionRowViewModel">
                                <Grid ColumnDefinitions="130,*,90,200,Auto" Margin="0,4" Opacity="{Binding RowOpacity}">
                                    <TextBlock Text="{Binding WhenText}" Opacity="0.8" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ReasonText}" IsVisible="{Binding HasReason}"
                                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" FontStyle="Italic" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LengthText}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding OutcomeText}" HorizontalAlignment="Right" Opacity="0.8"
                                               TextWrapping="Wrap" TextAlignment="Right" />
                                    <Button Grid.Column="4" Content="{Binding MarkButtonText}" ToolTip.Tip="{Binding MarkButtonTip}"
                                            Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).ToggleOmittedCommand}"
                                            CommandParameter="{Binding}" Margin="12,0,0,0" Padding="8,2" FontSize="12"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
