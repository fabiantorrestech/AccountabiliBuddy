<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">
    <!-- The Devices tab (ADR 22): this PC and the user's other devices, the ways they share. -->
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <Border IsVisible="{Binding IsLocked}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                <TextBlock Text="Leaving the group and the sharing switches are locked while a focus session you started is running." TextWrapping="Wrap" />
            </Border>

            <!-- Every device in the group, this PC first, with how fresh its data is. -->
            <TextBlock Text="Your devices" Classes="title" />
            <TextBlock Text="{Binding CombinedTodayText}" IsVisible="{Binding CombinedTodayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Border Classes="card">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding RowMargin}">
                                <!-- What the device is: a PC, a phone or a watch. -->
                                <Path Data="{Binding Icon}" Width="16" Height="16" Stretch="None" Margin="0,2,10,0" VerticalAlignment="Top"
                                      Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock>
                                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Kind}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding MethodsText}" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding LastText}" Classes="muted" FontSize="12"
                                               IsVisible="{Binding LastText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- The state in words and colour, never colour alone. -->
                                    <Border Background="{Binding PillBrush}" CornerRadius="10" Padding="9,2">
                                        <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sync now" Command="{Binding SyncNowCommand}" IsEnabled="{Binding InGroup}"
                        ToolTip.Tip="Write this PC's sync file now and hand it to connected devices" />
                <Button Content="Show QR code" Command="{Binding ShowQrCodeCommand}" IsVisible="{Binding QrOn}" />
                <Button Content="Import sync file or picture…" Click="OnImport" IsEnabled="{Binding InGroup}" />
            </StackPanel>

            <!-- Joining another device's group, or showing this group's code to link one. -->
            <TextBlock Text="Link your devices" Classes="title" Margin="0,8,0,0" />
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="muted"
                               Text="Devices in one group share their focus through encrypted sync files. The link code is the key: anyone with it can read your files, so keep it to your own devices." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Link a device" Command="{Binding LinkDeviceCommand}" Classes="accent" />
                        <Button Content="Leave group" Command="{Binding LeaveGroupCommand}" IsVisible="{Binding InGroup}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasLinkCode}">
                        <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
                            <Image Source="{Binding LinkQrImage}" Width="200" Height="200" RenderOptions.BitmapInterpolationMode="None" />
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="Scan it with the phone's camera, or type the code on another PC" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding LinkCodeText}" FontSize="16" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding JoinCode}" PlaceholderText="A link code from your other device (40 characters)" />
                        <Button Grid.Column="1" Content="Join" Command="{Binding JoinCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The ways this PC shares, safest first. -->
            <TextBlock Text="How this PC shares" Classes="title" Margin="0,8,0,0" />
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="muted"
                               Text="Safest first. Sync files hold focus times, profile names and sites; never page titles, addresses or reasons." />
                    <CheckBox IsChecked="{Binding QrOn}" Content="QR codes: show today's codes for the phone to scan (nothing leaves the PC but the picture)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsVisible="{Binding QrOn}">
                        <CheckBox IsChecked="{Binding ReminderAtWorkEnd}" Content="Remind me when work ends" VerticalAlignment="Center" />
                        <TimePicker SelectedTime="{Binding ReminderAt}" MinuteIncrement="15" ClockIdentifier="12HourClock" IsVisible="{Binding !ReminderAtWorkEnd}" />
                        <TextBlock Text="Later waits" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding SnoozeIndex}">
                            <ComboBoxItem Content="5 min" />
                            <ComboBoxItem Content="15 min" />
                            <ComboBoxItem Content="30 min" />
                            <ComboBoxItem Content="1 h" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding FileShareOn}" Content="Sync files: save or open a .absync file by hand" />
                    <CheckBox IsChecked="{Binding DriveOn}" Content="Google Drive: sync through the app's own Drive folder (every 20 s in a session, else 5 min)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <TextBlock Text="{Binding DriveStatusText}" Classes="muted" VerticalAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
                        <Button Content="Sign in…" Command="{Binding SignInDriveCommand}" IsVisible="{Binding !DriveSignedIn}" />
                        <Button Content="Sign out" Command="{Binding SignOutDriveCommand}" IsVisible="{Binding DriveSignedIn}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding RelayOn}" Content="Own relay: sync through a small relay you run (changes arrive in about a second)" />
                    <StackPanel Spacing="6" Margin="28,0,0,0">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding RelayUrlText}" PlaceholderText="Relay address, e.g. https://192.168.1.20:8743" IsEnabled="{Binding !RelayHost.HostOn}" />
                            <TextBox Grid.Column="1" Text="{Binding RelayPinText}" IsEnabled="{Binding !RelayHost.HostOn}"
                                     PlaceholderText="Pin (empty if the relay has a normal certificate)" />
                        </Grid>
                        <TextBox Text="{Binding RelayAdmissionText}" IsEnabled="{Binding !RelayHost.HostOn}" MaxWidth="560" HorizontalAlignment="Left"
                                 PlaceholderText="Admission key (from the relay; lets this PC start the group on it)" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="560"
                                   Text="The admission key is printed by the relay with its address and pin. Joining with a link from a device that has it fills this in. Keep it private: whoever has it can start groups on your relay." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save address" Command="{Binding SaveRelayCommand}" />
                            <Button Content="Test connection" Command="{Binding TestRelayCommand}" />
                            <TextBlock Text="{Binding RelayStatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                                       IsVisible="{Binding RelayStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RelayTestText}" TextWrapping="Wrap" MaxWidth="560"
                                   IsVisible="{Binding RelayTestText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <!-- The short steps for running the relay; the full guide ships with the app. -->
                        <Expander Header="Run your own relay" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Text="1. Run the relay program (AccountabiliBuddy.Relay) on a computer that stays on: your home PC or server, a Raspberry Pi, a Docker container or a rented server. On its first start it prints a line like &quot;relay address: https://192.168.1.20:8743   pin: …&quot;." />
                                <TextBlock TextWrapping="Wrap" Text="2. Type that address, pin and admission key above, tick Own relay, and press Test connection." />
                                <TextBlock TextWrapping="Wrap" Text="3. Link the phone: Devices → Link a device shows a QR code that carries the address, pin and admission key, so scanning it sets the relay up there too. Never photograph, screen-share or post that QR: it is the key to all your synced data." />
                                <TextBlock TextWrapping="Wrap" Text="4. Away from home, reach the relay through a VPN such as Tailscale, or put it behind a reverse proxy with a real certificate (then leave the pin empty). Never forward the relay's port on a home router without that." />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="The relay stores only sealed bytes. The key never leaves your devices, and the connection is HTTPS with the relay's certificate checked. The full guide has every setup, step by step." />
                                <Button Content="Open the full guide" Click="OnOpenSelfHostedGuide" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <!-- Running the relay on this PC (ADR 46): the relay program ships next to the app and ends with it. -->
                    <Border Classes="card" Margin="28,0,0,0" IsVisible="{Binding RelayHost, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Run a relay on this PC" Classes="title" />
                            <TextBlock Classes="muted"
                                       Text="No other computer needed: this PC runs the relay while AccountabiliBuddy runs, so your phone and tablet can sync through it on any network. Everything on it is sealed, and the connection is HTTPS pinned to its own certificate." />
                            <Button Content="Run a relay on this PC…" Command="{Binding RelayHost.BeginTurnOnCommand}" Classes="accent"
                                    HorizontalAlignment="Left" IsVisible="{Binding !RelayHost.HostOn}" />

                            <!-- Said before Windows' permission prompt. -->
                            <Border IsVisible="{Binding RelayHost.ConfirmingTurnOn}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock TextWrapping="Wrap" Text="What turning this on does:" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Text="• Starts the relay program that came with the app, whenever the app starts; it ends when the app quits." />
                                    <TextBlock TextWrapping="Wrap" Text="• Lets other devices reach it on any network: home Wi-Fi, someone else's Wi-Fi, a coffee shop. Windows will ask for permission once to open its firewall for the relay program; if you say no, the relay still runs but Windows may block your phone." />
                                    <TextBlock TextWrapping="Wrap" Text="• Makes this PC sync through it too (Own relay above)." />
                                    <TextBlock TextWrapping="Wrap" Text="• It never changes what is blocked during focus: only sync." />
                                    <CheckBox IsChecked="{Binding RelayHost.AlsoPublic}" Content="Also on public networks (coffee shops, someone else's Wi-Fi)" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#F59E0B" IsVisible="{Binding RelayHost.ReplacesOtherRelay}"
                                               Text="This PC already syncs through another relay; this replaces that address." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Turn on" Command="{Binding RelayHost.ConfirmTurnOnCommand}" Classes="accent" />
                                        <Button Content="Cancel" Command="{Binding RelayHost.CancelTurnOnCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="8" IsVisible="{Binding RelayHost.HostOn}">
                                <!-- The public-network notice, with a quick way out. -->
                                <Border IsVisible="{Binding RelayHost.PublicNetworkNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding RelayHost.PublicNetworkNotice}" TextWrapping="Wrap" />
                                        <Button Content="Stop the relay" Command="{Binding RelayHost.StopRelayCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding RelayHost.StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RelayHost.LastChangeText}" Classes="muted"
                                           IsVisible="{Binding RelayHost.LastChangeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start" Command="{Binding RelayHost.StartRelayCommand}" IsEnabled="{Binding !RelayHost.IsRunning}" />
                                    <Button Content="Stop" Command="{Binding RelayHost.StopRelayCommand}" IsEnabled="{Binding RelayHost.IsRunning}" />
                                    <Button Content="Restart" Command="{Binding RelayHost.RestartRelayCommand}" />
                                    <Button Content="Turn the relay off" Command="{Binding RelayHost.TurnOffCommand}" />
                                </StackPanel>

                                <TextBlock Text="Address and pin for your other devices" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding RelayHost.ShareAddresses}" SelectedItem="{Binding RelayHost.SelectedShareAddress}" MinWidth="320" />
                                <TextBlock Classes="muted" Text="Pick the address your phone can reach: a 192.168… or 10… one on home Wi-Fi, a 100… one over Tailscale. The pin is the same for all of them." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Pin:" VerticalAlignment="Center" />
                                    <SelectableTextBlock Text="{Binding RelayHost.PinText}" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Admission key:" VerticalAlignment="Center" />
                                    <SelectableTextBlock Text="{Binding RelayHost.AdmissionKeyText}" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="560"
                                           Text="The admission key lets a device start a new group on this relay (groups that already exist need only their own code). The join QR carries it. Keep it private." />
                                <Button Content="Show join QR (carries the address, the pin, the admission key and the group code)" Command="{Binding LinkDeviceCommand}" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasLinkCode}">
                                    <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
                                        <Image Source="{Binding LinkQrImage}" Width="200" Height="200" RenderOptions.BitmapInterpolationMode="None" />
                                    </Border>
                                    <TextBlock Classes="muted" MaxWidth="320" VerticalAlignment="Center"
                                               Text="Scan it with the phone's camera: it joins your group and sets up this relay. Change the address above first if the phone needs another one, then show the QR again." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding RelayHost.HostOn}">
                                <TextBlock Text="Port" VerticalAlignment="Center" />
                                <TextBox Text="{Binding RelayHost.PortText}" Width="100" />
                                <Button Content="Set port" Command="{Binding RelayHost.SetPortCommand}" />
                                <CheckBox IsChecked="{Binding RelayHost.AlsoPublic}" Content="Also on public networks" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding RelayHost.ShowAddFirewallRule}">
                                <TextBlock Text="Windows' firewall has no rule for the relay, so it may block your phone." Classes="muted" VerticalAlignment="Center" MaxWidth="400" />
                                <Button Content="Add the firewall rule…" Command="{Binding RelayHost.AddFirewallRuleCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding RelayHost.ShowRemoveFirewallRule}">
                                <TextBlock Text="The relay is off, but its firewall rule is still there." Classes="muted" VerticalAlignment="Center" MaxWidth="400" />
                                <Button Content="Remove the firewall rule…" Command="{Binding RelayHost.RemoveFirewallRuleCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding RelayHost.StorageText, StringFormat='Stored on the relay: {0}'}" VerticalAlignment="Center" />
                                <Button Content="Clear relay storage…" Command="{Binding RelayHost.BeginClearCommand}" />
                            </StackPanel>
                            <Border IsVisible="{Binding RelayHost.ConfirmingClear}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock TextWrapping="Wrap" Text="Delete every sync file stored on this relay? Each device writes its file again within minutes, so nothing is lost; the relay's certificate and pin stay." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Clear" Command="{Binding RelayHost.ConfirmClearCommand}" />
                                        <Button Content="Cancel" Command="{Binding RelayHost.CancelClearCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Expander Header="Relay log (last 50 lines: times, group prefixes and statuses only)" HorizontalAlignment="Stretch">
                                <ScrollViewer MaxHeight="220">
                                    <SelectableTextBlock Text="{Binding RelayHost.LogText}" FontFamily="Consolas, Courier New, monospace" FontSize="12" />
                                </ScrollViewer>
                            </Expander>
                            <TextBlock Text="{Binding RelayHost.Message}" TextWrapping="Wrap"
                                       IsVisible="{Binding RelayHost.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <CheckBox IsChecked="{Binding FolderOn}" Content="Sync folder: write and read sync files in a folder (e.g. inside Google Drive)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <TextBlock Text="{Binding FolderPath, TargetNullValue=No folder chosen}" Classes="muted" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        <Button Content="Choose folder…" Click="OnChooseFolder" />
                        <TextBlock Text="every" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding IntervalIndex}">
                            <ComboBoxItem Content="change (instant)" />
                            <ComboBoxItem Content="1 minute" />
                            <ComboBoxItem Content="5 minutes" />
                            <ComboBoxItem Content="15 minutes" />
                        </ComboBox>
                    </StackPanel>
                    <!-- The short steps for a folder kept in step by the user's own tools; the full guide ships with the app. -->
                    <Expander Header="Sync with your own server (Syncthing, Nextcloud)" HorizontalAlignment="Stretch" Margin="28,0,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock TextWrapping="Wrap" Text="1. Install Syncthing on this PC, your other computers and the phone (Syncthing-Fork on Android). Or use the Nextcloud desktop client, and a two-way sync app such as Autosync for Nextcloud on the phone." />
                            <TextBlock TextWrapping="Wrap" Text="2. Connect the devices to each other (Syncthing: Show ID on one, Add Remote Device on the other)." />
                            <TextBlock TextWrapping="Wrap" Text="3. Share one empty folder, e.g. &quot;AccountabiliBuddy sync&quot;, as Send &amp; Receive with every device." />
                            <TextBlock TextWrapping="Wrap" Text="4. Here: tick Sync folder above and choose that folder itself (not its parent)." />
                            <TextBlock TextWrapping="Wrap" Text="5. On the phone: Devices → Sync folder (backup), then pick the same folder in Android's folder picker." />
                            <TextBlock TextWrapping="Wrap" Text="6. Optional: keep one computer always on as the hub, so the phone gets this PC's file while it's off." />
                            <TextBlock TextWrapping="Wrap" Text="7. Away from home, let Syncthing's own relays or a mesh VPN (Tailscale, WireGuard) carry it. Never open your file share or Syncthing's web page to the internet." />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="The files are sealed: the tool and any server only carry scrambled bytes. The full guide covers Windows, macOS, Linux, Android, an always-on computer, safe access from outside and a small rented server." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Open the full guide" Click="OnOpenSelfHostedGuide" />
                                <TextBlock x:Name="GuideProblem" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" IsVisible="False" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
