<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">
    <!-- Devices & sync (ADR 22, design 5q): this PC and the user's other devices with how fresh each is, a note for a stale one, the
         ways this PC shares (each its own switch: several can be on together), their settings, linking and leaving the group, the sync
         light and the battery matrix (16a). The switches and Leave are locked during a focus session the user started, as before;
         the shell above carries the page title, Add a device and Sync now, and the resting banner. -->
    <UserControl.Styles>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource Ab.Met}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.dot.stale">
            <Setter Property="Fill" Value="{DynamicResource Ab.Sleep}" />
        </Style>
        <Style Selector="ToggleSwitch.rowSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,24" Spacing="12">
            <TextBlock Classes="sHint" Margin="4,0,0,0" IsVisible="{Binding IsLocked}"
                       Text="Leaving the group and the sharing switches rest while you focus; the sync light and batteries still change." />
            <TextBlock Classes="muted" Text="{Binding CombinedTodayText}" Margin="4,0,0,0"
                       IsVisible="{Binding CombinedTodayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Every device in the group, this PC first, with how fresh its data is. -->
            <Border Classes="sPanel">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,-1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceRowViewModel">
                            <Border Classes="sRow" Padding="18,15">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="{Binding RowMargin}">
                                    <mi:MaterialIcon Kind="{Binding IconKind}" Width="22" Height="22" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="sTitle" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="sHint" Text="{Binding DetailText}" />
                                    </StackPanel>
                                    <!-- The state in a dot and in words, never colour alone: Met = fresh, Sleep = stale. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Classes="dot" Classes.stale="{Binding IsStale}" />
                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding AgoText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- A device that has fallen behind. -->
            <Border Classes="sInfo" IsVisible="{Binding StaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <mi:MaterialIcon Kind="SyncAlert" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource Ab.InfoInk}" />
                    <TextBlock Grid.Column="1" Text="{Binding StaleText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- The ways this PC shares: each is its own switch, so several can be on at once (the sync files are the same for all of them). -->
            <TextBlock Classes="sGroup" Text="How they sync" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow" Padding="18,15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Google Drive" />
                                <TextBlock Classes="sHint" Text="Works anywhere · through the app's own Drive folder, every 20 s in a session, else every 5 min" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding DriveOn}" AutomationProperties.Name="Google Drive" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow" Padding="18,15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Shared folder" />
                                <TextBlock Classes="sHint" Text="OneDrive, Dropbox, a NAS path or your own server: write and read sync files in a folder" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding FolderOn}" AutomationProperties.Name="Shared folder" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow" Padding="18,15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Own relay" />
                                <TextBlock Classes="sHint" Text="A small relay you run, on this PC or another; changes arrive in about a second" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding RelayOn}" AutomationProperties.Name="Own relay" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow" Padding="18,15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="QR codes" />
                                <TextBlock Classes="sHint" Text="Show today's codes for the phone to scan; nothing leaves the PC but the picture" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding QrOn}" AutomationProperties.Name="QR codes" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow" Padding="18,15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Sync files" />
                                <TextBlock Classes="sHint" Text="Save or open a .absync file by hand" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding FileShareOn}" AutomationProperties.Name="Sync files" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Classes="sHint" Margin="4,-4,0,0"
                       Text="Safest first. Sync files hold focus times, profile names and sites; never page titles, addresses or reasons." />

            <!-- Each method's own settings. -->
            <TextBlock Classes="sGroup" Text="Google Drive" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Classes="sHint" Text="{Binding DriveStatusText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Sign in…" Command="{Binding SignInDriveCommand}" IsVisible="{Binding !DriveSignedIn}" />
                                <Button Content="Sign out" Command="{Binding SignOutDriveCommand}" IsVisible="{Binding DriveSignedIn}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Classes="sGroup" Text="Shared folder" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Folder" />
                                <TextBlock Classes="sHint" Text="{Binding FolderPath, TargetNullValue=No folder chosen}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Choose folder…" Click="OnChooseFolder" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Classes="sTitle" Text="Check the folder" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding IntervalIndex}" MinWidth="170" AutomationProperties.Name="How often to check the folder">
                                <ComboBoxItem Content="every change (instant)" />
                                <ComboBoxItem Content="every 1 minute" />
                                <ComboBoxItem Content="every 5 minutes" />
                                <ComboBoxItem Content="every 15 minutes" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <!-- The short steps for a folder kept in step by the user's own tools; the full guide ships with the app. -->
                    <Border Classes="sRow" Padding="14,6">
                        <Expander Header="Sync with your own server (Syncthing, Nextcloud)" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="6" Margin="0,4,0,8">
                                <TextBlock TextWrapping="Wrap" Text="1. Install Syncthing on this PC, your other computers and the phone (Syncthing-Fork on Android). Or use the Nextcloud desktop client, and a two-way sync app such as Autosync for Nextcloud on the phone." />
                                <TextBlock TextWrapping="Wrap" Text="2. Connect the devices to each other (Syncthing: Show ID on one, Add Remote Device on the other)." />
                                <TextBlock TextWrapping="Wrap" Text="3. Share one empty folder, e.g. &quot;AccountabiliBuddy sync&quot;, as Send &amp; Receive with every device." />
                                <TextBlock TextWrapping="Wrap" Text="4. Here: turn on Shared folder above and choose that folder itself (not its parent)." />
                                <TextBlock TextWrapping="Wrap" Text="5. On the phone: Devices → Sync folder (backup), then pick the same folder in Android's folder picker." />
                                <TextBlock TextWrapping="Wrap" Text="6. Optional: keep one computer always on as the hub, so the phone gets this PC's file while it's off." />
                                <TextBlock TextWrapping="Wrap" Text="7. Away from home, let Syncthing's own relays or a mesh VPN (Tailscale, WireGuard) carry it. Never open your file share or Syncthing's web page to the internet." />
                                <TextBlock Classes="sHint"
                                           Text="The files are sealed: the tool and any server only carry scrambled bytes. The full guide covers Windows, macOS, Linux, Android, an always-on computer, safe access from outside and a small rented server." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open the full guide" Click="OnOpenSelfHostedGuide" />
                                    <TextBlock x:Name="GuideProblem" Classes="sHint" VerticalAlignment="Center" MaxWidth="420" IsVisible="False" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Classes="sGroup" Text="Own relay" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Text="{Binding RelayUrlText}" PlaceholderText="Relay address, e.g. https://192.168.1.20:8743" IsEnabled="{Binding !RelayHost.HostOn}" />
                                <TextBox Grid.Column="1" Text="{Binding RelayPinText}" IsEnabled="{Binding !RelayHost.HostOn}"
                                         PlaceholderText="Pin (empty if the relay has a normal certificate)" />
                            </Grid>
                            <TextBox Text="{Binding RelayAdmissionText}" IsEnabled="{Binding !RelayHost.HostOn}" MaxWidth="560" HorizontalAlignment="Left"
                                     PlaceholderText="Admission key (from the relay; lets this PC start the group on it)" />
                            <TextBlock Classes="sHint"
                                       Text="The admission key is printed by the relay with its address and pin. Joining with a link from a device that has it fills this in. Keep it private: whoever has it can start groups on your relay." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save address" Command="{Binding SaveRelayCommand}" />
                                <Button Content="Test connection" Command="{Binding TestRelayCommand}" />
                                <TextBlock Text="{Binding RelayStatusText}" Classes="sHint" VerticalAlignment="Center" MaxWidth="460"
                                           IsVisible="{Binding RelayStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RelayTestText}" TextWrapping="Wrap" MaxWidth="560"
                                       IsVisible="{Binding RelayTestText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <!-- The short steps for running the relay; the full guide ships with the app. -->
                    <Border Classes="sRow" Padding="14,6">
                        <Expander Header="Run your own relay" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="6" Margin="0,4,0,8">
                                <TextBlock TextWrapping="Wrap" Text="1. Run the relay program (AccountabiliBuddy.Relay) on a computer that stays on: your home PC or server, a Raspberry Pi, a Docker container or a rented server. On its first start it prints a line like &quot;relay address: https://192.168.1.20:8743   pin: …&quot;." />
                                <TextBlock TextWrapping="Wrap" Text="2. Type that address, pin and admission key above, turn on Own relay, and press Test connection." />
                                <TextBlock TextWrapping="Wrap" Text="3. Link the phone: Settings › Devices &amp; sync → Link a device shows a QR code that carries the address, pin and admission key, so scanning it sets the relay up there too. Never photograph, screen-share or post that QR: it is the key to all your synced data." />
                                <TextBlock TextWrapping="Wrap" Text="4. Away from home, reach the relay through a VPN such as Tailscale, or put it behind a reverse proxy with a real certificate (then leave the pin empty). Never forward the relay's port on a home router without that." />
                                <TextBlock Classes="sHint"
                                           Text="The relay stores only sealed bytes. The key never leaves your devices, and the connection is HTTPS with the relay's certificate checked. The full guide has every setup, step by step." />
                                <Button Content="Open the full guide" Click="OnOpenSelfHostedGuide" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <!-- Running the relay on this PC (ADR 46): the relay program ships next to the app and ends with it. -->
                    <Border Classes="sRow" IsVisible="{Binding RelayHost, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Run a relay on this PC" Classes="sTitle" />
                            <TextBlock Classes="sHint"
                                       Text="No other computer needed: this PC runs the relay while AccountabiliBuddy runs, so your phone and tablet can sync through it on any network. Everything on it is sealed, and the connection is HTTPS pinned to its own certificate." />
                            <Button Content="Run a relay on this PC…" Command="{Binding RelayHost.BeginTurnOnCommand}" HorizontalAlignment="Left" IsVisible="{Binding !RelayHost.HostOn}" />

                            <!-- Said before Windows' permission prompt. -->
                            <Border IsVisible="{Binding RelayHost.ConfirmingTurnOn}" Classes="sInfo">
                                <StackPanel Spacing="8">
                                    <TextBlock TextWrapping="Wrap" Text="What turning this on does:" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Text="• Starts the relay program that came with the app, whenever the app starts; it ends when the app quits." />
                                    <TextBlock TextWrapping="Wrap" Text="• Lets other devices reach it on any network: home Wi-Fi, someone else's Wi-Fi, a coffee shop. Windows will ask for permission once to open its firewall for the relay program; if you say no, the relay still runs but Windows may block your phone." />
                                    <TextBlock TextWrapping="Wrap" Text="• Makes this PC sync through it too (Own relay above)." />
                                    <TextBlock TextWrapping="Wrap" Text="• It never changes what is blocked during focus: only sync." />
                                    <CheckBox IsChecked="{Binding RelayHost.AlsoPublic}" Content="Also on public networks (coffee shops, someone else's Wi-Fi)" />
                                    <TextBlock TextWrapping="Wrap" IsVisible="{Binding RelayHost.ReplacesOtherRelay}"
                                               Text="This PC already syncs through another relay; this replaces that address." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Turn on" Command="{Binding RelayHost.ConfirmTurnOnCommand}" />
                                        <Button Content="Cancel" Command="{Binding RelayHost.CancelTurnOnCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="8" IsVisible="{Binding RelayHost.HostOn}">
                                <!-- The public-network notice, with a quick way out. -->
                                <Border IsVisible="{Binding RelayHost.PublicNetworkNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="sInfo">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding RelayHost.PublicNetworkNotice}" TextWrapping="Wrap" />
                                        <Button Content="Stop the relay" Command="{Binding RelayHost.StopRelayCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding RelayHost.StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RelayHost.LastChangeText}" Classes="sHint"
                                           IsVisible="{Binding RelayHost.LastChangeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start" Command="{Binding RelayHost.StartRelayCommand}" IsEnabled="{Binding !RelayHost.IsRunning}" />
                                    <Button Content="Stop" Command="{Binding RelayHost.StopRelayCommand}" IsEnabled="{Binding RelayHost.IsRunning}" />
                                    <Button Content="Restart" Command="{Binding RelayHost.RestartRelayCommand}" />
                                    <Button Content="Turn the relay off" Command="{Binding RelayHost.TurnOffCommand}" />
                                </StackPanel>

                                <TextBlock Text="Address and pin for your other devices" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding RelayHost.ShareAddresses}" SelectedItem="{Binding RelayHost.SelectedShareAddress}" MinWidth="320" />
                                <TextBlock Classes="sHint" Text="Pick the address your phone can reach: a 192.168… or 10… one on home Wi-Fi, a 100… one over Tailscale. The pin is the same for all of them." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Pin:" VerticalAlignment="Center" />
                                    <SelectableTextBlock Text="{Binding RelayHost.PinText}" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Admission key:" VerticalAlignment="Center" />
                                    <SelectableTextBlock Text="{Binding RelayHost.AdmissionKeyText}" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="sHint" MaxWidth="560"
                                           Text="The admission key lets a device start a new group on this relay (groups that already exist need only their own code). The join QR carries it. Keep it private." />
                                <Button Content="Show join QR (carries the address, the pin, the admission key and the group code)" Command="{Binding LinkDeviceCommand}" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasLinkCode}">
                                    <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
                                        <Image Source="{Binding LinkQrImage}" Width="200" Height="200" RenderOptions.BitmapInterpolationMode="None" />
                                    </Border>
                                    <TextBlock Classes="sHint" MaxWidth="320" VerticalAlignment="Center"
                                               Text="Scan it with the phone's camera: it joins your group and sets up this relay. Change the address above first if the phone needs another one, then show the QR again." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding RelayHost.HostOn}">
                                <TextBlock Text="Port" VerticalAlignment="Center" />
                                <TextBox Text="{Binding RelayHost.PortText}" Width="100" />
                                <Button Content="Set port" Command="{Binding RelayHost.SetPortCommand}" />
                                <CheckBox IsChecked="{Binding RelayHost.AlsoPublic}" Content="Also on public networks" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding RelayHost.ShowAddFirewallRule}">
                                <TextBlock Text="Windows' firewall has no rule for the relay, so it may block your phone." Classes="sHint" VerticalAlignment="Center" MaxWidth="400" />
                                <Button Content="Add the firewall rule…" Command="{Binding RelayHost.AddFirewallRuleCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding RelayHost.ShowRemoveFirewallRule}">
                                <TextBlock Text="The relay is off, but its firewall rule is still there." Classes="sHint" VerticalAlignment="Center" MaxWidth="400" />
                                <Button Content="Remove the firewall rule…" Command="{Binding RelayHost.RemoveFirewallRuleCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding RelayHost.StorageText, StringFormat='Stored on the relay: {0}'}" VerticalAlignment="Center" />
                                <Button Content="Clear relay storage…" Command="{Binding RelayHost.BeginClearCommand}" />
                            </StackPanel>
                            <Border IsVisible="{Binding RelayHost.ConfirmingClear}" Classes="sInfo">
                                <StackPanel Spacing="8">
                                    <TextBlock TextWrapping="Wrap" Text="Delete every sync file stored on this relay? Each device writes its file again within minutes, so nothing is lost; the relay's certificate and pin stay." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Clear" Command="{Binding RelayHost.ConfirmClearCommand}" />
                                        <Button Content="Cancel" Command="{Binding RelayHost.CancelClearCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Expander Header="Relay log (last 50 lines: times, group prefixes and statuses only)" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <ScrollViewer MaxHeight="220">
                                    <SelectableTextBlock Text="{Binding RelayHost.LogText}" FontFamily="Consolas, Courier New, monospace" FontSize="12" />
                                </ScrollViewer>
                            </Expander>
                            <TextBlock Text="{Binding RelayHost.Message}" TextWrapping="Wrap"
                                       IsVisible="{Binding RelayHost.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Classes="sGroup" Text="QR codes and sync files" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow" IsVisible="{Binding QrOn}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Remind me to show the QR codes" />
                                <TextBlock Classes="sHint" Text="Remind me when work ends, or at a set time; Later waits for the time on the right." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox Classes="sw" IsChecked="{Binding ReminderAtWorkEnd}" Content="When work ends" VerticalAlignment="Center" />
                                <TimePicker SelectedTime="{Binding ReminderAt}" MinuteIncrement="15" ClockIdentifier="12HourClock" IsVisible="{Binding !ReminderAtWorkEnd}" />
                                <TextBlock Text="Later waits" VerticalAlignment="Center" Classes="muted" />
                                <ComboBox SelectedIndex="{Binding SnoozeIndex}">
                                    <ComboBoxItem Content="5 min" />
                                    <ComboBoxItem Content="15 min" />
                                    <ComboBoxItem Content="30 min" />
                                    <ComboBoxItem Content="1 h" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Import a sync file or a picture of the codes" />
                                <TextBlock Classes="sHint" Text="A .absync file from another device, or pictures of the phone's QR codes." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Import…" Click="OnImport" IsEnabled="{Binding InGroup}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Joining another device's group, or showing this group's code to link one. -->
            <TextBlock Classes="sGroup" Text="Link your devices" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Link a device" />
                                <TextBlock Classes="sHint"
                                           Text="Devices in one group share their focus through encrypted sync files. The link code is the key: anyone with it can read your files, so keep it to your own devices." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Link a device" Command="{Binding LinkDeviceCommand}" />
                                <Button Content="Leave group" Command="{Binding LeaveGroupCommand}" IsVisible="{Binding InGroup}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="sRow" IsVisible="{Binding HasLinkCode}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
                                <Image Source="{Binding LinkQrImage}" Width="200" Height="200" RenderOptions.BitmapInterpolationMode="None" />
                            </Border>
                            <StackPanel Spacing="6" VerticalAlignment="Center" MaxWidth="360">
                                <TextBlock Text="Scan it with the phone's camera, or type the code on another PC" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding LinkCodeText}" FontSize="16" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding JoinCode}" PlaceholderText="A link code from your other device (40 characters)" />
                            <Button Grid.Column="1" Content="Join" Command="{Binding JoinCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- The title bar's sync light (display only). -->
            <TextBlock Classes="sGroup" Text="Sync light" />
            <Border Classes="sPanel">
                <Border Classes="sRow" BorderThickness="0">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sTitle" Text="Show the sync light in the title bar" />
                            <TextBlock Classes="sHint" Text="The dot and device icons next to the sync button. The sync button itself always stays." />
                        </StackPanel>
                        <ListBox Classes="segmented" ItemsSource="{x:Static vm:DevicesViewModel.SyncLightNames}"
                                 SelectedIndex="{Binding SyncLightIndex}" AutomationProperties.Name="Sync light" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Which devices' batteries show where (design 16a). Stored now; the overlay and the Ctrl+Alt panel read it. -->
            <TextBlock Classes="sGroup" Text="Batteries" />
            <Border Classes="sPanel">
                <StackPanel Margin="0,0,0,-1">
                    <Border Classes="sRow" Padding="18,10">
                        <Grid ColumnDefinitions="*,92,92,92">
                            <TextBlock Classes="sHint" Text="Device" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="sHint" Text="Collapsed overlay" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="sHint" Text="Ctrl+Alt panel" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Classes="sHint" Text="In the app" TextAlignment="Center" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding BatteryRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatteryRowViewModel">
                                <Border Classes="sRow" Padding="18,8">
                                    <Grid ColumnDefinitions="Auto,*,92,92,92" ColumnSpacing="0">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="sTitle" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="sHint" Text="{Binding BatteryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding CollapsedOverlay}" IsEnabled="{Binding HasBattery}" HorizontalAlignment="Center" MinWidth="0"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='{}{0} in the collapsed overlay'}" />
                                        <CheckBox Grid.Column="3" IsChecked="{Binding CtrlAltPanel}" IsEnabled="{Binding HasBattery}" HorizontalAlignment="Center" MinWidth="0"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='{}{0} in the Ctrl+Alt panel'}" />
                                        <CheckBox Grid.Column="4" IsChecked="{Binding InApp}" IsEnabled="{Binding HasBattery}" HorizontalAlignment="Center" MinWidth="0"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='{}{0} in the app'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Always show a device below 20%" />
                                <TextBlock Classes="sHint" Text="Even where it's unticked, until it's charging" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding AlwaysShowBelow20}" AutomationProperties.Name="Always show a device below 20%" />
                        </Grid>
                    </Border>
                    <Border Classes="sRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sTitle" Text="Hide a device once it's full" />
                                <TextBlock Classes="sHint" Text="Collapsed overlay only" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="rowSwitch" IsChecked="{Binding HideWhenFull}" AutomationProperties.Name="Hide a device once it's full" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Classes="sHint" Margin="4,-4,0,0"
                       Text="A device shows 'no battery info' until it reports a level; its boxes unlock then. Nothing is sent anywhere for this." />

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="4,0,0,0"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
