<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">
    <!-- The Devices tab (ADR 22): this PC and the user's other devices, the ways they share. -->
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <Border IsVisible="{Binding IsLocked}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                <TextBlock Text="Leaving the group and the sharing switches are locked while a focus session you started is running." TextWrapping="Wrap" />
            </Border>

            <!-- Every device in the group, this PC first, with how fresh its data is. -->
            <TextBlock Text="Your devices" Classes="title" />
            <TextBlock Text="{Binding CombinedTodayText}" IsVisible="{Binding CombinedTodayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Border Classes="card">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding RowMargin}">
                                <!-- What the device is: a PC, a phone or a watch. -->
                                <Path Data="{Binding Icon}" Width="16" Height="16" Stretch="None" Margin="0,2,10,0" VerticalAlignment="Top"
                                      Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock>
                                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Kind}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding MethodsText}" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding LastText}" Classes="muted" FontSize="12"
                                               IsVisible="{Binding LastText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- The state in words and colour, never colour alone. -->
                                    <Border Background="{Binding PillBrush}" CornerRadius="10" Padding="9,2">
                                        <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sync now" Command="{Binding SyncNowCommand}" IsEnabled="{Binding InGroup}"
                        ToolTip.Tip="Write this PC's sync file now and hand it to connected devices" />
                <Button Content="Show QR code" Command="{Binding ShowQrCodeCommand}" IsVisible="{Binding QrOn}" />
                <Button Content="Import sync file or picture…" Click="OnImport" IsEnabled="{Binding InGroup}" />
            </StackPanel>

            <!-- Joining another device's group, or showing this group's code to link one. -->
            <TextBlock Text="Link your devices" Classes="title" Margin="0,8,0,0" />
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="muted"
                               Text="Devices in one group share their focus through encrypted sync files. The link code is the key: anyone with it can read your files, so keep it to your own devices." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Link a device" Command="{Binding LinkDeviceCommand}" Classes="accent" />
                        <Button Content="Leave group" Command="{Binding LeaveGroupCommand}" IsVisible="{Binding InGroup}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasLinkCode}">
                        <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
                            <Image Source="{Binding LinkQrImage}" Width="200" Height="200" RenderOptions.BitmapInterpolationMode="None" />
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="Scan it with the phone's camera, or type the code on another PC" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding LinkCodeText}" FontSize="16" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding JoinCode}" PlaceholderText="A link code from your other device (40 characters)" />
                        <Button Grid.Column="1" Content="Join" Command="{Binding JoinCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The ways this PC shares, safest first. -->
            <TextBlock Text="How this PC shares" Classes="title" Margin="0,8,0,0" />
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="muted"
                               Text="Safest first. Sync files hold focus times, profile names and sites; never page titles, addresses or reasons." />
                    <CheckBox IsChecked="{Binding QrOn}" Content="QR codes: show today's codes for the phone to scan (nothing leaves the PC but the picture)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsVisible="{Binding QrOn}">
                        <CheckBox IsChecked="{Binding ReminderAtWorkEnd}" Content="Remind me when work ends" VerticalAlignment="Center" />
                        <TimePicker SelectedTime="{Binding ReminderAt}" MinuteIncrement="15" ClockIdentifier="12HourClock" IsVisible="{Binding !ReminderAtWorkEnd}" />
                        <TextBlock Text="Later waits" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding SnoozeIndex}">
                            <ComboBoxItem Content="5 min" />
                            <ComboBoxItem Content="15 min" />
                            <ComboBoxItem Content="30 min" />
                            <ComboBoxItem Content="1 h" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding FileShareOn}" Content="Sync files: save or open a .absync file by hand" />
                    <CheckBox IsChecked="{Binding DriveOn}" Content="Google Drive: sync through the app's own Drive folder (every 20 s in a session, else 5 min)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <TextBlock Text="{Binding DriveStatusText}" Classes="muted" VerticalAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
                        <Button Content="Sign in…" Command="{Binding SignInDriveCommand}" IsVisible="{Binding !DriveSignedIn}" />
                        <Button Content="Sign out" Command="{Binding SignOutDriveCommand}" IsVisible="{Binding DriveSignedIn}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding RelayOn}" Content="Own relay: sync through a small relay you run (changes arrive in about a second)" />
                    <StackPanel Spacing="6" Margin="28,0,0,0">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding RelayUrlText}" PlaceholderText="Relay address, e.g. https://192.168.1.20:8743" />
                            <TextBox Grid.Column="1" Text="{Binding RelayPinText}"
                                     PlaceholderText="Pin (empty if the relay has a normal certificate)" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save address" Command="{Binding SaveRelayCommand}" />
                            <Button Content="Test connection" Command="{Binding TestRelayCommand}" />
                            <TextBlock Text="{Binding RelayStatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                                       IsVisible="{Binding RelayStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RelayTestText}" TextWrapping="Wrap" MaxWidth="560"
                                   IsVisible="{Binding RelayTestText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <!-- The short steps for running the relay; the full guide ships with the app. -->
                        <Expander Header="Run your own relay" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Text="1. Run the relay program (AccountabiliBuddy.Relay) on a computer that stays on: your home PC or server, a Raspberry Pi, a Docker container or a rented server. On its first start it prints a line like &quot;relay address: https://192.168.1.20:8743   pin: …&quot;." />
                                <TextBlock TextWrapping="Wrap" Text="2. Type that address and pin above, tick Own relay, and press Test connection." />
                                <TextBlock TextWrapping="Wrap" Text="3. Link the phone: Devices → Link a device shows a QR code that carries the address and pin, so scanning it sets the relay up there too." />
                                <TextBlock TextWrapping="Wrap" Text="4. Away from home, reach the relay through a VPN such as Tailscale, or put it behind a reverse proxy with a real certificate (then leave the pin empty). Never forward the relay's port on a home router without that." />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="The relay stores only sealed bytes. The key never leaves your devices, and the connection is HTTPS with the relay's certificate checked. The full guide has every setup, step by step." />
                                <Button Content="Open the full guide" Click="OnOpenSelfHostedGuide" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding FolderOn}" Content="Sync folder: write and read sync files in a folder (e.g. inside Google Drive)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <TextBlock Text="{Binding FolderPath, TargetNullValue=No folder chosen}" Classes="muted" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        <Button Content="Choose folder…" Click="OnChooseFolder" />
                        <TextBlock Text="every" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding IntervalIndex}">
                            <ComboBoxItem Content="change (instant)" />
                            <ComboBoxItem Content="1 minute" />
                            <ComboBoxItem Content="5 minutes" />
                            <ComboBoxItem Content="15 minutes" />
                        </ComboBox>
                    </StackPanel>
                    <!-- The short steps for a folder kept in step by the user's own tools; the full guide ships with the app. -->
                    <Expander Header="Sync with your own server (Syncthing, Nextcloud)" HorizontalAlignment="Stretch" Margin="28,0,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock TextWrapping="Wrap" Text="1. Install Syncthing on this PC, your other computers and the phone (Syncthing-Fork on Android). Or use the Nextcloud desktop client, and a two-way sync app such as Autosync for Nextcloud on the phone." />
                            <TextBlock TextWrapping="Wrap" Text="2. Connect the devices to each other (Syncthing: Show ID on one, Add Remote Device on the other)." />
                            <TextBlock TextWrapping="Wrap" Text="3. Share one empty folder, e.g. &quot;AccountabiliBuddy sync&quot;, as Send &amp; Receive with every device." />
                            <TextBlock TextWrapping="Wrap" Text="4. Here: tick Sync folder above and choose that folder itself (not its parent)." />
                            <TextBlock TextWrapping="Wrap" Text="5. On the phone: Devices → Sync folder (backup), then pick the same folder in Android's folder picker." />
                            <TextBlock TextWrapping="Wrap" Text="6. Optional: keep one computer always on as the hub, so the phone gets this PC's file while it's off." />
                            <TextBlock TextWrapping="Wrap" Text="7. Away from home, let Syncthing's own relays or a mesh VPN (Tailscale, WireGuard) carry it. Never open your file share or Syncthing's web page to the internet." />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="The files are sealed: the tool and any server only carry scrambled bytes. The full guide covers Windows, macOS, Linux, Android, an always-on computer, safe access from outside and a small rented server." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Open the full guide" Click="OnOpenSelfHostedGuide" />
                                <TextBlock x:Name="GuideProblem" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" IsVisible="False" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
