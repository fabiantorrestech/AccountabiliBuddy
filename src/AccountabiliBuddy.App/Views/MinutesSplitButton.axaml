<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.MinutesSplitButton"
             x:DataType="vm:MinutesChoiceViewModel">
    <!-- Shared by the timer's "time is up" window and the alarm windows: main button, menu of presets, custom 1-180. -->
    <SplitButton x:Name="SplitMenu" Command="{Binding ChooseCommand}"
                 PointerEntered="OnChoiceEntered" PointerExited="OnChoiceExited">
        <SplitButton.Content>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" />
                <TextBlock Text="{Binding MainText}" VerticalAlignment="Center" />
            </StackPanel>
        </SplitButton.Content>
        <SplitButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="2" MinWidth="130">
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MinutesPreset">
                                <Button Content="{Binding Text}" Tag="{Binding Minutes}"
                                        Command="{Binding $parent[ItemsControl].((vm:MinutesChoiceViewModel)DataContext).ChooseCommand}"
                                        CommandParameter="{Binding Minutes}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,2" Click="OnChoicePicked"
                                        PointerEntered="OnChoiceEntered" PointerExited="OnChoiceExited" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <mi:MaterialIcon Kind="PencilOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CustomMinutesText}" PlaceholderText="Custom (1-180)" Width="120"
                                 MaxLength="3" KeyDown="OnCustomKeyDown" />
                    </StackPanel>
                    <TextBlock Text="Minutes 1 to 180, then Enter." FontSize="11" Opacity="0.65"
                               IsVisible="{Binding !IsCustomInvalid}" />
                    <TextBlock Text="Use a whole number from 1 to 180." FontSize="11" Foreground="#FFF59E0B"
                               IsVisible="{Binding IsCustomInvalid}" />
                </StackPanel>
            </Flyout>
        </SplitButton.Flyout>
    </SplitButton>
</UserControl>
