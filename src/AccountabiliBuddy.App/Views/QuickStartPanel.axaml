<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.QuickStartPanel"
             x:DataType="vm:QuickSessionViewModel">
    <UserControl.Styles>
        <!-- "Quick Start with Default": the biggest button, in teal so it stands apart from Start. -->
        <Style Selector="Button.quickDefault">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.quickDefault:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14917F" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.quickDefault:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0B5E57" />
        </Style>
    </UserControl.Styles>
    <!-- Tasks first (what the session is for), then Quick Start with Default on top, Start with the remembered length,
         and "More options" folded away: profile, length (presets, slider or an end time), optional break, Quick Start
         with the profile picked. Used by the quick-session popup and the Today tab. -->
    <StackPanel Spacing="16">
        <!-- Guided sessions: what this session is for, as tasks with subtasks (optional). -->
        <Panel IsVisible="{Binding Checklist, Converter={x:Static ObjectConverters.IsNotNull}}">
            <views:ChecklistView DataContext="{Binding Checklist}" />
        </Panel>

        <Button Classes="quickDefault" Command="{Binding QuickStartDefaultCommand}" AutomationProperties.Name="Quick Start with Default"
                ToolTip.Tip="Starts your default profile (Settings) for the length below; the on-screen bar counts down. Choose No set end under More options to count up instead.">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="Quick Start with Default" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="{Binding DefaultProfileName}" FontSize="12" />
                    <TextBlock Text="·" FontSize="12" />
                    <TextBlock Text="{Binding FocusLabel}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Button>

        <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}" Classes="accent"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,12" FontSize="16" />

        <Expander Header="More options: profile, length, break" HorizontalAlignment="Stretch" IsExpanded="{Binding ShowsOptions}">
            <StackPanel Spacing="16" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasProfiles}">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />
                    <ComboBox x:Name="ProfileBox" Grid.Column="1" ItemsSource="{Binding ProfileOptions}"
                              SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch" />
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="Focus" Opacity="0.8" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DurationPresetViewModel">
                                <Button Content="{Binding Label}" ToolTip.Tip="{Binding ToolTip}"
                                        Classes.accent="{Binding IsSelected}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Margin="3,0" Padding="0,8" FontSize="16"
                                        Command="{Binding $parent[ItemsControl].((vm:QuickSessionViewModel)DataContext).SelectPresetCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 1-minute steps; 5-minute while Shift is held. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Minimum="5" Maximum="180" TickFrequency="{Binding SliderStep}" IsSnapToTickEnabled="True"
                                SmallChange="{Binding SliderStep}" LargeChange="15" Value="{Binding SliderMinutes}"
                                ToolTip.Tip="Hold Shift for 5-minute steps" />
                        <TextBlock Grid.Column="1" Text="{Binding FocusLabel}" FontSize="16" FontWeight="SemiBold"
                                   MinWidth="70" Margin="12,0,0,0" TextAlignment="Right"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- End time: click to choose one. -->
                    <Button Command="{Binding BeginEditUntilCommand}"
                            IsVisible="{Binding !IsEditingUntil}" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand"
                            ToolTip.Tip="Click to choose when the session should end">
                        <TextBlock Text="{Binding EndTimeText}" FontSize="13" Opacity="0.75" TextDecorations="Underline" />
                    </Button>
                    <StackPanel Spacing="6" IsVisible="{Binding IsEditingUntil}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="Run until" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBox x:Name="UntilBox" Text="{Binding UntilText}" Width="120" PlaceholderText="6:30pm" />
                            <Button Content="Set" Command="{Binding ApplyUntilCommand}" Classes="accent" />
                            <Button Content="✕" Command="{Binding CancelEditUntilCommand}" ToolTip.Tip="Cancel (Esc)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="or pick" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                            <TimePicker ClockIdentifier="12HourClock" SelectedTime="{Binding PickerTime}" MinuteIncrement="5" />
                        </StackPanel>
                        <TextBlock Text="{Binding UntilError}" IsVisible="{Binding HasUntilError}" Foreground="#E76F51"
                                   HorizontalAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,70">
                    <CheckBox Content="Break after" IsChecked="{Binding BreakEnabled}" Margin="0,0,12,0" />
                    <Slider Grid.Column="1" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding BreakMinutes}" IsEnabled="{Binding BreakEnabled}" />
                    <TextBlock Grid.Column="2" Text="{Binding BreakLabel}" FontSize="16" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Opacity="{Binding BreakLabelOpacity}" />
                </Grid>

                <!-- No set length with the profile picked above; the on-screen bar counts up. -->
                <Button Content="{Binding OpenEndedLabel}" Command="{Binding StartOpenEndedCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8"
                        ToolTip.Tip="Starts the profile picked above with no set end and no countdown. The on-screen bar fills each hour and glows every 30 minutes with how long you've been at it; hold Ctrl+Alt to see it any time." />

                <!-- Test session: enforcement, prompts and the overlay as in a real one; never counted, logged or synced. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Test session" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Value="{Binding TestMinutesInput}" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                        <Button Content="Start test" Command="{Binding StartTestCommand}" />
                    </StackPanel>
                    <TextBlock Text="Uses the profile picked above and runs like a session, so you can try the rules and prompts. It is never counted, not in History, and not synced. End test stops it at once."
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
