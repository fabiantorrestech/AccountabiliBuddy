<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:domain="using:AccountabiliBuddy.Core.Domain"
             x:Class="AccountabiliBuddy.App.Views.DayPlanEditorView"
             x:DataType="vm:DayPlanEditorViewModel">
    <!-- One day template: the bar on top, then the selected part (or all parts) to fine-tune. -->
    <StackPanel Spacing="8">
        <controls:DayPlanBar Editor="{Binding}" />
        <TextBlock Text="Click empty space to add a part · drag an edge to resize it, the middle to move it · snaps to 15 minutes"
                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#DC2626" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding ShownRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanPartRowViewModel">
                    <StackPanel Spacing="4" Margin="0,2">
                    <Grid ColumnDefinitions="16,140,140,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Label}" PlaceholderText="{Binding Category.Name}"
                                 ToolTip.Tip="Name for this part (empty = the category's name)" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:DayCategory">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TimePicker ClockIdentifier="12HourClock" Grid.Column="3" SelectedTime="{Binding Start}" MinuteIncrement="15" MinWidth="0" Width="196" />
                        <TextBlock Grid.Column="4" Text="–" VerticalAlignment="Center" />
                        <TimePicker ClockIdentifier="12HourClock" Grid.Column="5" SelectedTime="{Binding End}" MinuteIncrement="15" MinWidth="0" Width="196"
                                    IsEnabled="{Binding EndEditable}" />
                        <Button Grid.Column="6" Content="✕" ToolTip.Tip="Delete this part" Command="{Binding DeleteCommand}" />
                    </Grid>
                    <!-- A Sleep part woken by the alarm (ADR 33): only the bedtime is set. -->
                    <CheckBox Margin="24,0,0,0" IsVisible="{Binding IsSleep}" IsChecked="{Binding WakeByAlarm}"
                              Content="Wake = my alarm (no alarm set: bedtime + sleep goal)"
                              ToolTip.Tip="The wake-up alarm app chosen on the phone (Devices) sets the morning's wake time; set only when to be in bed by" />
                    <!-- A flexible break (e.g. lunch): the times are the window; it starts when you press Start lunch. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                        <CheckBox IsChecked="{Binding IsFlexible}" Content="Flexible: start any time in this window, for"
                                  ToolTip.Tip="Like lunch: it can lie over your work block; until you press Start lunch the window counts as work" />
                        <NumericUpDown Value="{Binding FlexMinutes}" Minimum="15" Maximum="240" Increment="15" FormatString="0" Width="110"
                                       IsEnabled="{Binding IsFlexible}" />
                        <TextBlock Text="min · hint at" VerticalAlignment="Center" IsVisible="{Binding IsFlexible}" />
                        <TimePicker ClockIdentifier="12HourClock" SelectedTime="{Binding HintAt}" MinuteIncrement="15" MinWidth="0" Width="196" IsVisible="{Binding IsFlexible}" />
                    </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Show all parts" Command="{Binding ShowAllCommand}" IsVisible="{Binding HasSelection}" />
    </StackPanel>
</UserControl>
