<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.ExceptionsView"
             x:DataType="vm:ExceptionsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.day">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="76" />
        </Style>
        <!-- A day cell: Surface2; a day with its own plan in the info colour; the selected day outlined in ink. -->
        <Style Selector="Button.day /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.day:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <Style Selector="Button.day.adjusted /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.InfoBg}" />
        </Style>
        <Style Selector="Button.day.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.day.today TextBlock.number">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- Like a calendar's agenda: one row per part in time order, tinted in its category's colour. -->
        <DataTemplate x:Key="AgendaRowTemplate" x:DataType="vm:AgendaRow">
            <Border Background="{Binding Tint}" CornerRadius="8" Margin="0,2" ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Background="{Binding Brush}" />
                    <StackPanel Grid.Column="1" Margin="10,5,8,6" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Times}" FontSize="12" Opacity="0.8" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The Plan page's "Change a day" sheet: the month with its events, one date's own plan and the one-off days. The calendar links and
         Google sign-in are in Settings > Connections. -->
    <DockPanel Margin="30,6,24,24">
        <views:PendingChangesBanner DockPanel.Dock="Top" DataContext="{Binding PendingChanges}" Margin="0,0,0,12" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Single dates planned differently from your day plan: a day off, a half day. Pick a date, then Plan this day differently; it starts from that day's default day plan and applies as soon as it's saved." />
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsLocked}" Background="{DynamicResource Ab.Surface2}" BorderBrush="{DynamicResource Ab.Waiting}"
                BorderThickness="3,0,0,0" Padding="14,10" Margin="0,0,0,12" CornerRadius="6">
            <TextBlock Text="One-off days are locked while a focus session you started is running." TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="*,16,320">
            <DockPanel Grid.Column="0">
                <!-- The one-off day being edited, under the calendar where the bar has room. -->
                <Border x:Name="OneOffEditorHost" DockPanel.Dock="Bottom" IsVisible="{Binding IsEditingOneOff}" Padding="14" Margin="0,12,0,0" CornerRadius="12"
                        Background="{DynamicResource Ab.Surface2}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding EditingDateTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="A part that crosses midnight (Sleep) is the night before this day; its piece at the right end of the bar starts the evening before."
                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding OneOffEditor}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:DayPlanEditorViewModel">
                                    <views:DayPlanEditorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <TextBox Text="{Binding OneOffNote}" PlaceholderText="Note (optional), e.g. dentist, half day" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Classes="primary" Padding="22,9" Command="{Binding SaveOneOffDayCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelOneOffDayCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,6">
                    <Button Grid.Column="0" Content="◀" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month" />
                    <Button Grid.Column="1" Content="Today" Command="{Binding GoToTodayCommand}" Margin="6,0" />
                    <Button Grid.Column="2" Content="▶" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month" />
                    <TextBlock Grid.Column="3" Text="{Binding MonthTitle}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="4" Content="Refresh calendars" HorizontalAlignment="Right"
                            Command="{Binding Feeds.RefreshCalendarsCommand}"
                            ToolTip.Tip="Fetch every event of every connected calendar now, hidden ones included" />
                </Grid>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{x:Static vm:ExceptionsViewModel.WeekdayHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Opacity="0.75" Margin="8,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Days}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDayViewModel">
                            <Button Classes="day" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsToday}"
                                    Classes.adjusted="{Binding IsAdjusted}" Opacity="{Binding Opacity}"
                                    Command="{Binding $parent[ItemsControl].((vm:ExceptionsViewModel)DataContext).SelectDayCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="1">
                                    <TextBlock Classes="number" Text="{Binding DayNumber}" FontSize="13" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CalendarDayLine">
                                                <Border Background="{Binding Brush}" CornerRadius="3" Padding="4,0" Margin="0,1"
                                                        ToolTip.Tip="{Binding Text}">
                                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="White"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MoreText}" FontSize="11" Opacity="0.75"
                                               IsVisible="{Binding MoreText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="10" Margin="0,0,14,0">
                    <!-- Calendar links and Google sign-in moved to Settings > Connections. -->
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="Calendar links and Google sign-in are in Settings › Connections." />
                        <Button Classes="quiet" Command="{Binding OpenCalendarSettingsCommand}" HorizontalAlignment="Left" Padding="0,4"
                                AutomationProperties.Name="Open Settings Connections">
                            <TextBlock Text="Open Connections" TextDecorations="Underline" />
                        </Button>
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Feeds.CalendarMessage}"
                                   IsVisible="{Binding Feeds.CalendarMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedDateTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <TextBlock Text="Events" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding SelectedEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventRowViewModel">
                                <Grid ColumnDefinitions="4,*,Auto" Margin="0,3">
                                    <Border Background="{Binding Brush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Margin="8,0,4,0">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding When}" FontSize="12" />
                                        <TextBlock Text="{Binding CalendarName}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                            <Button Content="Plan this day around it" FontSize="12" Padding="6,2"
                                                    Command="{Binding $parent[ItemsControl].((vm:ExceptionsViewModel)DataContext).PlanDayForEventCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Edit" FontSize="12" Padding="6,2" IsVisible="{Binding IsEditable}"
                                                    AutomationProperties.Name="Edit event"
                                                    Command="{Binding $parent[ItemsControl].((vm:ExceptionsViewModel)DataContext).EditEventCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✕" ToolTip.Tip="Remove event" IsVisible="{Binding IsEditable}"
                                            VerticalAlignment="Top"
                                            Command="{Binding $parent[ItemsControl].((vm:ExceptionsViewModel)DataContext).RemoveEventCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding NewEventTitle}" PlaceholderText="New event, e.g. Exam" AutomationProperties.Name="New event title" />
                    <CheckBox Content="All day" IsChecked="{Binding NewEventAllDay}" AutomationProperties.Name="Event all day" />
                    <Grid ColumnDefinitions="44,*" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding !NewEventAllDay}">
                        <TextBlock Text="From" VerticalAlignment="Center" />
                        <TimePicker Grid.Column="1" SelectedTime="{Binding NewEventStart}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                        <TextBlock Grid.Row="1" Text="To" VerticalAlignment="Center" />
                        <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding NewEventEnd}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{Binding EventButtonText}" Command="{Binding AddEventCommand}" />
                        <Button Content="Cancel" IsVisible="{Binding IsEditingEvent}" Command="{Binding CancelEventEditCommand}"
                                AutomationProperties.Name="Cancel event edit" />
                    </StackPanel>

                    <TextBlock Text="This day's plan" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <!-- At a glance: adjusted (in the one-off colour, like the calendar) or the default plan. -->
                    <Border CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" Background="{DynamicResource Ab.InfoBg}" IsVisible="{Binding SelectedIsAdjusted}">
                        <TextBlock Text="{Binding SelectedDayPlanText}" FontWeight="SemiBold" />
                    </Border>
                    <Border CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" Background="{DynamicResource Ab.Surface2}" IsVisible="{Binding !SelectedIsAdjusted}">
                        <TextBlock Text="{Binding SelectedDayPlanText}" Opacity="0.85" />
                    </Border>
                    <TextBlock Text="Nothing planned." Opacity="0.6" IsVisible="{Binding !SelectedDayAgenda.Count}" />
                    <ItemsControl ItemsSource="{Binding SelectedDayAgenda}" ItemTemplate="{StaticResource AgendaRowTemplate}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Plan this day differently" Command="{Binding PlanSelectedDayCommand}" IsVisible="{Binding !SelectedHasOwnPlan}" />
                        <Button Content="Edit" Command="{Binding PlanSelectedDayCommand}" IsVisible="{Binding SelectedHasOwnPlan}" />
                        <Button Content="Default Day Plan" Command="{Binding ClearSelectedDayCommand}" IsVisible="{Binding SelectedHasOwnPlan}"
                                ToolTip.Tip="Go back to the default day plan for this date" />
                    </StackPanel>

                    <TextBlock Text="One-off days" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="None yet." Opacity="0.6" IsVisible="{Binding !OneOffDays.Count}" />
                    <ItemsControl ItemsSource="{Binding OneOffDays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OneOffDayRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3" Opacity="{Binding IsPast, Converter={x:Static vm:PastOpacityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.7" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                                        <TextBlock Text="Same as the default day plan" FontSize="11" Opacity="0.7" IsVisible="{Binding IsSameAsDefault}" />
                                        <TextBlock Text="Nothing planned" FontSize="12" Opacity="0.6" IsVisible="{Binding HasNothingPlanned}" />
                                        <ItemsControl ItemsSource="{Binding Agenda}" ItemTemplate="{StaticResource AgendaRowTemplate}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Edit" Command="{Binding EditCommand}" VerticalAlignment="Top" Margin="4,0"
                                            IsEnabled="{Binding !$parent[ItemsControl].((vm:ExceptionsViewModel)DataContext).IsLocked}" />
                                    <Button Grid.Column="2" Content="✕" ToolTip.Tip="Back to the default day plan" Command="{Binding DeleteCommand}" VerticalAlignment="Top"
                                            IsEnabled="{Binding !$parent[ItemsControl].((vm:ExceptionsViewModel)DataContext).IsLocked}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
