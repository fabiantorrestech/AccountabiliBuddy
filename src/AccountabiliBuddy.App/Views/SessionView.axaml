<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.SessionView"
             x:DataType="vm:SessionViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

            <Border Padding="20" CornerRadius="8" Background="#220F766E" BorderBrush="#550F766E" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusDetail}" FontSize="16" />
                    <Button Content="End session…" Command="{Binding EndSessionCommand}"
                            IsVisible="{Binding IsSessionActive}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="20" IsVisible="{Binding !IsSessionActive}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Profile" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                              MinWidth="260" PlaceholderText="Choose a profile" />
                    <TextBlock IsVisible="{Binding HasNoProfiles}" Opacity="0.75" TextWrapping="Wrap"
                               Text="No profiles yet. Open the Profiles tab and add one (or the example profile)." />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Manual session" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Minutes (leave blank to run until you stop it)" Opacity="0.75" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding ManualMinutes}" Width="120" />
                        <Button Content="Start manual session" Command="{Binding StartManualCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Pomodoro" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PomodoroSummary}" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock Text="Focus cycles (leave blank to run until you stop it)" Opacity="0.75" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding PomodoroCycles}" Width="120" />
                        <Button Content="Start Pomodoro" Command="{Binding StartPomodoroCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
