<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.CalendarFeedsView"
             x:DataType="vm:CalendarFeedsViewModel">
    <!-- The connected calendars (Settings › Connections): each source with its calendars (show on the Plan page's month view, colour),
         an iCal link to add, and Google sign-in, as rows of a title, a Muted line and the control on the right. -->
    <StackPanel Margin="0,0,0,-1">
        <ItemsControl ItemsSource="{Binding CalendarSources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarSourceRowViewModel">
                    <Border Classes="sRow">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="sTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Text="{Binding StatusText}" Classes="sHint" Classes.error="{Binding HasError}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.error">
                                                <Setter Property="Foreground" Value="{DynamicResource Ab.Drift}" />
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding RemoveLabel}" IsVisible="{Binding CanRemove}" VerticalAlignment="Top"
                                        Command="{Binding $parent[ItemsControl].((vm:CalendarFeedsViewModel)DataContext).RemoveSourceCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Calendars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarRowViewModel">
                                        <StackPanel Spacing="4" Margin="0,3">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <CheckBox Classes="sw" IsChecked="{Binding IsVisible}" ToolTip.Tip="Show on the Plan page's month view"
                                                          AutomationProperties.Name="{Binding Name, StringFormat='Show {0}'}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                </CheckBox>
                                                <Button Grid.Column="1" Width="22" Height="22" Padding="0" CornerRadius="11"
                                                        Background="{Binding Brush}" ToolTip.Tip="Change colour"
                                                        AutomationProperties.Name="Change colour"
                                                        Command="{Binding NextColorCommand}" />
                                            </Grid>

                                            <!-- The calendar's rule (ADR 58), indented under it; the rows show only when it isn't Off. Disabled during a focus session. -->
                                            <StackPanel Margin="28,0,0,4" Spacing="6" DataContext="{Binding Rule}" x:DataType="vm:CalendarRuleViewModel"
                                                        IsEnabled="{Binding Owner.IsUnlocked}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Classes="sHint" Text="Day plan category" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" MinWidth="200"
                                                              AutomationProperties.Name="{Binding CalendarName, StringFormat='Rule for {0}'}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RuleModeChoice">
                                                                <TextBlock Text="{Binding Text}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <TextBlock Classes="sHint" Text="{Binding WaitingText}" IsVisible="{Binding HasWaiting}" TextWrapping="Wrap" />

                                                <!-- Every event gets one category. -->
                                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEveryEvent}">
                                                    <TextBlock Classes="sHint" Text="Category" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="160"
                                                              AutomationProperties.Name="{Binding CalendarName, StringFormat='Category for every event of {0}'}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RuleCategoryChoice">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Keywords to categories: the shared list or this calendar's own. -->
                                                <StackPanel Spacing="6" IsVisible="{Binding IsKeywords}">
                                                    <CheckBox Classes="sw" IsChecked="{Binding UsesOwnList}" Content="This calendar has its own keyword list"
                                                              AutomationProperties.Name="{Binding CalendarName, StringFormat='Own keyword list for {0}'}" />
                                                    <TextBlock Classes="sHint" Text="{Binding ListHint}" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding ShownKeywords}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:KeywordRowViewModel">
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                                                    <TextBox Text="{Binding Keyword}" PlaceholderText="Word in the title" AutomationProperties.Name="Keyword" />
                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="140"
                                                                              AutomationProperties.Name="Category for this keyword">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:RuleCategoryChoice">
                                                                                <TextBlock Text="{Binding Name}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <Button Grid.Column="2" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this keyword" AutomationProperties.Name="Remove keyword"><mi:MaterialIcon Kind="Close" Width="14" Height="14" /></Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="Add keyword" Command="{Binding AddKeywordCommand}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Calendar rules (ADR 58): the choice under each calendar above is a draft; Save queues the whole set. -->
        <Border Classes="sRow" DataContext="{Binding Rules}" x:DataType="vm:CalendarRulesViewModel">
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Classes="sTitle" Text="Calendar rules" />
                    <TextBlock Classes="sHint" TextWrapping="Wrap"
                               Text="A rule under a calendar gives its events a day plan category, so the guards follow the real day. A saved rule always waits before it takes effect, and the rules in force stay until then. Hidden calendars still count: hiding only changes what the Plan page shows." />
                </StackPanel>
                <TextBlock Text="{Binding LockText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Ab.Waiting}" IsVisible="{Binding IsLocked}" />
                <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ab.Waiting}" IsVisible="{Binding HasPending}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save rules" Command="{Binding SaveCommand}" />
                    <Button Content="Discard changes" Command="{Binding DiscardCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasMessage}" />
            </StackPanel>
        </Border>

        <Border Classes="sRow">
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Classes="sTitle" Text="Add an iCal link" />
                    <TextBlock Classes="sHint" Text="Google: calendar Settings → Integrate calendar → Secret address in iCal format. One link per calendar. Outlook, iCloud and Nextcloud have the same kind of link. The address is stored encrypted." />
                </StackPanel>
                <TextBox Text="{Binding NewLinkAddress}" PasswordChar="•" PlaceholderText="https://… or webcal://…" AutomationProperties.Name="iCal address" />
                <TextBox Text="{Binding NewLinkGroup}" PlaceholderText="Group name (optional), e.g. Work account" AutomationProperties.Name="Group name" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add link" Command="{Binding AddLinkCommand}" />
                    <Button Content="Refresh calendars" Command="{Binding RefreshCalendarsCommand}"
                            ToolTip.Tip="Fetch every event of every connected calendar now, hidden ones included" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="sRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="sTitle" Text="Google account" />
                    <TextBlock Classes="sHint" Text="Add one Google account at a time (press again for another). Lists all calendars of the account; changes show up within about 30 seconds. Needs your Google client ID in Settings › Your day › Calendars." />
                    <TextBlock Text="{Binding CalendarMessage}" TextWrapping="Wrap" FontSize="12"
                               IsVisible="{Binding CalendarMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Connect a Google account…" Command="{Binding ConnectGoogleCommand}" VerticalAlignment="Top" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
