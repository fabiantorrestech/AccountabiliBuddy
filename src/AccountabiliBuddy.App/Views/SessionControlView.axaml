<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="AccountabiliBuddy.App.Views.SessionControlView"
             x:DataType="vm:SessionControlViewModel">
    <UserControl.Styles>
        <!-- Idle: the accent "Start session" pill, 34 tall; its shortcut shows only in the tooltip (owner 2026-11-14). -->
        <Style Selector="Button.sessionStart">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sessionStart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.sessionStart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.sessionStart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.sessionStart:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRingOnAccent}" />
        </Style>

        <!-- The [Step away] pill inside the running pill and the ⋯ after the time: quiet, on Surface. -->
        <Style Selector="Button.sessionHalf">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sessionHalf /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.sessionHalf:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.sessionHalf:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.sessionHalf:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
        </Style>

        <!-- Hover or keyboard focus (or away) opens the extras to the left of the ring, into room the control keeps free on its
             left (owner 2026-11-14: the control sits at the right of the title bar); nothing else moves. -->
        <Style Selector="Border#Extras">
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border#Pill.open Border#Extras">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border#Pill">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border#Pill.open">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        </Style>

        <!-- The ring: accent arc on the line colour; a break uses the sleep colour (as on Today). -->
        <Style Selector="controls|ProgressRing.titleRing">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Thickness" Value="4" />
            <Setter Property="TrackBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <Style Selector="controls|ProgressRing.titleRing.break">
            <Setter Property="ArcBrush" Value="{DynamicResource Ab.Sleep}" />
        </Style>

        <!-- Ended: the target fades in and out (only while motion is on; the view sets .fade). -->
        <Style Selector="mi|MaterialIcon.endedTarget.fade">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.sessionEnded">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0,13,0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sessionEnded /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.sessionEnded:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
        </Style>

        <Style Selector="TextBlock.menuSub">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
    </UserControl.Styles>

    <Panel VerticalAlignment="Center" HorizontalAlignment="Right">
        <!-- Idle: the app's usual start controls open (the quick-session popup), the same as the global shortcut. -->
        <Button x:Name="StartButton" Classes="sessionStart" IsVisible="{Binding IsIdle, FallbackValue=False}" Command="{Binding StartCommand}"
                ToolTip.Tip="Start a session (Ctrl+Shift+S)" AutomationProperties.Name="Start session">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="Play" Width="17" Height="17" VerticalAlignment="Center" />
                <TextBlock Text="Start session" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Running, paused or away: [extras] ring  32 min left. -->
        <Border x:Name="Pill" IsVisible="{Binding IsRunningOrAway, FallbackValue=False}" Height="34" CornerRadius="17" Padding="4,0,4,0"
                Background="{DynamicResource Ab.Surface2}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="Extras" ClipToBounds="True" VerticalAlignment="Center">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="MaxWidth" Duration="0:0:0.28" Easing="CubicEaseOut" />
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                        </Transitions>
                    </Border.Transitions>
                    <!-- Compact (owner 2026-11-14, smaller reserve): Step away (or I'm back / Resume) as an icon with its name in the
                         tooltip, and the short end time ("ends 11:20"; the full one in its tooltip). The end time is what gives way
                         (trims) when the window is too narrow for both after the left group gave way. -->
                    <controls:GiveWayPanel x:Name="ExtrasRow">
                        <Border Height="28" CornerRadius="14" Background="{DynamicResource Ab.Surface}" ClipToBounds="True">
                            <Button x:Name="MainActionButton" Classes="sessionHalf" Width="30" Padding="0" HorizontalContentAlignment="Center"
                                    Command="{Binding MainActionCommand}" ToolTip.Tip="{Binding MainActionText}"
                                    AutomationProperties.Name="{Binding MainActionText}">
                                <mi:MaterialIcon Kind="{Binding MainActionIcon}" Width="15" Height="15" VerticalAlignment="Center" />
                            </Button>
                        </Border>
                        <TextBlock x:Name="EndsShort" controls:GiveWayPanel.Order="1" Text="{Binding EndsShortText}" ToolTip.Tip="{Binding EndsText}"
                                   Foreground="{DynamicResource Ab.Muted}" FontSize="13" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </controls:GiveWayPanel>
                </Border>
                <Panel Width="20" Height="20" VerticalAlignment="Center">
                    <controls:ProgressRing Classes="titleRing" Classes.break="{Binding IsBreak}" Value="{Binding RingValue}"
                                           IsVisible="{Binding HasRing}" Opacity="{Binding RingOpacity}"
                                           AutomationProperties.Name="Share of this phase left" />
                    <Ellipse IsVisible="{Binding IsCountUp}" Margin="1.5" Stroke="{DynamicResource Ab.Accent}" StrokeThickness="3"
                             StrokeDashArray="1,1" AutomationProperties.Name="Counting up" />
                    <mi:MaterialIcon Kind="Pause" Width="10" Height="10" Foreground="{DynamicResource Ab.Muted}" IsVisible="{Binding IsPaused}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="numeral" Text="{Binding PrimaryText}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SecondaryText}" Foreground="{DynamicResource Ab.Muted}" FontSize="13" FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- Round 2 (brief §4.2): "32 min left ⋯": the Session menu, anchored under the ⋯ and aligned to its right edge. -->
                <Button x:Name="MoreButton" Classes="sessionHalf" Width="26" Height="26" Padding="0" CornerRadius="13" HorizontalContentAlignment="Center"
                        VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" AutomationProperties.Name="Session menu"
                        ToolTip.Tip="Session menu: step away, pause, add time, end" Click="OnMoreClick">
                    <mi:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Ended: "◌ Ended · switches next time"; a click switches Tasks back now. -->
        <Button x:Name="EndedButton" Classes="sessionEnded" IsVisible="{Binding IsEnded, FallbackValue=False}" Command="{Binding ClearEndedCommand}"
                ToolTip.Tip="{Binding EndedTip}" AutomationProperties.Name="Session ended. Switch Tasks back now">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon x:Name="EndedTarget" Classes="endedTarget" Kind="Target" Width="19" Height="19"
                                 Foreground="{DynamicResource Ab.Accent}" VerticalAlignment="Center" />
                <TextBlock Classes="numeral" Text="{Binding PrimaryText}" FontSize="13" Foreground="{DynamicResource Ab.Ink}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SecondaryText}" Foreground="{DynamicResource Ab.Muted}" FontSize="13" FontWeight="Medium"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Panel>
</UserControl>
