<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.QuitGuardCard"
             x:DataType="vm:QuitGuardViewModel">
    <!-- The quit safeguard (ADR 59), a row under the profiles on the Guards page and the migration assistant's page. -->
    <Border Classes="sRow" search:SearchArea.Name="Quit safeguard">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsEnabled="{Binding CanEdit}">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="sTitle" Text="Quit safeguard" />
                    <TextBlock Classes="sHint" TextWrapping="Wrap"
                               Text="Refuses the tray's Quit at the times below, and brings AccountabiliBuddy back if it's ended from Task Manager then. Windows shutdown, sign-out and updates still work. It's friction, not a lock: it can still be got around." />
                </StackPanel>
                <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding IsOn}" VerticalAlignment="Center" AutomationProperties.Name="Quit safeguard" />
            </Grid>

            <StackPanel Spacing="8" IsVisible="{Binding IsOn}" IsEnabled="{Binding CanEdit}">
                <TextBlock Classes="sHint" Text="During these parts of your day" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="16" LineSpacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuitCategoryRowViewModel">
                            <CheckBox IsChecked="{Binding IsTicked}" AutomationProperties.Name="{Binding Name}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox IsChecked="{Binding DuringSession}" Content="During a focus session, breaks included" />
                <StackPanel Spacing="2">
                    <CheckBox IsChecked="{Binding AllTheTime}" Content="All the time (hardcore)" />
                    <TextBlock Classes="sHint" TextWrapping="Wrap" Margin="28,0,0,0"
                               Text="The only way back out is your spare key, then the wait for looser changes." />
                </StackPanel>
            </StackPanel>

            <!-- Leaving "All the time": the spare key, before the wait starts. -->
            <Border IsVisible="{Binding AsksKey}" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Text="Type your spare key to leave &quot;All the time&quot;. The wait for looser changes starts after that." />
                    <TextBox Text="{Binding TypedKey}" PlaceholderText="Spare key" AutomationProperties.Name="Spare key" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start the wait" Command="{Binding ConfirmKeyCommand}" />
                        <Button Classes="quiet" Content="Keep it on" Command="{Binding CancelKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" Foreground="{DynamicResource Ab.Drift}" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Spacing="6" IsVisible="{Binding HasPending}">
                <TextBlock Classes="sHint" Text="{Binding PendingText}" TextWrapping="Wrap" />
                <Button Classes="quiet" Content="Cancel this change" Command="{Binding CancelPendingCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Classes="sHint" Text="Locked while a focus session you started is running." IsVisible="{Binding InFocus}" />
        </StackPanel>
    </Border>
</UserControl>
