<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        x:Class="AccountabiliBuddy.App.Views.StartOfDayWindow"
        x:DataType="vm:StartOfDayCardViewModel"
        Title="Start of your day"
        Width="560" SizeToContent="Height" MaxHeight="760"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual">
    <!-- The start-of-day assistant: on the first arrival of a workday, in front of everything (hours, first tasks, Start). -->
    <Border Padding="24,20" Background="#FF15191E" BorderBrush="#AA2A9D8F" BorderThickness="2" CornerRadius="10">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding StepText}" FontSize="12" Opacity="0.7" />
            <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#FFE9B44C"
                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- 1: today's hours -->
            <StackPanel IsVisible="{Binding IsHoursStep}" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding Hours}" Minimum="0.5" Maximum="8" Increment="0.5" FormatString="0.0" Width="150" />
                    <TextBlock Text="hours" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="This is today's goal, and today's budget on a Budget day. Raising it applies at once; lowering it waits like any looser change." />
            </StackPanel>

            <!-- 2: the first tasks, at most 3 for the session -->
            <StackPanel IsVisible="{Binding IsTasksStep}" Spacing="8">
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="Up to 3 tasks for this session. Tasks carried over from before are already here; more than 3 get picked down when you start." />
                <ScrollViewer MaxHeight="360">
                    <views:ChecklistView DataContext="{Binding Checklist}" />
                </ScrollViewer>
            </StackPanel>

            <!-- 3: start -->
            <StackPanel IsVisible="{Binding IsStartStep}" Spacing="8">
                <TextBlock Text="{Binding StartSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FFE9B44C"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Classes="accent" />
            </Grid>

            <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Reason}" PlaceholderText="Not now because… (e.g. stand-up call)" />
                        <Button Grid.Column="1" Content="Not now" Command="{Binding NotNowCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding ComesBackText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               IsVisible="{Binding ComesBackText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="The reason stays on this computer, sealed, for 14 days." FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
