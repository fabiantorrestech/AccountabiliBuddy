<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             xmlns:domain="using:AccountabiliBuddy.Core.Domain"
             x:Class="AccountabiliBuddy.App.Views.DayPlanView"
             x:DataType="vm:DayPlanViewModel">
    <UserControl.Styles>
        <!-- The day type list: the selected type in Surface2 and Ink, not Fluent's accent fill. -->
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
    </UserControl.Styles>
    <!-- The week cycle, the day types and the categories, in the Plan page's "Day types" sheet. Save and Revert are the same as ever:
         Save goes through the configuration (a change that frees today's work hours waits), and everything is locked during a session. -->
    <DockPanel Margin="30,8,24,20">
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsLocked}" Background="{DynamicResource Ab.Surface2}" BorderBrush="{DynamicResource Ab.Waiting}"
                BorderThickness="3,0,0,0" Padding="14,10" Margin="0,0,0,12" CornerRadius="6">
            <TextBlock Text="The day plan is locked while a focus session you started is running." TextWrapping="Wrap" />
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary" Padding="22,9" />
            <Button Content="Revert" Command="{Binding RevertCommand}" Padding="18,9" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="22" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsLocked}" Margin="0,0,14,0">
                <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="13"
                           Text="Day types (a timeline, a work window, a budget of productive hours, or a free day) and which type each weekday follows. Watch parts are when the buddy asks about new sites and counts drift, Comms parts are work time for mail and chat, Rest parts are breaks, and Sleep sets bedtime and wake time. A part that crosses midnight is the night before the day it ends on. A single date is changed with Change a day." />

                <!-- Which day type each weekday follows; one column per week of the repeating cycle, up to 8 (ADR 47). -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CalendarWeek" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="Week" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding WeekCountText}" VerticalAlignment="Center"
                                   ToolTip.Tip="The weeks take turns in a cycle of up to 8. Today has a switch to say which week of the cycle this one is." />
                        <Button Command="{Binding AddWeekCommand}" ToolTip.Tip="Add a week to the cycle (up to 8)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                <TextBlock Text="Add week" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveWeekCommand}" ToolTip.Tip="Remove the last week of the cycle">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="Minus" Width="16" Height="16" />
                                <TextBlock Text="Remove last week" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSeveralWeeks}">
                            <TextBlock Text="Week 1 starts on the Monday" VerticalAlignment="Center" />
                            <CalendarDatePicker SelectedDate="{Binding CycleStartDate}" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                    <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="110" />
                        <ItemsControl ItemsSource="{Binding WeekHeaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Width="180" Text="{Binding}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding WeekRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekdayRowViewModel">
                                <StackPanel Orientation="Horizontal" Margin="0,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Label}" Width="110" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WeekCellViewModel">
                                                <ComboBox Width="180" ItemsSource="{Binding $parent[UserControl].((vm:DayPlanViewModel)DataContext).Templates}"
                                                          SelectedItem="{Binding Template}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PlanTemplateEditorViewModel">
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- The day types (ADR 47): each a Schedule, a Budget or a free day; Workday and Off day stay. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Day types" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="6">
                            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanTemplateEditorViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Classes="muted" Text="{Binding Summary}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button Command="{Binding AddTemplateCommand}" ToolTip.Tip="Add a day type" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><mi:MaterialIcon Kind="Plus" Width="16" Height="16" /><TextBlock Text="Add" /></StackPanel>
                                </Button>
                                <Button Command="{Binding DuplicateTemplateCommand}" ToolTip.Tip="Copy the selected day type" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" /><TextBlock Text="Duplicate" /></StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteTemplateCommand}" ToolTip.Tip="Delete the selected day type (Workday and Off day stay)" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" /><TextBlock Text="Delete" /></StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                        <views:DayTemplateEditorView x:Name="TemplateEditor" DataContext="{Binding SelectedTemplate}"
                                                     IsVisible="{Binding $parent[UserControl].((vm:DayPlanViewModel)DataContext).HasSelectedTemplate}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Categories" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Watch: the buddy asks about new sites and counts drift · Comms: work time for mail and chat (on a day with Comms parts, mail and chat are distracting in a session outside them) · Rest: no asking; parked Today items come up · Sleep: bedtime reminder and the shaded night."
                               Opacity="0.75" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryRowViewModel">
                                <Grid ColumnDefinitions="200,90,120,Auto" ColumnSpacing="8" Margin="0,2">
                                    <TextBox Text="{Binding Name}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ColorChoice">
                                                <Border Width="40" Height="14" CornerRadius="3" Background="{Binding Brush}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:CategoryRowViewModel.Behaviors}" SelectedItem="{Binding Behavior}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="3" Content="Delete" Command="{Binding DeleteCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add a category" Command="{Binding AddCategoryCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
