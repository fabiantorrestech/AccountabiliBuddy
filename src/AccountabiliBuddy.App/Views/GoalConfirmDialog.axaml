<views:TaskDialogWindow xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:views="using:AccountabiliBuddy.App.Views"
                        x:Class="AccountabiliBuddy.App.Views.GoalConfirmDialog"
                        Title="Goals"
                        Icon="/Assets/app-icon.png"
                        Width="440">
    <!-- A question the goal screens ask first (round 2 R5.4): Delete goal… (red), Track time only (it waits). Esc or Cancel closes. -->
    <StackPanel Margin="22,20" Spacing="14">
        <TextBlock x:Name="TitleText" Classes="dlgTitle" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Classes="dlgSub" TextWrapping="Wrap" />
        <TextBlock x:Name="ResultText" FontSize="12.5" Foreground="{DynamicResource Ab.Waiting}" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Classes="dialogStart" Content="Cancel" Click="OnCancel" />
            <Button x:Name="RunButton" Classes="primary" Click="OnRun" />
        </StackPanel>
    </StackPanel>
</views:TaskDialogWindow>
