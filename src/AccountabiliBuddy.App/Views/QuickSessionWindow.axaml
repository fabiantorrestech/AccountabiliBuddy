<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        x:Class="AccountabiliBuddy.App.Views.QuickSessionWindow"
        x:DataType="vm:QuickSessionViewModel"
        Title="Quick focus"
        SizeToContent="WidthAndHeight"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        RequestedThemeVariant="Dark"
        TransparencyLevelHint="Transparent" Background="Transparent">
    <Border x:Name="Card" Margin="24" Width="480" Padding="24,20" CornerRadius="14"
            Background="#F51B2024" BorderBrush="#2EFFFFFF" BorderThickness="1"
            BoxShadow="0 10 36 0 #73000000"
            Opacity="0" RenderTransform="scale(0.96)">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>

        <StackPanel Spacing="16">
            <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" />

            <!-- A session is already running -->
            <StackPanel Spacing="12" IsVisible="{Binding IsSessionRunning}">
                <TextBlock Text="{Binding RunningSessionText}" FontSize="15" Opacity="0.85" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{Binding EndSessionText}" Command="{Binding EndSessionCommand}" />
                    <Button Content="Close" Command="{Binding CloseCommand}" Classes="accent" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Create a profile in Settings › Guards first." IsVisible="{Binding HasNoProfiles}" Opacity="0.85" />

            <!-- Start controls -->
            <StackPanel Spacing="16" IsVisible="{Binding CanChoose}">
                <views:QuickStartPanel x:Name="StartPanel" />

                <TextBlock Text="Enter start · Esc close · 1–5 presets · ← → ±5 min (Shift ±1) · B break · click the time to set an end"
                           FontSize="12" Opacity="0.55" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
