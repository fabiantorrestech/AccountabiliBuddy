<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        x:Class="AccountabiliBuddy.App.Views.NudgeToast"
        x:DataType="vm:NudgeToastViewModel"
        Title="AccountabiliBuddy nudge"
        Width="360" SizeToContent="Height"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual">
    <Grid ColumnDefinitions="6,*">
        <Border Grid.Column="0" Background="{Binding Accent}" />
        <StackPanel Grid.Column="1" Margin="14,12" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="✕" Command="{Binding DismissCommand}"
                        Padding="6,0" Background="Transparent" VerticalAlignment="Top"
                        ToolTip.Tip="Dismiss" />
            </Grid>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.9" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <!-- "Later ▾": a plain click waits the default time, the menu picks one. -->
                <SplitButton Content="Later" Command="{Binding LaterCommand}" IsVisible="{Binding HasLater}">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuItem Header="5 min" Command="{Binding LaterCommand}" CommandParameter="5" />
                            <MenuItem Header="15 min" Command="{Binding LaterCommand}" CommandParameter="15" />
                            <MenuItem Header="30 min" Command="{Binding LaterCommand}" CommandParameter="30" />
                            <MenuItem Header="1 h" Command="{Binding LaterCommand}" CommandParameter="60" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Content="{Binding ActionLabel}" Command="{Binding ActCommand}"
                        IsVisible="{Binding HasAction}" Classes="accent" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
