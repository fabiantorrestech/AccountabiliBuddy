<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        x:Class="AccountabiliBuddy.App.Views.TaskbarOverlayWindow"
        x:DataType="vm:TaskbarOverlayViewModel"
        Title="AccountabiliBuddy overlay"
        WindowDecorations="None" CanResize="False" SizeToContent="Width"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" RequestedThemeVariant="Dark"
        TransparencyLevelHint="Transparent" Background="Transparent">
    <controls:OverlayTileView x:Name="TileView" />
</Window>
