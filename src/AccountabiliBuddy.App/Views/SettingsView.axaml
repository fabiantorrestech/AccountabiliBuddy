<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             xmlns:services="using:AccountabiliBuddy.App.Services"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <!-- Each section is a card with room around it; translucent so it works in light and dark. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0F808080" />
            <Setter Property="BorderBrush" Value="#26808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.sectionLink">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="10,1,0,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.sectionLink:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- One Save for the whole tab, always in reach; leaving with unsaved changes asks first. -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="#33808080" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#F59E0B" IsVisible="{Binding HasUnsavedChanges}" VerticalAlignment="Center" />
                    <TextBlock Text="Unsaved changes" IsVisible="{Binding HasUnsavedChanges}" Opacity="0.85" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SaveStatus}" Opacity="0.75" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560"
                               IsVisible="{Binding !HasUnsavedChanges}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Revert" Command="{Binding RevertCommand}" IsEnabled="{Binding HasUnsavedChanges}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsEnabled="{Binding HasUnsavedChanges}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Why a save didn't go through stays visible while the changes are still unsaved. -->
        <Border DockPanel.Dock="Top" Padding="16,6" Background="#22E5484D"
                IsVisible="{Binding HasUnsavedChanges}">
            <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding SaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Border>
    <Grid ColumnDefinitions="230,*">
        <!-- Groups on the left (one shows at a time); clicking a section name scrolls to its card. -->
        <Border BorderBrush="#26808080" BorderThickness="0,0,1,0">
            <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedIndex="{Binding SelectedGroupIndex}" SelectionMode="AlwaysSelected"
                     SelectionChanged="OnGroupChanged"
                     Background="Transparent" Margin="8,12,8,12">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsGroupViewModel">
                        <StackPanel Spacing="2" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="sectionLink" Text="{Binding}" Tapped="OnSectionTapped" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ScrollViewer x:Name="SectionsScroller" Grid.Column="1">
            <StackPanel Margin="24,16,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <Border IsVisible="{Binding IsLocked}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                    <TextBlock Text="Settings are locked while a focus session is running." />
                </Border>
                <views:PendingChangesBanner DataContext="{Binding PendingChanges}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Spacing="16" IsVisible="{Binding Groups[0].IsSelected}"
                            search:SearchArea.Name="Focus sessions" search:SearchArea.SettingsGroup="0">
                    <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="Target" Width="22" Height="22" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Focus sessions" Classes="groupTitle" /></StackPanel>
                    <Border Classes="card" search:SearchArea.Name="Quick session shortcut">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="KeyboardOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Quick session shortcut" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="Click the box and press the keys you want (at least one of Ctrl, Alt or Win, plus a letter, number, F-key or Space)."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <controls:HotkeyBox Text="{Binding HotkeyText}" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="Quick Start with Default" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="The big &quot;Quick Start with Default&quot; button (quick session and Today tab) starts this profile with no set end: the on-screen bar fills each hour and glows every 30 minutes with how long you've been at it (hold Ctrl+Alt to see it any time). &quot;Quick Start&quot; does the same with the profile picked there."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding CountUpChoices}" SelectedItem="{Binding SelectedCountUp}" MinWidth="300" />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Step away" IsVisible="{Binding HasStepAway}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Walk" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Step away" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="A bathroom break or someone at your desk: the countdown pauses until you're back. Any key or mouse movement brings you back. It never shortens a wait. Also in the tray and the on-screen window (hold Ctrl+Alt)."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <controls:HotkeyBox Text="{Binding StepAwayHotkey}" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding StepAwayStatus}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Content="Step away by itself after" IsChecked="{Binding StepAwayAutoIdle}" />
                            <NumericUpDown Value="{Binding StepAwayIdleMinutes}" Minimum="1" Maximum="60" Increment="1" FormatString="0"
                                           Width="110" IsEnabled="{Binding StepAwayAutoIdle}" />
                            <TextBlock Text="minutes with no input" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="The idle minutes before it starts still count as focus." Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Hyperfocus reminder" IsVisible="{Binding HasHyperfocus}">
                    <StackPanel Spacing="6" DataContext="{Binding Hyperfocus}" x:DataType="vm:HyperfocusViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Brain" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Hyperfocus reminder" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="One quiet reminder after a long stretch of focus with no break: water, stand, eat. Coming back from Step away starts the stretch over."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Content="Remind me after" IsChecked="{Binding IsOn}" />
                            <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="15" Maximum="240" Increment="15" FormatString="0"
                                           Width="110" IsEnabled="{Binding IsOn}" />
                            <TextBlock Text="minutes of unbroken focus" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="During these profiles:" Opacity="0.75" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HyperfocusProfileRowViewModel">
                                    <CheckBox IsChecked="{Binding Reminds}" Content="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save reminder" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Pomodoro defaults">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="TimerOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Pomodoro defaults" Classes="sectionTitle" />
                        </StackPanel>
                        <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="Focus (minutes)" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FocusMinutes}" />
                            <TextBlock Grid.Row="1" Text="Short break (minutes)" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortBreakMinutes}" />
                            <TextBlock Grid.Row="2" Text="Long break (minutes)" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LongBreakMinutes}" />
                            <TextBlock Grid.Row="3" Text="Long break every N cycles" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CyclesBeforeLongBreak}" />
                        </Grid>
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Escalation">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="AlertOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Escalation (seconds of continuous distraction)" Classes="sectionTitle" />
                        </StackPanel>
                        <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="Notification after" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NudgeSeconds}" />
                            <TextBlock Grid.Row="1" Text="Screen overlay after" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverlaySeconds}" />
                            <TextBlock Grid.Row="2" Text="Minimize / block after" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnforceSeconds}" />
                        </Grid>
                        <!-- The computer types' "notice and overlay only" (ADR 22), e.g. on a work computer. -->
                        <CheckBox IsChecked="{Binding NoticeAndOverlayOnly}"
                                  Content="Notice and overlay only: never minimize a window or redirect a tab (e.g. on a work computer)" />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Ending a focus session early">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ExitRun" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Ending a focus session early" Classes="sectionTitle" />
                        </StackPanel>
                        <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="Wait before you can end (seconds)" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BypassWaitSeconds}" />
                            <TextBlock Grid.Row="1" Text="Minimum reason length (characters)" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinReasonLength}" />
                        </Grid>
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Unlocks">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="LockOpenOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Unlocks" Classes="sectionTitle" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding RelockAtMidnight}" Content="Relock at midnight" />
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                   Text="When on, an unlock lifts the blocks only until the next midnight unless you pick another time when unlocking. Unlock options are set per profile." />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Looser changes">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="TimerSand" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Looser changes" Classes="sectionTitle" />
                        </StackPanel>
                        <Grid ColumnDefinitions="240,120">
                            <TextBlock Text="Wait before they apply (minutes)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding LooseningDelayMinutes}" />
                        </Grid>
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                   Text="Removing a block rule, adding an allow rule or an unlock option, or lowering any wait counts down this long first, and never takes effect during a session. Stricter changes apply at once. Shortening this wait counts down too." />
                    </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="16" IsVisible="{Binding Groups[1].IsSelected}"
                            search:SearchArea.Name="Your day" search:SearchArea.SettingsGroup="1">
                    <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="WeatherSunny" Width="22" Height="22" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Your day" Classes="groupTitle" /></StackPanel>
                    <Border Classes="card" search:SearchArea.Name="Steer me to start" IsVisible="{Binding HasStartNudge}">
                    <StackPanel Spacing="6" DataContext="{Binding StartNudge}" x:DataType="vm:StartNudgeViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="CompassOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Steer me to start" Classes="sectionTitle" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsOn}" Content="During work parts with no session, open Today with the task box ready" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                            <TextBlock Text="Nudge again every" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Static vm:StartNudgeViewModel.RepeatNames}" SelectedIndex="{Binding RepeatIndex}" MinWidth="140" />
                        </StackPanel>
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                   Text="When a work part starts, when the app starts during one, when you come back after 10 minutes away, and again every few minutes until a session starts. Never during a session; the on-screen window says it in amber meanwhile." />
                    </StackPanel>
                    </Border>
                    <!-- ADR 27: a personal computer can hold dev tools during the plan's work parts. -->
                    <Border Classes="card" search:SearchArea.Name="Work hours on this computer" IsVisible="{Binding HasWorkHours}">
                    <StackPanel Spacing="8" DataContext="{Binding WorkHours}" x:DataType="vm:WorkHoursViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="BriefcaseOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Work hours on this computer" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="For a personal computer next to your work one: during your day plan's work parts, the apps below are minimized at once (Claude Code, terminals and editors by default). Calls, mail and the browser stay open. It also holds during a session you start here. Reaching for one of them after a pause asks what you were about to do. Stopping for today waits like ending a session early; while it's on, a day plan change that frees today's work hours waits too."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Content="Turn on" Command="{Binding TurnOnCommand}" IsVisible="{Binding !IsOn}" Classes="accent" />
                            <Button Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding IsOn}" />
                            <Button Content="Stop for today…" Command="{Binding BeginStopCommand}" IsVisible="{Binding HasWorkLeftToday}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsStopping}">
                            <TextBlock Text="{Binding StopWaitText}" />
                            <TextBox Text="{Binding StopReason}" PlaceholderText="Why stop today? (the same reason length as ending a session early)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Stop for today" Command="{Binding ConfirmStopCommand}" />
                                <Button Content="Cancel" Command="{Binding CancelStopCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Apps that wait (process names, comma separated)" FontSize="12" Opacity="0.75" />
                        <TextBox Text="{Binding AppsText}" TextWrapping="Wrap" AcceptsReturn="False" />
                        <Button Content="Save apps" Command="{Binding SaveAppsCommand}" HorizontalAlignment="Left" />
                        <!-- Lights out (design K, opt-in): only while work hours are kept here. -->
                        <StackPanel Spacing="4" Margin="0,8,0,0"
                                    DataContext="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).LightsOut}" x:DataType="vm:LightsOutViewModel"
                                    IsVisible="{Binding CanUse, FallbackValue=False}">
                            <CheckBox IsChecked="{Binding IsOn}" Content="Lights out: lock this computer when a work part starts and after 3 idle minutes during work hours" />
                            <CheckBox IsChecked="{Binding UsesSleep}" Content="Sleep instead of locking (stronger; downloads pause)" Margin="28,0,0,0" IsVisible="{Binding IsOn}" />
                            <TextBlock Text="Never while a session runs here, during a calendar event, on a day off or once today's goal is met. Waking lands on the gate."
                                       Opacity="0.75" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F4A261"
                                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.85"
                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Day bar">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ChartTimelineVariant" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Day bar" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="The bar above the tabs: rows for your calendar, your day plan, the focus sessions you started (with red drift marks) and Cold Turkey's blocks, with a red line at now. The on-screen timeline uses the same rows. Can be saved during focus too."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding ShowDayBar}" Content="Show the day bar" />
                        <RadioButton GroupName="dayRange" IsChecked="{Binding !DayBarFullDay}" Content="Fit to my day (grows when a block falls outside it; with sleep mode on, wake time to bedtime)" />
                        <RadioButton GroupName="dayRange" IsChecked="{Binding DayBarFullDay}" Content="Always the whole 24 hours" />
                        <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" IsEnabled="{Binding !DayBarFullDay}">
                            <TextBlock Grid.Row="0" Text="Day starts at" VerticalAlignment="Center" />
                            <TimePicker Grid.Row="0" Grid.Column="1" SelectedTime="{Binding DayStart}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                            <TextBlock Grid.Row="1" Text="Day ends at (before the start = after midnight)" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding DayEnd}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                        </Grid>

                        <TextBlock Text="Rows, top to bottom" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding TimelineRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelineRowSettingViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                        <CheckBox IsChecked="{Binding Shown}" Content="{Binding Name}" Width="320" />
                                        <Button Content="↑" Command="{Binding MoveUpCommand}" Padding="10,2" ToolTip.Tip="Move up" />
                                        <Button Content="↓" Command="{Binding MoveDownCommand}" Padding="10,2" ToolTip.Tip="Move down" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Calendars on the timeline" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="No calendars to show yet: add them in the Calendar tab (hidden calendars aren't listed)."
                                   IsVisible="{Binding !HasTimelineCalendars}" Opacity="0.75" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding TimelineCalendars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelineCalendarViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding OnTimeline}" Content="{Binding Name}" />
                                        <TextBlock Text="{Binding SourceName}" Opacity="0.6" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox IsChecked="{Binding ShowColdTurkeyOnTimeline}" Content="Show Cold Turkey's blocks on the Blockers row" Margin="0,4,0,0" />

                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Sleep">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="WeatherNight" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Sleep" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="Your bedtime and wake time. The day bar runs from wake time to bedtime and shades the night; staying up past bedtime shades the lost sleep red. From when going to bed would give your sleep goal, a line on screen counts down the sleep you'll get if you go now, with your wake time (green down to an hour under the goal, yellow down to three hours under, red below), and a reminder pops up two hours before bedtime. Hold Ctrl+Alt over the on-screen window to change tonight's wake time. The times are the Sleep parts of your day plan. Can be changed during focus too."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding SleepEnabled}" Content="Use sleep mode" />
                        <!-- ADR 23: the phone's next alarm (from its sync file) as the wake time, over a one-night change. -->
                        <!-- ADR 35: where the wake time comes from, this PC's own choice. -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Wake time from" VerticalAlignment="Center" Width="240" />
                            <ComboBox SelectedIndex="{Binding WakeSource}" MinWidth="260">
                                <ComboBoxItem Content="My phone's alarm" />
                                <ComboBoxItem Content="This PC's alarm (it rings here)" />
                                <ComboBoxItem Content="Neither (the Sleep part's wake time)" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="My phone's alarm wins over a one-night change (changing tomorrow's wake then asks first). This PC's alarm rings at the night's wake time with Stop and Snooze 9 min; it can only wake you if the PC is on or Windows can wake it."
                                   Opacity="0.75" TextWrapping="Wrap" Margin="28,0,0,0" />
                        <TextBlock Text="{Binding PcAlarmNote}" IsVisible="{Binding PcAlarmNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="#F59E0B" TextWrapping="Wrap" Margin="28,0,0,0" />
                        <!-- ADR 38: the bedtime reminders, shared with the phone. -->
                        <StackPanel Spacing="6" DataContext="{Binding Reminders}" x:DataType="vm:BedtimeRemindersViewModel">
                            <CheckBox IsChecked="{Binding On}" Content="Bedtime reminders (shared with your phone; each says where it rings)" />
                            <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding On}" Margin="28,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BedtimeReminderRowViewModel">
                                        <WrapPanel Orientation="Horizontal" Margin="0,2">
                                            <ComboBox ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding MinutesBefore}" MinWidth="90" Margin="0,0,8,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Int32">
                                                        <TextBlock Text="{Binding StringFormat='{}{0} min'}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="before bedtime" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding Alarm}" Content="Rings" Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding Phone}" Content="Phone" Margin="0,0,8,0" />
                                            <CheckBox IsChecked="{Binding Watch}" Content="Watch" Margin="0,0,8,0" />
                                            <CheckBox IsChecked="{Binding AllPcs}" Content="All PCs" Margin="0,0,8,0" />
                                            <CheckBox IsChecked="{Binding ThisPc}" Content="This PC" IsVisible="{Binding HasThisPc}" Margin="0,0,8,0" />
                                            <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this reminder" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsVisible="{Binding On}">
                                <Button Content="Add a reminder" Command="{Binding AddCommand}" />
                                <Button Content="Reset to the 3 defaults" Command="{Binding ResetCommand}" />
                            </StackPanel>
                            <TextBlock Text="0 min = at bedtime. A reminder that rings has Dismiss and Snooze 5 min; dismissing it on one device stops it on the others. Sound and volume for the phone are set on the phone."
                                       Opacity="0.75" TextWrapping="Wrap" Margin="28,0,0,0" />
                        </StackPanel>
                        <!-- ADR 34: the phone learns a smart bedtime; the PC takes its time in bed before waking. -->
                        <CheckBox IsChecked="{Binding UsePhoneBedtime}"
                                  Content="Use my phone's smart bedtime (it learns from your measured sleep and moves bedtime earlier as you earn it)" />
                        <TextBlock Text="{Binding PhoneBedtimeText}" Opacity="0.75" TextWrapping="Wrap" Margin="28,0,0,0" />
                        <!-- ADR 34, 35: the smart bedtime's switches and limits, shared with the phone, which alone measures sleep. -->
                        <StackPanel Spacing="6" Margin="28,0,0,0" IsEnabled="{Binding CanUseSmartBedtime}">
                            <TextBlock Text="{Binding SmartBedtimeHint}" Opacity="0.75" TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding SmartWorkdays}" Content="Smart bedtime for Workdays (nights before a workday)" />
                            <CheckBox IsChecked="{Binding SmartOffDays}" Content="Smart bedtime for Off-Days" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Minimum sleep" VerticalAlignment="Center" Width="212" />
                                <ComboBox ItemsSource="{Binding SmartMinChoices}" SelectedItem="{Binding SmartMin}" MinWidth="120">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SleepGoalChoice">
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Maximum sleep" VerticalAlignment="Center" Width="212" />
                                <ComboBox ItemsSource="{Binding SmartMaxChoices}" SelectedItem="{Binding SmartMax}" MinWidth="120">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SleepGoalChoice">
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6" IsEnabled="{Binding SleepEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Sleep goal" VerticalAlignment="Center" Width="240" />
                                <ComboBox ItemsSource="{Binding SleepGoalChoices}" SelectedItem="{Binding SelectedSleepGoal}" MinWidth="120">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SleepGoalChoice">
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <TextBlock Text="Nights before workdays" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding WeeknightSleepText}" Opacity="0.8" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="Other nights" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WeekendSleepText}" Opacity="0.8" VerticalAlignment="Center" />
                            </Grid>
                            <Button Content="Edit sleep times in the Day plan" Command="{Binding EditSleepTimesCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Text="Real sleep from a Fitbit or Pixel Watch (coming next): prepare your Google project now." Opacity="0.75" TextWrapping="Wrap" />
                            <Button Content="Set up sleep tracking with Google…" Command="{Binding OpenSleepGuideCommand}" />
                        </StackPanel>

                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Calendars">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="CalendarMonthOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Calendars" Classes="sectionTitle" />
                        </StackPanel>
                        <Grid ColumnDefinitions="240,120">
                            <TextBlock Text="Check iCal links every (minutes)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding CalendarRefreshMinutes}" />
                        </Grid>
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                   Text="5 minutes or more. Links are also checked when you press Refresh calendars and when the window opens. Google accounts check for changes every 30 seconds." />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <TextBlock Text="Google client (for Connect a Google account)" VerticalAlignment="Center" />
                            <Button Content="Set up Google step by step…" Command="{Binding OpenGoogleGuideCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="2" Opacity="0.75">
                            <TextBlock TextWrapping="Wrap" Text="In your own Google Cloud project:" />
                            <TextBlock TextWrapping="Wrap" Text="1. Turn on the Google Calendar API (and the Google Drive API for Drive sync)." />
                            <TextBlock TextWrapping="Wrap" Text="2. Set up the OAuth consent screen and add yourself as a test user." />
                            <TextBlock TextWrapping="Wrap" Text="3. Add the scopes: Calendar read-only (and drive.file for Drive sync)." />
                            <TextBlock TextWrapping="Wrap" Text="4. Create an OAuth client of type Desktop app." />
                            <TextBlock TextWrapping="Wrap" Text="5. Paste its client ID and secret below." />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="While the project is in Testing, Google ends the sign-in after 7 days: publish it (Audience → Publish app) to stop that; the step-by-step guide shows how. The secret is stored encrypted on this computer." />
                        </StackPanel>
                        <TextBox Text="{Binding GoogleClientId}" PlaceholderText="Client ID (…apps.googleusercontent.com)" />
                        <TextBox Text="{Binding GoogleClientSecret}" PasswordChar="•" PlaceholderText="{Binding GoogleClientSecretHint}" />
                    </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="16" IsVisible="{Binding Groups[2].IsSelected}"
                            search:SearchArea.Name="On screen &amp; sound" search:SearchArea.SettingsGroup="2">
                    <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="MonitorSpeaker" Width="22" Height="22" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="On screen &amp; sound" Classes="groupTitle" /></StackPanel>
                    <Border Classes="card" search:SearchArea.Name="Theme" IsVisible="{Binding HasMotion}">
                    <StackPanel Spacing="6" DataContext="{Binding Motion}" x:DataType="vm:MotionViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Theme" Classes="sectionTitle" />
                        </StackPanel>
                        <ComboBox ItemsSource="{x:Static vm:MotionViewModel.ThemeNames}" SelectedIndex="{Binding ThemeIndex}" MinWidth="160" />
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                   Text="Light or dark for the app's window; As Windows follows Windows' own setting. The on-screen window stays dark so it reads over anything." />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Animations" IsVisible="{Binding HasMotion}">
                    <StackPanel Spacing="6" DataContext="{Binding Motion}" x:DataType="vm:MotionViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Animation" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Animations" Classes="sectionTitle" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Speed" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Static vm:MotionViewModel.SpeedNames}" SelectedIndex="{Binding SpeedIndex}" MinWidth="140" />
                        </StackPanel>
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                   Text="Pages fade and slide in when you open a tab, cards ease their colour and progress bars glide. Off shows every change at once." />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Sounds when time is up">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="BellRingOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Sounds when time is up" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="Played when focus or a break runs out (not when you end a session yourself), also while the on-screen window is hidden. Can be saved during focus too."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="240,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                            <TextBlock Grid.Row="0" Text="When focus is up (break or end)" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding FocusEndSound}" MinWidth="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:SoundChoice">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Row="0" Grid.Column="2" Content="Test" Command="{Binding TestFocusEndSoundCommand}" />
                            <TextBlock Grid.Row="1" Text="When a break is up" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding BreakEndSound}" MinWidth="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:SoundChoice">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Row="1" Grid.Column="2" Content="Test" Command="{Binding TestBreakEndSoundCommand}" />
                            <TextBlock Grid.Row="2" Text="Volume (built-in chimes)" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}" Width="200" />
                                <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add a .wav file…" Command="{Binding AddSoundFileCommand}" />
                            <TextBlock Text="{Binding SoundStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Noise player">
                    <StackPanel Spacing="6" IsVisible="{Binding HasNoisePlayer}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="MusicNote" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Noise player" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="The player at the bottom left plays the sound files of this folder in name order (mp3, wav, m4a, aac, flac, wma). Folder changes apply at once."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NoiseFolderText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose folder…" Command="{Binding ChooseNoiseFolderCommand}" />
                            <Button Content="Use Music\Noise" Command="{Binding UseMusicNoiseFolderCommand}" />
                            <Button Content="Look for new files" Command="{Binding RescanNoiseFolderCommand}" />
                        </StackPanel>
                        <TextBlock Text="Shortcuts work anywhere: click a box and press the keys (Ctrl, Alt or Win plus a letter, number, F-key, Space, an arrow or Page Up/Down); Backspace clears it."
                                   Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <TextBlock Text="Play / pause" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Column="1" Text="{Binding NoisePlayPauseKey}" Width="220" />
                            <TextBlock Grid.Row="1" Text="Volume up 10%" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Row="1" Grid.Column="1" Text="{Binding NoiseVolumeUpKey}" Width="220" />
                            <TextBlock Grid.Row="2" Text="Volume down 10%" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Row="2" Grid.Column="1" Text="{Binding NoiseVolumeDownKey}" Width="220" />
                        </Grid>
                        <CheckBox Content="The keyboard's media keys and Windows' media pop-up also control the noise" IsChecked="{Binding NoiseMediaKeys}" />
                        <CheckBox Content="Stop when headphones disconnect" IsChecked="{Binding NoiseStopsWhenHeadphonesGo}" Margin="0,6,0,0" />
                        <TextBlock Text="Pauses the noise when any headphones go, wired or Bluetooth, so it never carries on through the speakers. Applies at once. The lock on the player (bottom left) goes further: it won't play at all without headphones."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NoiseKeysStatus}" TextWrapping="Wrap"
                                   IsVisible="{Binding NoiseKeysStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Play when headphones connect" IsVisible="{Binding HasHeadphones}">
                    <StackPanel Spacing="6" DataContext="{Binding Headphones}" x:DataType="vm:HeadphoneSettingsViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Headphones" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Play when headphones connect" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="The noise player starts its last file when these headphones connect, any time of day, and pauses when they disconnect. Changes apply at once."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <Border Background="#1FF59E0B" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="Tip: it really helps to have a dedicated pair of work/focus headphones, so putting them on means focus and it doesn't get in the way of your normal headphones."
                                       TextWrapping="Wrap" />
                        </Border>
                        <CheckBox IsChecked="{Binding Wired}" Content="Wired headphones or a headset (USB always works; a headphone jack only if your sound driver reports it)" />
                        <CheckBox IsChecked="{Binding Bluetooth}" Content="These Bluetooth headphones:" />
                        <StackPanel Margin="28,0,0,0" Spacing="4" IsVisible="{Binding Bluetooth}">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HeadphoneChoiceViewModel">
                                        <CheckBox IsChecked="{Binding IsChosen}" Content="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Status}" Opacity="0.75" TextWrapping="Wrap"
                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Button Content="Look again" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="16" IsVisible="{Binding Groups[3].IsSelected}"
                            search:SearchArea.Name="Overlay" search:SearchArea.SettingsGroup="3">
                    <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="LayersOutline" Width="22" Height="22" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="Overlay" Classes="groupTitle" /></StackPanel>
                    <Border Classes="card" search:SearchArea.Name="On-screen timer">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ClockOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="On-screen timer" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="Shows how much of the session is left, on top of other windows, for the profiles chosen below (also set in each profile on the Profiles tab). Clicks go through it; hold Ctrl+Alt to see the details and drag to move it. Can be saved during focus too."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="Look" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Text="At rest" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerColourModes}"
                                      SelectedIndex="{Binding TimerColourIndex}" MinWidth="200" />
                            <TextBlock Grid.Row="4" Text="Corner (bottom corners stay above the taskbar)" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerCornerNames}"
                                      SelectedIndex="{Binding TimerCornerIndex}" MinWidth="200" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerStyleNames}"
                                      SelectedIndex="{Binding TimerStyleIndex}" MinWidth="200" />
                            <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerSizeNames}"
                                      SelectedIndex="{Binding TimerSizeIndex}" MinWidth="200" />
                            <TextBlock Grid.Row="3" Text="Marks (split the bar or ring into equal parts)" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerMarkNames}"
                                      SelectedIndex="{Binding TimerMarksIndex}" MinWidth="200" />
                            <TextBlock Grid.Row="2" Text="Opacity" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding TimerOpacityPercent}" Width="200" />
                                <TextBlock Text="{Binding TimerOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <CheckBox IsChecked="{Binding TimerWrapUpColor}" Content="Turn amber in the last 5 minutes of focus" />
                        <CheckBox IsChecked="{Binding TimerPulseAtMarks}" Content="Brighten softly once when passing a mark" />
                        <CheckBox IsChecked="{Binding TimerHideInFullscreen}" Content="Hide while a fullscreen app is in front (videos, presentations, games)" />
                        <CheckBox IsChecked="{Binding TimerFillUp}" Content="Fill up as time passes (instead of counting down from a full bar)" />
                        <CheckBox IsChecked="{Binding TimerQuietMarks}"
                                  Content="Quiet at rest dulls the timeline's red too (drift marks, now line), 3 seconds after Ctrl+Alt is let go" />
                        <CheckBox IsChecked="{Binding TaskOnlyWithCtrlAlt}" Content="Hide the current task unless Ctrl+Alt is held" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Opacity while Ctrl+Alt is held (background and all)" VerticalAlignment="Center" />
                            <Slider Minimum="20" Maximum="100" Value="{Binding HeldOpacityPercent}" Width="200" />
                            <TextBlock Text="{Binding HeldOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnDefinitions="240,Auto" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding MoveForMaximizedApps}" VerticalAlignment="Center">
                                <TextBlock Text="Move in from the corner while a maximized app is in front (keeps its buttons and bars clickable)" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding MoveForMaximizedApps}" VerticalAlignment="Center">
                                <NumericUpDown Value="{Binding MaximizedAppDrop}" Minimum="0" Maximum="600" Increment="10" FormatString="0" MinWidth="140" />
                                <TextBlock Text="{Binding VerticalLabel}" VerticalAlignment="Center" Opacity="0.75" />
                                <TextBlock Text="(default)" VerticalAlignment="Center" Opacity="0.75" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4" IsEnabled="{Binding MoveForMaximizedApps}" Margin="0,2,0,4">
                            <TextBlock Text="Per app: maximize the app, hold Ctrl+Alt and drag the timer where it should sit (away from the corner, and sideways past a side panel if needed); that spot is kept for the app."
                                       Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding AppDrops}" IsVisible="{Binding HasAppDrops}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppDropRowViewModel">
                                        <Grid ColumnDefinitions="160,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                            <TextBlock Text="{Binding App}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Drop}" Minimum="0" Maximum="600" Increment="10" FormatString="0" MinWidth="120" />
                                            <TextBlock Grid.Column="2" Text="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).VerticalLabel}" VerticalAlignment="Center" Opacity="0.75" />
                                            <NumericUpDown Grid.Column="3" Value="{Binding Shift}" Minimum="0" Maximum="2000" Increment="10" FormatString="0" MinWidth="120" />
                                            <TextBlock Grid.Column="4" Text="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SidewaysLabel}" VerticalAlignment="Center" Opacity="0.75" />
                                            <Button Grid.Column="5" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Use the default for this app" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid ColumnDefinitions="240,Auto">
                            <TextBlock Text="Hide button (hold Ctrl+Alt) hides it for (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <NumericUpDown Grid.Column="1" Value="{Binding QuickHideSeconds}" Minimum="3" Maximum="600" Increment="5"
                                           FormatString="0" MinWidth="200" />
                        </Grid>
                        <TextBlock Text="Show it for these profiles" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="240,Auto" Margin="0,2">
                            <CheckBox IsChecked="{Binding DefaultTimerOn}" Content="Default (on for profiles set to Use default)" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultTimerColors}" SelectedItem="{Binding DefaultTimerColor}"
                                      IsEnabled="{Binding DefaultTimerOn}" MinWidth="200" ToolTip.Tip="Default timer colour">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimerColorOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                    BorderBrush="#55808080" BorderThickness="1" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TimerProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileTimerViewModel">
                                    <Grid ColumnDefinitions="240,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:TimerChoice.Names}" SelectedIndex="{Binding TimerChoiceIndex}"
                                                  MinWidth="130" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding TimerColors}" SelectedItem="{Binding TimerColor}"
                                                  IsVisible="{Binding HasOwnTimer}" MinWidth="170" ToolTip.Tip="Timer colour">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TimerColorOption">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                                BorderBrush="#55808080" BorderThickness="1" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="On-screen timeline">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Timeline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="On-screen timeline" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="A small copy of the day bar in the same spot as the timer: your blocks, the focus sessions you started and a red line at now, with the next block under it. It shows on days with blocks; hold Ctrl+Alt for how much you focused."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding ShowTimeline}" Content="Show the timeline on days with focus blocks" />
                        <StackPanel Spacing="6" IsEnabled="{Binding ShowTimeline}">
                            <TextBlock Text="While the session timer shows" />
                            <RadioButton GroupName="timelineInFocus" IsChecked="{Binding !TimelineStaysInFocus}" Content="Swap: the timer takes the timeline's place until the session ends" />
                            <RadioButton GroupName="timelineInFocus" IsChecked="{Binding TimelineStaysInFocus}" Content="Show both: timeline on top, timer under it" />
                            <CheckBox IsChecked="{Binding TimelineShowsTime}" Content="Show the current time" />
                            <TextBlock Text="While no session runs (in a session the timer's opacity applies)" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <TextBlock Grid.Row="0" Text="Opacity" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding TimelineOpacityPercent}" Width="200" />
                                    <TextBlock Text="{Binding TimelineOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Opacity while Ctrl+Alt is held" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding TimelineHeldOpacityPercent}" Width="200" />
                                    <TextBlock Text="{Binding TimelineHeldOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Reset position" Command="{Binding ResetTimerPositionCommand}" />
                            <TextBlock Text="{Binding TimerStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="16" IsVisible="{Binding Groups[4].IsSelected}"
                            search:SearchArea.Name="App &amp; data" search:SearchArea.SettingsGroup="4">
                    <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="CogOutline" Width="22" Height="22" VerticalAlignment="Center" Opacity="0.85" /><TextBlock Text="App &amp; data" Classes="groupTitle" /></StackPanel>
                    <Border Classes="card" search:SearchArea.Name="Computer type">
                    <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Laptop" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Computer type" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="{Binding ComputerTypeText}" />
                        <TextBlock Text="Applying a type sets its starting switches again (privacy, escalation, sharing, update checks). Profiles and the day plan stay as they are."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox SelectedIndex="{Binding ComputerTypeIndex}" MinWidth="200">
                                <ComboBoxItem Content="Personal computer" />
                                <ComboBoxItem Content="Work computer" />
                                <ComboBoxItem Content="Local only" />
                            </ComboBox>
                            <Button Content="Apply a type again" Command="{Binding ApplyComputerTypeCommand}" />
                        </StackPanel>
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Backup">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="BackupRestore" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Backup" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="Save your profiles, settings, calendars and history to a file, or restore them from one, e.g. on a new PC."
                                   Opacity="0.75" TextWrapping="Wrap" />
                        <views:BackupPanel DataContext="{Binding Backup}" />
                    </StackPanel>
                    </Border>
                    <Border Classes="card" search:SearchArea.Name="Data">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="DatabaseOutline" Width="18" Height="18" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Data" Classes="sectionTitle" />
                        </StackPanel>
                        <TextBlock Text="Everything is stored only on this computer:" Opacity="0.75" />
                        <SelectableTextBlock Text="{Binding DatabasePath}" />
                        <!-- Off: History keeps only times, apps, sites and their sections (ADR 22, the Work computer type). -->
                        <CheckBox IsChecked="{Binding KeepTitlesAndAddresses}" Margin="0,6,0,0"
                                  Content="Keep window titles, full addresses and screen text in History (encrypted). Off: only times, apps, sites and their sections" />
                        <TextBlock Text="{Binding VersionText}" Opacity="0.75" Margin="0,6,0,0" />
                    </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </DockPanel>
</UserControl>
