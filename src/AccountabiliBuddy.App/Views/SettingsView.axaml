<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             xmlns:services="using:AccountabiliBuddy.App.Services"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <!-- The Settings list's content for Your day, Sleep, Focus sessions, Alerts &amp; on-screen, Appearance and App &amp; data
         (the shell, SettingsShellView, holds the list, the Save bar and the rows that are pages of their own). One row's
         cards show at a time; Rows[i] is the list's row, and its SearchArea names let search open it. -->
    <UserControl.Styles>
        <!-- Each group of settings is a panel sunk into the page card (rows of a label, a Muted line and the control). -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Ab.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Ab.CardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer x:Name="SectionsScroller">
        <StackPanel Margin="0,0,16,24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <!-- Your day: each group of settings is a panel of rows (a title, a Muted line, the control on the right). -->
            <StackPanel Spacing="12" IsVisible="{Binding Rows[0].IsSelected}"
                        search:SearchArea.Name="Your day" search:SearchArea.SettingsGroup="0">
                <StackPanel Spacing="6" search:SearchArea.Name="Steer me to start" IsVisible="{Binding HasStartNudge}">
                    <TextBlock Classes="sGroup" Text="Steer me to start" />
                    <Border Classes="sPanel" DataContext="{Binding StartNudge}" x:DataType="vm:StartNudgeViewModel">
                        <StackPanel Margin="0,0,0,-1">
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="During work parts with no session, open Today with the task box ready when I arrive" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Open Today with the task box ready when I arrive" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="On my first arrival of a workday, ask how many hours I hope to get done, what's first, then start (start-of-day assistant)" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding IsAssistantOn}" IsEnabled="{Binding IsOn}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Start-of-day assistant" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Ask again every" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:StartNudgeViewModel.RepeatNames}" SelectedIndex="{Binding RepeatIndex}" MinWidth="140" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <TextBlock Classes="sHint"
                                           Text="It starts when you arrive: your first input in a work part, or after 10 minutes away. 5 minutes later with still no session, a card in front of everything asks you to start, or to say why not now (kept sealed on this computer for 14 days), and comes back until a session starts. Never during a session, a calendar event, a day off or once today's goal is met. The first arrival of a workday (before work starts too, never on a free day) opens the start-of-day assistant in front of everything instead, once a day: your hours for today (raising applies at once, lowering waits like any looser change), up to 3 first tasks, then Start with your remembered length. Not now works the same: a reason, then it asks again." />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6" search:SearchArea.Name="Lunch length on workdays" IsVisible="{Binding HasLunch}">
                    <TextBlock Classes="sGroup" Text="Lunch" />
                    <Border Classes="sPanel" DataContext="{Binding Lunch}" x:DataType="vm:LunchSettingsViewModel">
                        <StackPanel Margin="0,0,0,-1">
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="sTitle" Text="Lunch length on workdays" />
                                        <TextBlock Classes="sHint"
                                                   Text="Start lunch on Today (or your phone) on any workday; it lasts this long, and +5 / −5 min change it while you're on it, on every device. A lunch part in your day plan is only when you usually take it: it gives the reminder time and shows on the day bar." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <NumericUpDown Value="{Binding LengthMinutes}" Minimum="{x:Static vm:LunchSettingsViewModel.MinMinutes}"
                                                       Maximum="{x:Static vm:LunchSettingsViewModel.MaxMinutes}" Increment="{x:Static vm:LunchSettingsViewModel.StepMinutes}"
                                                       FormatString="0" Width="110" />
                                        <TextBlock Text="minutes" VerticalAlignment="Center" Classes="muted" />
                                        <TextBlock Text="{Binding LengthText, StringFormat='({0})'}" VerticalAlignment="Center" Classes="sHint" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ADR 27: a personal computer can hold dev tools during the plan's work parts. -->
                <StackPanel Spacing="6" search:SearchArea.Name="Work hours on this computer" IsVisible="{Binding HasWorkHours}">
                    <TextBlock Classes="sGroup" Text="Work hours on this computer" />
                    <Border Classes="sPanel" DataContext="{Binding WorkHours}" x:DataType="vm:WorkHoursViewModel">
                        <StackPanel Margin="0,0,0,-1">
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="sTitle" Text="{Binding StatusText}" FontWeight="SemiBold" />
                                        <TextBlock Classes="sHint"
                                                   Text="For a personal computer next to your work one: during your day plan's work parts, the apps below are minimized at once (Claude Code, terminals and editors by default). Calls, mail and the browser stay open. It also holds during a session you start here. Reaching for one of them after a pause asks what you were about to do. Stopping for today waits like ending a session early; while it's on, a day plan change that frees today's work hours waits too." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button Content="Turn on" Command="{Binding TurnOnCommand}" IsVisible="{Binding !IsOn}" />
                                        <Button Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding IsOn}" />
                                        <Button Content="Stop for today…" Command="{Binding BeginStopCommand}" IsVisible="{Binding HasWorkLeftToday}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="sRow" IsVisible="{Binding IsStopping}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="sTitle" Text="{Binding StopWaitText}" />
                                    <TextBox Text="{Binding StopReason}" PlaceholderText="Why stop today? (the same reason length as ending a session early)" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Stop for today" Command="{Binding ConfirmStopCommand}" />
                                        <Button Content="Cancel" Command="{Binding CancelStopCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="sRow">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="sTitle" Text="Apps that wait (process names, comma separated)" />
                                    <TextBox Text="{Binding AppsText}" TextWrapping="Wrap" AcceptsReturn="False" />
                                    <Button Content="Save apps" Command="{Binding SaveAppsCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <!-- Lights out (design K, opt-in): only while work hours are kept here. -->
                            <StackPanel DataContext="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).LightsOut}" x:DataType="vm:LightsOutViewModel"
                                        IsVisible="{Binding CanUse, FallbackValue=False}">
                                <Border Classes="sRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="sTitle" Text="Lights out: lock this computer when a work part starts and after 3 idle minutes during work hours" />
                                            <TextBlock Classes="sHint" Text="Never while a session runs here, during a calendar event, on a day off or once today's goal is met. Waking lands on the gate." />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding IsOn}" VerticalAlignment="Center" AutomationProperties.Name="Lights out" />
                                    </Grid>
                                </Border>
                                <Border Classes="sRow" IsVisible="{Binding IsOn}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="sTitle" Text="Sleep instead of locking (stronger; downloads pause)" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding UsesSleep}" VerticalAlignment="Center" AutomationProperties.Name="Sleep instead of locking" />
                                    </Grid>
                                </Border>
                                <Border Classes="sRow" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Waiting}" />
                                </Border>
                            </StackPanel>
                            <Border Classes="sRow" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="sHint" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6" search:SearchArea.Name="Day bar">
                    <TextBlock Classes="sGroup" Text="Day bar" />
                    <Border Classes="sPanel">
                        <StackPanel Margin="0,0,0,-1">
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="sTitle" Text="Show the day bar" />
                                        <TextBlock Classes="sHint"
                                                   Text="The bar above the Stats page: rows for your calendar, your day plan, the focus sessions you started (with red drift marks) and Cold Turkey's blocks, with a red line at now. The on-screen timeline uses the same rows. Can be saved during focus too." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding ShowDayBar}" VerticalAlignment="Center" AutomationProperties.Name="Show the day bar" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="sTitle" Text="Range" />
                                    <RadioButton GroupName="dayRange" IsChecked="{Binding !DayBarFullDay}" Content="Fit to my day (grows when a block falls outside it; with sleep mode on, wake time to bedtime)" />
                                    <RadioButton GroupName="dayRange" IsChecked="{Binding DayBarFullDay}" Content="Always the whole 24 hours" />
                                </StackPanel>
                            </Border>
                            <Border Classes="sRow" IsEnabled="{Binding !DayBarFullDay}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Day starts at" VerticalAlignment="Center" />
                                    <TimePicker Grid.Column="1" SelectedTime="{Binding DayStart}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow" IsEnabled="{Binding !DayBarFullDay}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Day ends at (before the start = after midnight)" VerticalAlignment="Center" />
                                    <TimePicker Grid.Column="1" SelectedTime="{Binding DayEnd}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sTitle" Text="Rows, top to bottom" />
                                    <ItemsControl ItemsSource="{Binding TimelineRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimelineRowSettingViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,3">
                                                    <CheckBox Classes="sw" IsChecked="{Binding Shown}" Content="{Binding Name}" />
                                                    <Button Grid.Column="1" Content="↑" Command="{Binding MoveUpCommand}" Padding="10,2" ToolTip.Tip="Move up" />
                                                    <Button Grid.Column="2" Content="↓" Command="{Binding MoveDownCommand}" Padding="10,2" ToolTip.Tip="Move down" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="sRow">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sTitle" Text="Calendars on the timeline" />
                                    <TextBlock Text="No calendars to show yet: add them in Settings › Connections (hidden calendars aren't listed)."
                                               IsVisible="{Binding !HasTimelineCalendars}" Classes="sHint" />
                                    <ItemsControl ItemsSource="{Binding TimelineCalendars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimelineCalendarViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" VerticalAlignment="Center" />
                                                    <CheckBox Classes="sw" IsChecked="{Binding OnTimeline}" Content="{Binding Name}" />
                                                    <TextBlock Text="{Binding SourceName}" Classes="faint" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Show Cold Turkey's blocks on the Blockers row" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding ShowColdTurkeyOnTimeline}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Show Cold Turkey's blocks on the Blockers row" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6" search:SearchArea.Name="Calendars">
                    <TextBlock Classes="sGroup" Text="Calendars" />
                    <Border Classes="sPanel">
                        <StackPanel Margin="0,0,0,-1" IsEnabled="{Binding !IsLocked}">
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="sTitle" Text="Check iCal links every (minutes)" />
                                        <TextBlock Classes="sHint"
                                                   Text="5 minutes or more. Links are also checked when you press Refresh calendars and when the window opens. Google accounts check for changes every 30 seconds." />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding CalendarRefreshMinutes}" Width="90" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="sTitle" Text="Google client (for Connect a Google account)" />
                                        <StackPanel Spacing="2" TextElement.Foreground="{DynamicResource Ab.Muted}" TextElement.FontSize="12">
                                            <TextBlock TextWrapping="Wrap" Text="In your own Google Cloud project:" />
                                            <TextBlock TextWrapping="Wrap" Text="1. Turn on the Google Calendar API (and the Google Drive API for Drive sync)." />
                                            <TextBlock TextWrapping="Wrap" Text="2. Set up the OAuth consent screen and add yourself as a test user." />
                                            <TextBlock TextWrapping="Wrap" Text="3. Add the scopes: Calendar read-only (and drive.file for Drive sync)." />
                                            <TextBlock TextWrapping="Wrap" Text="4. Create an OAuth client of type Desktop app." />
                                            <TextBlock TextWrapping="Wrap" Text="5. Paste its client ID and secret below." />
                                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="While the project is in Testing, Google ends the sign-in after 7 days: publish it (Audience → Publish app) to stop that; the step-by-step guide shows how. The secret is stored encrypted on this computer." />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Set up Google step by step…" Command="{Binding OpenGoogleGuideCommand}" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <StackPanel Spacing="8">
                                    <TextBox Text="{Binding GoogleClientId}" PlaceholderText="Client ID (…apps.googleusercontent.com)" />
                                    <TextBox Text="{Binding GoogleClientSecret}" PasswordChar="•" PlaceholderText="{Binding GoogleClientSecretHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Sleep -->
            <StackPanel Spacing="12" IsVisible="{Binding Rows[1].IsSelected}"
                        search:SearchArea.Name="Sleep" search:SearchArea.SettingsGroup="1">
                <TextBlock Classes="sHint" Margin="4,0,0,0"
                           Text="Your bedtime and wake time. The day bar runs from wake time to bedtime and shades the night; staying up past bedtime shades the lost sleep red. From when going to bed would give your sleep goal, a line on screen counts down the sleep you'll get if you go now, with your wake time (green down to an hour under the goal, yellow down to three hours under, red below), and a reminder pops up two hours before bedtime. Hold Ctrl+Alt over the on-screen window to change tonight's wake time. The times are the Sleep parts of your day plan. Can be changed during focus too, except turning sleep mode off: that waits like other looser changes and is refused during focus." />
                <Border Classes="sPanel">
                    <StackPanel Margin="0,0,0,-1">
                        <Border Classes="sRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sTitle" Text="Use sleep mode" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding SleepEnabled}" VerticalAlignment="Center" AutomationProperties.Name="Use sleep mode" />
                            </Grid>
                        </Border>
                        <Border Classes="sRow" IsVisible="{Binding HasSleepPendingOff}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Text="{Binding SleepPendingOffText}" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Waiting}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelSleepOffCommand}" />
                            </Grid>
                        </Border>
                        <!-- ADR 23: the phone's next alarm (from its sync file) as the wake time, over a one-night change. -->
                        <!-- ADR 35: where the wake time comes from, this PC's own choice. -->
                        <Border Classes="sRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="sTitle" Text="Wake time from" />
                                    <TextBlock Classes="sHint"
                                               Text="My phone's alarm wins over a one-night change (changing tomorrow's wake then asks first). This PC's alarm rings at the night's wake time with Stop and Snooze 9 min; it can only wake you if the PC is on or Windows can wake it." />
                                    <TextBlock Text="{Binding PcAlarmNote}" IsVisible="{Binding PcAlarmNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Foreground="{DynamicResource Ab.Waiting}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding WakeSource}" MinWidth="260" VerticalAlignment="Top">
                                    <ComboBoxItem Content="My phone's alarm" />
                                    <ComboBoxItem Content="This PC's alarm (it rings here)" />
                                    <ComboBoxItem Content="Neither (the Sleep part's wake time)" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Classes="sRow" IsEnabled="{Binding SleepEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sTitle" Text="Sleep goal" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SleepGoalChoices}" SelectedItem="{Binding SelectedSleepGoal}" MinWidth="120">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SleepGoalChoice">
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Classes="sRow" IsEnabled="{Binding SleepEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sTitle" Text="Nights before workdays" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding WeeknightSleepText}" Classes="sHint" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="sRow" IsEnabled="{Binding SleepEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sTitle" Text="Other nights" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding WeekendSleepText}" Classes="sHint" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="sRow" IsEnabled="{Binding SleepEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sHint" Text="The times are the Sleep parts of your day plan." VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Edit sleep times in the Day plan" Command="{Binding EditSleepTimesCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ADR 38: the bedtime reminders, shared with the phone. -->
                <TextBlock Classes="sGroup" Text="Bedtime reminders" />
                <Border Classes="sPanel" DataContext="{Binding Reminders}" x:DataType="vm:BedtimeRemindersViewModel">
                    <StackPanel Margin="0,0,0,-1">
                        <Border Classes="sRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sTitle" Text="Bedtime reminders (shared with your phone; each says where it rings)" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding On}" VerticalAlignment="Center" AutomationProperties.Name="Bedtime reminders" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding On}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BedtimeReminderRowViewModel">
                                    <Border Classes="sRow" Padding="18,10">
                                        <WrapPanel Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding MinutesBefore}" MinWidth="90" Margin="0,0,8,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Int32">
                                                        <TextBlock Text="{Binding StringFormat='{}{0} min'}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="before bedtime" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <CheckBox Classes="sw" IsChecked="{Binding Alarm}" Content="Rings" Margin="0,0,16,0" />
                                            <CheckBox Classes="sw" IsChecked="{Binding Phone}" Content="Phone" Margin="0,0,16,0" />
                                            <CheckBox Classes="sw" IsChecked="{Binding Watch}" Content="Watch" Margin="0,0,16,0" />
                                            <CheckBox Classes="sw" IsChecked="{Binding AllPcs}" Content="All PCs" Margin="0,0,16,0" />
                                            <CheckBox Classes="sw" IsChecked="{Binding ThisPc}" Content="This PC" IsVisible="{Binding HasThisPc}" Margin="0,0,16,0" />
                                            <Button Content="✕" Classes="quiet" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this reminder" />
                                        </WrapPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="sRow" IsVisible="{Binding On}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Add a reminder" Command="{Binding AddCommand}" />
                                    <Button Content="Reset to the 3 defaults" Command="{Binding ResetCommand}" />
                                </StackPanel>
                                <TextBlock Text="0 min = at bedtime. A reminder that rings has Dismiss and Snooze 5 min; dismissing it on one device stops it on the others. Sound and volume for the phone are set on the phone."
                                           Classes="sHint" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ADR 34: the phone learns a smart bedtime; the PC takes its time in bed before waking. -->
                <TextBlock Classes="sGroup" Text="Smart bedtime" />
                <Border Classes="sPanel">
                    <StackPanel Margin="0,0,0,-1">
                        <Border Classes="sRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="sTitle" Text="Use my phone's smart bedtime (it learns from your measured sleep and moves bedtime earlier as you earn it)" />
                                    <TextBlock Text="{Binding PhoneBedtimeText}" Classes="sHint" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding UsePhoneBedtime}" VerticalAlignment="Center" AutomationProperties.Name="Use my phone's smart bedtime" />
                            </Grid>
                        </Border>
                        <!-- ADR 34, 35: the smart bedtime's switches and limits, shared with the phone, which alone measures sleep. -->
                        <StackPanel IsEnabled="{Binding CanUseSmartBedtime}">
                            <Border Classes="sRow">
                                <TextBlock Text="{Binding SmartBedtimeHint}" Classes="sHint" />
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Smart bedtime for Workdays (nights before a workday)" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding SmartWorkdays}" VerticalAlignment="Center" AutomationProperties.Name="Smart bedtime for Workdays" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Smart bedtime for Off-Days" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Classes="sw" IsChecked="{Binding SmartOffDays}" VerticalAlignment="Center" AutomationProperties.Name="Smart bedtime for Off-Days" />
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Minimum sleep" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SmartMinChoices}" SelectedItem="{Binding SmartMin}" MinWidth="120">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SleepGoalChoice">
                                                <TextBlock Text="{Binding Text}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Classes="sRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Classes="sTitle" Text="Maximum sleep" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SmartMaxChoices}" SelectedItem="{Binding SmartMax}" MinWidth="120">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SleepGoalChoice">
                                                <TextBlock Text="{Binding Text}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border Classes="sRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="sHint" Text="Real sleep from a Fitbit or Pixel Watch (coming next): prepare your Google project now." VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Set up sleep tracking with Google…" Command="{Binding OpenSleepGuideCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding Rows[2].IsSelected}"
                        search:SearchArea.Name="Focus sessions" search:SearchArea.SettingsGroup="2">
                <Border Classes="card" search:SearchArea.Name="Quick session shortcut">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="KeyboardOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Quick session shortcut" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="Click the box and press the keys you want (at least one of Ctrl, Alt or Win, plus a letter, number, F-key or Space)."
                               Classes="sHint" TextWrapping="Wrap" />
                    <controls:HotkeyBox Text="{Binding HotkeyText}" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="Quick Start with Default" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="The big &quot;Quick Start with Default&quot; button (quick session and Today) starts this profile for the length chosen there (the remembered one from a phone or watch), and the on-screen bar counts down. The &quot;No set end&quot; button below Start runs the profile picked under More options until you end it, and the bar counts up."
                               Classes="sHint" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding CountUpChoices}" SelectedItem="{Binding SelectedCountUp}" MinWidth="300" />
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Step away" IsVisible="{Binding HasStepAway}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Walk" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Step away" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="A bathroom break or someone at your desk: the countdown pauses until you say you're back. The first key or mouse movement asks if you are back to your task; Back on track resumes, Still away asks again in 2 minutes. It never shortens a wait. Also in the tray and the on-screen window (hold Ctrl+Alt)."
                               Classes="sHint" TextWrapping="Wrap" />
                    <controls:HotkeyBox Text="{Binding StepAwayHotkey}" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StepAwayStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Classes="sw" Content="Step away by itself after" IsChecked="{Binding StepAwayAutoIdle}" />
                        <NumericUpDown Value="{Binding StepAwayIdleMinutes}" Minimum="1" Maximum="60" Increment="1" FormatString="0"
                                       Width="110" IsEnabled="{Binding StepAwayAutoIdle}" />
                        <TextBlock Text="minutes with no input" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="The idle minutes before it starts still count as focus." Classes="sHint" TextWrapping="Wrap" />
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Hyperfocus reminder" IsVisible="{Binding HasHyperfocus}">
                <StackPanel Spacing="6" DataContext="{Binding Hyperfocus}" x:DataType="vm:HyperfocusViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Brain" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Hyperfocus reminder" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="One quiet reminder after a long stretch of focus with no break: water, stand, eat. Coming back from Step away starts the stretch over."
                               Classes="sHint" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Classes="sw" Content="Remind me after" IsChecked="{Binding IsOn}" />
                        <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="15" Maximum="240" Increment="15" FormatString="0"
                                       Width="110" IsEnabled="{Binding IsOn}" />
                        <TextBlock Text="minutes of unbroken focus" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="During these profiles:" Classes="sHint" />
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HyperfocusProfileRowViewModel">
                                <CheckBox Classes="sw" IsChecked="{Binding Reminds}" Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save reminder" Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Classes="sHint" />
                    </StackPanel>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Pomodoro defaults">
                <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="TimerOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Pomodoro defaults" Classes="sectionTitle" />
                    </StackPanel>
                    <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Text="Focus (minutes)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FocusMinutes}" />
                        <TextBlock Grid.Row="1" Text="Short break (minutes)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortBreakMinutes}" />
                        <TextBlock Grid.Row="2" Text="Long break (minutes)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LongBreakMinutes}" />
                        <TextBlock Grid.Row="3" Text="Long break every N cycles" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CyclesBeforeLongBreak}" />
                    </Grid>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Escalation">
                <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Escalation (seconds of continuous distraction)" Classes="sectionTitle" />
                    </StackPanel>
                    <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Text="Notification after" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NudgeSeconds}" />
                        <TextBlock Grid.Row="1" Text="Screen overlay after" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverlaySeconds}" />
                        <TextBlock Grid.Row="2" Text="Minimize / block after" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnforceSeconds}" />
                    </Grid>
                    <!-- The computer types' "notice and overlay only" (ADR 22), e.g. on a work computer. -->
                    <CheckBox Classes="sw" IsChecked="{Binding NoticeAndOverlayOnly}"
                              ><TextBlock Text="Notice and overlay only: never minimize a window or redirect a tab (e.g. on a work computer)" TextWrapping="Wrap" /></CheckBox>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Ending a focus session early">
                <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ExitRun" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Ending a focus session early" Classes="sectionTitle" />
                    </StackPanel>
                    <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Text="Wait before you can end (seconds)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BypassWaitSeconds}" />
                        <TextBlock Grid.Row="1" Text="Minimum reason length (characters)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinReasonLength}" />
                    </Grid>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Looser changes">
                <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="TimerSand" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Looser changes" Classes="sectionTitle" />
                    </StackPanel>
                    <Grid ColumnDefinitions="240,120">
                        <TextBlock Text="Wait before they apply (minutes)" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding LooseningDelayMinutes}" />
                    </Grid>
                    <TextBlock Classes="sHint" TextWrapping="Wrap"
                               Text="Removing a block rule, adding an allow rule or an unlock option, or lowering any wait counts down this long first, and never takes effect during a session. Stricter changes apply at once. Shortening this wait counts down too." />
                </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding Rows[4].IsSelected}"
                        search:SearchArea.Name="Alerts &amp; on-screen" search:SearchArea.SettingsGroup="4">
                <Border Classes="card" search:SearchArea.Name="Animations" IsVisible="{Binding HasMotion}">
                <StackPanel Spacing="6" DataContext="{Binding Motion}" x:DataType="vm:MotionViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Animation" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Animations" Classes="sectionTitle" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Speed" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{x:Static vm:MotionViewModel.SpeedNames}" SelectedIndex="{Binding SpeedIndex}" MinWidth="140" />
                    </StackPanel>
                    <TextBlock Classes="sHint" TextWrapping="Wrap"
                               Text="Pages fade and slide in when you open a page, cards ease their colour and progress bars glide. Off shows every change at once." />
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Sounds when time is up">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="BellRingOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Sounds when time is up" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="Played when focus or a break runs out (not when you end a session yourself), also while the on-screen window is hidden. Can be saved during focus too."
                               Classes="sHint" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="240,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                        <TextBlock Grid.Row="0" Text="When focus is up (break or end)" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding FocusEndSound}" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:SoundChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Row="0" Grid.Column="2" Content="Test" Command="{Binding TestFocusEndSoundCommand}" />
                        <TextBlock Grid.Row="1" Text="When a break is up" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding BreakEndSound}" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:SoundChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Row="1" Grid.Column="2" Content="Test" Command="{Binding TestBreakEndSoundCommand}" />
                        <TextBlock Grid.Row="2" Text="Volume (built-in chimes)" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}" Width="200" />
                            <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add a .wav file…" Command="{Binding AddSoundFileCommand}" />
                        <TextBlock Text="{Binding SoundStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Noise player">
                <StackPanel Spacing="6" IsVisible="{Binding HasNoisePlayer}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="MusicNote" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Noise player" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="The player on Today (under Timers &amp; lunch) plays the sound files of this folder in name order (mp3, wav, m4a, aac, flac, wma). Folder changes apply at once."
                               Classes="sHint" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NoiseFolderText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Choose folder…" Command="{Binding ChooseNoiseFolderCommand}" />
                        <Button Content="Use Music\Noise" Command="{Binding UseMusicNoiseFolderCommand}" />
                        <Button Content="Look for new files" Command="{Binding RescanNoiseFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="Shortcuts work anywhere: click a box and press the keys (Ctrl, Alt or Win plus a letter, number, F-key, Space, an arrow or Page Up/Down); Backspace clears it."
                               Classes="sHint" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock Text="Play / pause" VerticalAlignment="Center" />
                        <controls:HotkeyBox Grid.Column="1" Text="{Binding NoisePlayPauseKey}" Width="220" />
                        <TextBlock Grid.Row="1" Text="Volume up 10%" VerticalAlignment="Center" />
                        <controls:HotkeyBox Grid.Row="1" Grid.Column="1" Text="{Binding NoiseVolumeUpKey}" Width="220" />
                        <TextBlock Grid.Row="2" Text="Volume down 10%" VerticalAlignment="Center" />
                        <controls:HotkeyBox Grid.Row="2" Grid.Column="1" Text="{Binding NoiseVolumeDownKey}" Width="220" />
                    </Grid>
                    <CheckBox Classes="sw" IsChecked="{Binding NoiseMediaKeys}" ><TextBlock Text="The keyboard's media keys and Windows' media pop-up also control the noise" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Classes="sw" Content="Stop when headphones disconnect" IsChecked="{Binding NoiseStopsWhenHeadphonesGo}" Margin="0,6,0,0" />
                    <TextBlock Text="Pauses the noise when any headphones go, wired or Bluetooth, so it never carries on through the speakers. Applies at once. The lock on the player goes further: it won't play at all without headphones."
                               Classes="sHint" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NoiseKeysStatus}" TextWrapping="Wrap"
                               IsVisible="{Binding NoiseKeysStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Play when headphones connect" IsVisible="{Binding HasHeadphones}">
                <StackPanel Spacing="6" DataContext="{Binding Headphones}" x:DataType="vm:HeadphoneSettingsViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Headphones" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Play when headphones connect" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="The noise player starts its last file when these headphones connect, any time of day, and pauses when they disconnect. Changes apply at once."
                               Classes="sHint" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource Ab.Surface2}" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                        <TextBlock Text="Tip: it really helps to have a dedicated pair of work/focus headphones, so putting them on means focus and it doesn't get in the way of your normal headphones."
                                   TextWrapping="Wrap" />
                    </Border>
                    <CheckBox Classes="sw" IsChecked="{Binding Wired}" ><TextBlock Text="Wired headphones or a headset (USB always works; a headphone jack only if your sound driver reports it)" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Classes="sw" IsChecked="{Binding Bluetooth}" Content="These Bluetooth headphones:" />
                    <StackPanel Margin="28,0,0,0" Spacing="4" IsVisible="{Binding Bluetooth}">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HeadphoneChoiceViewModel">
                                    <CheckBox Classes="sw" IsChecked="{Binding IsChosen}" Content="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Status}" Classes="sHint" TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Button Content="Look again" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <CheckBox Classes="sw" IsChecked="{Binding OnlyAtTimes}" Content="Only at certain times" Margin="0,6,0,0" />
                    <StackPanel Margin="28,0,0,0" Spacing="6" IsVisible="{Binding OnlyAtTimes}">
                        <TextBlock Text="It starts by itself only when any ticked option matches the time the headphones connect. The player's lock still applies."
                                   Classes="sHint" TextWrapping="Wrap" />
                        <CheckBox Classes="sw" IsChecked="{Binding DuringPlanWindow}" ><TextBlock Text="During a day plan window of these categories:" TextWrapping="Wrap" /></CheckBox>
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="28,0,0,0" IsVisible="{Binding DuringPlanWindow}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HeadphoneOptionViewModel">
                                    <CheckBox Classes="sw" IsChecked="{Binding IsChosen}" Content="{Binding Label}" Margin="0,0,12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Classes="sw" IsChecked="{Binding OnDaysAndHours}" Content="On these days and hours:" />
                        <StackPanel Margin="28,0,0,0" Spacing="6" IsVisible="{Binding OnDaysAndHours}">
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HeadphoneOptionViewModel">
                                        <ToggleButton IsChecked="{Binding IsChosen}" Content="{Binding Label}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TimePicker SelectedTime="{Binding StartTime}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                                <TextBlock Text="to" VerticalAlignment="Center" />
                                <TimePicker SelectedTime="{Binding EndTime}" MinuteIncrement="15" ClockIdentifier="12HourClock" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding ScheduleHint}" Foreground="{DynamicResource Ab.Waiting}" TextWrapping="Wrap"
                                   IsVisible="{Binding ScheduleHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="On-screen timer">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ClockOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="On-screen timer" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="Shows how much of the session is left, on top of other windows, for the profiles chosen below (also set in each profile in Settings › Guards). Clicks go through it; hold Ctrl+Alt to see the details and drag to move it. Can be saved during focus too."
                               Classes="sHint" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Text="Look" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="5" Text="At rest" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerColourModes}"
                                  SelectedIndex="{Binding TimerColourIndex}" MinWidth="200" />
                        <TextBlock Grid.Row="4" Text="Corner (bottom corners stay above the taskbar)" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerCornerNames}"
                                  SelectedIndex="{Binding TimerCornerIndex}" MinWidth="200" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerStyleNames}"
                                  SelectedIndex="{Binding TimerStyleIndex}" MinWidth="200" />
                        <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerSizeNames}"
                                  SelectedIndex="{Binding TimerSizeIndex}" MinWidth="200" />
                        <TextBlock Grid.Row="3" Text="Marks (split the bar or ring into equal parts)" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerMarkNames}"
                                  SelectedIndex="{Binding TimerMarksIndex}" MinWidth="200" />
                        <TextBlock Grid.Row="2" Text="Opacity" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding TimerOpacityPercent}" Width="200" />
                            <TextBlock Text="{Binding TimerOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Classes="sw" IsChecked="{Binding TimerWrapUpColor}" ><TextBlock Text="Turn amber in the last 5 minutes of focus" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Classes="sw" IsChecked="{Binding TimerPulseAtMarks}" Content="Brighten softly once when passing a mark" />
                    <CheckBox Classes="sw" IsChecked="{Binding TimerHideInFullscreen}" ><TextBlock Text="Hide while a fullscreen app is in front (videos, presentations, games)" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Classes="sw" IsChecked="{Binding TimerFillUp}" ><TextBlock Text="Fill up as time passes (instead of counting down from a full bar)" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Classes="sw" IsChecked="{Binding TimerQuietMarks}"
                              ><TextBlock Text="Quiet at rest dulls the timeline's red too (drift marks, now line), 3 seconds after Ctrl+Alt is let go" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Classes="sw" IsChecked="{Binding TaskOnlyWithCtrlAlt}" ><TextBlock Text="Hide the current task unless Ctrl+Alt is held" TextWrapping="Wrap" /></CheckBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Opacity while Ctrl+Alt is held (background and all)" VerticalAlignment="Center" />
                        <Slider Minimum="20" Maximum="100" Value="{Binding HeldOpacityPercent}" Width="200" />
                        <TextBlock Text="{Binding HeldOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="240,Auto" ColumnSpacing="8">
                        <CheckBox Classes="sw" IsChecked="{Binding MoveForMaximizedApps}" VerticalAlignment="Center">
                            <TextBlock Text="Move in from the corner while a maximized app is in front (keeps its buttons and bars clickable)" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding MoveForMaximizedApps}" VerticalAlignment="Center">
                            <NumericUpDown Value="{Binding MaximizedAppDrop}" Minimum="0" Maximum="600" Increment="10" FormatString="0" MinWidth="140" />
                            <TextBlock Text="{Binding VerticalLabel}" VerticalAlignment="Center" Classes="sHint" />
                            <TextBlock Text="(default)" VerticalAlignment="Center" Classes="sHint" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4" IsEnabled="{Binding MoveForMaximizedApps}" Margin="0,2,0,4">
                        <TextBlock Text="Per app: maximize the app, hold Ctrl+Alt and drag the timer where it should sit (away from the corner, and sideways past a side panel if needed); that spot is kept for the app."
                                   Classes="sHint" TextWrapping="Wrap" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding AppDrops}" IsVisible="{Binding HasAppDrops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppDropRowViewModel">
                                    <Grid ColumnDefinitions="160,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                        <TextBlock Text="{Binding App}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding Drop}" Minimum="0" Maximum="600" Increment="10" FormatString="0" MinWidth="120" />
                                        <TextBlock Grid.Column="2" Text="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).VerticalLabel}" VerticalAlignment="Center" Classes="sHint" />
                                        <NumericUpDown Grid.Column="3" Value="{Binding Shift}" Minimum="0" Maximum="2000" Increment="10" FormatString="0" MinWidth="120" />
                                        <TextBlock Grid.Column="4" Text="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SidewaysLabel}" VerticalAlignment="Center" Classes="sHint" />
                                        <Button Grid.Column="5" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Use the default for this app" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid ColumnDefinitions="240,Auto">
                        <TextBlock Text="Hide button (hold Ctrl+Alt) hides it for (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <NumericUpDown Grid.Column="1" Value="{Binding QuickHideSeconds}" Minimum="3" Maximum="600" Increment="5"
                                       FormatString="0" MinWidth="200" />
                    </Grid>
                    <TextBlock Text="Show it for these profiles" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="240,Auto" Margin="0,2">
                        <CheckBox Classes="sw" IsChecked="{Binding DefaultTimerOn}" VerticalAlignment="Center" ><TextBlock Text="Default (on for profiles set to Use default)" TextWrapping="Wrap" /></CheckBox>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultTimerColors}" SelectedItem="{Binding DefaultTimerColor}"
                                  IsEnabled="{Binding DefaultTimerOn}" MinWidth="200" ToolTip.Tip="Default timer colour">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimerColorOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TimerProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileTimerViewModel">
                                <Grid ColumnDefinitions="240,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:TimerChoice.Names}" SelectedIndex="{Binding TimerChoiceIndex}"
                                              MinWidth="130" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding TimerColors}" SelectedItem="{Binding TimerColor}"
                                              IsVisible="{Binding HasOwnTimer}" MinWidth="170" ToolTip.Tip="Timer colour">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimerColorOption">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                            BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="On-screen timeline">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Timeline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="On-screen timeline" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="A small copy of the day bar in the same spot as the timer: your blocks, the focus sessions you started and a red line at now, with the next block under it. It shows on days with blocks; hold Ctrl+Alt for how much you focused."
                               Classes="sHint" TextWrapping="Wrap" />
                    <CheckBox Classes="sw" IsChecked="{Binding ShowTimeline}" ><TextBlock Text="Show the timeline on days with focus blocks" TextWrapping="Wrap" /></CheckBox>
                    <StackPanel Spacing="6" IsEnabled="{Binding ShowTimeline}">
                        <TextBlock Text="While the session timer shows" />
                        <RadioButton GroupName="timelineInFocus" IsChecked="{Binding !TimelineStaysInFocus}" Content="Swap: the timer takes the timeline's place until the session ends" />
                        <RadioButton GroupName="timelineInFocus" IsChecked="{Binding TimelineStaysInFocus}" Content="Show both: timeline on top, timer under it" />
                        <CheckBox Classes="sw" IsChecked="{Binding TimelineShowsTime}" Content="Show the current time" />
                        <TextBlock Text="While no session runs (in a session the timer's opacity applies)" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="Opacity" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding TimelineOpacityPercent}" Width="200" />
                                <TextBlock Text="{Binding TimelineOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Opacity while Ctrl+Alt is held" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding TimelineHeldOpacityPercent}" Width="200" />
                                <TextBlock Text="{Binding TimelineHeldOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reset position" Command="{Binding ResetTimerPositionCommand}" />
                        <TextBlock Text="{Binding TimerStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                </Border>
                <!-- Slot for the on-screen overlay settings page (design 15c, built with the overlay): it shows under the page's own cards. -->
                <ContentControl x:Name="OverlaySettingsSlot" search:SearchArea.Name="On-screen overlay" />
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding Rows[7].IsSelected}"
                        search:SearchArea.Name="Appearance" search:SearchArea.SettingsGroup="7">
                <StackPanel DataContext="{Binding Appearance}" x:DataType="vm:AppearanceViewModel"
                            IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).HasAppearance}">
                    <views:AppearanceView />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding Rows[8].IsSelected}"
                        search:SearchArea.Name="App &amp; data" search:SearchArea.SettingsGroup="8">
                <Border Classes="card" search:SearchArea.Name="Computer type">
                <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Laptop" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Computer type" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="{Binding ComputerTypeText}" />
                    <TextBlock Text="Applying a type sets its starting switches again (privacy, escalation, sharing, update checks). Profiles and the day plan stay as they are."
                               Classes="sHint" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox SelectedIndex="{Binding ComputerTypeIndex}" MinWidth="200">
                            <ComboBoxItem Content="Personal computer" />
                            <ComboBoxItem Content="Work computer" />
                            <ComboBoxItem Content="Local only" />
                        </ComboBox>
                        <Button Content="Apply a type again" Command="{Binding ApplyComputerTypeCommand}" />
                    </StackPanel>
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Backup">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="BackupRestore" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Backup" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="Save your profiles, settings, calendars and history to a file, or restore them from one, e.g. on a new PC."
                               Classes="sHint" TextWrapping="Wrap" />
                    <views:BackupPanel DataContext="{Binding Backup}" />
                </StackPanel>
                </Border>
                <Border Classes="card" search:SearchArea.Name="Data">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="DatabaseOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Text="Data" Classes="sectionTitle" />
                    </StackPanel>
                    <TextBlock Text="Everything is stored only on this computer:" Classes="sHint" />
                    <SelectableTextBlock Text="{Binding DatabasePath}" />
                    <!-- Off: History keeps only times, apps, sites and their sections (ADR 22, the Work computer type). -->
                    <CheckBox Classes="sw" IsChecked="{Binding KeepTitlesAndAddresses}" Margin="0,6,0,0"
                              ><TextBlock Text="Keep window titles, full addresses and screen text in History (encrypted). Off: only times, apps, sites and their sections" TextWrapping="Wrap" /></CheckBox>
                    <TextBlock Text="{Binding VersionText}" Classes="sHint" Margin="0,6,0,0" />
                </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
