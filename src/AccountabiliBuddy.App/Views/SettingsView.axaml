<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             xmlns:services="using:AccountabiliBuddy.App.Services"
             x:Class="AccountabiliBuddy.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <Border IsVisible="{Binding IsLocked}" Background="#33F59E0B" Padding="12,8" CornerRadius="6">
                <TextBlock Text="Settings are locked while a focus session is running." />
            </Border>
            <views:PendingChangesBanner DataContext="{Binding PendingChanges}" />

            <StackPanel Spacing="6">
                <TextBlock Text="Quick session shortcut" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Click the box and press the keys you want (at least one of Ctrl, Alt or Win, plus a letter, number, F-key or Space)."
                           Opacity="0.75" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:HotkeyBox Text="{Binding HotkeyText}" Width="220" />
                    <Button Content="Apply" Command="{Binding ApplyHotkeyCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Day bar" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="The bar above the tabs: planned focus, what actually ran, calendar events and a red line at now. Changes apply right away, also during focus."
                           Opacity="0.75" TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding ShowDayBar}" Content="Show the day bar" />
                <RadioButton GroupName="dayRange" IsChecked="{Binding !DayBarFullDay}" Content="Fit to my day (grows when a block falls outside it; with sleep mode on, wake time to bedtime)" />
                <RadioButton GroupName="dayRange" IsChecked="{Binding DayBarFullDay}" Content="Always the whole 24 hours" />
                <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" IsEnabled="{Binding !DayBarFullDay}">
                    <TextBlock Grid.Row="0" Text="Day starts at" VerticalAlignment="Center" />
                    <TimePicker Grid.Row="0" Grid.Column="1" SelectedTime="{Binding DayStart}" MinuteIncrement="15" ClockIdentifier="24HourClock" />
                    <TextBlock Grid.Row="1" Text="Day ends at (before the start = after midnight)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding DayEnd}" MinuteIncrement="15" ClockIdentifier="24HourClock" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Apply" Command="{Binding ApplyDayBarCommand}" />
                    <TextBlock Text="{Binding DayBarStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Sleep" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Your bedtime and wake time. The day bar runs from wake time to bedtime and shades the night; staying up past bedtime shades the lost sleep red. From two hours before bedtime a line on screen says how much sleep you'll get if you go to bed now (green from 7 hours, yellow from 5, red below). Changes apply right away, also during focus."
                           Opacity="0.75" TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding SleepEnabled}" Content="Use sleep mode" />
                <StackPanel Spacing="6" IsEnabled="{Binding SleepEnabled}">
                    <RadioButton GroupName="sleepNights" IsChecked="{Binding !SleepSameEveryNight}" Content="Weeknights and weekends (Friday and Saturday nights)" />
                    <RadioButton GroupName="sleepNights" IsChecked="{Binding SleepSameEveryNight}" Content="Same every night" />
                    <Grid ColumnDefinitions="240,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Bedtime" Opacity="0.75" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Wake up" Opacity="0.75" />
                        <TextBlock Grid.Row="1" Text="Every night" IsVisible="{Binding SleepSameEveryNight}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Weeknights (Sun–Thu)" IsVisible="{Binding !SleepSameEveryNight}" VerticalAlignment="Center" />
                        <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding WeeknightBedtime}" MinuteIncrement="15" />
                        <TimePicker Grid.Row="1" Grid.Column="2" SelectedTime="{Binding WeeknightWake}" MinuteIncrement="15" />
                        <TextBlock Grid.Row="2" Text="Weekend nights (Fri–Sat)" IsVisible="{Binding !SleepSameEveryNight}" VerticalAlignment="Center" />
                        <TimePicker Grid.Row="2" Grid.Column="1" SelectedTime="{Binding WeekendBedtime}" MinuteIncrement="15"
                                    IsVisible="{Binding !SleepSameEveryNight}" />
                        <TimePicker Grid.Row="2" Grid.Column="2" SelectedTime="{Binding WeekendWake}" MinuteIncrement="15"
                                    IsVisible="{Binding !SleepSameEveryNight}" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="Real sleep from a Fitbit or Pixel Watch (coming next): prepare your Google project now." Opacity="0.75" TextWrapping="Wrap" />
                    <Button Content="Set up sleep tracking with Google…" Command="{Binding OpenSleepGuideCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Apply" Command="{Binding ApplySleepCommand}" />
                    <TextBlock Text="{Binding SleepStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="On-screen timer" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Shows how much of the session is left, on top of other windows, for the profiles chosen below (also set in each profile on the Profiles tab). Clicks go through it; hold Ctrl+Alt to see the details and drag to move it. Changes apply right away, also during focus."
                           Opacity="0.75" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="240,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Text="Look" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerStyleNames}"
                              SelectedIndex="{Binding TimerStyleIndex}" MinWidth="200" />
                    <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerSizeNames}"
                              SelectedIndex="{Binding TimerSizeIndex}" MinWidth="200" />
                    <TextBlock Grid.Row="3" Text="Marks (split the bar or ring into equal parts)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.TimerMarkNames}"
                              SelectedIndex="{Binding TimerMarksIndex}" MinWidth="200" />
                    <TextBlock Grid.Row="2" Text="Opacity" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding TimerOpacityPercent}" Width="200" />
                        <TextBlock Text="{Binding TimerOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <CheckBox IsChecked="{Binding TimerWrapUpColor}" Content="Turn amber in the last 5 minutes of focus" />
                <CheckBox IsChecked="{Binding TimerPulseAtMarks}" Content="Brighten softly once when passing a mark" />
                <CheckBox IsChecked="{Binding TimerHideInFullscreen}" Content="Hide while a fullscreen app is in front (videos, presentations, games)" />
                <CheckBox IsChecked="{Binding TimerFillUp}" Content="Fill up as time passes (instead of counting down from a full bar)" />
                <Grid ColumnDefinitions="240,Auto">
                    <TextBlock Text="Hide button (hold Ctrl+Alt) hides it for (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumericUpDown Grid.Column="1" Value="{Binding QuickHideSeconds}" Minimum="3" Maximum="600" Increment="5"
                                   FormatString="0" MinWidth="200" />
                </Grid>
                <TextBlock Text="Show it for these profiles" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="240,Auto" Margin="0,2">
                    <CheckBox IsChecked="{Binding DefaultTimerOn}" Content="Default (on for profiles set to Use default)" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultTimerColors}" SelectedItem="{Binding DefaultTimerColor}"
                              IsEnabled="{Binding DefaultTimerOn}" MinWidth="200" ToolTip.Tip="Default timer colour">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimerColorOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                            BorderBrush="#55808080" BorderThickness="1" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <ItemsControl ItemsSource="{Binding TimerProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileTimerViewModel">
                            <Grid ColumnDefinitions="240,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:TimerChoice.Names}" SelectedIndex="{Binding TimerChoiceIndex}"
                                          MinWidth="130" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding TimerColors}" SelectedItem="{Binding TimerColor}"
                                          IsVisible="{Binding HasOwnTimer}" MinWidth="170" ToolTip.Tip="Timer colour">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TimerColorOption">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                        BorderBrush="#55808080" BorderThickness="1" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="On-screen timeline" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="A small copy of the day bar in the same spot as the timer: planned focus, what actually ran and a red line at now, with the next block under it. It shows on days with focus blocks; hold Ctrl+Alt for how much you focused."
                           Opacity="0.75" TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding ShowTimeline}" Content="Show the timeline on days with focus blocks" />
                <StackPanel Spacing="6" IsEnabled="{Binding ShowTimeline}">
                    <TextBlock Text="While the session timer shows" />
                    <RadioButton GroupName="timelineInFocus" IsChecked="{Binding !TimelineStaysInFocus}" Content="Swap: the timer takes the timeline's place until the session ends" />
                    <RadioButton GroupName="timelineInFocus" IsChecked="{Binding TimelineStaysInFocus}" Content="Show both: timeline on top, timer under it" />
                    <CheckBox IsChecked="{Binding TimelineShowsTime}" Content="Show the current time" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Apply" Command="{Binding ApplyTimerCommand}" />
                    <Button Content="Reset position" Command="{Binding ResetTimerPositionCommand}" />
                    <TextBlock Text="{Binding TimerStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Sounds when time is up" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Played when focus or a break runs out (not when you end a session yourself), also while the on-screen window is hidden. Changes apply right away, also during focus."
                           Opacity="0.75" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="240,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Text="When focus is up (break or end)" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding FocusEndSound}" MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:SoundChoice">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Row="0" Grid.Column="2" Content="Test" Command="{Binding TestFocusEndSoundCommand}" />
                    <TextBlock Grid.Row="1" Text="When a break is up" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding BreakEndSound}" MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:SoundChoice">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Row="1" Grid.Column="2" Content="Test" Command="{Binding TestBreakEndSoundCommand}" />
                    <TextBlock Grid.Row="2" Text="Volume (built-in chimes)" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}" Width="200" />
                        <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Apply" Command="{Binding ApplySoundsCommand}" />
                    <Button Content="Add a .wav file…" Command="{Binding AddSoundFileCommand}" />
                    <TextBlock Text="{Binding SoundStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                <TextBlock Text="Pomodoro defaults" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Text="Focus (minutes)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FocusMinutes}" />
                    <TextBlock Grid.Row="1" Text="Short break (minutes)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortBreakMinutes}" />
                    <TextBlock Grid.Row="2" Text="Long break (minutes)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LongBreakMinutes}" />
                    <TextBlock Grid.Row="3" Text="Long break every N cycles" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CyclesBeforeLongBreak}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                <TextBlock Text="Escalation (seconds of continuous distraction)" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Text="Notification after" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NudgeSeconds}" />
                    <TextBlock Grid.Row="1" Text="Screen overlay after" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverlaySeconds}" />
                    <TextBlock Grid.Row="2" Text="Minimize / block after" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnforceSeconds}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                <TextBlock Text="Ending a focus session early" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="240,120" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Text="Wait before you can end (seconds)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BypassWaitSeconds}" />
                    <TextBlock Grid.Row="1" Text="Minimum reason length (characters)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinReasonLength}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                <TextBlock Text="Unlocks" FontSize="16" FontWeight="SemiBold" />
                <CheckBox IsChecked="{Binding RelockAtMidnight}" Content="Relock at midnight" />
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="When on, an unlock lifts the blocks only until the next midnight unless you pick another time when unlocking. Unlock options are set per profile." />
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                <TextBlock Text="Calendars" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="240,120">
                    <TextBlock Text="Check iCal links every (minutes)" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding CalendarRefreshMinutes}" />
                </Grid>
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="5 minutes or more. Links are also checked when you press Refresh calendars and when the window opens. Google accounts check for changes every 30 seconds." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <TextBlock Text="Google client (for Connect Google account)" VerticalAlignment="Center" />
                    <Button Content="Set up Google step by step…" Command="{Binding OpenGoogleGuideCommand}" />
                </StackPanel>
                <TextBox Text="{Binding GoogleClientId}" PlaceholderText="Client ID (…apps.googleusercontent.com)" />
                <TextBox Text="{Binding GoogleClientSecret}" PasswordChar="•" PlaceholderText="{Binding GoogleClientSecretHint}" />
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="Create these in your own Google Cloud project: enable the Google Calendar API, set up the OAuth consent screen (add yourself as a test user), then create an OAuth client of type Desktop app. While the project is in Testing, Google ends the sign-in after 7 days. The secret is stored encrypted on this computer." />
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding !IsLocked}">
                <TextBlock Text="Looser changes" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="240,120">
                    <TextBlock Text="Wait before they apply (minutes)" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding LooseningDelayMinutes}" />
                </Grid>
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="Deleting a scheduled block, removing a block rule, adding an allow rule, time off or an unlock option, or lowering any wait counts down this long first, and never takes effect during a session. Stricter changes apply at once. Shortening this wait counts down too." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                <Button Content="Revert" Command="{Binding RevertCommand}" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Backup" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Save your profiles, settings, calendars and history to a file, or restore them from one, e.g. on a new PC."
                           Opacity="0.75" TextWrapping="Wrap" />
                <views:BackupPanel DataContext="{Binding Backup}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Data" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Everything is stored only on this computer:" Opacity="0.75" />
                <SelectableTextBlock Text="{Binding DatabasePath}" />
                <TextBlock Text="{Binding VersionText}" Opacity="0.75" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
