<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.NotebookView"
             x:DataType="vm:NotebookViewModel">
    <!-- Everything written down, so it can leave your head: come-backs, notes, unfinished and done tasks. -->
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock Text="Notebook" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Parked ideas, notes from sessions and tasks, newest first. Written down means you can stop holding it."
                       Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Search}" Width="260" PlaceholderText="Search" AutomationProperties.Name="Search the notebook" />
                <ComboBox ItemsSource="{x:Static vm:NotebookViewModel.Filters}" SelectedItem="{Binding Filter}" MinWidth="160" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" Opacity="0.6" FontSize="12" />
            <TextBlock Text="Nothing here yet." Opacity="0.6" IsVisible="{Binding IsEmpty}" />

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotebookItemViewModel">
                        <Border Padding="12,8" Margin="0,0,0,6" CornerRadius="8" Background="#12808080" BorderBrush="#26808080" BorderThickness="1"
                                Classes.sub="{Binding IsSubtask}">
                            <Border.Styles>
                                <Style Selector="Border.sub">
                                    <Setter Property="Margin" Value="28,-2,0,6" />
                                </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <CheckBox Command="{Binding Tick}" IsVisible="{Binding CanTick}" ToolTip.Tip="Done: tick it off" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsNotEditing}" />
                                    <TextBox Text="{Binding EditText}" IsVisible="{Binding IsEditing}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <TextBlock Text="{Binding WhenText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11" Opacity="0.55" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}" VerticalAlignment="Top">
                                    <Button Content="✎" Command="{Binding EditCommand}" IsVisible="{Binding IsNotEditing}" ToolTip.Tip="Rename"
                                            Background="Transparent" Padding="6,0" />
                                    <Button Content="✓" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" ToolTip.Tip="Keep the new name"
                                            Background="Transparent" Padding="6,0" />
                                    <Button Content="✕" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete (a task goes with its subtasks)"
                                            Background="Transparent" Padding="6,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
