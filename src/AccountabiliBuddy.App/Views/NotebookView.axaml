<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.NotebookView"
             x:DataType="vm:NotebookViewModel">
    <!-- The Archive sheet's content (Tasks redesign item 6; SPEC "Archive"; boards 04, 12, 32; ArchiveSheetView slides it up). Rows 12 px
         apart: the grab bar (44 × 4, Line3); the header ("Archive" in Ab.DisplayFont 24 semibold · space · "Search the Archive" with its
         filter button · fold ˅); the pills (Everything · Unfinished (8) · Done (38) · Recently deleted; "Results for “…”" at the right
         while searching); then the columns like the Shelf's, 14 px apart, each scrolling on its own: Unfinished, Done, Recently deleted
         (Everything folds Recently deleted to its 62 px rail). Come-backs and session notes are not listed here. -->
    <UserControl.Styles>
        <!-- The search (6.07): 300 wide, shrinking to 180; 34 high, radius 999, 1 px Line2; magnifier 15; 13 px placeholder. -->
        <Style Selector="Border.archiveSearch">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,3,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line2}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.archiveSearch:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="TextBox.archiveSearchEntry">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style Selector="TextBox.archiveSearchEntry /template/ Border#PART_BorderElement, TextBox.archiveSearchEntry:pointerover /template/ Border#PART_BorderElement, TextBox.archiveSearchEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <!-- The filter button inside the search: 28 round, Tune 15, faded until used (its panel is item 7). -->
        <Style Selector="Button.archiveFilters">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.archiveFilters /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.archiveFilters:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.archiveFilters.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <!-- The fold button (6.08): 34 square, radius 10, chevron-down 18 in Muted. -->
        <Style Selector="Button.archiveFold">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.archiveFold /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.archiveFold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <!-- A pill (6.10): 30 high, padding 0 14 0 11, radius 999, 13 px, icon 15; picked = Line fill + 1 px Muted border, the others
             transparent + 1 px Line2; 0.2 s. -->
        <Style Selector="Button.archivePill">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="11,0,14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.archivePill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.archivePill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.archivePill.picked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector=":is(Window).motionOn Button.archivePill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Panel>
    <DockPanel>
        <!-- The grab bar (6.05). -->
        <Border DockPanel.Dock="Top" Width="44" Height="4" CornerRadius="2" Background="{DynamicResource Ab.Line3}" HorizontalAlignment="Center" />

        <!-- The header (6.06-6.08). -->
        <Grid DockPanel.Dock="Top" Margin="0,12,0,0" ColumnSpacing="10">
            <!-- Title · space · the search (a star column capped at 300, never under 180, so it shrinks before anything wraps) · fold. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Archive" FontFamily="{DynamicResource Ab.DisplayFont}" FontWeight="SemiBold" FontSize="24" VerticalAlignment="Center" />
            <Border x:Name="SearchPill" Grid.Column="2" Classes="archiveSearch">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <mi:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Classes="archiveSearchEntry" Text="{Binding Search}" PlaceholderText="Search the Archive"
                             AutomationProperties.Name="Search the Archive">
                        <TextBox.InnerRightContent><controls:ClearTextButton /></TextBox.InnerRightContent>
                    </TextBox>
                    <!-- Opens the Archive's Search filters (item 7); "on" (accent) while a filter narrows the Archive. -->
                    <Button Grid.Column="2" Classes="archiveFilters idleFade" Classes.on="{Binding HasSearchFilters}" Command="{Binding ToggleSearchFiltersCommand}"
                            ToolTip.Tip="Search filters" AutomationProperties.Name="Search filters">
                        <mi:MaterialIcon Kind="Tune" Width="15" Height="15" />
                    </Button>
                </Grid>
            </Border>
            <Button x:Name="FoldButton" Grid.Column="3" Classes="archiveFold" Command="{Binding CloseCommand}" ToolTip.Tip="Close the Archive (Esc)"
                    AutomationProperties.Name="Close the Archive">
                <mi:MaterialIcon Kind="ChevronDown" Width="18" Height="18" />
            </Button>
        </Grid>

        <!-- The pills (6.09-6.12): Material icons per O10. -->
        <Grid DockPanel.Dock="Top" Margin="0,12,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="archivePill" Classes.picked="{Binding IsEverythingPicked}" Command="{Binding PickPillCommand}" CommandParameter="Everything"
                        AutomationProperties.Name="Everything">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <mi:MaterialIcon Kind="ArchiveOutline" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Everything" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="archivePill" Classes.picked="{Binding IsUnfinishedPicked}" Command="{Binding PickPillCommand}" CommandParameter="Unfinished"
                        AutomationProperties.Name="{Binding UnfinishedPillText}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <mi:MaterialIcon Kind="CheckboxBlankOutline" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UnfinishedPillText}" VerticalAlignment="Center" FontFeatures="+tnum" />
                    </StackPanel>
                </Button>
                <Button Classes="archivePill" Classes.picked="{Binding IsDonePicked}" Command="{Binding PickPillCommand}" CommandParameter="Done"
                        AutomationProperties.Name="{Binding DonePillText}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <mi:MaterialIcon Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DonePillText}" VerticalAlignment="Center" FontFeatures="+tnum" />
                    </StackPanel>
                </Button>
                <Button Classes="archivePill" Classes.picked="{Binding IsDeletedPicked}" Command="{Binding PickPillCommand}" CommandParameter="Deleted"
                        AutomationProperties.Name="Recently deleted">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <mi:MaterialIcon Kind="DeleteClockOutline" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Recently deleted" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ResultsText}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="260"
                       TextTrimming="CharacterEllipsis" IsVisible="{Binding IsSearching}" />
        </Grid>

        <!-- The columns (6.13-6.17): laid out by the code-behind (open columns share the width, a rail is 62 px, 14 px apart). -->
        <Grid x:Name="ColumnsGrid" Margin="0,12,0,0" ColumnSpacing="14">
            <views:ArchiveColumnView x:Name="UnfinishedView" DataContext="{Binding UnfinishedColumn}" />
            <views:ArchiveColumnView x:Name="DoneView" DataContext="{Binding DoneColumn}" />
            <views:ArchiveColumnView x:Name="DeletedView" DataContext="{Binding DeletedColumn}" />
        </Grid>
    </DockPanel>

    <!-- Search filters (item 7, 7.11): under the Archive's search box, over the sheet, inside its height (at most 66% of the card − 76); no
         Bins (the pills do that job). A click elsewhere on the sheet closes it. -->
    <Panel x:Name="FiltersLayer" IsVisible="{Binding IsSearchFiltersOpen}">
        <Border Background="Transparent" PointerPressed="OnFiltersOutsidePressed" />
        <views:SearchFiltersPanel x:Name="Filters" DataContext="{Binding FiltersPanel}" HorizontalAlignment="Right" VerticalAlignment="Top" />
    </Panel>
    </Panel>
</UserControl>
