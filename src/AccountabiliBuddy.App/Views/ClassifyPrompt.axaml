<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        x:Class="AccountabiliBuddy.App.Views.ClassifyPrompt"
        x:DataType="vm:ClassifyPromptViewModel"
        Title="Is this on track?"
        Width="400" SizeToContent="Height"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual">
    <Grid ColumnDefinitions="6,*">
        <Border Grid.Column="0" Background="#2A9D8F" />
        <StackPanel Grid.Column="1" Margin="14,12" Spacing="8">
            <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WindowTitleText}" Opacity="0.75" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
            <!-- A browser tab: the whole site, or only certain parts (then which part). -->
            <StackPanel Spacing="2" IsVisible="{Binding HasSite}">
                <RadioButton Content="{Binding SiteLabel}" IsChecked="{Binding IsSite}" GroupName="site" FontWeight="SemiBold" />
                <RadioButton Content="Only certain parts" IsChecked="{Binding IsOnlyParts}" GroupName="site" FontWeight="SemiBold" />
                <StackPanel Margin="26,0,0,0" Spacing="0" IsVisible="{Binding IsOnlyParts}">
                    <RadioButton Content="{Binding PartLabel}" IsChecked="{Binding IsPart}" IsVisible="{Binding HasPart}" GroupName="part" />
                    <RadioButton Content="{Binding PageLabel}" IsChecked="{Binding IsPage}" IsVisible="{Binding HasPage}" GroupName="part" />
                    <RadioButton Content="Only this view (match the window title)" IsChecked="{Binding IsTitle}" GroupName="part" />
                    <TextBlock Text="{Binding PartsNote}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <RadioButton Content="{Binding WholeAppLabel}" IsChecked="{Binding IsWholeApp}" GroupName="site" FontSize="12" Opacity="0.8" />
            </StackPanel>
            <!-- Any other app: the whole app, or only this view. -->
            <StackPanel Spacing="2" IsVisible="{Binding !HasSite}">
                <RadioButton Content="{Binding WholeAppLabel}" IsChecked="{Binding IsWholeApp}" GroupName="app" />
                <RadioButton Content="Only this view (match the window title)" IsChecked="{Binding IsTitle}" GroupName="app" />
            </StackPanel>
            <TextBlock Text="{Binding PatternLabel}" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding Pattern}" />
            <TextBox Text="{Binding Reason}" PlaceholderText="Why? Needed to allow it (one word is enough)" />
            <TextBlock Text="{Binding Error}" Foreground="#E76F51" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Distracting" Command="{Binding MarkDistractingCommand}" />
                <Button Content="On track (this session)" Command="{Binding MarkOnTrackCommand}" Classes="accent" />
            </StackPanel>

            <Button Content="Add exemption to profile…" Command="{Binding ToggleExemptionCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" Opacity="0.7"
                    HorizontalAlignment="Left" />
            <StackPanel Spacing="4" IsVisible="{Binding IsExemptionOpen}">
                <TextBlock Text="{Binding ExemptionProfileText}" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding HasOtherProfiles}" />
                <ItemsControl ItemsSource="{Binding OtherProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileChoiceViewModel">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add exemption" Command="{Binding AddExemptionCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
