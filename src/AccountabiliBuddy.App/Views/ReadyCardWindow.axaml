<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        x:Class="AccountabiliBuddy.App.Views.ReadyCardWindow"
        x:DataType="vm:ReadyCardViewModel"
        Title="Ready?"
        Width="460" SizeToContent="Height"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual">
    <!-- No button takes keyboard focus: the card appears while the user types, and a typed Space or Enter must not answer it. -->
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Styles>
    <!-- The planning card: planning time is up. Start, or a little more planning. -->
    <Border Padding="24,20" Background="#FF15191E" BorderBrush="#AA7C9EF2" BorderThickness="2" CornerRadius="10">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Planning time is up. Start the focus countdown, or plan a little longer." Opacity="0.85" TextWrapping="Wrap" />
            <views:PlanningTip />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start" Command="{Binding StartCommand}" Classes="accent" />
                <Button Content="+2 min" Command="{Binding ExtendCommand}" CommandParameter="2" />
                <Button Content="+5 min" Command="{Binding ExtendCommand}" CommandParameter="5" />
                <Button Content="+15 min" Command="{Binding ExtendCommand}" CommandParameter="15" />
            </StackPanel>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Text="Planning time is not focus time. Blocking and nudges keep running, and the focus countdown starts fresh when you start." />
        </StackPanel>
    </Border>
</Window>
