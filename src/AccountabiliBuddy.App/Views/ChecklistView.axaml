<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="AccountabiliBuddy.App.Views.ChecklistView"
             x:DataType="vm:ChecklistViewModel">
    <!-- A guided session's checklist (ADR 24, 25): before Start (add/edit), while it runs (tick/add/edit) or in the
         on-screen window's Ctrl+Alt details (tick and pick only, small). Clicking a name picks it for the on-screen bar
         (marked with a pin icon). Move and rename show on hover in the app's lists. Open tasks are grouped under their categories
         (a task's dot changes its category; ↑ ↓ move it within its group). The ⠿ handle drags a task (dropped among another
         category's tasks it joins that category) or a subtask within its task. ⚑ parks a task as a come-back. Done tasks sit
         under a collapsed "Done (n)". -->
    <UserControl.Styles>
        <!-- A category's header over its tasks; smaller in the on-screen window (the style after it). -->
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.compact">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- The on-screen window is small: smaller boxes and a slim "Done (n)" header there. -->
        <Style Selector="CheckBox.compact">
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <Style Selector="CheckBox.compact /template/ Border#NormalRectangle">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Expander.compact">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Expander.compact /template/ ToggleButton#ExpanderHeader">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- A name that picks it for the on-screen bar: looks like text. -->
        <Style Selector="Button.name">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- Move and rename only show on the row under the pointer, so the list stays calm. -->
        <Style Selector="Grid.row Button.onHover">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Grid.row:pointerover Button.onHover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The drag handle (⠿) at a row's left: shows on hover like move and rename. -->
        <Style Selector="Border.dragHandle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Grid.row:pointerover Border.dragHandle">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- Where a dragged row would go: a line above or below the row under the pointer. -->
        <Style Selector="Border.dropLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="#2A9D8F" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- A category menu's entries (a task's dot, the "Add a task" box's dot): colour, name, ✓ for the one it has. -->
        <ControlTheme x:Key="CategoryMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="vm:TaskCategoryChoiceViewModel">
            <Setter Property="Command" Value="{Binding PickCommand}" />
        </ControlTheme>
        <DataTemplate x:Key="CategoryChoiceTemplate" x:DataType="vm:TaskCategoryChoiceViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Stroke="#80808080" StrokeThickness="1" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="✓" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Heading}" Opacity="0.8" IsVisible="{Binding !IsCompact}" />

        <!-- Open tasks under their category's header (in its colour), "No category" last; no headers while no open
             task has a category. -->
        <ItemsControl ItemsSource="{Binding OpenGroups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChecklistGroupViewModel">
                    <StackPanel Spacing="2">
                        <!-- A Grid, not a StackPanel, so a long name is cut with "…" (the on-screen window is 200 px). -->
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding ShowsHeader}">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Brush}" VerticalAlignment="Center" IsVisible="{Binding HasCategory}" />
                            <TextBlock Grid.Column="1" Classes="groupHeader" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                       IsVisible="{Binding HasCategory}"
                                       Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                            <TextBlock Grid.Column="1" Classes="groupHeader" Text="{Binding Name}" Opacity="0.6" IsVisible="{Binding !HasCategory}"
                                       Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskRowViewModel">
                                    <Panel Classes="taskItem">
                                    <StackPanel Spacing="2">
                                        <Grid Classes="row" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                                            <Border Classes="dragHandle" ToolTip.Tip="Drag to move" AutomationProperties.Name="Drag to move"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}"
                                                    PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased"
                                                    PointerCaptureLost="OnHandleCaptureLost">
                                                <TextBlock Text="⠿" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsDone}" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanTick}"
                                                      Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                                            <!-- Its category: the dot opens the menu to put it in another one. -->
                                            <Button Grid.Column="2" Classes="small" Padding="2,0" ToolTip.Tip="{Binding CategoryName, StringFormat='Category: {0} (click to change)'}"
                                                    AutomationProperties.Name="Change category"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).ShowsCategoryPickers}">
                                                <Ellipse Width="10" Height="10" Fill="{Binding CategoryBrush}" Stroke="#80808080" StrokeThickness="1" />
                                                <Button.Flyout>
                                                    <MenuFlyout ItemsSource="{Binding CategoryChoices}" ItemContainerTheme="{StaticResource CategoryMenuItem}"
                                                                ItemTemplate="{StaticResource CategoryChoiceTemplate}" />
                                                </Button.Flyout>
                                            </Button>
                                            <Button Grid.Column="3" Classes="name" Command="{Binding PickCommand}" IsVisible="{Binding !IsEditing}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    ToolTip.Tip="Show this on the on-screen bar (click it again: back to the first open task)">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                            <mi:MaterialIcon Kind="Pin" Width="14" Height="14" IsVisible="{Binding IsCurrent}" />
                                                        </Panel>
                                                        <TextBlock Text="{Binding NumberText}" IsVisible="{Binding HasNumber}" Opacity="0.7" VerticalAlignment="Center"
                                                                   Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                                                </Grid>
                                            </Button>
                                            <TextBox Grid.Column="3" Classes="taskEntry" Text="{Binding EditTitle}" IsVisible="{Binding IsEditing}"
                                                     PropertyChanged="OnRenameBoxPropertyChanged" LostFocus="OnRenameBoxLostFocus">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
                                                    <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <Button Grid.Column="4" Classes="small onHover" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                            <Button Grid.Column="5" Classes="small onHover" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                            <Button Grid.Column="6" Classes="small onHover" Content="✎" Command="{Binding BeginEditCommand}" ToolTip.Tip="Rename"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                            <Button Grid.Column="7" Classes="small onHover" Content="⚑" Command="{Binding ParkCommand}"
                                                    ToolTip.Tip="Park: it leaves the checklist and waits under Come back to"
                                                    AutomationProperties.Name="Park"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanPark}" />
                                            <Button Grid.Column="8" Classes="small" Content="+ step" Command="{Binding BeginAddSubtaskCommand}" ToolTip.Tip="Add a subtask"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                            <Button Grid.Column="9" Classes="small" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Subtasks}" Margin="24,0,0,0" IsVisible="{Binding HasSubtasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SubtaskRowViewModel">
                                                    <Panel Classes="subtaskItem">
                                                    <Grid Classes="row" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                                                        <Border Classes="dragHandle" ToolTip.Tip="Drag to move" AutomationProperties.Name="Drag to move"
                                                                IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}"
                                                                PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased"
                                                                PointerCaptureLost="OnHandleCaptureLost">
                                                            <TextBlock Text="⠿" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsDone}" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanTick}"
                                                                  Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                                                        <Button Grid.Column="2" Classes="name" Command="{Binding PickCommand}" IsVisible="{Binding !IsEditing}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                                ToolTip.Tip="Show this on the on-screen bar (click it again: back to the first open task)">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <mi:MaterialIcon Kind="Pin" Width="14" Height="14" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.85"
                                                                           Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                                                            </Grid>
                                                        </Button>
                                                        <TextBox Grid.Column="2" Classes="taskEntry" Text="{Binding EditTitle}" IsVisible="{Binding IsEditing}"
                                                     PropertyChanged="OnRenameBoxPropertyChanged" LostFocus="OnRenameBoxLostFocus">
                                                            <TextBox.KeyBindings>
                                                                <KeyBinding Gesture="Enter" Command="{Binding SaveEditCommand}" />
                                                                <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                            </TextBox.KeyBindings>
                                                        </TextBox>
                                                        <Button Grid.Column="3" Classes="small onHover" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up"
                                                                IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                                        <Button Grid.Column="4" Classes="small onHover" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down"
                                                                IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                                        <Button Grid.Column="5" Classes="small onHover" Content="✎" Command="{Binding BeginEditCommand}" ToolTip.Tip="Rename"
                                                                IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                                        <Button Grid.Column="6" Classes="small" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove"
                                                                IsVisible="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).CanEdit}" />
                                                    </Grid>
                                                    <Border Classes="dropLine" VerticalAlignment="Top" IsVisible="{Binding IsDropAbove}" />
                                                    <Border Classes="dropLine" VerticalAlignment="Bottom" IsVisible="{Binding IsDropBelow}" />
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Classes="taskEntry" Margin="40,0,0,0" Text="{Binding NewSubtaskTitle}" PlaceholderText="Subtask (Enter)"
                                                 IsVisible="{Binding IsAddingSubtask}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding AddSubtaskCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <Border Classes="dropLine" VerticalAlignment="Top" IsVisible="{Binding IsDropAbove}" />
                                    <Border Classes="dropLine" VerticalAlignment="Bottom" IsVisible="{Binding IsDropBelow}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add a task: the dot picks the category it goes in; the tag button opens the categories panel. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding CanEdit}">
            <Button Classes="small" Padding="2,0" Margin="0,0,4,0" ToolTip.Tip="{Binding NewTaskCategoryTip}"
                    AutomationProperties.Name="Category for new tasks" IsVisible="{Binding HasCategories}">
                <Ellipse Width="12" Height="12" Fill="{Binding NewTaskCategoryBrush}" Stroke="#80808080" StrokeThickness="1" />
                <Button.Flyout>
                    <!-- Items are rebuilt each time it opens (OnNewTaskPickerOpening); a long-lived flyout whose ItemsSource is
                         replaced kept the stale item set. -->
                    <MenuFlyout Opening="OnNewTaskPickerOpening" ItemContainerTheme="{StaticResource CategoryMenuItem}"
                                ItemTemplate="{StaticResource CategoryChoiceTemplate}" />
                </Button.Flyout>
            </Button>
            <TextBox Grid.Column="1" x:Name="NewTaskBox" Classes="taskEntry" Text="{Binding NewTaskTitle}" PlaceholderText="Add a task (Enter)">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="2" Classes="small" Margin="4,0,0,0" Command="{Binding ToggleManageCategoriesCommand}"
                    ToolTip.Tip="Categories: group tasks under names with colours (e.g. Work, Personal)" AutomationProperties.Name="Categories">
                <mi:MaterialIcon Kind="TagMultipleOutline" Width="16" Height="16" />
            </Button>
        </Grid>

        <!-- A 4th task: park it, or add it anyway with a reason (3 tasks per session). -->
        <Border IsVisible="{Binding IsOverLimitPrompt}" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="8,6">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding OverLimitText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBox Text="{Binding OverLimitReason}" PlaceholderText="Or add it anyway: why? (10+ characters, stays on this PC)" />
                <TextBlock Text="{Binding OverLimitError}" Foreground="#E5484D" TextWrapping="Wrap"
                           IsVisible="{Binding OverLimitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Content="Park it" Command="{Binding ParkHeldTaskCommand}" />
                    <Button Classes="small" Content="Add anyway" Command="{Binding AddHeldTaskAnywayCommand}" />
                    <Button Classes="small" Content="Cancel" Command="{Binding CancelHeldTaskCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The categories panel: add, rename (Enter or click away), recolour (8 colours) and delete. -->
        <Border IsVisible="{Binding IsManagingCategories}" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="8,6">
            <StackPanel Spacing="4">
                <TextBlock Text="Categories" FontWeight="SemiBold" />
                <TextBlock Text="Deleting one leaves its tasks with no category." FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CategoryRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskCategoryRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,2">
                                <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" MinWidth="0"
                                          AutomationProperties.Name="Colour">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ColorChoice">
                                            <Ellipse Width="14" Height="14" Fill="{Binding Brush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="1" Classes="taskEntry" Text="{Binding Name}" LostFocus="OnCategoryNameLostFocus"
                                         AutomationProperties.Name="Category name">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SaveNameCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2" Classes="small" Content="✕" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this category" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Classes="taskEntry" Text="{Binding NewCategoryName}" PlaceholderText="New category, e.g. Work (Enter)">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddCategoryCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
        </Border>

        <Expander Header="{Binding DoneHeader}" IsVisible="{Binding HasDone}" IsExpanded="False" HorizontalAlignment="Stretch" Padding="8,4"
                  Classes.compact="{Binding IsCompact}">
            <ItemsControl ItemsSource="{Binding DoneTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRowViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <CheckBox IsChecked="{Binding IsDone}" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                            <!-- Its category's colour, with the name on hover. -->
                            <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding CategoryBrush}"
                                     IsVisible="{Binding HasCategory}" ToolTip.Tip="{Binding CategoryName}" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextDecorations="Strikethrough" Opacity="0.7"
                                           Classes.compact="{Binding $parent[UserControl].((vm:ChecklistViewModel)DataContext).IsCompact}" />
                                <TextBlock Text="{Binding DoneText}" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <CheckBox Content="Tell me when all tasks are done" IsChecked="{Binding NotifyAllDone}" IsVisible="{Binding ShowsNotifyChoice}" />
        <Button Content="End session · all tasks done" Command="{Binding EndAtOnceCommand}" IsVisible="{Binding CanEndAtOnce}"
                Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Every task is ticked: the session ends now, with the reason &quot;All tasks done&quot;" />
    </StackPanel>
</UserControl>
