<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.SessionReviewView"
             x:DataType="vm:SessionReviewViewModel">
    <!-- The review card (in Today's side column): sites and apps with no rule, each Distracting / Fine / Ignore; one reason for the Fine ones. -->
    <Border Classes="card">
        <StackPanel Spacing="12">
            <DockPanel>
                <mi:MaterialIcon DockPanel.Dock="Left" Kind="ClipboardCheckOutline" Width="18" Height="18" VerticalAlignment="Top"
                                 Foreground="{DynamicResource Ab.Muted}" Margin="0,2,8,0" />
                <TextBlock Classes="display" Text="{Binding Heading}" FontSize="18" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding PhoneText}" Foreground="{DynamicResource Ab.Met}" TextWrapping="Wrap"
                       IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="muted" Text="{Binding OverLimitText}" IsVisible="{Binding HasOverLimit}" TextWrapping="Wrap" />
            <!-- Notes kept during the session (redesign phase 5): shown once, here. -->
            <StackPanel Spacing="2" IsVisible="{Binding HasNotes}">
                <TextBlock Classes="section" Text="Noted during the session" />
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasProfileChoice}">
                <TextBlock Classes="section" Text="Rules go to" />
                <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                        <StackPanel Margin="0,4" Spacing="4">
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                <ToggleButton Classes="choice" Content="Distracting" IsChecked="{Binding IsDistracting}" />
                                <ToggleButton Classes="choice" Content="Fine" IsChecked="{Binding IsFine}" />
                                <ToggleButton Classes="choice" Content="Ignore" IsChecked="{Binding IsIgnored}" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- On track in three sessions: offered once as always allowed. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasPromotions}">
                <ItemsControl ItemsSource="{Binding Promotions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PromoteRowViewModel">
                            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsYes}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBox Text="{Binding Reason}" PlaceholderText="Why is what you allow fine? (needed to allow it)" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Ab.Drift}" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Skip" Command="{Binding SkipCommand}" />
                <Button Content="Done" Command="{Binding DoneCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
