<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             x:Class="AccountabiliBuddy.App.Views.SessionReviewView"
             x:DataType="vm:SessionReviewViewModel">
    <!-- The review card: sites and apps with no rule, each Distracting / Fine / Ignore; one reason for the Fine ones. -->
    <Border Padding="20" CornerRadius="10" Background="#1A2A9D8F" BorderBrush="#552A9D8F" BorderThickness="1">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PhoneText}" Foreground="#22C55E" TextWrapping="Wrap"
                       IsVisible="{Binding PhoneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <!-- Notes kept during the session (redesign phase 5): shown once, here. -->
            <StackPanel Spacing="2" IsVisible="{Binding HasNotes}">
                <TextBlock Text="Noted during the session" Opacity="0.8" />
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasProfileChoice}">
                <TextBlock Text="Rules go to" VerticalAlignment="Center" Opacity="0.8" />
                <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}" MinWidth="200" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <ToggleButton Content="Distracting" IsChecked="{Binding IsDistracting}" />
                                <ToggleButton Content="Fine" IsChecked="{Binding IsFine}" />
                                <ToggleButton Content="Ignore" IsChecked="{Binding IsIgnored}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- On track in three sessions: offered once as always allowed. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasPromotions}">
                <ItemsControl ItemsSource="{Binding Promotions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PromoteRowViewModel">
                            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsYes}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBox Text="{Binding Reason}" PlaceholderText="Why is what you allow fine? (needed to allow it)" />
            <TextBlock Text="{Binding Error}" Foreground="#E76F51" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Skip" Command="{Binding SkipCommand}" />
                <Button Content="Done" Command="{Binding DoneCommand}" Classes="accent" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
