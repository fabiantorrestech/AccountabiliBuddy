<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        x:Class="AccountabiliBuddy.App.Views.SetupAssistantWindow"
        x:DataType="vm:SetupAssistantViewModel"
        Title="AccountabiliBuddy setup"
        Icon="/Assets/app-icon.png"
        Width="880" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.locked">
            <Setter Property="Background" Value="#33F59E0B" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#E9A23B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="28,20,28,12">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding StepNumberText}" Opacity="0.7" />
                <TextBlock Text="{Binding StepTitle}" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="28,12" BorderBrush="#33808080" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Close" Command="{Binding CloseCommand}" IsVisible="{Binding !IsDone}"
                            AutomationProperties.Name="Close assistant" />
                    <Button Content="Back" Command="{Binding BackCommand}" />
                    <Button Content="{Binding NextText}" Command="{Binding NextCommand}" Classes="accent" MinWidth="110"
                            AutomationProperties.Name="Next step" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Padding="28,4,28,16">
            <Panel>
                <!-- 1. Welcome -->
                <StackPanel IsVisible="{Binding IsWelcome}" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="body"
                               Text="AccountabiliBuddy watches what's on your screens and nudges you back when you drift from what you planned. Everything it sees stays on this computer." />
                    <TextBlock Classes="body"
                               Text="This assistant brings over your blocks from other blockers (Cold Turkey, AppBlock, BlockSite, LeechBlock, or any list you paste), then connects your browsers and sets the basics. It takes a couple of minutes, and you can skip any step." />
                    <TextBlock Classes="muted" Text="You can run it again later from the Setup tab." />
                    <Border Classes="locked" IsVisible="{Binding IsLocked}">
                        <TextBlock Text="A focus session is running, so nothing can be imported right now. You can still set up browsers and the basics."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 1b. Link to your other devices first (ADR 22) -->
                <StackPanel IsVisible="{Binding IsLinkFirst}" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="body"
                               Text="Already using AccountabiliBuddy on a phone or another PC? Link this one first: it gets your profiles, day plan and settings from them, and they share their focus with each other." />
                    <RadioButton GroupName="link" IsChecked="{Binding !HasOtherDevice}" Content="This is my first device" />
                    <RadioButton GroupName="link" IsChecked="{Binding HasOtherDevice}" Content="I have AccountabiliBuddy on another device" />
                    <StackPanel Spacing="6" Margin="28,0,0,0" IsVisible="{Binding HasOtherDevice}">
                        <TextBlock Classes="muted"
                                   Text="On the other device, open Devices → Link a device, and type its link code here (40 characters; the dashes don't matter)." />
                        <TextBox Text="{Binding LinkCode}" PlaceholderText="e.g. 8KQ2V-7XHPM-D4WN6-…" MaxWidth="520" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="You can also do this later in the Devices tab." />
                </StackPanel>

                <!-- 1c. What kind of computer is this? (ADR 22) -->
                <StackPanel IsVisible="{Binding IsComputerType}" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="body"
                               Text="Each type is only a starting set of switches: you can change any of them later in Settings and Devices. Safest first." />
                    <RadioButton GroupName="type" IsChecked="{Binding IsLocalOnlyType}">
                        <TextBlock TextWrapping="Wrap" Text="Local only: makes no network connections of its own; no syncing, no update checks." />
                    </RadioButton>
                    <RadioButton GroupName="type" IsChecked="{Binding IsWorkType}">
                        <TextBlock TextWrapping="Wrap" Text="Work computer: keeps only sites (no titles or addresses), notices and overlays but never minimizes work windows, shares through a sync folder and QR codes." />
                    </RadioButton>
                    <RadioButton GroupName="type" IsChecked="{Binding IsPersonalType}">
                        <TextBlock TextWrapping="Wrap" Text="Personal computer: everything available; shares with your phone through Google Drive once you sign in." />
                    </RadioButton>
                    <Button Content="Choose the sync folder…" Command="{Binding ChooseSyncFolderCommand}" IsVisible="{Binding IsWorkType}"
                            ToolTip.Tip="E.g. a folder inside Google Drive for desktop" />
                    <Panel IsVisible="{Binding HasWorkHours}">
                        <CheckBox IsChecked="{Binding GuardWorkHours}" IsVisible="{Binding IsPersonalType}" Margin="28,0,0,0">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Guard work hours here: Claude Code, terminals and editors wait during your day plan's work parts (for a personal computer next to a work one)." />
                        </CheckBox>
                    </Panel>
                    <TextBlock Text="What this computer will do" Classes="title" />
                    <ItemsControl ItemsSource="{Binding TypeSummary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. Bring your blocks -->
                <StackPanel IsVisible="{Binding IsImport}" Spacing="12">
                    <Border Classes="locked" IsVisible="{Binding IsLocked}">
                        <TextBlock Text="Importing is locked while a focus session is running." TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Classes="muted"
                               Text="Tick what to bring over. Nothing is changed in the other blockers, and nothing existing here is replaced." />
                    <TextBlock Text="Found on this PC" Classes="title" IsVisible="{Binding HasSources}" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetectedSourceRowViewModel">
                                <Border Classes="card">
                                    <StackPanel Spacing="4">
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" Classes="title" />
                                                <TextBlock Text="{Binding Summary}" Classes="muted" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Details}" IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontSize="13" Margin="28,0,0,0" />
                                        <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Classes="warning"
                                                   FontSize="13" Margin="28,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding OtherBlockersNote}" TextWrapping="Wrap"
                               IsVisible="{Binding OtherBlockersNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock Text="LeechBlock" Classes="title" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   Text="In LeechBlock's options, use Export Options to save a file, then import it here." />
                        <Button Grid.Column="1" Content="Import a LeechBlock file…" Command="{Binding ImportFileCommand}" />
                    </Grid>

                    <TextBlock Text="Paste a list" Classes="title" Margin="0,8,0,0" />
                    <TextBlock Classes="muted"
                               Text="From Freedom, FocusMe, Curbox, BlockSite or any other blocker: open its block list, copy the sites or apps and paste them here, one per line or separated by spaces. Wildcards like *.example.com work; apps can be names like Discord.exe." />
                    <TextBox Text="{Binding PasteName}" PlaceholderText="Name, e.g. Freedom" MaxWidth="320" HorizontalAlignment="Left"
                             AutomationProperties.Name="Pasted list name" />
                    <TextBox Text="{Binding PasteText}" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                             PlaceholderText="reddit.com&#x0a;youtube.com/shorts&#x0a;Discord.exe"
                             AutomationProperties.Name="Pasted list" />
                    <Button Content="Add pasted list" Command="{Binding AddPasteCommand}" />

                    <TextBlock Text="Restore an AccountabiliBuddy backup" Classes="title" Margin="0,8,0,0" />
                    <TextBlock Classes="muted" Text="Moving from another PC? Restore a backup made in Settings, under Backup." />
                    <views:BackupPanel DataContext="{Binding Backup}" />
                </StackPanel>

                <!-- 3. Your usage -->
                <StackPanel IsVisible="{Binding IsUsage}" Spacing="12">
                    <TextBlock Classes="muted"
                               Text="Your most-used sites and apps in Cold Turkey over the last 30 days. Tick any you want blocked." />
                    <Grid ColumnDefinitions="*,24,*">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sites" Classes="title" />
                            <ItemsControl ItemsSource="{Binding SiteSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageSuggestionRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Opacity="0.7" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Apps" Classes="title" />
                            <ItemsControl ItemsSource="{Binding AppSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageSuggestionRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Opacity="0.7" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Add the ticked ones to" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SuggestionTargets}" SelectedItem="{Binding SelectedSuggestionTarget}" MinWidth="280"
                                  AutomationProperties.Name="Add suggestions to" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding CopyUsageToHistory}" IsEnabled="{Binding CanCopyUsageToHistory}"
                              Content="Also copy the last 90 days of Cold Turkey usage into History (times, sites and apps only)" />
                </StackPanel>

                <!-- 4. Review -->
                <StackPanel IsVisible="{Binding IsReview}" Spacing="12">
                    <Border Classes="locked" IsVisible="{Binding IsLocked}">
                        <TextBlock Text="Importing is locked while a focus session is running." TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Classes="muted" IsVisible="{Binding !HasPlannedProfiles}"
                               Text="Nothing is selected to import. Go back to pick something, or skip this step." />
                    <StackPanel IsVisible="{Binding HasPlannedProfiles}" Spacing="12">
                        <TextBlock Text="Profiles to create" Classes="title" />
                        <TextBlock Classes="muted"
                                   Text="Each one only blocks what's listed, like the blocker it came from (it gets 'allow everything else' rules you can remove later to make it stricter). Rename them or untick any you don't want." />
                        <ItemsControl ItemsSource="{Binding PlannedProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlannedProfileRowViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Top"
                                                      AutomationProperties.Name="Include profile" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBox Text="{Binding Name}" MaxWidth="460" HorizontalAlignment="Left"
                                                         AutomationProperties.Name="Profile name" />
                                                <TextBlock Text="{Binding Origin}" IsVisible="{Binding IsCombined}" FontStyle="Italic" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.8" />
                                                <TextBlock Text="{Binding Skipped}" IsVisible="{Binding HasSkipped}" Classes="warning" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Weekly schedule" Classes="title" />
                        <SelectableTextBlock Text="{Binding WeekPreview}" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="13" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasNotes}" Spacing="4">
                        <TextBlock Text="Left out" Classes="title" />
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Classes="muted" FontSize="13" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- 5. Browsers -->
                <StackPanel IsVisible="{Binding IsBrowsers}" Spacing="12">
                    <TextBlock Classes="muted" Text="Install the extension in each browser you use." />
                    <views:BrowserSetupList DataContext="{Binding Setup}" />
                </StackPanel>

                <!-- 6. Basics -->
                <Panel IsVisible="{Binding IsBasics}">
                <StackPanel Spacing="8" DataContext="{Binding Setup}" x:DataType="vm:SetupViewModel">
                    <TextBlock Classes="muted" Text="Each of these can be revoked later in the Setup tab (outside a focus session)." />
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Start with Windows" Classes="title" />
                            <TextBlock Grid.Row="1" Text="{Binding StartupStatus}" Classes="muted" />
                            <Button Grid.RowSpan="2" Grid.Column="1" Content="Turn on" Command="{Binding GrantStartupCommand}" Classes="accent"
                                    VerticalAlignment="Center" AutomationProperties.Name="Turn on start with Windows" />
                        </Grid>
                    </Border>
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Quick session in the Start menu" Classes="title" />
                            <TextBlock Grid.Row="1" Text="{Binding QuickLaunchStatus}" Classes="muted" />
                            <Button Grid.RowSpan="2" Grid.Column="1" Content="Turn on" Command="{Binding GrantQuickLaunchCommand}" Classes="accent"
                                    VerticalAlignment="Center" AutomationProperties.Name="Turn on quick session shortcut" />
                        </Grid>
                    </Border>
                    <Border Classes="card" DataContext="{Binding Privacy}" x:DataType="vm:PrivacySetupViewModel">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Activity history" Classes="title" />
                            <TextBlock Grid.Row="1" Text="{Binding ActivityLogStatus}" Classes="muted" />
                            <Button Grid.RowSpan="2" Grid.Column="1" Content="Turn on" Command="{Binding GrantActivityLogCommand}" Classes="accent"
                                    VerticalAlignment="Center" AutomationProperties.Name="Turn on activity history" />
                        </Grid>
                    </Border>
                    <Border Classes="card" DataContext="{Binding Privacy}" x:DataType="vm:PrivacySetupViewModel">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Screen reading (OCR), optional" Classes="title" />
                            <TextBlock Grid.Row="1" Text="{Binding ScreenReadingStatus}" Classes="muted" />
                            <Button Grid.RowSpan="2" Grid.Column="1" Content="Turn on" Command="{Binding GrantScreenReadingCommand}"
                                    VerticalAlignment="Center" AutomationProperties.Name="Turn on screen reading" />
                        </Grid>
                    </Border>
                </StackPanel>
                </Panel>

                <!-- ADR 47 (C 15): your workdays: which days, and a work window or a budget of hours -->
                <Panel IsVisible="{Binding IsWorkdays}">
                    <StackPanel DataContext="{Binding Workdays}" x:DataType="vm:WorkdaysSetupViewModel" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Classes="body" TextWrapping="Wrap"
                                   Text="Which days do you work, and when? A work window is enough for the buddy to guard your workdays; you can plan each day part by part, or a budget of hours, later in the Day plan tab." />
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkdayChip">
                                    <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsOn}" MinWidth="48" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <RadioButton GroupName="workdays" IsChecked="{Binding IsKeepTimeline}" IsVisible="{Binding HasTimeline}"
                                     Content="Keep my timeline (the day's parts as they are)" />
                        <RadioButton GroupName="workdays" IsChecked="{Binding IsWorkWindow}" Content="Just a work window" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsVisible="{Binding IsWorkWindow}">
                            <TextBlock Text="Work from" VerticalAlignment="Center" />
                            <TimePicker ClockIdentifier="12HourClock" SelectedTime="{Binding WindowStart}" MinuteIncrement="15" MinWidth="0" Width="196" />
                            <TextBlock Text="to" VerticalAlignment="Center" />
                            <TimePicker ClockIdentifier="12HourClock" SelectedTime="{Binding WindowEnd}" MinuteIncrement="15" MinWidth="0" Width="196" />
                        </StackPanel>
                        <RadioButton GroupName="workdays" IsChecked="{Binding IsBudget}" Content="A budget of productive hours" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsVisible="{Binding IsBudget}">
                            <NumericUpDown Value="{Binding BudgetHours}" Minimum="0.25" Maximum="24" Increment="0.25" FormatString="0.00" Width="130" />
                            <TextBlock Text="hours, between waking and bedtime" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Message}" />
                    </StackPanel>
                </Panel>

                <!-- ADR 46: the own relay, set up in Devices -->
                <StackPanel IsVisible="{Binding IsOwnRelay}" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Classes="body" TextWrapping="Wrap"
                               Text="Your devices can now sync through a small relay you run yourself, with changes arriving in about a second and no Google account. Everything stays sealed: the relay stores scrambled bytes and the key never leaves your devices." />
                    <TextBlock Classes="body" TextWrapping="Wrap"
                               Text="To set it up, finish here, then open Devices → How this PC shares → Own relay. Type your relay's address and pin, press Test connection and tick Own relay. The Devices page has the short steps and the full guide." />
                </StackPanel>

                <!-- The start-of-day assistant: on the first arrival of a workday -->
                <StackPanel IsVisible="{Binding IsStartOfDay}" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Classes="body" TextWrapping="Wrap"
                               Text="On your first arrival of a workday, a card in front of everything now asks how many hours of work you hope to get done today, what's first (up to 3 tasks), and starts your session with the remembered length, counting down, planning first." />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Raising today's goal (and budget on a Budget day) applies at once; lowering it waits like any looser change. Not now takes a reason and asks again later. It never comes on a free day. You can switch it off any time in Settings → Your day → Steer me to start." />
                    <CheckBox IsChecked="{Binding IsStartOfDayOn}" Content="Ask me at the start of my workday" />
                </StackPanel>

                <!-- ADR 39: Cold Turkey, let AccountabiliBuddy hold the keys -->
                <StackPanel IsVisible="{Binding IsColdTurkeyKeys}" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Classes="body" TextWrapping="Wrap"
                               Text="Pick the Cold Turkey blocks AccountabiliBuddy should lock during your focus sessions, Pre-Work and work hours. While it holds them, Cold Turkey won't let them be switched off. Outside those times they're yours again." />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Focus sessions use a hard lock (AccountabiliBuddy's password; your spare key is the only other way out). Pre-Work and work hours use a timed lock renewed every minute, which ends by itself within 10 minutes if AccountabiliBuddy stops." />
                    <Border Classes="card" IsVisible="{Binding ColdTurkeyNotPro}">
                        <TextBlock TextWrapping="Wrap" Text="Hard locks need Cold Turkey Pro. Without it, AccountabiliBuddy uses timed locks everywhere." />
                    </Border>
                    <ItemsControl ItemsSource="{Binding ColdTurkeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColdTurkeySetupRow">
                                <Border Classes="card" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Name}" Classes="title" />
                                        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <CheckBox Content="Focus sessions" IsChecked="{Binding InFocusSessions}" Margin="0,0,16,0" />
                                            <CheckBox Content="Pre-Work" IsChecked="{Binding InPreWork}" Margin="0,0,16,0" />
                                            <CheckBox Content="Work hours" IsChecked="{Binding InWorkHours}" Margin="0,0,16,0" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <CheckBox Content="Hard lock in focus sessions" IsChecked="{Binding HardInFocus}" Margin="0,0,16,0" />
                                            <CheckBox Content="Hard lock in Pre-Work and work hours too" IsChecked="{Binding HardElsewhere}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="In Cold Turkey, for each block above" Classes="title" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="1. Open the block's settings. 2. Set its lock to None: AccountabiliBuddy does the locking. 3. Turn off &quot;unblock when the lock ends&quot;, so the block stays on after a timed lock. Then press Check again." />
                            <Button Content="Check again" Command="{Binding CheckColdTurkeyAgainCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <CheckBox IsChecked="{Binding RearmOn}" Content="Turn blocks I switched off back on at the day's re-enable time" />
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding RearmOn}">
                                <TextBlock Text="Workdays" VerticalAlignment="Center" Width="80" />
                                <TimePicker ClockIdentifier="12HourClock" SelectedTime="{Binding WorkdayReenable}" MinuteIncrement="15" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding RearmOn}">
                                <TextBlock Text="Off-Days" VerticalAlignment="Center" Width="80" />
                                <TimePicker ClockIdentifier="12HourClock" SelectedTime="{Binding OffDayReenable}" MinuteIncrement="15" />
                            </StackPanel>
                            <TextBlock Classes="muted" Text="12:00 AM = midnight, the end of the day. A heads-up comes 5 minutes before." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ADR 39: the spare key -->
                <StackPanel IsVisible="{Binding IsSpareKey}" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="body" TextWrapping="Wrap"
                               Text="This key unlocks your Cold Turkey blocks if AccountabiliBuddy ever can't. Write it on paper now and keep it somewhere annoying to reach, or with someone you trust. It's shown only this once." />
                    <Border Background="#1A6366F1" CornerRadius="8" Padding="16" HorizontalAlignment="Left">
                        <SelectableTextBlock Text="{Binding SpareKey}" FontFamily="Consolas,Courier New,monospace" FontSize="28" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="In an emergency: the tray menu, Emergency release (Cold Turkey), and type it there. If AccountabiliBuddy is broken, open Cold Turkey, stop the block and type the key exactly as written. Timed locks end by themselves within 10 minutes of the app stopping." />
                    <TextBlock Text="Type the key from your paper to confirm you wrote it down:" />
                    <TextBox x:Name="AssistantSpareBox" Text="{Binding TypedSpareKey}" FontFamily="Consolas,Courier New,monospace" MaxWidth="420" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- First run: the daily goal -->
                <StackPanel IsVisible="{Binding IsGoal}" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="body" Text="Counted focus a day you'd be happy with. Start small; you can change it later." />
                    <RadioButton GroupName="goal" IsChecked="{Binding IsGoal30}" Content="30 minutes" />
                    <RadioButton GroupName="goal" IsChecked="{Binding IsGoal60}" Content="1 hour" />
                    <RadioButton GroupName="goal" IsChecked="{Binding IsGoal120}" Content="2 hours" />
                    <RadioButton GroupName="goal" IsChecked="{Binding IsGoal240}" Content="4 hours" />
                </StackPanel>

                <!-- 7. Done -->
                <StackPanel IsVisible="{Binding IsDone}" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="body" Text="{Binding Summary}" />
                    <TextBlock Text="What's next" Classes="title" />
                    <TextBlock Classes="body" Text="• Start a session from the Today tab, or press Ctrl+Alt+F anywhere." />
                    <TextBlock Classes="body" IsVisible="{Binding IsQuick}"
                               Text="• Your first session learns: it asks about nothing new, and at its end you sort what you used on Today." />
                    <TextBlock Classes="body" Text="• Your day plan is in the Day plan tab; a day planned differently is in Calendar." />
                    <TextBlock Classes="body" IsVisible="{Binding IsQuick}"
                               Text="• Imports from other blockers and browser extensions: More → Setup → Full setup." />
                    <TextBlock Classes="body" IsVisible="{Binding !IsQuick}" Text="• Run this assistant again any time from More → Setup." />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</Window>
