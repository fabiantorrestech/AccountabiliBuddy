<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             xmlns:controls="using:AccountabiliBuddy.App.Controls"
             xmlns:search="using:AccountabiliBuddy.App.Services.Search"
             x:Class="AccountabiliBuddy.App.Views.SettingsShellView"
             x:DataType="vm:MainWindowViewModel">
    <!-- Settings as a list on the left (280, 220 on a narrow window) and the chosen row's page on the right, in one page card (design 5q).
         Each page has a display title, a Muted summary and its actions on the right. SettingsView holds the pages of Your day, Sleep,
         Focus sessions, Alerts & on-screen, Appearance and App & data; Guards, Devices & sync, Connections, Setup and About are pages
         of their own. One Save for the pages in SettingsView, kept here so it stays in reach; leaving Settings with unsaved changes asks first. -->
    <UserControl.Resources>
        <!-- Quiet colour on Settings: ticked boxes, chosen radios and sliders read in ink, not the accent. -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource Ab.BgColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{DynamicResource Ab.BgColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{DynamicResource Ab.BgColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource Ab.InkColor}" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox.settingsList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.settingsList > ListBoxItem" x:DataType="vm:SettingsRowViewModel">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="{Binding RowMargin}" />
            <Setter Property="IsVisible" Value="{Binding IsListed}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Never the accent: hover and the chosen row are Surface2, the chosen one with a heavier name. -->
        <Style Selector="ListBox.settingsList > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.settingsList > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="ListBox.settingsList > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="ListBox.settingsList > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="ListBox.settingsList > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="ListBox.settingsList > ListBoxItem:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- The Search field: a Surface2 pill with a magnifier. -->
        <Style Selector="TextBox.settingsSearch /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="TextBox.settingsSearch:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.settingsSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- The overlay preview (Alerts & on-screen): a fixed pane on the right while the page area is wide; under that width it moves
             above the page as a short strip with a fold arrow. -->
        <Style Selector="Panel.previewHost">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Width" Value="420" />
            <Setter Property="Margin" Value="12,0,16,16" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Grid.pageHost">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <ContainerQuery Name="SettingsPage" Query="max-width:1060">
            <Style Selector="Panel.previewHost">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Margin" Value="0,0,16,8" />
            </Style>
            <Style Selector="Panel.previewHost > controls|OverlayPreview">
                <Setter Property="IsStrip" Value="True" />
            </Style>
            <Style Selector="Grid.pageHost">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.RowSpan" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid x:Name="Layout" ColumnDefinitions="280,*">
            <!-- The list. -->
            <Border BorderBrush="{DynamicResource Ab.Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,28,16,20" Spacing="4">
                        <TextBlock Classes="display" Text="Settings" FontSize="28" Margin="10,0,0,14" />
                        <TextBox Classes="settingsSearch" Text="{Binding Settings.ListFilter, Mode=TwoWay}" PlaceholderText="Search"
                                 Margin="0,0,0,10" Padding="14,10" FontSize="13" AutomationProperties.Name="Search settings">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="10,0,0,0" Foreground="{DynamicResource Ab.Muted}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ListBox x:Name="RowList" Classes="settingsList" ItemsSource="{Binding Settings.Rows}"
                                 SelectedIndex="{Binding Settings.SelectedRowIndex}" SelectionMode="AlwaysSelected"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}"
                                          search:SearchArea.SettingsGroup="{Binding Index}">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <mi:MaterialIcon Grid.Column="2" Kind="LockOutline" Width="16" Height="16" IsVisible="{Binding IsResting}"
                                                         Foreground="{DynamicResource Ab.Faint}" ToolTip.Tip="Resting while you focus" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The chosen row's page. -->
            <DockPanel Grid.Column="1" Margin="32,26,12,0">
                <!-- Title, a Muted one-line summary and the page's actions on the right (Devices & sync: Add a device, Sync now). -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="display" FontSize="28" Text="{Binding Settings.SelectedRow.Name}" />
                        <TextBlock Classes="muted" FontSize="14" TextWrapping="Wrap" Text="{Binding Settings.SelectedRow.Summary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom"
                                IsVisible="{Binding Settings.Rows[5].IsSelected}">
                        <Button Classes="sRound" Command="{Binding Devices.ShowQrCodeCommand}" IsVisible="{Binding Devices.QrOn, FallbackValue=False}"
                                ToolTip.Tip="Add a device: show today's QR codes" AutomationProperties.Name="Add a device">
                            <mi:MaterialIcon Kind="QrcodeScan" Width="22" Height="22" />
                        </Button>
                        <Button Classes="sSoft" Content="Sync now" Command="{Binding Devices.SyncNowCommand}" IsEnabled="{Binding Devices.InGroup, FallbackValue=False}"
                                ToolTip.Tip="Write this PC's sync file now and hand it to connected devices" />
                    </StackPanel>
                </Grid>

                <!-- One Save for the whole of Settings' pages; shown while there is something to save or to say. -->
                <Border DockPanel.Dock="Top" Margin="0,0,16,10" Padding="14,8" CornerRadius="{DynamicResource Ab.PanelRadius}" Background="{DynamicResource Ab.Surface2}">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="Settings.HasUnsavedChanges" />
                            <Binding Path="Settings.SaveStatus" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Ab.Waiting}" IsVisible="{Binding Settings.HasUnsavedChanges}" VerticalAlignment="Center" />
                            <TextBlock Text="Unsaved changes" IsVisible="{Binding Settings.HasUnsavedChanges}" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" Text="{Binding Settings.SaveStatus}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460"
                                       IsVisible="{Binding !Settings.HasUnsavedChanges}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Revert" Command="{Binding Settings.RevertCommand}" IsEnabled="{Binding Settings.HasUnsavedChanges}" />
                            <Button Classes="primary" Content="Save" Command="{Binding Settings.SaveCommand}" IsEnabled="{Binding Settings.HasUnsavedChanges}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Why a save didn't go through stays visible while the changes are still unsaved. -->
                <Border DockPanel.Dock="Top" Classes="sInfo" Margin="0,0,16,10" Padding="14,8">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Settings.HasUnsavedChanges" />
                            <Binding Path="Settings.SaveStatus" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <TextBlock Text="{Binding Settings.SaveStatus}" TextWrapping="Wrap" />
                </Border>
                <!-- Guard settings are view-only while a session runs (as before); the banner shows on the pages that hold them. -->
                <Border DockPanel.Dock="Top" Classes="sInfo" Margin="0,0,16,8" Padding="14,8" IsVisible="{Binding Settings.ShowsLockedBanner}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <mi:MaterialIcon Kind="LockOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource Ab.InfoInk}" />
                        <TextBlock Grid.Column="1" Text="{Binding Settings.RestingBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <views:PendingChangesBanner DockPanel.Dock="Top" DataContext="{Binding Settings.PendingChanges}" Margin="0,0,16,8" />
                <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Settings.StatusMessage}" TextWrapping="Wrap" Margin="0,0,16,10"
                           IsVisible="{Binding Settings.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Grid Container.Name="SettingsPage" Container.Sizing="Width" ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <!-- The live preview of the overlay settings: shown only on Alerts & on-screen, where the overlay settings are. -->
                    <Panel Classes="previewHost">
                        <Panel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Settings.Rows[4].IsSelected" />
                                <Binding Path="Settings.OverlayPage" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            </MultiBinding>
                        </Panel.IsVisible>
                        <controls:OverlayPreview DataContext="{Binding Settings.OverlayPage.Preview}" />
                    </Panel>
                <Grid Classes="pageHost">
                    <!-- Your day, Sleep, Focus sessions, Alerts & on-screen, Appearance, App & data: SettingsView's pages. -->
                    <Panel IsVisible="{Binding Settings.UsesSettingsView}">
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </Panel>

                    <!-- Guards: the profiles (list and detail), then the rows around them: Unlocks, Cold Turkey and the block setup. -->
                    <ScrollViewer IsVisible="{Binding Settings.Rows[3].IsSelected}" search:SearchArea.Name="Guards" search:SearchArea.SettingsGroup="3"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="0,0,16,24">
                            <views:ProfilesView DataContext="{Binding Profiles}" />
                            <TextBlock Classes="sGroup" Text="Around the profiles" />
                            <Border Classes="sPanel">
                                <StackPanel Margin="0,0,0,-1">
                                    <views:SettingsUnlocksCard DataContext="{Binding Settings}" />
                                    <Border Classes="sRow" search:SearchArea.Name="Cold Turkey" DataContext="{Binding Integrations}" x:DataType="vm:IntegrationsViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="sTitle" Text="Cold Turkey Blocker" />
                                                <TextBlock Classes="sHint" Text="{Binding ColdTurkeySummary}" />
                                                <TextBlock Classes="sHint" Text="Its keys and spare key are set up in the full setup (Setup); the blocks each profile expects are on that profile. Nothing in Cold Turkey is changed." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Get a new spare key…" Command="{Binding NewSpareKeyCommand}" IsVisible="{Binding IsColdTurkeyInstalled}" />
                                                <Button Content="Open Connections"
                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenConnectionsCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="sRow" search:SearchArea.Name="Block setup">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="sTitle" Text="Block setup" />
                                                <TextBlock Classes="sHint" Text="Import a block list, see the other blockers on this PC and the sites Cold Turkey was seen blocking." />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Open Connections" VerticalAlignment="Center"
                                                    Command="{Binding OpenConnectionsCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Panel IsVisible="{Binding Settings.Rows[5].IsSelected}" search:SearchArea.Name="Devices &amp; sync" search:SearchArea.SettingsGroup="5">
                        <views:DevicesView DataContext="{Binding Devices}" />
                    </Panel>

                    <Panel IsVisible="{Binding Settings.Rows[6].IsSelected}" search:SearchArea.Name="Connections" search:SearchArea.SettingsGroup="6">
                        <views:IntegrationsView DataContext="{Binding Integrations}" />
                    </Panel>

                    <!-- Setup, with the day plan assistant (it used to sit in the top bar on the Day plan tab). -->
                    <DockPanel IsVisible="{Binding Settings.Rows[9].IsSelected}" search:SearchArea.Name="Setup" search:SearchArea.SettingsGroup="9">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,16,12">
                            <Button Command="{Binding OpenDpAssistantCommand}" ToolTip.Tip="Set up your day plan step by step, with sensible defaults">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="AutoFix" Width="16" Height="16" />
                                    <TextBlock Text="Setup DP Assistant" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="muted" Text="Day plan, step by step" VerticalAlignment="Center" />
                        </StackPanel>
                        <views:SetupView DataContext="{Binding Setup}" />
                    </DockPanel>

                    <Panel IsVisible="{Binding Settings.Rows[10].IsSelected}" search:SearchArea.Name="About" search:SearchArea.SettingsGroup="10">
                        <views:AboutView DataContext="{Binding Settings.Updates}" />
                    </Panel>
                </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
