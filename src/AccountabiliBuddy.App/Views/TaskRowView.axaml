<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TaskRowView"
             x:DataType="vm:TaskListRowViewModel">
    <!-- One task row, the same in the Shelf's columns and Today's sections (spec 03 §B): the number (This
         session) and check box, the title (a star before it when highlighted) with its detail line (⏱ 50 min, 📅 Fri 11/13,
         🔔 10 min before, #tags, origin, untouched, the sync-problem cloud), the label's dot and name, the time or "Now", the hover
         quick actions (← / →), the open arrow, the ⋯ menu and the drag handle. Highlighted (starred) rows get a faint gold tint and a
         gold star (round 2 R3, brief §3.8); selected ones (Ctrl/Shift+click) the accent tint, with a ring. The label is never a fill.
         Normal rows are 44 DIP or taller; Compact (a section with the "compact" class) 32, title only. A ticked row is struck through,
         then folds away. In a Shelf column (TaskColumnScope, round 2 R3) the label's dot sits before the check box and its name leads
         the sub-line (no label slot at the right), and the open arrow and ⋯ show only on hover or keyboard focus. -->
    <UserControl.Resources>
        <!-- Check boxes read in ink, not accent. -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource Ab.Surface2Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource Ab.FaintColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource Ab.InkColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource Ab.InkColor}" />
        <!-- One piece of the detail line (also Today's flags): icon and words, a tag chip, the amber pill, or the sync-problem cloud. -->
        <DataTemplate x:Key="RowBitTemplate" x:DataType="vm:TaskRowBit">
            <Panel VerticalAlignment="Center">
                <Border Classes="bit" Classes.chip="{Binding IsChip}" Classes.ink="{Binding IsInk}" Classes.faint="{Binding IsFaint}"
                        Classes.drift="{Binding IsDrift}" Classes.abPill="{Binding IsAmber}" Classes.amber="{Binding IsAmber}" ToolTip.Tip="{Binding Tip}" VerticalAlignment="Center" IsVisible="{Binding IsPlain}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="{Binding IconKind}" Width="13" Height="13" VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                        <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasText}" />
                    </StackPanel>
                </Border>
                <!-- The sync-problem cloud: "Changed on both devices". -->
                <Button Classes="rowTool conflictBit" IsVisible="{Binding OpensConflict}" Click="OnConflictClick" Width="20" Height="20"
                        ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="Changed on both devices: pick a version">
                    <mi:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{DynamicResource Ab.Drift}" />
                </Button>
            </Panel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Round 2 (Today): the running row's accent tint and outline, the Now badge, the "in focus" note. -->
        <Style Selector="Border.nowTint">
            <Setter Property="Background" Value="{DynamicResource Ab.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.nowBadge">
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,1" />
        </Style>
        <Style Selector="TextBlock.inFocus">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Accent}" />
        </Style>
        <!-- A list row: transparent, Surface2 while open or under the pointer (the tints sit under it). -->
        <Style Selector="Button.listRow">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.listRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
        </Style>
        <Style Selector="Button.listRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <!-- Inside a soft section block (round 2, brief §3.5) a hovered row turns lighter, not darker. -->
        <Style Selector="Border.abSoftBlock Button.listRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.RowHover}" />
        </Style>
        <Style Selector="Button.listRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.listRow.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.listRow.picked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Keyboard focus (13k): a 2 px accent ring 2 px off the row, only when the keyboard put it there (never on a click). -->
        <Style Selector="Button.listRow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Border.focusRing">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Margin" Value="-4" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.listRow:focus-visible Border.focusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- A row is one stop for the keyboard: its own buttons take clicks, not Tab (Space ticks, the menu key opens the menu). -->
        <Style Selector="Button.listRow Button, Button.listRow CheckBox">
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style Selector="Border.tint">
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.ring">
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- A row's label chip (dot and name; a click opens the picker) and the quiet "+ label" spot on a row with none, which
             shows while the pointer is on the row or the row is open. Hidden, the spot takes no clicks. -->
        <Style Selector="Button.catChip">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.catChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.catChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <!-- Label style "Pill before" / "Pill in details" (Settings › Tasks): the label's name on a tint of its colour; a click opens the picker. -->
        <Style Selector="Button.labelPill">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.labelPill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <!-- Shown only while the pointer is on the row (or it is open): the "+ label" spot, the quick actions, the drag handle. -->
        <Style Selector="Panel.listItem :is(Control).onHover">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Panel.listItem:pointerover :is(Control).onHover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Panel.listItem:focus-within :is(Control).onHover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.listRow.selected :is(Control).onHover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!-- In a Shelf column (round 2 R3, brief §3.5): the open arrow and ⋯ appear on hover or focus, like the quick actions; the
             label slot goes (the dot leads the row, the name the sub-line). -->
        <Style Selector="Border.taskColumn Panel.listItem Button.rowEnd">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.taskColumn Panel.listItem:pointerover Button.rowEnd">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.taskColumn Panel.listItem:focus-within Button.rowEnd">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.taskColumn Button.listRow.selected Button.rowEnd">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.taskColumn Panel.categorySlot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The lead cell (number, check box) and the row's tools: their place outside a Shelf column (set here, not on the elements, so the
             column's styles below can move them). -->
        <Style Selector="StackPanel.leadCell">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style Selector="Border.rowTools">
            <Setter Property="Grid.Column" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.taskColumn Border.rowTools">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.taskColumn Panel.listItem:pointerover Border.rowTools">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.taskColumn Panel.listItem:focus-within Border.rowTools">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.taskColumn Button.listRow.selected Border.rowTools">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.taskColumn StackPanel.leadCell">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="10,7,4,0" />
        </Style>
        <Style Selector="Border.taskColumn :is(Control).compact StackPanel.leadCell">
            <Setter Property="Margin" Value="10,4,4,0" />
        </Style>
        <!-- The leading label dot (a click opens the label picker): filled in the label's colour, hollow and faint without one. -->
        <Style Selector="Button.leadDot">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.leadDot /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.leadDot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <!-- A starred row: a faint gold tint (the amber fill token) and a gold star. -->
        <Style Selector="Border.starTint">
            <Setter Property="Background" Value="{DynamicResource Ab.AmberFill}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.PanelRadius}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Quick actions and the open arrow: 28 DIP, faint, ink under the pointer. -->
        <Style Selector="Button.rowTool">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="Button.rowTool /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.rowTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>

        <!-- A row's title: Ink; Muted once the task is ticked (the strike comes from the global TextBlock.done). -->
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="TextBlock.rowTitle.done">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="TextBlock.mainTitle">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- ===== Today (round 2, owner fix after 0.1.132; boards B-PC-Idle / B-PC-Session). TodayView marks its list "todayRows". ===== -->
        <!-- Today's indented sub-line replaces the Tasks page's detail line, plain line and step line; the label lives in it, so the
             label slot at the right goes. -->
        <Style Selector="Panel.todayOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.todayOnly">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.tasksOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.categorySlot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The running row: its title 16 semibold, its number in the accent (the tint, outline and Now badge are above). -->
        <Style Selector="StackPanel.todayRows Panel.listItem.now TextBlock.mainTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.listItem.now TextBlock.rowNumber">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Row actions on hover or keyboard focus only (brief §3.5): the open arrow, ⋯ and the drag handle float over the row's right end
             on a Surface2 chip, so the time stays where the board has it and nothing moves. -->
        <Style Selector="StackPanel.todayRows Border.rowTools">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.listItem:pointerover Border.rowTools">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.listItem:focus-within Border.rowTools">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="StackPanel.todayRows Button.listRow.selected Border.rowTools">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!-- The detail line's pieces: Muted, or Ink / Faint / Drift; tags as Surface2 chips. -->
        <Style Selector="Border.bit">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.bit.chip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Padding" Value="8,1" />
        </Style>
        <Style Selector="Border.bit">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Border.bit.ink">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Border.bit.faint">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="Border.bit.drift">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <!-- Overdue: the shared amber pill (Themes/AbStyles.axaml Border.abPill.amber), with the pill's own padding. -->
        <Style Selector="Border.bit.abPill">
            <Setter Property="Padding" Value="7,0" />
        </Style>

        <Style Selector="Border.dragHandle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Width" Value="22" />
        </Style>
        <Style Selector="Border.dropLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- A step's letter chip ("b"): Surface2, muted, 11 DIP. -->
        <Style Selector="Border.letterChip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.letterChip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- "skipped": a quiet tag after a passed-over step (Grouped). -->
        <Style Selector="Border.skippedTag">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Row columns: the label slot is 92 wide. -->
        <Style Selector="Grid.rowGrid">
            <Setter Property="ColumnSpacing" Value="6" />
        </Style>
        <Style Selector="Panel.categorySlot">
            <Setter Property="Width" Value="92" />
        </Style>
        <Style Selector="StackPanel.rowText">
            <Setter Property="Margin" Value="0,7" />
        </Style>

        <!-- Compact rows (the section's "compact" class): 32 DIP, the title on one line, no detail line, no quick actions. -->
        <Style Selector=":is(Control).compact Button.listRow">
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector=":is(Control).compact StackPanel.rowText">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style Selector=":is(Control).compact TextBlock.rowTitle">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector=":is(Control).compact :is(Control).rowSub">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Control).compact StackPanel.quickActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- A narrow column: the label slot goes and the gaps shrink, so the title keeps its room. -->
        <ContainerQuery Name="TaskColumn" Query="max-width:520">
            <Style Selector="Grid.rowGrid">
                <Setter Property="ColumnSpacing" Value="3" />
            </Style>
            <Style Selector="StackPanel.rowToolsList">
                <Setter Property="Spacing" Value="3" />
            </Style>
            <Style Selector="Panel.categorySlot">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <StackPanel x:Name="RowRoot" Spacing="0">
        <Border Classes="dropLine" IsVisible="{Binding ShowsLineAbove}" Margin="8,0" />
        <!-- abMenuHost: the row gets an accent outline (Border.abMenuRing) while its menu is open (round 2, brief §3.6). -->
        <Panel Classes="listItem abMenuHost" Classes.now="{Binding IsNow}" ContextRequested="OnRowContextRequested" KeyDown="OnRowKeyDown">
            <!-- Round 2 (Today only, brief §4.2): the running row is tinted and outlined in the accent. -->
            <Border Classes="nowTint">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsNow" />
                        <Binding Path="$self.(views:TodayPageScope.IsToday)" />
                    </MultiBinding>
                </Border.IsVisible>
            </Border>
            <Border Classes="starTint" Opacity="0.75" IsVisible="{Binding ShowsHighlightTint}" />
            <Border Classes="tint" Opacity="0.16" IsVisible="{Binding IsPicked}" />
            <Border Classes="ring" IsVisible="{Binding IsPicked}" />
            <Button x:Name="RowButton" Classes="listRow" Classes.selected="{Binding IsSelected}" Classes.picked="{Binding IsPicked}" Click="OnRowClick"
                    AutomationProperties.Name="{Binding Title}">
                <Panel>
                <Border Classes="focusRing" />
                <Grid Classes="rowGrid" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,4,0">
                    <StackPanel Grid.Column="0" Classes="leadCell" Orientation="Horizontal" Spacing="6" MinWidth="22">
                        <Button Classes="leadDot" Click="OnCategoryClick" AutomationProperties.Name="Change label" ToolTip.Tip="{Binding LeadDotTip}"
                                IsVisible="{Binding $self.(views:TaskColumnScope.IsColumn)}" IsEnabled="{Binding CanLabel}">
                            <Panel Width="8" Height="8">
                                <Ellipse Fill="{Binding CategoryBrush}" IsVisible="{Binding ShowsLabelChip}" />
                                <Ellipse Stroke="{DynamicResource Ab.Faint}" StrokeThickness="1.2" IsVisible="{Binding !HasCategory}" />
                            </Panel>
                        </Button>
                        <TextBlock Classes="muted rowNumber" Text="{Binding Number}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="13" VerticalAlignment="Center"
                                   MinWidth="12" IsVisible="{Binding IsNumbered}" />
                        <CheckBox IsChecked="{Binding ShowsTicked, Mode=OneWay}" Command="{Binding ToggleCommand}" IsVisible="{Binding ShowsDoneTick}"
                                  MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Finish"
                                  ToolTip.Tip="Finish (untick to open it again)" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Classes="rowText" Spacing="2" VerticalAlignment="Center">
                        <DockPanel>
                            <mi:MaterialIcon DockPanel.Dock="Left" Kind="Star" Width="14" Height="14" Margin="0,0,5,0" Foreground="{DynamicResource Ab.AmberInk}"
                                             VerticalAlignment="Center" IsVisible="{Binding ShowsHighlightTint}" ToolTip.Tip="Highlighted" />
                            <Panel Classes="tasksOnly" DockPanel.Dock="Left">
                            <Button Classes="labelPill" Margin="0,0,6,0" IsVisible="{Binding ShowsLabelPillBefore}" Click="OnCategoryClick" AutomationProperties.Name="Change label" ToolTip.Tip="Change label">
                                <Panel>
                                    <Border Background="{Binding CategoryBrush}" Opacity="0.18" CornerRadius="999" />
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="7,1,8,1">
                                        <Ellipse Width="6" Height="6" Fill="{Binding CategoryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" MaxWidth="90" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Panel>
                            </Button>
                            </Panel>
                            <Border DockPanel.Dock="Left" Classes="letterChip" Margin="0,0,6,0" IsVisible="{Binding HasStepLetter}">
                                <TextBlock Text="{Binding StepLetter}" />
                            </Border>
                            <TextBlock Classes="rowTitle mainTitle" Classes.done="{Binding ShowsTicked}" Text="{Binding Title}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" />
                        </DockPanel>
                        <!-- Round 2 (Today only, owner fix after 0.1.132; boards B-PC-Idle / B-PC-Session): the details on one indented line
                             under the title: a step "↳ task · ● label · 142b", a task "● label · 25 min"; a missing part goes with its dot. The
                             amber Overdue pill and the sync-problem cloud still show; a step's ▾ (its live step list) on hover or focus. -->
                        <Panel Classes="todayOnly rowSub">
                            <DockPanel IsVisible="{Binding HasTodayLine}" AutomationProperties.Name="{Binding TodayLineText}">
                                <TextBlock DockPanel.Dock="Left" Classes="muted" Text="{Binding TodayParent}" FontSize="12" MaxWidth="260"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding HasTodayParent}" />
                                <TextBlock DockPanel.Dock="Left" Classes="muted" Text="·" FontSize="12" Margin="5,0" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowsTodayDotAfterParent}" />
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasTodayLabel}">
                                    <Ellipse Width="7" Height="7" Fill="{Binding TodayLabelBrush}" VerticalAlignment="Center" />
                                    <TextBlock Classes="muted" Text="{Binding TodayLabel}" FontSize="12" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" Classes="muted" Text="·" FontSize="12" Margin="5,0" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowsTodayDotBeforeTail}" />
                                <TextBlock DockPanel.Dock="Left" Classes="muted" Text="{Binding TodayTail}" FontSize="12" MaxWidth="280"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding HasTodayTail}" />
                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding TodayFlags}" IsVisible="{Binding HasTodayFlags}" Margin="8,0,0,0"
                                              VerticalAlignment="Center" ItemTemplate="{StaticResource RowBitTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button DockPanel.Dock="Left" Classes="rowTool onHover" Width="22" Height="20" Margin="2,0,0,0" Click="OnStepListClick"
                                        IsVisible="{Binding IsStepRow}" ToolTip.Tip="Its steps: tick, bring into focus, add"
                                        AutomationProperties.Name="Show the task's steps">
                                    <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                                </Button>
                                <Panel />
                            </DockPanel>
                        </Panel>
                        <Panel Classes="tasksOnly">
                        <TextBlock Classes="muted rowSub" Text="{Binding SubText}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ShowsSubText}" />
                        </Panel>
                        <!-- A focused step (Quiet view): "↳ task · ● label · 142b ▾", also in Compact; ▾ opens the live step list. -->
                        <Panel Classes="tasksOnly">
                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsStepRow}">
                            <TextBlock Classes="muted" Text="↳" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" Text="{Binding StepSourceTitle}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasStepSourceLabel}">
                                <TextBlock Classes="faint" Text="·" FontSize="12" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" Fill="{Binding StepSourceBrush}" VerticalAlignment="Center" />
                                <TextBlock Classes="muted" Text="{Binding StepSourceLabel}" FontSize="12" MaxWidth="70" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Classes="rowTool stepListButton" Width="NaN" Padding="4,0" Height="20" Click="OnStepListClick"
                                    ToolTip.Tip="Its steps: tick, bring into focus, add" AutomationProperties.Name="Show the task's steps">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Classes="muted" Text="{Binding StepSourceId}" FontSize="12" FontFamily="{DynamicResource Ab.NumeralFont}"
                                               VerticalAlignment="Center" IsVisible="{Binding HasStepSourceId}" />
                                    <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Panel>
                        <!-- Round 2 (Today only): the running task's steps open, with letters; a done step struck; "done" / "in focus" at the right. -->
                        <ItemsControl ItemsSource="{Binding NowSteps}" Margin="0,6,0,0">
                            <ItemsControl.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasNowSteps" />
                                    <Binding Path="$self.(views:TodayPageScope.IsToday)" />
                                </MultiBinding>
                            </ItemsControl.IsVisible>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodayNowStepViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" MinHeight="26">
                                        <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Command="{Binding ToggleCommand}" MinWidth="0" Padding="0"
                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" ToolTip.Tip="Finish this step (untick to open it again)" />
                                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Letter}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="rowTitle" Classes.done="{Binding IsDone}" Text="{Binding Title}" FontSize="13.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasNote}"
                                                   Classes.muted="{Binding IsDone}" Classes.done="{Binding IsDone}" Classes.inFocus="{Binding InFocus}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Grouped view: the task's steps under it. -->
                        <ItemsControl ItemsSource="{Binding StepLines}" IsVisible="{Binding HasStepLines}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionStepLineViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="24" Opacity="{Binding LineOpacity}">
                                        <TextBlock Classes="muted" Text="{Binding Number}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="12.5"
                                                   MinWidth="12" VerticalAlignment="Center" IsVisible="{Binding IsNumbered}" />
                                        <CheckBox IsChecked="False" Command="{Binding ToggleCommand}" IsVisible="{Binding CanToggle}" MinWidth="0" Padding="0"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Finish this step" ToolTip.Tip="Finish this step" />
                                        <Border Classes="letterChip" IsVisible="{Binding HasLetter}">
                                            <TextBlock Text="{Binding Letter}" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"
                                                   Classes.muted="{Binding IsSummary}" />
                                        <Border Classes="skippedTag" IsVisible="{Binding IsSkipped}">
                                            <TextBlock Classes="muted" Text="skipped" FontSize="11" />
                                        </Border>
                                        <Button Classes="rowTool" Width="22" Height="22" Command="{Binding FocusCommand}" IsVisible="{Binding CanFocus}"
                                                ToolTip.Tip="Bring into focus" AutomationProperties.Name="Bring this step into focus">
                                            <mi:MaterialIcon Kind="Target" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Panel Classes="tasksOnly">
                        <DockPanel Classes="rowSub">
                            <DockPanel.IsVisible>
                                <MultiBinding Converter="{x:Static views:TaskRowView.DetailLineShown}">
                                    <Binding Path="ShowsDetailLine" />
                                    <Binding Path="ShowsLabelChip" />
                                    <Binding Path="$self.(views:TaskColumnScope.IsColumn)" />
                                </MultiBinding>
                            </DockPanel.IsVisible>
                            <TextBlock DockPanel.Dock="Left" Classes="muted" Text="{Binding CategoryName}" FontSize="12" Margin="0,0,10,0" MaxWidth="120"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="ShowsLabelChip" />
                                        <Binding Path="$self.(views:TaskColumnScope.IsColumn)" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <Button Classes="labelPill" DockPanel.Dock="Left" Margin="0,0,10,0" IsVisible="{Binding ShowsLabelPillInDetails}" Click="OnCategoryClick" AutomationProperties.Name="Change label" ToolTip.Tip="Change label">
                                    <Panel>
                                        <Border Background="{Binding CategoryBrush}" Opacity="0.18" CornerRadius="999" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="7,1,8,1">
                                            <Ellipse Width="6" Height="6" Fill="{Binding CategoryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12" MaxWidth="90" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </Button>
                        <ItemsControl ItemsSource="{Binding Bits}" IsVisible="{Binding HasBits}" VerticalAlignment="Center" ItemTemplate="{StaticResource RowBitTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="10" LineSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </DockPanel>
                        </Panel>
                    </StackPanel>
                    <!-- The label chip (Label style Dot; a click opens the picker, the same as ⋯ › Label) or, on a row with none, the quiet "+ label". -->
                    <Panel Grid.Column="2" Classes="categorySlot" VerticalAlignment="Center">
                        <Button Classes="catChip" IsVisible="{Binding ShowsLabelChip}" Click="OnCategoryClick"
                                AutomationProperties.Name="Change label" ToolTip.Tip="Change label">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" VerticalAlignment="Center" />
                                <TextBlock Classes="muted" Text="{Binding CategoryName}" FontSize="12" MaxWidth="60" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="catChip onHover" IsVisible="{Binding ShowsAddCategory}" Click="OnCategoryClick"
                                AutomationProperties.Name="Add label" ToolTip.Tip="Add a label">
                            <TextBlock Classes="faint" Text="+ label" FontSize="12" VerticalAlignment="Center" />
                        </Button>
                    </Panel>
                    <!-- This session's time (number font), or "Now" on the running task; on Today the running task has a Now badge and keeps its time. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Classes="nowBadge" VerticalAlignment="Center">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsNow" />
                                    <Binding Path="$self.(views:TodayPageScope.IsToday)" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <TextBlock Text="Now" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Ab.OnAccent}" />
                        </Border>
                        <TextBlock Classes="muted" Text="Now" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsNow" />
                                    <Binding Path="!$self.(views:TodayPageScope.IsToday)" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                        <TextBlock Classes="muted" Text="{Binding TimeText}" FontFamily="{DynamicResource Ab.NumeralFont}" FontSize="12.5" VerticalAlignment="Center">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="HasTime" />
                                    <Binding Path="$self.(views:TodayPageScope.IsToday)" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </StackPanel>
                    <!-- The row's tools: the quick actions (hover: ← / the target, →), the open arrow, ⋯ and the drag handle (its 22 kept). In a
                         Shelf column they float over the end of the title on hover or focus instead of keeping their width (round 2 R3). -->
                    <Border Classes="rowTools">
                        <StackPanel Classes="rowToolsList" Orientation="Horizontal" Spacing="6">
                            <StackPanel Classes="quickActions onHover" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <Button Classes="rowTool" IsVisible="{Binding HasLeftAction}" Command="{Binding LeftAction.Command}"
                                        ToolTip.Tip="{Binding LeftAction.Tip}" AutomationProperties.Name="{Binding LeftAction.Tip}">
                                    <mi:MaterialIcon Kind="{Binding LeftAction.Icon}" Width="17" Height="17" />
                                </Button>
                                <Button Classes="rowTool" IsVisible="{Binding HasRightAction}" Command="{Binding RightAction.Command}"
                                        ToolTip.Tip="{Binding RightAction.Tip}" AutomationProperties.Name="{Binding RightAction.Tip}">
                                    <mi:MaterialIcon Kind="{Binding RightAction.Icon}" Width="17" Height="17" />
                                </Button>
                            </StackPanel>
                            <Button Classes="rowTool rowEnd" Click="OnOpenClick" ToolTip.Tip="{Binding OpenTip}" AutomationProperties.Name="{Binding OpenTip}">
                                <mi:MaterialIcon Kind="{Binding OpenIcon}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="rowTool rowEnd" AutomationProperties.Name="More actions"
                                    ToolTip.Tip="Rename, label, move, add a step, delete (or right-click the row)" Click="OnMoreClick">
                                <mi:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                            </Button>
                            <Panel Width="22">
                                <Border Classes="dragHandle onHover" IsVisible="{Binding ShowsDragHandle}"
                                        ToolTip.Tip="Drag to reorder or to another section (Alt+↑/↓)" AutomationProperties.Name="Drag to move"
                                        PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased"
                                        PointerCaptureLost="OnHandleCaptureLost">
                                    <mi:MaterialIcon Kind="DragVertical" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                                </Border>
                            </Panel>
                        </StackPanel>
                    </Border>
                </Grid>
                </Panel>
            </Button>
            <Border Classes="abMenuRing" />
        </Panel>
        <Border Classes="dropLine" IsVisible="{Binding ShowsLineBelow}" Margin="8,0" />
    </StackPanel>
</UserControl>
