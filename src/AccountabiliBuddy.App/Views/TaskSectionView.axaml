<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TaskSectionView"
             x:DataType="vm:TaskSectionViewModel">
    <!-- One section of a task panel: the header (chevron, icon or label dot, title, faint hint, pin; a Shelf bin's "+") folds it on a
         click and offers Expand all / Collapse all / Pinned open on a right-click; then its rows, or "Nothing to see here.". A quiet
         section (Queued, Reminders due today, Finished today) is faded as a whole and its title is faint. A Shelf group's header follows
         the shared section header rule (round 2, brief §3.4; Themes/AbStyles.axaml): 16.5 px bold title, 19 px icon, the count in a grey
         pill, and its "+" only on hover or keyboard focus. -->
    <UserControl.Styles>
        <Style Selector="Button.sectionHeader">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.sectionHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="StackPanel.quiet TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Opacity="{Binding Fade}" Classes.compact="{Binding IsCompact}" Spacing="2" Margin="0,4,0,2">
        <Grid Classes="abHoverHost" ColumnDefinitions="*,Auto" IsVisible="{Binding $parent[views:TaskSectionView].ShowsHeader}">
            <Button Classes="sectionHeader" Command="{Binding ToggleCommand}" ContextRequested="OnHeaderContextRequested"
                    AutomationProperties.Name="{Binding Title}" ToolTip.Tip="Click to fold or unfold · right-click for Expand all, Collapse all and Pinned open">
                <StackPanel Classes.quiet="{Binding IsQuiet}" Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="{Binding Chevron}" Width="18" Height="18" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                    <mi:MaterialIcon Kind="{Binding IconKind}" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}"
                                     VerticalAlignment="Center" IsVisible="{Binding ShowsSmallIcon}" />
                    <mi:MaterialIcon Classes="abSectionIcon" Kind="{Binding IconKind}" IsVisible="{Binding ShowsSectionIcon}" />
                    <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center" IsVisible="{Binding HasDot}" />
                    <TextBlock Classes.sectionTitle="{Binding !IsShelfGroup}" Classes.abSectionTitle="{Binding IsShelfGroup}" Text="{Binding Title}"
                               VerticalAlignment="Center" />
                    <TextBlock Classes="faint" Text="{Binding Hint}" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding ShowsHintText}" />
                    <Border Classes="abCountPill" IsVisible="{Binding ShowsCountPill}">
                        <TextBlock Text="{Binding Hint}" />
                    </Border>
                    <mi:MaterialIcon Kind="PinOutline" Width="13" Height="13" Foreground="{DynamicResource Ab.Faint}" VerticalAlignment="Center"
                                     IsVisible="{Binding ShowsPin}" ToolTip.Tip="Pinned open" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="quiet abHoverOnly" Padding="5" MinHeight="0" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding HasAdd}"
                    Command="{Binding BeginAddCommand}" ToolTip.Tip="{Binding AddTip}" AutomationProperties.Name="{Binding AddTip}">
                <mi:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="{DynamicResource Ab.Faint}" />
            </Button>
        </Grid>

        <!-- The "+" box: the add box preset to this bin; Enter adds a task and keeps the box for the next; Esc or leaving it empty closes it. -->
        <views:AddBoxView DataContext="{Binding AddBox}" IsVisible="{Binding $parent[views:TaskSectionView].((vm:TaskSectionViewModel)DataContext).IsAdding, FallbackValue=False}"
                          Margin="28,0,6,4" ZIndex="1" />

        <!-- The rows are one Tab stop (roving focus, 13k): Tab lands on the row last used (else the first), ↑/↓ move inside. -->
        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowsRows}" KeyboardNavigation.TabNavigation="Once">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskListRowViewModel">
                    <views:TaskRowView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="faint" Text="{Binding EmptyText}" FontSize="13" Margin="30,2,0,6" IsVisible="{Binding ShowsEmpty}" />
        <!-- A row dragged over the section's header or empty space: it would go at the end of this section. -->
        <Border Height="2" CornerRadius="1" Margin="8,0" Background="{DynamicResource Ab.Accent}" IsHitTestVisible="False"
                IsVisible="{Binding IsDropTarget}" />
    </StackPanel>
</UserControl>
