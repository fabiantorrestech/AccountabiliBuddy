<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
             xmlns:views="using:AccountabiliBuddy.App.Views"
             x:Class="AccountabiliBuddy.App.Views.TaskSectionView"
             x:DataType="vm:TaskSectionViewModel">
    <!-- One section of a task panel: the header (chevron, icon or label dot, title, faint hint, pin; a Shelf bin's "+") folds it on a
         click and offers Expand all / Collapse all / Pinned open on a right-click; then its rows, or "Nothing to see here.". A quiet
         section (Queued, Reminders due today, Finished today) is faded as a whole and its title is faint. A Shelf group's header follows
         the shared section header rule (round 2, brief §3.4; Themes/AbStyles.axaml): 16.5 px bold title, 19 px icon, the count in a grey
         pill, and its "+" only on hover or keyboard focus. -->
    <UserControl.Styles>
        <Style Selector="Button.sectionHeader">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.sectionHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <!-- 7.39: the hand-off box's button. -->
        <Style Selector="Button.handOff">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.handOff /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.handOff:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="StackPanel.quiet TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="mi|MaterialIcon.chevron">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <!-- Today (round 2, owner fix after 0.1.132; boards B-PC-Idle / B-PC-Session; TodayView marks its list "todayRows"): "This session"
             in 13 semibold muted with its "3 ready · 60 min", no chevron or pin; the folded sections in 13 muted with a small ›, their
             count after the name, no icon. -->
        <Style Selector="StackPanel.todayRows mi|MaterialIcon.chevron">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="StackPanel.todayRows StackPanel.session mi|MaterialIcon.chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.pinSlot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.todayRows Panel.smallIconSlot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.todayRows TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="StackPanel.todayRows StackPanel.quiet TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="StackPanel.todayRows StackPanel.quiet TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Opacity="{Binding Fade}" Classes.compact="{Binding IsCompact}" Spacing="2" Margin="0,4,0,2">
        <Grid Classes="abHoverHost" ColumnDefinitions="*,Auto" IsVisible="{Binding $parent[views:TaskSectionView].ShowsHeader}">
            <Button Classes="sectionHeader" Command="{Binding ToggleCommand}" ContextRequested="OnHeaderContextRequested"
                    AutomationProperties.Name="{Binding Title}" ToolTip.Tip="Click to fold or unfold · right-click for Expand all, Collapse all and Pinned open">
                <StackPanel Classes.quiet="{Binding IsQuiet}" Classes.session="{Binding IsSessionSection}" Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Classes="chevron" Kind="{Binding Chevron}" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center" />
                    <Panel Classes="smallIconSlot" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="{Binding IconKind}" Width="15" Height="15" Foreground="{DynamicResource Ab.Muted}"
                                         VerticalAlignment="Center" IsVisible="{Binding ShowsSmallIcon}" />
                    </Panel>
                    <mi:MaterialIcon Classes="abSectionIcon" Kind="{Binding IconKind}" IsVisible="{Binding ShowsSectionIcon}" />
                    <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center" IsVisible="{Binding HasDot}" />
                    <TextBlock Classes.sectionTitle="{Binding !IsShelfGroup}" Classes.abSectionTitle="{Binding IsShelfGroup}" Text="{Binding Title}"
                               VerticalAlignment="Center" />
                    <TextBlock Classes="faint hint" Text="{Binding Hint}" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding ShowsHintText}" />
                    <Border Classes="abCountPill" IsVisible="{Binding ShowsCountPill}">
                        <TextBlock Text="{Binding Hint}" />
                    </Border>
                    <Panel Classes="pinSlot" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="PinOutline" Width="13" Height="13" Foreground="{DynamicResource Ab.Faint}" VerticalAlignment="Center"
                                         IsVisible="{Binding ShowsPin}" ToolTip.Tip="Pinned open" />
                    </Panel>
                </StackPanel>
            </Button>
            <!-- A Shelf bin's "+" shows on hover; This session's always shows (owner, AB-Improvements #35). -->
            <Button Grid.Column="1" Classes="quiet" Classes.abHoverOnly="{Binding !IsSessionSection}" Padding="5" MinHeight="0" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding HasAdd}"
                    Command="{Binding BeginAddCommand}" ToolTip.Tip="{Binding AddTip}" AutomationProperties.Name="{Binding AddTip}">
                <mi:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="{DynamicResource Ab.Faint}" />
            </Button>
        </Grid>

        <!-- The "+" box: the add box preset to this bin; Enter adds a task and keeps the box for the next; Esc or leaving it empty closes it. -->
        <views:AddBoxView DataContext="{Binding AddBox}" IsVisible="{Binding $parent[views:TaskSectionView].((vm:TaskSectionViewModel)DataContext).IsAdding, FallbackValue=False}"
                          Margin="28,0,6,4" ZIndex="1" />

        <!-- The rows are one Tab stop (roving focus, 13k): Tab lands on the row last used (else the first), ↑/↓ move inside. -->
        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowsRows}" KeyboardNavigation.TabNavigation="Once">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskListRowViewModel">
                    <views:TaskRowView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="faint" Text="{Binding EmptyText}" FontSize="13" Margin="30,2,0,6">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="ShowsEmpty" />
                    <Binding Path="!$self.(views:TaskColumnScope.IsColumn)" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <!-- In a Shelf column (Tasks redesign 4c.21, 4b.15, 4c.51): styled by the column (TaskColumnView's TextBlock.sectionEmpty). -->
        <TextBlock Classes="sectionEmpty" Text="{Binding EmptyText}">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="ShowsEmptyLine" />
                    <Binding Path="$self.(views:TaskColumnScope.IsColumn)" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <!-- Tasks redesign 7.37-7.39: nothing on the Shelf matches the search: the first column's dashed box (1 px dashed Line3, radius 12,
             padding 14 16, margin 4 8, 10 apart): the line, "Search the Archive for “…”" (34 high, padding 0 14, radius 999, Surface2,
             1 px Line2, ArchiveOutline 16, 13 px), "Your filters come along too." (12 px Muted). -->
        <Panel Margin="8,4" IsVisible="{Binding ShowsHandOff}">
            <Rectangle Stroke="{DynamicResource Ab.Line3}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="12" RadiusY="12" IsHitTestVisible="False" />
            <StackPanel Margin="16,14" Spacing="10">
                <TextBlock Text="{Binding HandOffTitle}" FontSize="13.5" Foreground="{DynamicResource Ab.Ink}" TextWrapping="Wrap" />
                <Button Classes="handOff" Command="{Binding HandOffCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding HandOffButtonText}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ArchiveOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HandOffButtonText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Your filters come along too." FontSize="12" Foreground="{DynamicResource Ab.Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </Panel>
        <!-- A row dragged over the section's header or empty space: it would go at the end of this section. -->
        <Border Height="2" CornerRadius="1" Margin="8,0" Background="{DynamicResource Ab.Accent}" IsHitTestVisible="False"
                IsVisible="{Binding IsDropTarget}" />
    </StackPanel>
</UserControl>
