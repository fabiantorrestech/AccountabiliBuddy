<Application xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AccountabiliBuddy.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AccountabiliBuddy.App/Themes/FluentOverrides.axaml" />
                <ResourceInclude Source="avares://AccountabiliBuddy.App/Themes/Instrument.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <mi:MaterialIconStyles />
        <StyleInclude Source="avares://AccountabiliBuddy.App/Themes/AbStyles.axaml" />
    </Application.Styles>
</Application>
