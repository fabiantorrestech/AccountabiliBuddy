<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AccountabiliBuddy.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AccountabiliBuddy"
        Icon="/Assets/app-icon.png"
        Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ab.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <!-- The rail's items (design 5x/6d): a Material icon over a label. Muted; the chosen one is Ink and SemiBold on a
             56 x 32 Surface2 pill; hover is Surface2. Never the accent. -->
        <Style Selector="controls|RailButton">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Background="Transparent" Spacing="4" HorizontalAlignment="Center">
                        <Border x:Name="Pill" Width="56" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                            <mi:MaterialIcon Kind="{TemplateBinding Icon}" Width="22" Height="22" Foreground="{TemplateBinding Foreground}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|RailButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="controls|RailButton:pointerover /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="controls|RailButton:selected">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="controls|RailButton:selected /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="controls|RailButton:focus-visible /template/ Border#Pill">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
        </Style>
        <!-- "N resting": a quiet lock and label, no pill until hovered. -->
        <Style Selector="controls|RailButton.resting">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="controls|RailButton.resting /template/ Border#Pill">
            <Setter Property="Height" Value="26" />
        </Style>

        <!-- The title bar's buttons: quiet, muted icons. -->
        <Style Selector="Button.titleIcon">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.titleIcon:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <!-- The window's own caption buttons, 46 x 34 (design 5x). Their roles make Windows treat them as the real ones
             (minimize, maximize with snap layouts, close); a click is the system's, not a command of ours. -->
        <Style Selector="Button.caption">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        </Style>
        <!-- Busy: the sync icon spins while a sync runs. -->
        <Style Selector="Button.busy mi|MaterialIcon">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The sync light (design 20a): green = all in step; lilac = 2+ devices over an hour old; red = this device can't sync. -->
        <Style Selector="Ellipse.syncDot">
            <Setter Property="Fill" Value="{DynamicResource Ab.Met}" />
        </Style>
        <Style Selector="Ellipse.syncDot.sleep">
            <Setter Property="Fill" Value="{DynamicResource Ab.Sleep}" />
        </Style>
        <Style Selector="Ellipse.syncDot.drift">
            <Setter Property="Fill" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <Style Selector="mi|MaterialIcon.deviceGlyph">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="mi|MaterialIcon.deviceGlyph.dim">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.deviceName.dim">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="FlyoutPresenter.syncPopover">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.CardRadius}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
    </Window.Styles>
    <Panel>
        <Grid RowDefinitions="34,Auto,*">
            <!-- Title bar, 34 tall (design 5x): the app name, the sync light, the sync button and the search magnifier; the
                 system's own minimize / maximize / close buttons stay at the right (snap layouts and all). The empty part
                 drags the window and a double click maximizes it. -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Ab.Bg}" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <TextBlock Text="AccountabiliBuddy" FontSize="12" Foreground="{DynamicResource Ab.Muted}" VerticalAlignment="Center"
                           Margin="18,0,0,0" IsHitTestVisible="False" />
                <!-- Only with another device linked: a dot and one glyph per device. Hover or click for each device's last sync. -->
                <Button x:Name="SyncLightButton" Grid.Column="1" Classes="quiet titleIcon" Padding="10,0" Margin="0,0,2,0"
                        chrome:WindowDecorationProperties.ElementRole="User"
                        IsVisible="{Binding SyncLight.IsVisible, FallbackValue=False}" AutomationProperties.Name="Sync status"
                        ToolTip.Tip="Sync status: hover or click for each device">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard" FlyoutPresenterClasses="syncPopover">
                            <StackPanel x:Name="SyncPopover" Spacing="10" x:DataType="vm:MainWindowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse Classes="syncDot" Width="7" Height="7" Classes.sleep="{Binding SyncLight.IsSeveralBehind}"
                                                 Classes.drift="{Binding SyncLight.IsOffline}" IsVisible="{Binding SyncLight.IsDotSolid}" />
                                        <Ellipse Width="7" Height="7" Stroke="{DynamicResource Ab.Met}" StrokeThickness="1.5" IsVisible="{Binding SyncLight.IsSyncing}" />
                                    </Panel>
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding SyncLight.SummaryText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SyncLight.Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SyncLightDeviceViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,5">
                                                <mi:MaterialIcon Classes="deviceGlyph" Classes.dim="{Binding IsDim}" Kind="{Binding Icon}" Width="18" Height="18" />
                                                <TextBlock Grid.Column="1" Classes="deviceName" Classes.dim="{Binding IsDim}" Text="{Binding Name}" Foreground="{DynamicResource Ab.Ink}" />
                                                <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding AgoText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel ItemSpacing="4" LineSpacing="2">
                                    <Button Classes="quiet" Command="{Binding RefreshNowCommand}" Content="Sync now" FontWeight="SemiBold" />
                                    <Button Classes="quiet" Command="{Binding OpenDevicesAndSyncCommand}" Content="Devices &amp; sync" />
                                    <Button Classes="quiet" Command="{Binding ShowSyncQrCodesCommand}" IsVisible="{Binding ShowsQrButton}"
                                            ToolTip.Tip="Show today's QR codes for your phone to scan">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="QrcodeScan" Width="16" Height="16" />
                                            <TextBlock Text="Add a device" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Panel Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse Classes="syncDot" Width="7" Height="7" Classes.sleep="{Binding SyncLight.IsSeveralBehind}"
                                     Classes.drift="{Binding SyncLight.IsOffline}" IsVisible="{Binding SyncLight.IsDotSolid}" />
                            <Ellipse Width="7" Height="7" Stroke="{DynamicResource Ab.Met}" StrokeThickness="1.5" IsVisible="{Binding SyncLight.IsSyncing}" />
                        </Panel>
                        <ItemsControl ItemsSource="{Binding SyncLight.Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SyncLightDeviceViewModel">
                                    <mi:MaterialIcon Classes="deviceGlyph" Classes.dim="{Binding IsDim}" Kind="{Binding Icon}" Width="13" Height="13" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Button>
                <!-- Sync now and reload everything, for a manual check that all is in step (Ctrl+R). The divider sits at the left edge of the
                     button's own cell; centred, it drew a line through the icon. -->
                <Border Grid.Column="2" Width="1" Height="16" Background="{DynamicResource Ab.Line}" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsVisible="{Binding SyncLight.IsVisible, FallbackValue=False}" />
                <Button Grid.Column="2" Classes="quiet titleIcon" Width="44" Command="{Binding RefreshNowCommand}" ToolTip.Tip="{Binding RefreshTip}"
                        chrome:WindowDecorationProperties.ElementRole="User"
                        AutomationProperties.Name="Refresh and sync now" Classes.busy="{Binding IsRefreshing}">
                    <mi:MaterialIcon Kind="Sync" Width="15" Height="15" RenderTransformOrigin="50%,50%">
                        <mi:MaterialIcon.RenderTransform>
                            <RotateTransform />
                        </mi:MaterialIcon.RenderTransform>
                    </mi:MaterialIcon>
                </Button>
                <Button x:Name="SearchButton" Grid.Column="3" Classes="quiet titleIcon" Width="44" Command="{Binding OpenSearchCommand}"
                        chrome:WindowDecorationProperties.ElementRole="User"
                        ToolTip.Tip="Search (Ctrl+F)" AutomationProperties.Name="Search">
                    <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
                </Button>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Classes="caption" chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                            AutomationProperties.Name="Minimize">
                        <mi:MaterialIcon Kind="Minus" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="caption" chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                            AutomationProperties.Name="Maximize">
                        <mi:MaterialIcon x:Name="MaximizeIcon" Kind="CropSquare" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption close" chrome:WindowDecorationProperties.ElementRole="CloseButton"
                            AutomationProperties.Name="Close">
                        <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Banners: a soft wash of the Drift / Waiting colour, a bar of it on the left, Ink text. Full width under the title bar. -->
            <StackPanel Grid.Row="1">
                <Panel IsVisible="{Binding HasLoadError}">
                    <Border Background="{DynamicResource Ab.Drift}" Opacity="0.16" />
                    <Border BorderBrush="{DynamicResource Ab.Drift}" BorderThickness="3,0,0,0" Padding="16,10">
                        <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Ink}" />
                    </Border>
                </Panel>
                <Panel IsVisible="{Binding HasClockNotice}">
                    <Border Background="{DynamicResource Ab.Waiting}" Opacity="0.16" />
                    <Border BorderBrush="{DynamicResource Ab.Waiting}" BorderThickness="3,0,0,0" Padding="16,10">
                        <TextBlock Text="{Binding ClockNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Ink}" />
                    </Border>
                </Panel>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="76,*">
                <!-- The rail, 76 wide: Today, Tasks, Plan, Stats at the top; "N resting" (while a session runs) and Settings at the
                     bottom. Every item shows in a session too: the locks stay where they were. -->
                <Grid Background="{DynamicResource Ab.Bg}" RowDefinitions="Auto,*,Auto" Margin="0,10,0,20">
                    <StackPanel Spacing="14">
                        <controls:RailButton Label="Today" Icon="CalendarToday" IsSelected="{Binding IsTodaySelected}" AutomationProperties.Name="Today"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Today}" />
                        <controls:RailButton Label="Tasks" Icon="FormatListChecks" IsSelected="{Binding IsTasksSelected}" AutomationProperties.Name="Tasks"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Tasks}" />
                        <controls:RailButton Label="Plan" Icon="ViewAgendaOutline" IsSelected="{Binding IsPlanSelected}" AutomationProperties.Name="Plan"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Plan}" />
                        <controls:RailButton Label="Stats" Icon="ChartTimelineVariant" IsSelected="{Binding IsStatsSelected}" AutomationProperties.Name="Stats"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Stats}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="14" VerticalAlignment="Bottom">
                        <controls:RailButton Classes="resting" Label="{Binding RestingText}" Icon="LockOutline" IsVisible="{Binding ShowsResting}"
                                             AutomationProperties.Name="Resting while you focus" Command="{Binding OpenGuardsCommand}"
                                             ToolTip.Tip="Guards that are view-only while you focus; open them" />
                        <controls:RailButton Label="Activity" Icon="Bug" IsSelected="{Binding IsActivitySelected}" AutomationProperties.Name="Activity (dev)"
                                             IsVisible="{Binding ShowDevTools}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Activity}" />
                        <controls:RailButton Label="Settings" Icon="Cog" IsSelected="{Binding IsSettingsSelected}" AutomationProperties.Name="Settings"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Settings}" />
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Column="1">
                    <!-- The pages sit side by side; switching only shows or hides them. A TabControl takes a page out of the window
                         and puts it back on every switch, which rebuilds every control on it (hundreds of ms on Profiles or Settings);
                         a hidden page costs nothing. Same order as MainTab. -->
                    <Grid Margin="0,10,20,20">
                        <Panel x:Name="Pages">
                            <views:TodayView DataContext="{Binding Session}" />
                            <views:TasksView DataContext="{Binding Tasks}" IsVisible="False" />
                            <views:PlanView DataContext="{Binding Plan}" IsVisible="False" />
                            <views:StatsView DataContext="{Binding Stats}" IsVisible="False" />
                            <views:SettingsShellView IsVisible="False" />
                            <views:ActivityView DataContext="{Binding Activity}" IsVisible="False" />
                        </Panel>
                        <!-- Search matches on the page showing, drawn over it without taking clicks. -->
                        <controls:SearchHighlightLayer x:Name="Highlights" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Search: opened by Ctrl+F or the title bar's magnifier, under the title bar and over the page; Esc closes it. -->
        <Border x:Name="SearchFlyout" IsVisible="{Binding IsSearchOpen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,38,20,0"
                Padding="10" CornerRadius="{DynamicResource Ab.CardRadius}" Background="{DynamicResource Ab.Surface}" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" ZIndex="20">
            <views:SearchBox x:Name="Search" DataContext="{Binding Search}" />
        </Border>

        <!-- Leaving Settings (or closing the window) with unsaved changes. -->
        <Border IsVisible="{Binding ShowsLeavePrompt}" Background="#99000000" ZIndex="30">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20,16"
                    CornerRadius="{DynamicResource Ab.CardRadius}" Background="{DynamicResource Ab.Surface}"
                    BorderBrush="{DynamicResource Ab.Line}" BorderThickness="{DynamicResource Ab.CardBorderThickness}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Unsaved settings" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="You changed settings without saving them. Save them before you go?" TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Stay" Command="{Binding StayCommand}" />
                        <Button Content="Discard" Command="{Binding DiscardAndLeaveCommand}" />
                        <Button Content="Save" Command="{Binding SaveAndLeaveCommand}" Classes="primary" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
