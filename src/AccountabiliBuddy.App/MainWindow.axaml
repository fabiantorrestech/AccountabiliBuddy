<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AccountabiliBuddy.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource Ab.BrandName}"
        Icon="/Assets/app-icon.png"
        Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ab.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <!-- The rail's items (Tasks redesign 03 §A): 60 wide, a Material icon on a 44 x 30 pill over an 11.5 label. Muted; the
             chosen one is Ink and SemiBold on a Surface2 pill; hover is Surface2. Never the accent. -->
        <Style Selector="controls|RailButton">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Width" Value="60" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Background="Transparent" Spacing="3" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}">
                        <Border x:Name="Pill" Width="44" Height="30" CornerRadius="15" Background="Transparent" HorizontalAlignment="Center">
                            <mi:MaterialIcon Kind="{TemplateBinding Icon}" Width="20" Height="20" Foreground="{TemplateBinding Foreground}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|RailButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="controls|RailButton:pointerover /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="controls|RailButton:selected">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="controls|RailButton:selected /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="controls|RailButton:focus-visible /template/ Border#Pill">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
        </Style>
        <!-- "N resting": a quiet lock and label, no pill until hovered. -->
        <Style Selector="controls|RailButton.resting">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="controls|RailButton.resting /template/ Border#Pill">
            <Setter Property="Height" Value="26" />
        </Style>

        <!-- The title bar's buttons: quiet, muted icons. -->
        <Style Selector="Button.titleIcon">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Muted}" />
        </Style>
        <Style Selector="Button.titleIcon:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <!-- The 1 px lines between the title bar's groups (round 2, brief §3.2: the LN line token, 16 tall, 6-10 margin). -->
        <Style Selector="Border.titleDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <!-- The swipe bubble (NAV2): a 44 round bubble with a chevron at the page's edge while a two-finger swipe builds up; Surface with a Line
             edge, the accent at the threshold, Faint while there is nowhere to go. Never takes the mouse. -->
        <Style Selector="ContentControl#SwipeBubble">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="ContentControl#SwipeBubble.filled">
            <Setter Property="Background" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        </Style>
        <Style Selector="ContentControl#SwipeBubble.greyed">
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <!-- Back / forward (owner 2026-11-14), at the far left of the title bar: quiet 28 x 32 chevrons, Ink while there is somewhere to go,
             Faint (greyed) while not, like a browser's. -->
        <Style Selector="Button.titleNav">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.titleNav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.titleNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.titleNav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.titleNav:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Faint}" />
        </Style>
        <Style Selector="Button.titleNav:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
        </Style>
        <!-- The window's own caption buttons, 46 x 40 (Tasks redesign 03 §A). Their roles make Windows treat them as the real ones
             (minimize, maximize with snap layouts, close); a click is the system's, not a command of ours. -->
        <Style Selector="Button.caption">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ab.OnAccent}" />
        </Style>
        <!-- The title-bar menu's button (Tasks redesign 9.02): 36 x 32, radius 10, a magnifier in Ink; transparent, Line while its menu is open. -->
        <Style Selector="Button.titleMenu">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.titleMenu /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.titleMenu:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.titleMenu:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Ab.Ink}" />
        </Style>
        <Style Selector="Button.titleMenu.open /template/ ContentPresenter#PART_ContentPresenter, Button.titleMenu.open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ab.Line}" />
        </Style>
        <Style Selector="Button.titleMenu:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource Ab.FocusRing}" />
        </Style>
        <Style Selector=":is(Window).motionOn Button.titleMenu /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <!-- The menu's dropdown appears over 0.16 s (9.04; Animations on). -->
        <Style Selector=":is(Window).motionOn views|TitleMenuView#TitleMenu">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- The sync dot on the menu's button (design 20a; 9.03): Met = all in step; Sleep = 2+ devices over an hour old; Drift = this PC can't sync. -->
        <Style Selector="Ellipse.syncDot">
            <Setter Property="Fill" Value="{DynamicResource Ab.Met}" />
        </Style>
        <Style Selector="Ellipse.syncDot.sleep">
            <Setter Property="Fill" Value="{DynamicResource Ab.Sleep}" />
        </Style>
        <Style Selector="Ellipse.syncDot.drift">
            <Setter Property="Fill" Value="{DynamicResource Ab.Drift}" />
        </Style>
        <!-- The lunch chip (LU1b): a quiet pill with the lunch's time left and its ✕. -->
        <Style Selector="Border.titleChip">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,1,3,1" />
        </Style>
        <!-- Compact (the title bar's layout sets it when the window is too narrow for the session control): the words give way, the short time stays. -->
        <Style Selector="Border.titleChip TextBlock.chipShort">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.titleChip.compact TextBlock.chipLong">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.titleChip.compact TextBlock.chipShort">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.titleChip.compact">
            <Setter Property="Padding" Value="7,1,3,1" />
        </Style>
        <Style Selector="FlyoutPresenter.syncPopover">
            <Setter Property="Background" Value="{DynamicResource Ab.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ab.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Ab.CardRadius}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
    </Window.Styles>
    <Panel x:Name="Root">
        <Grid RowDefinitions="40,Auto,*">
            <!-- Title bar, 40 tall (round 2, brief §3.2; owner 2026-11-14): at the left back / forward │ the app name, the PB pill
                 (ProductaBuddy mode only) │ the noise control; at the right the session control (it keeps room on its left where its
                 extras open, so nothing moves), then the title-bar menu's button with the sync dot (Tasks redesign 9: search, sync and
                 appearance; it replaced the sync light, Sync now, light/dark and Search), then the window's own minimize / maximize / close
                 (snap layouts and all). The empty part drags the window and a double click maximizes it. Only one title-bar pop-up is open
                 at a time (MainWindow.axaml.cs). -->
            <controls:TitleBarLayout x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Ab.Bg}"
                                     chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <!-- In a narrow window the sound name gives way first, down to a short name (204 = the pill without its name + a 48 wide
                     name box, enough for the headphones notice), then the app name, and last the rest of the sound name (156 = the pill
                     without its name); back / forward and the noise buttons keep their size (owner 2026-11-14). -->
                <controls:GiveWayPanel x:Name="TitleBarStart" controls:TitleBarLayout.Slot="Start" Margin="8,0,10,0" VerticalAlignment="Center">
                    <!-- Back / forward (owner 2026-11-14): always here, greyed while there is nowhere to go (Alt+← / Alt+→, the mouse's
                         back / forward buttons, a touchpad's two-finger swipe). ‹ › chevrons like a browser's (NAV2). -->
                    <StackPanel x:Name="NavButtons" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Classes="titleNav" Command="{Binding GoBackCommand}" chrome:WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Back · Alt+←" AutomationProperties.Name="Back">
                            <mi:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
                        </Button>
                        <Button x:Name="ForwardButton" Classes="titleNav" Command="{Binding GoForwardCommand}" chrome:WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Forward · Alt+→" AutomationProperties.Name="Forward">
                            <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                    <Border Classes="titleDivider" Height="18" Margin="8,0,10,0" controls:GiveWayPanel.IsDivider="True" />
                    <TextBlock controls:GiveWayPanel.Order="2" controls:GiveWayPanel.HideBelow="44" Text="{DynamicResource Ab.BrandName}" FontSize="12" Foreground="{DynamicResource Ab.Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <!-- Not hit-testable, so it drags the window like the name; its name is read out instead of a tooltip. -->
                    <Border x:Name="ModePill" IsVisible="{Binding IsProductaBuddy}" IsHitTestVisible="False" CornerRadius="999"
                            Padding="8,1" Margin="8,0,0,0" BorderBrush="{DynamicResource Ab.Line}" BorderThickness="1" Background="{DynamicResource Ab.Surface}"
                            VerticalAlignment="Center" AutomationProperties.Name="ProductaBuddy mode">
                        <TextBlock Text="PB" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Ab.Accent}" />
                    </Border>
                    <Border Classes="titleDivider" Height="18" Margin="10,0" IsVisible="{Binding HasNoisePlayer}" controls:GiveWayPanel.IsDivider="True" />
                    <Panel controls:GiveWayPanel.Order="1" MinWidth="156" controls:GiveWayPanel.FirstMinWidth="204" IsVisible="{Binding HasNoisePlayer}"
                           VerticalAlignment="Center">
                        <views:TitleBarNoiseView x:Name="NoiseControl" DataContext="{Binding Session.NoisePlayer}"
                                                 chrome:WindowDecorationProperties.ElementRole="User" />
                    </Panel>
                </controls:GiveWayPanel>

                <!-- The lunch chip (LU1b, ADR 88): only while lunch runs, left of the session control: "Lunch · 42 min left" and a ✕ that opens
                     "End lunch?" (Count it / Discard it / Keep going) in a pop-up. It is not a part of the idle bar, so nothing moves without lunch. -->
                <Border x:Name="LunchChip" controls:TitleBarLayout.Slot="End" controls:TitleBarLayout.CompactsFirst="True" Classes="titleChip" Margin="0,0,8,0" VerticalAlignment="Center"
                        IsVisible="{Binding Session.Lunch.IsOnLunch, FallbackValue=False}" ToolTip.Tip="{Binding Session.Lunch.ChipTipText, FallbackValue=''}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="SilverwareForkKnife" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Muted}" />
                        <TextBlock Classes="chipLong" Text="{Binding Session.Lunch.ChipText, FallbackValue=''}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Ink}" />
                        <TextBlock Classes="chipShort" Text="{Binding Session.Lunch.ChipShortText, FallbackValue=''}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Ab.Ink}" />
                        <Button x:Name="LunchChipEndButton" Classes="quiet titleIcon" Width="24" Height="24" Padding="0" MinHeight="0" MinWidth="0"
                                chrome:WindowDecorationProperties.ElementRole="User" AutomationProperties.Name="End lunch"
                                ToolTip.Tip="End lunch: count it, discard it or keep going">
                            <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard" FlyoutPresenterClasses="syncPopover">
                                    <views:LunchEndPromptView x:Name="LunchChipPrompt" DataContext="{Binding Session.Lunch.TitleBarPrompt}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Start session / ring timer / Away / Ended (Ctrl+Shift+S starts): right, next to the title-bar menu (owner 2026-11-14; Tasks redesign 9). -->
                <views:SessionControlView x:Name="SessionControl" controls:TitleBarLayout.Slot="End" DataContext="{Binding SessionControl}"
                                          chrome:WindowDecorationProperties.ElementRole="User" />

                <StackPanel x:Name="TitleBarEnd" controls:TitleBarLayout.Slot="End" Orientation="Horizontal">
                    <!-- The title-bar menu (Tasks redesign 9): a click (or Ctrl+F off the Tasks page) opens the dropdown with the caret in its
                         search. The sync dot sits on its top-right, 5 from the top and 6 from the right, with a 2 px ring of the title bar's ground;
                         a hollow ring while a sync runs. It shows as the sync light did (another device linked; Settings › Devices & sync › Sync light). -->
                    <Button x:Name="TitleMenuButton" Classes="titleMenu" Margin="12,0,8,0" x:DataType="vm:TitleMenuViewModel"
                            chrome:WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{Binding ButtonTip}"
                            AutomationProperties.Name="{x:Static vm:TitleMenuViewModel.AccessibleName}">
                        <Panel>
                            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Panel Width="12" Height="12" Margin="0,3,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                   IsVisible="{Binding Sync.IsVisible, FallbackValue=False}">
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource Ab.Bg}" />
                                <Ellipse Classes="syncDot" Width="8" Height="8" Classes.sleep="{Binding Sync.IsSeveralBehind, FallbackValue=False}"
                                         Classes.drift="{Binding Sync.IsOffline, FallbackValue=False}" IsVisible="{Binding Sync.IsDotSolid, FallbackValue=True}" />
                                <Ellipse Width="8" Height="8" Stroke="{DynamicResource Ab.Met}" StrokeThickness="1.5" IsVisible="{Binding Sync.IsSyncing, FallbackValue=False}" />
                            </Panel>
                        </Panel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Classes="caption" chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                                AutomationProperties.Name="Minimize">
                            <mi:MaterialIcon Kind="Minus" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="MaximizeButton" Classes="caption" chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                                AutomationProperties.Name="Maximize">
                            <mi:MaterialIcon x:Name="MaximizeIcon" Kind="CropSquare" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="CloseButton" Classes="caption close" chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                AutomationProperties.Name="Close">
                            <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </controls:TitleBarLayout>

            <!-- Banners: a soft wash of the Drift / Waiting colour, a bar of it on the left, Ink text. Full width under the title bar. -->
            <StackPanel Grid.Row="1">
                <Panel IsVisible="{Binding HasLoadError}">
                    <Border Background="{DynamicResource Ab.Drift}" Opacity="0.16" />
                    <Border BorderBrush="{DynamicResource Ab.Drift}" BorderThickness="3,0,0,0" Padding="16,10">
                        <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Ink}" />
                    </Border>
                </Panel>
                <Panel IsVisible="{Binding HasClockNotice}">
                    <Border Background="{DynamicResource Ab.Waiting}" Opacity="0.16" />
                    <Border BorderBrush="{DynamicResource Ab.Waiting}" BorderThickness="3,0,0,0" Padding="16,10">
                        <TextBlock Text="{Binding ClockNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Ab.Ink}" />
                    </Border>
                </Panel>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="72,*">
                <!-- The rail, 72 wide (60-wide items): Today, Tasks, Plan, Stats, Goals at the top; "N resting" (while a session runs) and Settings at the
                     bottom. Every item shows in a session too: the locks stay where they were. -->
                <Grid Background="{DynamicResource Ab.Bg}" RowDefinitions="Auto,*,Auto" Margin="0,10,0,20">
                    <StackPanel Spacing="6">
                        <controls:RailButton Label="Today" Icon="CalendarToday" IsSelected="{Binding IsTodaySelected}" AutomationProperties.Name="Today"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Today}" />
                        <controls:RailButton Label="Tasks" Icon="FormatListChecks" IsSelected="{Binding IsTasksSelected}" AutomationProperties.Name="Tasks"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Tasks}" />
                        <controls:RailButton Label="Plan" Icon="ViewAgendaOutline" IsSelected="{Binding IsPlanSelected}" AutomationProperties.Name="Plan"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Plan}" />
                        <!-- Round 2 (owner 2026-11-14, Q394 reversed; change note §4): Goals takes Stats' slot. Stats opens from the Goals
                             header's Stats button (and Search, Back / Forward), so Goals stays lit while Stats shows. -->
                        <controls:RailButton Label="Goals" Icon="TrackChanges" IsSelected="{Binding IsGoalsRailSelected}" AutomationProperties.Name="Goals"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Goals}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="6" VerticalAlignment="Bottom">
                        <controls:RailButton Classes="resting" Label="{Binding RestingText}" Icon="LockOutline" IsVisible="{Binding ShowsResting}"
                                             AutomationProperties.Name="Resting while you focus" Command="{Binding OpenGuardsCommand}"
                                             ToolTip.Tip="Guards that are view-only while you focus; open them" />
                        <controls:RailButton Label="Activity" Icon="Bug" IsSelected="{Binding IsActivitySelected}" AutomationProperties.Name="Activity (dev)"
                                             IsVisible="{Binding ShowDevTools}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Activity}" />
                        <controls:RailButton Label="Settings" Icon="Cog" IsSelected="{Binding IsSettingsSelected}" AutomationProperties.Name="Settings"
                                             Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MainTab.Settings}" />
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Column="1">
                    <!-- The pages sit side by side; switching only shows or hides them. A TabControl takes a page out of the window
                         and puts it back on every switch, which rebuilds every control on it (hundreds of ms on Profiles or Settings);
                         a hidden page costs nothing. Same order as MainTab. -->
                    <Grid Margin="0,10,20,20">
                        <Panel x:Name="Pages">
                            <views:TodayView DataContext="{Binding Session}" />
                            <views:TasksView DataContext="{Binding Tasks}" IsVisible="False" />
                            <views:PlanView DataContext="{Binding Plan}" IsVisible="False" />
                            <views:StatsView DataContext="{Binding Stats}" IsVisible="False" />
                            <views:SettingsShellView IsVisible="False" />
                            <views:ActivityView DataContext="{Binding Activity}" IsVisible="False" />
                            <views:GoalsView DataContext="{Binding Goals}" IsVisible="False" />
                        </Panel>
                        <!-- Search matches on the page showing, drawn over it without taking clicks. -->
                        <controls:SearchHighlightLayer x:Name="Highlights" />
                        <!-- The swipe bubble (NAV2): over the page at its left (back) or right (forward) edge, clipped to the page area. -->
                        <Panel x:Name="SwipeLayer" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True">
                            <ContentControl x:Name="SwipeBubble" Width="44" Height="44" CornerRadius="22" BorderThickness="1" Padding="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"
                                            AutomationProperties.AccessibilityView="Raw">
                                <ContentControl.RenderTransform>
                                    <TranslateTransform />
                                </ContentControl.RenderTransform>
                                <mi:MaterialIcon x:Name="SwipeIcon" Kind="ChevronLeft" Width="26" Height="26" />
                            </ContentControl>
                        </Panel>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- The title-bar menu's dropdown (Tasks redesign 9.04): 8 under its button, right-aligned to it (the right margin is set from the
             button's place), over the page without dimming it; it fits the window's height and scrolls inside. A click outside or Esc closes it. -->
        <views:TitleMenuView x:Name="TitleMenu" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,146,12" ZIndex="20"
                             RenderTransform="translateY(0px)" />

        <!-- Leaving Settings (or closing the window) with unsaved changes. -->
        <Border IsVisible="{Binding ShowsLeavePrompt}" Background="#99000000" ZIndex="30">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20,16"
                    CornerRadius="{DynamicResource Ab.CardRadius}" Background="{DynamicResource Ab.Surface}"
                    BorderBrush="{DynamicResource Ab.Line}" BorderThickness="{DynamicResource Ab.CardBorderThickness}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Unsaved settings" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="You changed settings without saving them. Save them before you go?" TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Stay" Command="{Binding StayCommand}" />
                        <Button Content="Discard" Command="{Binding DiscardAndLeaveCommand}" />
                        <Button Content="Save" Command="{Binding SaveAndLeaveCommand}" Classes="primary" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
