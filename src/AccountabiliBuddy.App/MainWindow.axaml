<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        x:Class="AccountabiliBuddy.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AccountabiliBuddy"
        Icon="/Assets/app-icon.png"
        Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasLoadError}"
                Background="#33D13438" Padding="16,10">
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" />
        </Border>

        <!-- Tabs as a sidebar on the left; headers sized for a vertical list rather than the Fluent top-row default. -->
        <TabControl TabStripPlacement="Left" Margin="0,8,8,8">
            <TabControl.Styles>
                <Style Selector="TabControl[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
                    <Setter Property="Margin" Value="8,4,12,0" />
                </Style>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="MinWidth" Value="168" />
                    <Setter Property="Padding" Value="16,0,24,0" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Background" Value="#1F808080" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="#14808080" />
                </Style>
            </TabControl.Styles>
            <TabItem Header="Session">
                <views:SessionView DataContext="{Binding Session}" />
            </TabItem>
            <TabItem Header="Profiles">
                <views:ProfilesView DataContext="{Binding Profiles}" />
            </TabItem>
            <TabItem Header="Schedule">
                <views:ScheduleView DataContext="{Binding Schedule}" />
            </TabItem>
            <TabItem Header="Exceptions">
                <views:ExceptionsView DataContext="{Binding Exceptions}" />
            </TabItem>
            <TabItem Header="History">
                <views:HistoryView DataContext="{Binding History}" />
            </TabItem>
            <TabItem Header="Setup">
                <views:SetupView DataContext="{Binding Setup}" />
            </TabItem>
            <TabItem Header="Integrations">
                <views:IntegrationsView DataContext="{Binding Integrations}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Activity (dev)">
                <views:ActivityView DataContext="{Binding Activity}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
