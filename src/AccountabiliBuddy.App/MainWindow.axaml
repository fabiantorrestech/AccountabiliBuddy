<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountabiliBuddy.App.ViewModels"
        xmlns:views="using:AccountabiliBuddy.App.Views"
        xmlns:controls="using:AccountabiliBuddy.App.Controls"
        x:Class="AccountabiliBuddy.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AccountabiliBuddy"
        Icon="/Assets/app-icon.png"
        Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
    <Panel>
        <DockPanel>
            <!--
                Tabs as a sidebar on the left; headers sized for a vertical list rather than the Fluent top-row default.
                The TabControl only draws the headers: the pages live side by side in Pages and switching only shows or
                hides them. A TabControl takes a page out of the window and puts it back on every switch, which rebuilds
                every control on it (hundreds of ms on Profiles or Settings); a hidden page costs nothing.
            -->
            <DockPanel DockPanel.Dock="Left">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="22,18,12,6">
                    <Image Source="/Assets/app-icon.png" Width="26" Height="26" />
                    <TextBlock Text="AccountabiliBuddy" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <!-- The noise player, always at the bottom of the sidebar. -->
                <!-- Takes the sidebar's width without widening it (a long file name is cut with "…"). -->
                <controls:FillWidthDecorator DockPanel.Dock="Bottom" Margin="12,0,12,12"
                                             IsVisible="{Binding NoisePlayer, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <views:NoisePlayerView DataContext="{Binding NoisePlayer}" />
                </controls:FillWidthDecorator>
                <TabControl x:Name="Tabs" TabStripPlacement="Left" Margin="0,4,0,8" SelectionChanged="OnTabChanged"
                            SelectedIndex="{Binding SelectedTab}">
                    <TabControl.Styles>
                        <Style Selector="TabControl[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
                            <Setter Property="Margin" Value="8,4,12,0" />
                        </Style>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="MinWidth" Value="168" />
                            <Setter Property="Padding" Value="16,0,24,0" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                        <Style Selector="TabItem:selected">
                            <Setter Property="Background" Value="#1F808080" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="#14808080" />
                        </Style>
                    </TabControl.Styles>
                    <!-- Same order as Pages below. -->
                    <TabItem Header="Session" />
                    <TabItem Header="Profiles" />
                    <TabItem Header="Day plan" />
                    <TabItem Header="Exceptions" />
                    <TabItem Header="History" />
                    <TabItem Header="Devices" />
                    <TabItem Header="Setup" />
                    <TabItem Header="Integrations" />
                    <TabItem Header="Settings" />
                    <TabItem Header="About" />
                    <TabItem Header="Activity (dev)" IsVisible="{Binding ShowDevTools}" />
                </TabControl>
            </DockPanel>

            <!-- Right-hand pane: search, banners, today's bar, then the selected page. -->
            <DockPanel>
                <!-- Search the page showing (highlighted as you type) or the whole app (Ctrl+F). -->
                <Border DockPanel.Dock="Top" Padding="12,10,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <!-- Today's sync QR codes for the phone (ADR 22), while the QR code method is on. -->
                        <Button Content="Sync phone" Command="{Binding ShowSyncQrCodesCommand}" IsVisible="{Binding ShowsQrButton}"
                                ToolTip.Tip="Show today's QR codes for your phone to scan" VerticalAlignment="Center" />
                        <views:SearchBox x:Name="Search" DataContext="{Binding Search}"
                                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Search, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasLoadError}"
                        Background="#33D13438" Padding="16,10">
                    <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" />
                </Border>
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasClockNotice}"
                        Background="#33E0A800" Padding="16,10">
                    <TextBlock Text="{Binding ClockNotice}" TextWrapping="Wrap" />
                </Border>

                <!-- Today at a glance: the rows chosen in Settings (calendar, plan, focus, blockers) and a live "now" line. -->
                <Border DockPanel.Dock="Top" DataContext="{Binding DayBar}" x:DataType="vm:DayBarViewModel"
                        IsVisible="{Binding IsVisible, FallbackValue=False}" Padding="12,14,16,4">
                    <StackPanel Spacing="6">
                        <!-- The day's numbers are in the legend under the bar. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsSleep}">
                            <Ellipse Width="8" Height="8" Fill="{Binding SleepBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SleepText}" Opacity="0.85" />
                        </StackPanel>
                        <controls:DayBarControl Layout="{Binding Layout}" OpenProfileCommand="{Binding OpenProfileCommand}" OpenDayPlanCommand="{Binding OpenDayPlanCommand}"
                                                AddSessionCommand="{Binding AddSessionCommand}" />
                        <!-- Under the bar, lined up with its row labels: planned work by kind in its colours, and the focus so far,
                             on a faint panel (the negative margin keeps the columns under the row labels). -->
                        <Border Background="#1F808080" CornerRadius="6" Padding="6,4" Margin="-6,0">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="ShowsPlanTotals" />
                                    <Binding Path="ShowsFocusTotal" />
                                </MultiBinding>
                            </Border.IsVisible>
                        <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Plan" FontSize="11" Opacity="0.75" VerticalAlignment="Center" IsVisible="{Binding ShowsPlanTotals}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding PlanTotals}" IsVisible="{Binding ShowsPlanTotals}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanTotal">
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1,16,1">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Text}" FontSize="12" Opacity="0.85" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="1" Text="Focus" FontSize="11" Opacity="0.75" VerticalAlignment="Center" IsVisible="{Binding ShowsFocusTotal}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,1" IsVisible="{Binding ShowsFocusTotal}">
                                <Ellipse Width="8" Height="8" Fill="{x:Static controls:DayBarControl.FocusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FocusTotalText}" FontSize="12" Opacity="0.85" />
                            </StackPanel>
                        </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="12,8,8,8">
                <Panel x:Name="Pages">
                    <views:SessionView DataContext="{Binding Session}" />
                    <views:ProfilesView DataContext="{Binding Profiles}" IsVisible="False" />
                    <views:DayPlanView DataContext="{Binding DayPlan}" IsVisible="False" />
                    <views:ExceptionsView DataContext="{Binding Exceptions}" IsVisible="False" />
                    <views:HistoryView DataContext="{Binding History}" IsVisible="False" />
                    <views:DevicesView DataContext="{Binding Devices}" IsVisible="False" />
                    <views:SetupView DataContext="{Binding Setup}" IsVisible="False" />
                    <views:IntegrationsView DataContext="{Binding Integrations}" IsVisible="False" />
                    <views:SettingsView DataContext="{Binding Settings}" IsVisible="False" />
                    <views:AboutView DataContext="{Binding Settings.Updates}" IsVisible="False" />
                    <views:ActivityView DataContext="{Binding Activity}" IsVisible="False" />
                </Panel>
                <!-- Search matches on the page showing, drawn over it without taking clicks. -->
                <controls:SearchHighlightLayer x:Name="Highlights" />
                </Grid>
            </DockPanel>
        </DockPanel>

        <!-- Leaving Settings (or closing the window) with unsaved changes. -->
        <Border IsVisible="{Binding ShowsLeavePrompt}" Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20,16" CornerRadius="10"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#55808080" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Unsaved settings" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="You changed settings without saving them. Save them before you go?" TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Stay" Command="{Binding StayCommand}" />
                        <Button Content="Discard" Command="{Binding DiscardAndLeaveCommand}" />
                        <Button Content="Save" Command="{Binding SaveAndLeaveCommand}" Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
