<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only to the paired PC on the local network (ADR 14): pinned TLS, no cleartext (network_security_config). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Wi-Fi network's broadcast address, to find the paired PC when its address changed (ADR 14). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Take over the screen": the work nudge opens full screen over other apps (turned on by the user). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Settings → Permissions → Unrestricted battery: asks Android to let the app run on time (the user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "Pause in the car": tells a car's Bluetooth (by its class) from other devices; asked only when that switch is turned on. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Holding the timeline notification pinned at the top (see PinnedTimelineService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The noise player keeps playing in the background like any music app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Keeps LockMyPhone-Extended's "Accountabilibuddy" profile in sync with the essentials (ProfileSync). Granted only when
         LockMyPhone-Extended, signed with the same key, was installed first. -->
    <uses-permission android:name="com.fabiantorrestech.lockmyphone_extended.permission.MANAGE_PROFILES" />
    <!-- Which app was in front, for today's phone use (granted by the user in Settings > Usage access). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- The hardcore profile: LockMyPhone-Extended's public intent API (only asked to start a lock). -->
        <package android:name="com.fabiantorrestech.lockmyphone_extended" />
        <!-- Its profile names for the hardcore picker (read-only, guarded by its MANAGE_PROFILES permission). -->
        <provider android:authorities="com.fabiantorrestech.lockmyphone_extended.profiles" />
        <!-- App names for phone use, and home screens to leave out of it. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Curbox's API. -->
        <intent>
            <action android:name="neth.iecal.curbox.api.BIND" />
        </intent>
        <intent>
            <action android:name="neth.iecal.curbox.api.REQUEST_PERMISSION" />
        </intent>
    </queries>

    <application
        android:name=".CompanionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AccountabiliBuddy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect (Android 13 and older): why the app reads sleep. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- The PC's pairing QR code (ADR 14): the camera opens accountabilibuddy://pair?... here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="accountabilibuddy" android:host="pair" />
            </intent-filter>
            <!-- Device sync (ADR 22): the PC's link code (join) and its sync QR codes (sync), opened by the camera. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="accountabilibuddy" android:host="join" />
                <data android:scheme="accountabilibuddy" android:host="sync" />
            </intent-filter>
            <!-- Sync files (*.absync) opened or shared with the app; anything else gets "That file can't be read". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Sharing sync files out (ADR 22): only the app's cache/sync folder is offered. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sync_paths" />
        </provider>

        <!-- Health Connect (Android 14+): why the app reads sleep. -->
        <activity
            android:name=".nudge.NudgeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.accountabilibuddy.companion.nudge" />

        <!-- The essentials screen (LockMyPhone-Extended style, soft). -->
        <activity
            android:name=".essentials.EssentialsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="com.accountabilibuddy.companion.essentials" />

        <!-- "Need my phone" from the parked notice: the emergency chooser on its own. -->
        <activity
            android:name=".nudge.EmergencyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.accountabilibuddy.companion.nudge" />

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".notify.RefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The next alarm changed (ADR 23): a broadcast Android still sends to apps' manifest receivers. -->
        <receiver
            android:name=".sync.NextAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".notify.PinnedTimelineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's day-at-a-glance timeline notification pinned above other notifications" />
        </service>

        <!-- The widget's noise volume − and +. -->
        <receiver
            android:name=".noise.NoiseVolumeReceiver"
            android:exported="false" />

        <!-- The noise player while it plays (its notification has previous, play/pause, next). -->
        <service
            android:name=".noise.NoiseService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The watch app asks for news, or says how pairing with the PC went (ADR 21): wakes the app to answer. -->
        <service
            android:name=".watch.PhoneWearService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hello" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/pc-paired" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/noise-command" />
            </intent-filter>
        </service>

        <receiver
            android:name=".lunch.LunchReceiver"
            android:exported="false" />

        <receiver
            android:name=".pause.CarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.app.action.ENTER_CAR_MODE" />
                <action android:name="android.app.action.EXIT_CAR_MODE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.TimelineWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timeline_widget_info" />
        </receiver>
    </application>

</manifest>
