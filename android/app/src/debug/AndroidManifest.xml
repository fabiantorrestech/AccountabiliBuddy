<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a sample night for Health Connect, and the demo-data seeder for screenshots. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />

    <application>
        <receiver
            android:name=".debug.SampleSleepReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.accountabilibuddy.companion.debug.SAMPLE_SLEEP" />
            </intent-filter>
        </receiver>
        <!-- Made-up data for screenshots on an emulator: the extra "mode" is idle, session or clear (see DemoSeeder). -->
        <receiver
            android:name=".debug.DemoSeedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.accountabilibuddy.companion.debug.SEED" />
            </intent-filter>
        </receiver>
        <!-- Sets the theme, light or dark mode, colour, set times and place from adb (see AppearanceDebugReceiver). -->
        <receiver
            android:name=".debug.AppearanceDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.accountabilibuddy.companion.debug.APPEARANCE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugVoiceSwitch"
            android:exported="true">
            <intent-filter>
                <action android:name="com.accountabilibuddy.companion.debug.VOICE" />
            </intent-filter>
        </receiver>
        <!-- A stand-in voice service for the Park pill's microphone on an emulator; off until the VOICE broadcast turns it on (see DebugVoiceSwitch). -->
        <activity
            android:name=".debug.DebugVoiceActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- The component kit on one page, in one theme (see KitGalleryActivity). -->
        <activity
            android:name=".debug.KitGalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.AccountabiliBuddy" />
    </application>
</manifest>
