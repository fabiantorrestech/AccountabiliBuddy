<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A Wear OS app; its data comes from the phone over the Wearable Data Layer (ADR 21), or from the PC over Wi-Fi
         when the phone can't be reached (asking for Wi-Fi needs CHANGE_NETWORK_STATE). -->
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- The buzz when a focus or break timer ends, at the exact time even in Doze (a timer is what exact alarms are for). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Bedtime reminders from the phone (ADR 38). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The watch's own timers: "Time's up" over the watch face when it's asleep, and their alarms set again after a restart. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Not standalone: it shows what the phone (and through it, the PC) knows. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- The phone's messages: a snapshot to show, "not linked", or the PC's pairing code for Wi-Fi. -->
        <service
            android:name=".link.WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/snapshot" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/unlink" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/pc-offer" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/noise" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/reminder" />
            </intent-filter>
        </service>

        <!-- The swipe-in Tile: today's focus against the plan, or the running session. -->
        <service
            android:name=".tile.FocusTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- The watch-face complication: a ring or a short text. -->
        <service
            android:name=".complication.FocusComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- The second complication, "Timers": the watch's own timer that ends soonest (updated on each change and end). -->
        <service
            android:name=".complication.TimersComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/timers_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <activity
            android:name=".WatchActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".alerts.ReminderActionReceiver" android:exported="false" />

        <receiver
            android:name=".alerts.PhaseAlertReceiver"
            android:exported="false" />

        <!-- The watch's own timers: the end alarm, the "Time's up" notification's buttons, and setting alarms again after a restart. -->
        <receiver android:name=".timers.TimerEndReceiver" android:exported="false" />
        <receiver android:name=".timers.TimerActionReceiver" android:exported="false" />
        <receiver
            android:name=".timers.TimerBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
